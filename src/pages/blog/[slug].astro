---
/**
 * /blog/[slug] — Page article individuel PREMIUM (Expérience Immersive).
 *
 * Redesign avec :
 *   - Cover image full-width avec overlay cinématique
 *   - Header article avec typographie éditoriale impactante
 *   - Contenu prose optimisé pour la lecture (largeur, interlignage)
 *   - Table des matières sticky (si headings présentes)
 *   - Tags stylisés
 *   - Partage social premium
 *   - Articles liés en grid asymétrique
 *   - Navigation précédent/suivant
 */

import { render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import ArticleSEO from '../../components/blog/ArticleSEO.astro';
import CategoryBadge from '../../components/blog/CategoryBadge.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';
import NewsletterCard from '../../components/blog/NewsletterCard.astro';
import NewsletterModal from '../../components/blog/NewsletterModal.astro';
import { getAllArticles, getArticleUrl, getCategoryUrl, getReadingTime } from '../../lib/blog';

export async function getStaticPaths() {
        const all = await getAllArticles();
        return all.map((entry) => ({
                params: { slug: entry.id.replace(/\.md$/, '') },
                props: { entry },
        }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const url = getArticleUrl(entry);
const readingTime = getReadingTime(entry);

const dateStr = entry.data.publishedAt.toLocaleDateString('fr-FR', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
});

const hasCover = !!entry.data.coverImage;
const coverUrl = entry.data.coverImage
        ? entry.data.coverImage.startsWith('http')
                ? entry.data.coverImage
                : entry.data.coverImage
        : '';

// Get previous and next articles for navigation
const allArticles = await getAllArticles();
const currentIndex = allArticles.findIndex((a) => a.id === entry.id);
const prevArticle = currentIndex < allArticles.length - 1 ? allArticles[currentIndex + 1] : null;
const nextArticle = currentIndex > 0 ? allArticles[currentIndex - 1] : null;
---

<BlogLayout
        title={`${entry.data.title} | Blog FTCI`}
        description={entry.data.description}
        canonical={url}
>
        <ArticleSEO
                slot="head"
                title={entry.data.title}
                description={entry.data.description}
                url={url}
                publishedAt={entry.data.publishedAt}
                author={entry.data.author}
                coverImage={entry.data.coverImage}
                category={entry.data.category}
                keywords={entry.data.tags}
        />

        <article class="article-premium">
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- COVER IMAGE CINÉMATIQUE                                            -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                {
                        hasCover && (
                                <div class="article-cover-premium">
                                        <img
                                                src={coverUrl}
                                                alt=""
                                                loading="eager"
                                                fetchpriority="high"
                                                decoding="async"
                                                class="article-cover-img"
                                        />
                                        <div class="article-cover-overlay" aria-hidden="true"></div>
                                        <div class="article-cover-gradient" aria-hidden="true"></div>
                                        <!-- Breadcrumb sur cover -->
                                        <nav class="article-breadcrumb" aria-label="Fil d'Ariane">
                                                <a href="/blog" class="breadcrumb-link">Blog</a>
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                                <CategoryBadge category={entry.data.category} size="sm" href={getCategoryUrl(entry.data.category)} />
                                        </nav>
                                </div>
                        )
                }

                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- CONTENU PRINCIPAL                                                   -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <div class="article-wrapper">
                        <main class="article-main">
                                <!-- Header article -->
                                <header class="article-header-premium">
                                        {/* Breadcrumb si pas de cover */}
                                        {
                                                !hasCover && (
                                                        <nav class="article-breadcrumb article-breadcrumb--standalone" aria-label="Fil d'Ariane">
                                                                <a href="/blog" class="breadcrumb-link">Blog</a>
                                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                                                <span class="breadcrumb-current">{(await import('../../lib/blog')).getCategoryLabel(entry.data.category)}</span>
                                                        </nav>
                                                )
                                        }

                                        <h1 class="article-title-premium">{entry.data.title}</h1>
                                        
                                        <p class="article-lead">{entry.data.description}</p>

                                        <div class="article-meta-premium">
                                                <div class="meta-author">
                                                        <div class="author-avatar" aria-hidden="true">
                                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                                                </svg>
                                                        </div>
                                                        <div class="author-info">
                                                                <span class="author-name">{entry.data.author}</span>
                                                                <span class="author-role">Auteur</span>
                                                        </div>
                                                </div>

                                                <div class="meta-divider" aria-hidden="true"></div>

                                                <div class="meta-dates">
                                                        <time datetime={entry.data.publishedAt.toISOString()} class="meta-date">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                                {dateStr}
                                                        </time>
                                                        <span class="meta-reading">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                                {readingTime} min de lecture
                                                        </span>
                                                </div>
                                        </div>
                                </header>

                                <!-- Contenu Markdown -->
                                <div class="article-content-premium">
                                        <Content />
                                </div>

                                <!-- Tags -->
                                {
                                        entry.data.tags.length > 0 && (
                                                <footer class="article-tags-premium">
                                                        <span class="tags-label">Tags</span>
                                                        <div class="tags-list">
                                                                {entry.data.tags.map((tag) => (
                                                                        <span class="tag-item">#{tag}</span>
                                                                ))}
                                                        </div>
                                                </footer>
                                        )
                                }

                                <!-- Share -->
                                <div class="article-share-section">
                                        <div class="share-divider">
                                                <span class="share-dot"></span>
                                                <span class="share-dot"></span>
                                                <span class="share-dot"></span>
                                        </div>
                                        <ShareButtons title={entry.data.title} url={url} description={entry.data.description} />
                                </div>

                                <!-- Navigation articles -->
                                <nav class="article-nav" aria-label="Navigation entre articles">
                                        {prevArticle ? (
                                                <a href={`/blog/${prevArticle.id.replace(/\.md$/, '')}`} class="article-nav-link article-nav-prev">
                                                        <span class="nav-direction">
                                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                                                                Article précédent
                                                        </span>
                                                        <span class="nav-title">{prevArticle.data.title}</span>
                                                </a>
                                        ) : <div></div>}
                                        {nextArticle ? (
                                                <a href={`/blog/${nextArticle.id.replace(/\.md$/, '')}`} class="article-nav-link article-nav-next">
                                                        <span class="nav-direction">
                                                                Article suivant
                                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                                        </span>
                                                        <span class="nav-title">{nextArticle.data.title}</span>
                                                </a>
                                        ) : <div></div>}
                                </nav>
                        </main>

                        <!-- Sidebar (sur desktop) -->
                        <aside class="article-sidebar" aria-label="Informations complémentaires">
                                <div class="sidebar-sticky">
                                        <!-- Table des matières (générée par JS) -->
                                        <nav class="toc-widget" aria-label="Table des matières">
                                                <h4 class="toc-title">Sommaire</h4>
                                                <ol class="toc-list" id="toc-list">
                                                        <!-- Rempli dynamiquement -->
                                                </ol>
                                        </nav>

                                        <!-- CTA Sidebar - Carte newsletter minimaliste -->
                                        <NewsletterCard />
                                </div>
                        </aside>
                </div>

                <!-- Articles liés -->
                <RelatedArticles current={entry} />

                <!-- Retour au blog -->
                <div class="article-back-premium">
                        <a href="/blog" class="back-link">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                                </svg>
                                <span>Tous les articles</span>
                        </a>
                </div>
        </article>

        <!-- Modale newsletter (globale pour la page) -->
        <NewsletterModal />
</BlogLayout>

<script>
        // Générer la table des matières depuis les headings H2/H3
        function generateTOC() {
                const tocList = document.getElementById('toc-list');
                if (!tocList) return;

                const content = document.querySelector('.article-content-premium');
                if (!content) return;

                const headings = content.querySelectorAll(':scope > h2, :scope > h3');
                
                if (headings.length === 0) {
                        const tocWidget = tocList.closest('.toc-widget');
                        if (tocWidget) tocWidget.style.display = 'none';
                        return;
                }

                headings.forEach((heading, index) => {
                        const id = `heading-${index}`;
                        heading.id = id;

                        const li = document.createElement('li');
                        li.className = heading.tagName.toLowerCase() === 'h3' ? 'toc-item toc-subitem' : 'toc-item';

                        const a = document.createElement('a');
                        a.href = `#${id}`;
                        a.textContent = heading.textContent || '';
                        a.addEventListener('click', (e) => {
                                e.preventDefault();
                                heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        });

                        // Active state on scroll
                        const observer = new IntersectionObserver(
                                (entries) => {
                                        entries.forEach((entry) => {
                                                if (entry.isIntersecting) {
                                                        tocList.querySelectorAll('.toc-active').forEach((el) => el.classList.remove('toc-active'));
                                                        a.classList.add('toc-active');
                                                }
                                        });
                                },
                                { rootMargin: '-20% 0px -70% 0px' }
                        );
                        observer.observe(heading);

                        li.appendChild(a);
                        tocList.appendChild(li);
                });
        }

        // Exécuter après le chargement du DOM
        generateTOC();

        // Réexécuter si le contenu change (SPA-like transitions)
        document.addEventListener('astro:page-load', generateTOC);
</script>

<style>
        /* ═══════════════════════════════════════════════════════════════════════════
           COVER PREMIUM
           ═══════════════════════════════════════════════════════════════════════════ */
        .article-cover-premium {
                position: relative;
                width: 100%;
                height: 85vh;
                height: 85svh;
                max-width: none;
                margin: 0;
                overflow: hidden;
                background: var(--color-navy);
        }

        @media (max-width: 768px) {
                .article-cover-premium {
                        height: 75vh;
                        height: 75svh;
                        border-radius: 0;
                }
        }

        .article-cover-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
        }

        .article-cover-overlay {
                position: absolute;
                inset: 0;
                background:
                        linear-gradient(
                                to bottom,
                                rgba(15, 30, 61, 0.15) 0%,
                                rgba(15, 30, 61, 0.35) 50%,
                                rgba(15, 30, 61, 0.6) 85%,
                                rgba(15, 30, 61, 0.75) 100%
                        );
                z-index: 1;
        }

        .article-cover-gradient {
                position: absolute;
                inset: 0;
                background:
                        radial-gradient(ellipse at 30% 50%, rgba(107, 127, 199, 0.15) 0%, transparent 60%),
                        radial-gradient(ellipse at 80% 20%, rgba(238, 108, 26, 0.1) 0%, transparent 50%);
                z-index: 2;
                pointer-events: none;
        }

        /* Breadcrumb on cover */
        .article-breadcrumb {
                position: absolute;
                bottom: 2rem;
                left: 2rem;
                z-index: 5;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.8125rem;
                color: rgba(255, 255, 255, 0.75);
        }
        @media (max-width: 768px) {
                .article-breadcrumb {
                        bottom: 1.25rem;
                        left: 1.25rem;
                }
        }
        .breadcrumb-link {
                color: rgba(255, 255, 255, 0.85);
                text-decoration: none;
                font-weight: 500;
                transition: color 200ms ease;
        }
        .breadcrumb-link:hover {
                color: var(--color-orange);
        }
        .article-breadcrumb svg {
                opacity: 0.5;
        }

        /* Standalone breadcrumb (sans cover) */
        .article-breadcrumb--standalone {
                position: static;
                margin-bottom: 1.25rem;
                padding-bottom: 1rem;
                border-bottom: 1px solid rgba(15, 30, 61, 0.08);
        }
        .breadcrumb-current {
                color: var(--color-orange);
                font-weight: 500;
        }

        /* ═══════════════════════════════════════════════════════════════════════════
           WRAPPER & LAYOUT
           ═══════════════════════════════════════════════════════════════════════════ */
        .article-wrapper {
                max-width: 1200px;
                margin: 0 auto;
                padding: 3rem 1.5rem 4rem;
                display: grid;
                grid-template-columns: 1fr;
                gap: 3rem;
        }

        @media (min-width: 1024px) {
                .article-wrapper {
                        grid-template-columns: minmax(0, 1fr) 280px;
                        padding: 4rem 2rem 6rem;
                }
        }

        .article-main {
                min-width: 0;
        }

        /* ═══════════════════════════════════════════════════════════════════════════
           HEADER ARTICLE
           ═══════════════════════════════════════════════════════════════════════════ */
        .article-header-premium {
                margin-bottom: 3rem;
        }

        .article-title-premium {
                font-family: var(--font-display);
                font-weight: 800;
                font-size: clamp(2rem, 5vw, 3rem);
                line-height: 1.12;
                letter-spacing: -0.03em;
                color: var(--color-navy);
                margin: 0 0 1.25rem;
        }

        .article-lead {
                font-size: 1.1875rem;
                line-height: 1.65;
                color: var(--color-gray-text);
                margin: 0 0 2rem;
                padding-left: 1.5rem;
                border-left: 3px solid var(--color-orange);
        }

        /* Meta */
        .article-meta-premium {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 1.25rem;
                padding: 1.25rem 1.5rem;
                background: linear-gradient(135deg, rgba(15, 30, 61, 0.03) 0%, rgba(15, 30, 61, 0.01) 100%);
                border: 1px solid rgba(15, 30, 61, 0.06);
                border-radius: calc(var(--radius-card) - 2px);
        }

        .meta-author {
                display: flex;
                align-items: center;
                gap: 0.75rem;
        }
        .author-avatar {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--color-navy) 0%, #1c2d54 100%);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
        }
        .author-avatar svg {
                width: 22px;
                height: 22px;
        }
        .author-info {
                display: flex;
                flex-direction: column;
        }
        .author-name {
                font-weight: 600;
                font-size: 0.9375rem;
                color: var(--color-navy);
        }
        .author-role {
                font-size: 0.75rem;
                color: var(--color-gray-text);
        }

        .meta-divider {
                width: 1px;
                height: 32px;
                background: linear-gradient(180deg, transparent, rgba(15, 30, 61, 0.15), transparent);
        }

        .meta-dates {
                display: flex;
                flex-wrap: wrap;
                gap: 0.875rem;
        }
        .meta-date,
        .meta-reading {
                display: inline-flex;
                align-items: center;
                gap: 0.375rem;
                font-size: 0.8125rem;
                color: var(--color-gray-text);
        }
        .meta-date svg,
        .meta-reading svg {
                opacity: 0.6;
        }

        @media (max-width: 640px) {
                .article-meta-premium {
                        flex-direction: column;
                        align-items: flex-start;
                        gap: 1rem;
                }
                .meta-divider {
                        display: none;
                }
        }

        /* ═══════════════════════════════════════════════════════════════════════════
           CONTENU MARKDOWN (PROSE OPTIMISÉ)
           ═══════════════════════════════════════════════════════════════════════════ */
        .article-content-premium {
                font-size: 1.0625rem;
                line-height: 1.8;
                color: #1f2937;
        }

        .article-content-premium :global(h2) {
                font-family: var(--font-display);
                font-weight: 700;
                font-size: 1.625rem;
                line-height: 1.28;
                letter-spacing: -0.02em;
                color: var(--color-navy);
                margin: 3rem 0 1.125rem;
                padding-top: 1.5rem;
                border-top: 1px solid rgba(15, 30, 61, 0.08);
        }
        .article-content-premium :global(h2:first-child) {
                border-top: none;
                padding-top: 0;
                margin-top: 1.5rem;
        }

        .article-content-premium :global(h3) {
                font-family: var(--font-display);
                font-weight: 700;
                font-size: 1.3125rem;
                line-height: 1.32;
                color: var(--color-navy);
                margin: 2.25rem 0 0.875rem;
        }

        .article-content-premium :global(p) {
                margin: 0 0 1.375rem;
        }

        .article-content-premium :global(a) {
                color: var(--color-orange);
                text-decoration: underline;
                text-underline-offset: 3px;
                text-decoration-thickness: 1px;
                transition: color 150ms ease;
        }
        .article-content-premium :global(a:hover) {
                color: #c44100;
        }

        .article-content-premium :global(ul),
        .article-content-premium :global(ol) {
                margin: 0 0 1.5rem;
                padding-left: 1.625rem;
        }
        .article-content-premium :global(li) {
                margin: 0.5rem 0;
        }
        .article-content-premium :global(ul) :global(li)::marker {
                color: var(--color-orange);
        }
        .article-content-premium :global(ol) :global(li)::marker {
                color: var(--color-navy);
                font-weight: 600;
        }

        .article-content-premium :global(blockquote) {
                margin: 2rem 0;
                padding: 1.25rem 1.5rem;
                border-left: 4px solid var(--color-orange);
                background: linear-gradient(135deg, rgba(238, 108, 26, 0.05) 0%, rgba(238, 108, 26, 0.02) 100%);
                border-radius: 0 0.75rem 0.75rem 0;
                color: var(--color-navy);
                font-style: italic;
                font-size: 1.0625rem;
        }
        .article-content-premium :global(blockquote) :global(p) {
                margin: 0;
        }

        .article-content-premium :global(code) {
                font-family: ui-monospace, 'SF Mono', Monaco, Consolas, monospace;
                font-size: 0.88em;
                background: rgba(15, 30, 61, 0.06);
                padding: 0.175em 0.45em;
                border-radius: 0.25rem;
                color: var(--color-navy);
                border: 1px solid rgba(15, 30, 61, 0.08);
        }

        .article-content-premium :global(pre) {
                margin: 2rem 0;
                padding: 1.5rem;
                background: linear-gradient(135deg, #0f1e3d 0%, #162345 100%);
                color: #e5e7eb;
                border-radius: 0.875rem;
                overflow-x: auto;
                font-size: 0.875rem;
                line-height: 1.65;
                box-shadow: 
                        0 4px 16px rgba(15, 30, 61, 0.15),
                        inset 0 1px 0 rgba(255, 255, 255, 0.05);
        }
        .article-content-premium :global(pre) :global(code) {
                background: none;
                padding: 0;
                color: inherit;
                border: none;
                font-size: inherit;
        }

        .article-content-premium :global(img) {
                max-width: 100%;
                height: auto;
                border-radius: 0.875rem;
                margin: 2rem 0;
                box-shadow: 0 4px 20px rgba(15, 30, 61, 0.1);
        }

        .article-content-premium :global(hr) {
                margin: 3rem 0;
                border: none;
                height: 1px;
                background: linear-gradient(90deg, transparent, rgba(15, 30, 61, 0.12), transparent);
        }

        .article-content-premium :global(table) {
                width: 100%;
                margin: 2rem 0;
                border-collapse: collapse;
                font-size: 0.9375rem;
                border-radius: 0.75rem;
                overflow: hidden;
                box-shadow: 0 2px 8px rgba(15, 30, 61, 0.06);
        }
        .article-content-premium :global(th),
        .article-content-premium :global(td) {
                padding: 0.875rem 1rem;
                border: 1px solid rgba(15, 30, 61, 0.1);
                text-align: left;
        }
        .article-content-premium :global(th) {
                background: linear-gradient(135deg, rgba(15, 30, 61, 0.04) 0%, rgba(15, 30, 61, 0.02) 100%);
                font-weight: 600;
                color: var(--color-navy);
        }

        /* Strong emphasis */
        .article-content-premium :global(strong) {
                color: var(--color-navy);
                font-weight: 700;
        }

        /* ═══════════════════════════════════════════════════════════════════════════
           TAGS
           ═══════════════════════════════════════════════════════════════════════════ */
        .article-tags-premium {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.5rem;
                margin: 2.5rem 0 0;
                padding: 1.5rem;
                background: linear-gradient(135deg, rgba(15, 30, 61, 0.02) 0%, transparent 100%);
                border: 1px solid rgba(15, 30, 61, 0.06);
                border-radius: calc(var(--radius-card) - 2px);
        }
        .tags-label {
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: var(--color-gray-text);
        }
        .tags-list {
                display: flex;
                flex-wrap: wrap;
                gap: 0.375rem;
        }
        .tag-item {
                font-size: 0.8125rem;
                color: var(--color-navy);
                background: #fff;
                padding: 0.3rem 0.75rem;
                border-radius: var(--radius-pill);
                border: 1px solid rgba(15, 30, 61, 0.1);
                transition: all 200ms ease;
                cursor: default;
        }
        .tag-item:hover {
