---
/**
 * /blog/[slug] — Page article individuel.
 *
 * Prérendrée statiquement via getStaticPaths(). Rend le corps Markdown via
 * `render(entry)` (Astro 7 Content Layer API), wrapped dans BlogLayout.
 *
 * Inclut : ArticleSEO (meta + JSON-LD), cover image, badge catégorie, titre,
 * métadonnées (date, lecture, auteur), contenu Markdown, boutons de partage,
 * et RelatedArticles en bas.
 */

import { render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import ArticleSEO from '../../components/blog/ArticleSEO.astro';
import CategoryBadge from '../../components/blog/CategoryBadge.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';
import { getAllArticles, getArticleUrl, getCategoryUrl, getReadingTime } from '../../lib/blog';

export async function getStaticPaths() {
	const all = await getAllArticles();
	return all.map((entry) => ({
		params: { slug: entry.id.replace(/\.md$/, '') },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const url = getArticleUrl(entry);
const readingTime = getReadingTime(entry);

const dateStr = entry.data.publishedAt.toLocaleDateString('fr-FR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const hasCover = !!entry.data.coverImage;
const coverUrl = entry.data.coverImage
	? entry.data.coverImage.startsWith('http')
		? entry.data.coverImage
		: entry.data.coverImage
	: '';
---

<BlogLayout
	title={`${entry.data.title} | Blog FTCI`}
	description={entry.data.description}
	canonical={url}
>
	<ArticleSEO
		slot="head"
		title={entry.data.title}
		description={entry.data.description}
		url={url}
		publishedAt={entry.data.publishedAt}
		author={entry.data.author}
		coverImage={entry.data.coverImage}
		category={entry.data.category}
		keywords={entry.data.tags}
	/>

	<article class="article-page">
		<!-- ── Cover image (optionnelle) ────────────────────────────────── -->
		{
			hasCover && (
				<div class="article-cover observe" style="--d: 0s;">
					<img
						src={coverUrl}
						alt=""
						loading="eager"
						fetchpriority="high"
						decoding="async"
						class="article-cover-img"
					/>
				</div>
			)
		}

		<div class="container article-container">
			<!-- ── Header de l'article ─────────────────────────────────────── -->
			<header class="article-header observe" style="--d: 0.05s;">
				<div class="article-header-badge">
					<CategoryBadge
						category={entry.data.category}
						size="md"
						href={getCategoryUrl(entry.data.category)}
					/>
				</div>

				<h1 class="article-title">{entry.data.title}</h1>
				<p class="article-description">{entry.data.description}</p>

				<div class="article-meta">
					<div class="article-author">
						<div class="article-author-avatar" aria-hidden="true">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
								></path>
							</svg>
						</div>
						<span class="article-author-name">{entry.data.author}</span>
					</div>
					<span class="article-meta-sep" aria-hidden="true">·</span>
					<time datetime={entry.data.publishedAt.toISOString()}>{dateStr}</time>
					<span class="article-meta-sep" aria-hidden="true">·</span>
					<span>{readingTime} min de lecture</span>
				</div>
			</header>

			<!-- ── Contenu Markdown ────────────────────────────────────────── -->
			<div class="article-content observe" style="--d: 0.1s;">
				<Content />
			</div>

			<!-- ── Tags ────────────────────────────────────────────────────── -->
			{
				entry.data.tags.length > 0 && (
					<div class="article-tags observe" style="--d: 0.15s;">
						{entry.data.tags.map((tag) => (
							<span class="article-tag">#{tag}</span>
						))}
					</div>
				)
			}

			<!-- ── Boutons de partage ──────────────────────────────────────── -->
			<ShareButtons title={entry.data.title} url={url} description={entry.data.description} />

			<!-- ── Articles liés ───────────────────────────────────────────── -->
			<RelatedArticles current={entry} />

			<!-- ── Retour au blog ──────────────────────────────────────────── -->
			<div class="article-back">
				<a href="/blog" class="article-back-link">
					<svg
						class="w-4 h-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
					</svg>
					Tous les articles
				</a>
			</div>
		</div>
	</article>
</BlogLayout>

<style>
	.article-page {
		background: #fff;
	}

	.article-cover {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		aspect-ratio: 21 / 9;
		overflow: hidden;
		border-radius: 0 0 1.5rem 1.5rem;
		background: var(--color-navy);
	}
	@media (max-width: 768px) {
		.article-cover {
			aspect-ratio: 16 / 9;
			border-radius: 0;
		}
	}
	.article-cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.article-container {
		max-width: 780px;
		padding: 3rem 1.5rem 5rem;
	}
	@media (min-width: 768px) {
		.article-container {
			padding: 4rem 2rem 6rem;
		}
	}

	.article-header {
		margin-bottom: 2.5rem;
	}
	.article-header-badge {
		margin-bottom: 1.25rem;
	}
	.article-title {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.875rem, 4vw, 2.75rem);
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--color-navy);
		margin: 0 0 1rem;
	}
	.article-description {
		font-size: 1.125rem;
		line-height: 1.55;
		color: var(--color-gray-text);
		margin: 0 0 1.5rem;
	}

	.article-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: 0.875rem;
		color: var(--color-gray-text);
	}
	.article-author {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.article-author-avatar {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--color-navy);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.article-author-name {
		font-weight: 600;
		color: var(--color-navy);
	}
	.article-meta-sep {
		opacity: 0.4;
	}

	/* ── Contenu Markdown (prose-like) ────────────────────────────────── */
	.article-content {
		font-size: 1.0625rem;
		line-height: 1.75;
		color: #1f2937;
	}
	.article-content :global(h2) {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.75rem;
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--color-navy);
		margin: 2.5rem 0 1rem;
	}
	.article-content :global(h3) {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.375rem;
		line-height: 1.3;
		color: var(--color-navy);
		margin: 2rem 0 0.75rem;
	}
	.article-content :global(p) {
		margin: 0 0 1.25rem;
	}
	.article-content :global(a) {
		color: var(--color-orange);
		text-decoration: underline;
		text-underline-offset: 2px;
		transition: color 150ms var(--ease-out);
	}
	.article-content :global(a:hover) {
		color: var(--color-orange-700);
	}
	.article-content :global(ul),
	.article-content :global(ol) {
		margin: 0 0 1.25rem;
		padding-left: 1.5rem;
	}
	.article-content :global(li) {
		margin: 0.375rem 0;
	}
	.article-content :global(ul) :global(li) {
		list-style: disc;
	}
	.article-content :global(ol) :global(li) {
		list-style: decimal;
	}
	.article-content :global(blockquote) {
		margin: 1.5rem 0;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--color-orange);
		background: rgba(238, 108, 26, 0.05);
		border-radius: 0 0.5rem 0.5rem 0;
		color: var(--color-navy);
		font-style: italic;
	}
	.article-content :global(blockquote) :global(p) {
		margin: 0;
	}
	.article-content :global(code) {
		font-family: ui-monospace, 'SF Mono', Monaco, Consolas, monospace;
		font-size: 0.9em;
		background: rgba(15, 30, 61, 0.08);
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		color: var(--color-navy);
	}
	.article-content :global(pre) {
		margin: 1.5rem 0;
		padding: 1.25rem;
		background: var(--color-navy);
		color: #e5e7eb;
		border-radius: 0.75rem;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.article-content :global(pre) :global(code) {
		background: none;
		padding: 0;
		color: inherit;
	}
	.article-content :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 0.75rem;
		margin: 1.5rem 0;
	}
	.article-content :global(hr) {
		margin: 2.5rem 0;
		border: none;
		border-top: 1px solid rgba(15, 30, 61, 0.1);
	}
	.article-content :global(table) {
		width: 100%;
		margin: 1.5rem 0;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	.article-content :global(th),
	.article-content :global(td) {
		padding: 0.625rem 0.75rem;
		border: 1px solid rgba(15, 30, 61, 0.15);
		text-align: left;
	}
	.article-content :global(th) {
		background: var(--color-light-bg);
		font-weight: 600;
		color: var(--color-navy);
	}

	/* ── Tags ────────────────────────────────────────────────────────── */
	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 2rem 0 0;
		padding-top: 2rem;
		border-top: 1px solid rgba(15, 30, 61, 0.1);
	}
	.article-tag {
		font-size: 0.8125rem;
		color: var(--color-gray-text);
		background: var(--color-light-bg);
		padding: 0.25rem 0.625rem;
		border-radius: var(--radius-pill);
	}

	/* ── Retour au blog ──────────────────────────────────────────────── */
	.article-back {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(15, 30, 61, 0.1);
	}
	.article-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--color-navy);
		text-decoration: none;
		transition: color 200ms var(--ease-out);
	}
	.article-back-link:hover {
		color: var(--color-orange);
	}
</style>
