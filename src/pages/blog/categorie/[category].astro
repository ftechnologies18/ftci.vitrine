---
/**
 * /blog/categorie/[category] — Page catégorie PREMIUM.
 *
 * Redesign avec :
 *   - Hero catégorie avec icône et gradient
 *   - Compte d'articles animé
 *   - Grille articles premium
 *   - Description SEO
 */

import BlogLayout from '../../../layouts/BlogLayout.astro';
import BlogFilters from '../../../components/blog/BlogFilters.astro';
import ArticleCard from '../../../components/blog/ArticleCard.astro';
import { getArticlesByCategory, getCategoryLabel } from '../../../lib/blog';
import { BLOG_CATEGORIES } from '../../../../keystatic.config';

export async function getStaticPaths() {
	return BLOG_CATEGORIES.map((cat) => ({
		params: { category: cat.value },
		props: { categorySlug: cat.value },
	}));
}

const { categorySlug } = Astro.props;
const categoryLabel = getCategoryLabel(categorySlug);
const articles = await getArticlesByCategory(categorySlug);

// Icônes par catégorie
const categoryIcons: Record<string, string> = {
	'transformation-digitale':
		'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>',
	'intelligence-artificielle':
		'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
	'cloud-computing':
		'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>',
	cybersecurite:
		'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
	'tech-innovation':
		'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
	'actualites-ftci':
		'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 0a2 2 0 012 2v8a2 2 0 01-2 2m-4-12V4m0 0l-4 4m4-4l4 4"/>',
};

// Couleurs par catégorie
const categoryColors: Record<string, string> = {
	'transformation-digitale': '#ee6c1a',
	'intelligence-artificielle': '#6b7fc7',
	'cloud-computing': '#0f1e3d',
	cybersecurite: '#22c55e',
	'tech-innovation': '#e85d04',
	'actualites-ftci': '#4a5568',
};

// Descriptions SEO
const categoryDescriptions: Record<string, string> = {
	'transformation-digitale':
		'Digitalisation des entreprises, dématérialisation, outils numériques et stratégie digitale en Afrique.',
	'intelligence-artificielle':
		"IA générative, automatisation, agents IA, cas d'usage et bonnes pratiques pour les entreprises africaines.",
	'cloud-computing':
		"Cloud, SaaS, PaaS, hébergement, architecture cloud et meilleures pratiques d'infrastructure.",
	cybersecurite:
		'Sécurité informatique, protection des données, bonnes pratiques et conformité pour les organisations.',
	'tech-innovation':
		'Nouvelles technologies, tendances, innovations et analyses du secteur tech en Afrique et ailleurs.',
	'actualites-ftci':
		'Nouveautés, mises à jour et annonces concernant les produits et services FTCI (SECT, OPUC, CATS, ScolaGest).',
};

const description =
	categoryDescriptions[categorySlug] ?? `Articles dans la catégorie ${categoryLabel}.`;

const iconPath = categoryIcons[categorySlug] ?? '';
const catColor = categoryColors[categorySlug] ?? '#0f1e3d';
---

<BlogLayout
	title={`${categoryLabel} — Blog FTCI`}
	description={description}
	canonical={`/blog/categorie/${categorySlug}`}
>
	<!-- Hero Catégorie Premium -->
	<section class="cat-hero-premium">
		<div class="cat-hero-bg" aria-hidden="true">
			<div class="cat-mesh"></div>
			<div class="cat-grid-pattern"></div>
		</div>

		<div class="container">
			<div class="cat-hero-content">
				<!-- Breadcrumb -->
				<nav aria-label="Fil d'Ariane" class="cat-breadcrumb-premium">
					<a href="/blog">Blog</a>
					<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
						><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
						></path></svg
					>
					<span aria-current="page">{categoryLabel}</span>
				</nav>

				<!-- Icon + Titre -->
				<div class="cat-title-row">
					<div class="cat-icon-wrap" style={`--cat-color: ${catColor};`}>
						<svg
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
							set:html={iconPath}
						/>
					</div>
					<h1>{categoryLabel}</h1>
				</div>

				<p class="cat-desc">{description}</p>

				<div class="cat-stats">
					<span class="cat-stat-item">
						<strong>{articles.length}</strong> article{articles.length > 1 ? 's' : ''}
					</span>
				</div>
			</div>
		</div>
	</section>

	<div class="cat-body-premium">
		<div class="container">
			<BlogFilters activeCategory={categorySlug} />

			{
				articles.length > 0 ? (
					<section
						aria-label={`Articles dans la catégorie ${categoryLabel}`}
						class="cat-articles-section"
					>
						<div class="cat-grid">
							{articles.map((entry, i) => (
								<ArticleCard entry={entry} priority={i < 6} index={i} />
							))}
						</div>
					</section>
				) : (
					<div class="cat-empty-premium">
						<div class="empty-icon" aria-hidden="true">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 0a2 2 0 012 2v8a2 2 0 01-2 2m-4-12V4m0 0l-4 4m4-4l4 4"
								/>
							</svg>
						</div>
						<p class="empty-title">Bientôt du contenu ici</p>
						<p class="empty-desc">Nous préparons des articles sur ce sujet.</p>
						<a href="/blog" class="empty-link">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M10 19l-7-7m0 0l7-7m-7 7h18"
								/>
							</svg>
							Explorer tous les articles
						</a>
					</div>
				)
			}
		</div>
	</div>
</BlogLayout>

<style>
	/* Hero */
	.cat-hero-premium {
		position: relative;
		padding: 3rem 0;
		overflow: hidden;
		border-bottom: 1px solid rgba(15, 30, 61, 0.06);
	}
	.cat-hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}
	.cat-mesh {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(
				ellipse 60% 50% at 80% 30%,
				rgba(var(--cat-rgb, 238, 108, 26), 0.08) 0%,
				transparent 50%
			),
			linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
	}
	.cat-grid-pattern {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(15, 30, 61, 0.02) 1px, transparent 1px),
			linear-gradient(90deg, rgba(15, 30, 61, 0.02) 1px, transparent 1px);
		background-size: 40px 40px;
		mask-image: radial-gradient(ellipse 70% 60% at 80% 30%, black 10%, transparent 70%);
	}

	.cat-hero-content {
		position: relative;
		z-index: 1;
		max-width: 720px;
		padding: 0 1.5rem;
	}

	/* Breadcrumb */
	.cat-breadcrumb-premium {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		color: var(--color-gray-text);
		margin-bottom: 1.25rem;
	}
	.cat-breadcrumb-premium a {
		color: var(--color-gray-text);
		text-decoration: none;
		transition: color 200ms ease;
	}
	.cat-breadcrumb-premium a:hover {
		color: var(--color-orange);
	}
	.cat-breadcrumb-premium span[aria-current] {
		color: var(--color-navy);
		font-weight: 600;
	}
	.cat-breadcrumb-premium svg {
		width: 14px;
		height: 14px;
		opacity: 0.4;
	}

	/* Title row */
	.cat-title-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.cat-icon-wrap {
		width: 52px;
		height: 52px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(
			135deg,
			var(--cat-color) 0%,
			color-mix(in srgb, var(--cat-color) 70%, white) 100%
		);
		border-radius: 14px;
		color: #fff;
		flex-shrink: 0;
		box-shadow: 0 4px 16px color-mix(in srgb, var(--cat-color) 30%, transparent);
	}
	.cat-icon-wrap svg {
		width: 26px;
		height: 26px;
	}

	.cat-title-row h1 {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--color-navy);
		margin: 0;
	}

	/* Desc & stats */
	.cat-desc {
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--color-gray-text);
		margin: 0 0 1.25rem;
		max-width: 600px;
	}

	.cat-stats {
		display: flex;
		gap: 1rem;
	}
	.cat-stat-item {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		padding: 0.375rem 0.875rem;
		background: rgba(15, 30, 61, 0.04);
		border-radius: var(--radius-pill);
		color: var(--color-gray-text);
	}
	.cat-stat-item strong {
		color: var(--color-navy);
		font-weight: 700;
	}

	/* Body */
	.cat-body-premium {
		background: linear-gradient(180deg, #f8f9fb 0%, #ffffff 50%);
		padding: 2.5rem 0 5rem;
	}

	.cat-articles-section {
		padding: 0 1.5rem;
	}

	.cat-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1.5rem;
	}
	@media (max-width: 640px) {
		.cat-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Empty state */
	.cat-empty-premium {
		text-align: center;
		padding: 5rem 1.5rem;
	}
	.empty-icon {
		width: 64px;
		height: 64px;
		margin: 0 auto 1.25rem;
		color: var(--color-navy);
		opacity: 0.15;
	}
	.empty-icon svg {
		width: 100%;
		height: 100%;
	}
	.empty-title {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 700;
		color: var(--color-navy);
		margin: 0 0 0.5rem;
	}
	.empty-desc {
		font-size: 1rem;
		color: var(--color-gray-text);
		margin: 0 0 1.5rem;
	}
	.empty-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 500;
		color: var(--color-orange);
		text-decoration: none;
		padding: 0.625rem 1.25rem;
		border: 1px solid rgba(238, 108, 26, 0.25);
		border-radius: var(--radius-pill);
		transition: all 250ms ease;
	}
	.empty-link:hover {
		background: var(--color-orange);
		color: #fff;
		border-color: transparent;
	}
	.empty-link svg {
		width: 16px;
		height: 16px;
	}

	@media (max-width: 768px) {
		.cat-hero-premium {
			padding: 2rem 0 1.5rem;
		}
		.cat-body-premium {
			padding: 1.5rem 0 4rem;
		}
	}
</style>
