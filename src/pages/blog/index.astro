---
/**
 * /blog — Page d'index du blog FTCI — PREMIUM REDESIGN.
 *
 * Nouvelle ligne éditoriale "Tech Editorial Premium" :
 *   1. Hero cinématique avec mesh gradient animé + compteurs
 *   2. Article à la une format magazine (FeaturedArticle Premium)
 *   3. Barre de filtres pills animées (BlogFilters Premium)
 *   4. Grille articles avec cards glassmorphism
 *   5. Section catégories thématiques avec icônes
 *
 * Design tokens : variables CSS --blog-* pour cohérence.
 */

import BlogLayout from '../../layouts/BlogLayout';
import FeaturedArticle from '../../components/blog/FeaturedArticle.astro';
import BlogFilters from '../../components/blog/BlogFilters.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import { getAllArticles, getFeaturedArticles, getCategoriesWithCounts } from '../../lib/blog';

const allArticles = await getAllArticles();
const featuredArticles = await getFeaturedArticles();
const categories = await getCategoriesWithCounts();

// Article à la une : le premier featured, sinon le plus récent.
const hero = featuredArticles[0] ?? allArticles[0];

// Articles restants (excluant le hero) pour la grille.
const restArticles = hero ? allArticles.filter((a) => a.id !== hero.id) : [];

// Stats pour le hero
const totalArticles = allArticles.length;
const totalCategories = categories.length;
---

<BlogLayout
        title="Blog FTCI — Expertise Tech Africaine"
        canonical="/blog"
>
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- HERO CINÉMATIQUE PREMIUM                                               -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <section class="blog-hero-premium">
                <!-- Animated background elements -->
                <div class="hero-bg" aria-hidden="true">
                        <div class="hero-mesh"></div>
                        <div class="hero-grid-pattern"></div>
                        <div class="hero-float hero-float-1"></div>
                        <div class="hero-float hero-float-2"></div>
                        <div class="hero-float hero-float-3"></div>
                </div>

                <div class="container">
                        <div class="hero-content">
                                <!-- Eyebrow animé -->
                                <div class="hero-eyebrow">
                                        <span class="hero-eyebrow-dot"></span>
                                        <span>ESPACE EDITORIAL</span>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                        </svg>
                                </div>

                                <!-- Titre principal avec effet reveal -->
                                <h1 class="hero-title">
                                        <span class="hero-title-line hero-title-line-1">Expertises &</span>
                                        <span class="hero-title-line hero-title-line-2">Innovations <span class="hero-title-accent">Tech</span></span>
                                </h1>

                                <!-- Description -->
                                <p class="hero-description">
                                        Décryptons ensemble les enjeux du numérique en Afrique. Analyses pointues, 
                                        cas d'usage concrets et visions d'avenir pour les décideurs tech.
                                </p>

                                <!-- Stats animées -->
                                <div class="hero-stats">
                                        <div class="hero-stat">
                                                <span class="hero-stat-number">{totalArticles}</span>
                                                <span class="hero-stat-label">Articles</span>
                                        </div>
                                        <div class="hero-stat-divider" aria-hidden="true"></div>
                                        <div class="hero-stat">
                                                <span class="hero-stat-number">{totalCategories}</span>
                                                <span class="hero-stat-label">Thématiques</span>
                                        </div>
                                        <div class="hero-stat-divider" aria-hidden="true"></div>
                                        <div class="hero-stat">
                                                <span class="hero-stat-number">∞</span>
                                                <span class="hero-stat-label">Idées</span>
                                        </div>
                                </div>

                                <!-- Indicateur scroll -->
                                <div class="hero-scroll-indicator" aria-hidden="true">
                                        <div class="scroll-line"></div>
                                </div>
                        </div>
                </div>
        </section>

        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- CONTENU PRINCIPAL                                                     -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <div class="blog-body-premium">
                <div class="container">

                        <!-- ── ARTICLE À LA UNE (Magazine Format) ──────────────────────── -->
                        {
                                hero && (
                                        <section class="featured-section" aria-label="À la une">
                                                <div class="featured-header">
                                                        <span class="featured-badge-text">
                                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                        <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
                                                                </svg>
                                                                ARTICLE À LA UNE
                                                        </span>
                                                </div>
                                                <FeaturedArticle entry={hero} />
                                        </section>
                                )
                        }

                        <!-- ── FILTRES PAR CATÉGORIE ──────────────────────────────────── -->
                        <BlogFilters />

                        <!-- ── GRILLE D'ARTICLES ──────────────────────────────────────── -->
                        {
                                restArticles.length > 0 ? (
                                        <section class="articles-grid-section" aria-label="Tous les articles">
                                                <div class="articles-header">
                                                        <h2 class="articles-title">Dernières publications</h2>
                                                        <span class="articles-count">{restArticles.length} article{restArticles.length > 1 ? 's' : ''}</span>
                                                </div>
                                                <div class="articles-grid">
                                                        {restArticles.map((entry, i) => (
                                                                <ArticleCard entry={entry} priority={i < 6} index={i} />
                                                        ))}
                                                </div>
                                        </section>
                                ) : (
                                        <div class="blog-empty-premium">
                                                <div class="empty-icon" aria-hidden="true">
                                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                                                        </svg>
                                                </div>
                                                <p class="empty-title">Rendez-vous très bientôt</p>
                                                <p class="empty-desc">Nos équipes préparent des contenus exclusifs pour vous.</p>
                                        </div>
                                )
                        }

                        <!-- ── SECTION CATÉGORIES THÉMATIQUES ──────────────────────────── -->
                        {
                                categories.length > 0 && (
                                        <section class="categories-showcase" aria-label="Explorer par thématique">
                                                <div class="categories-header">
                                                        <h2 class="categories-title">Explorer par thématique</h2>
                                                        <p class="categories-subtitle">Plongez dans nos domaines d'expertise</p>
                                                </div>
                                                <div class="categories-grid">
                                                        {categories.map((cat) => (
                                                                <a href={`/blog/categorie/${cat.slug}`} class="category-card" data-category={cat.slug}>
                                                                        <div class="category-card-bg" aria-hidden="true"></div>
                                                                        <div class="category-card-icon">
                                                                                {cat.slug === 'transformation-digitale' && (
                                                                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                                                                )}
                                                                                {cat.slug === 'intelligence-artificielle' && (
                                                                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                                                                )}
                                                                                {cat.slug === 'cloud-computing' && (
                                                                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                                                                                )}
                                                                                {cat.slug === 'cybersecurite' && (
                                                                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                                                                )}
                                                                                {cat.slug === 'tech-innovation' && (
                                                                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                                                                )}
                                                                                {cat.slug === 'actualites-ftci' && (
                                                                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 0a2 2 0 012 2v8a2 2 0 01-2 2m-4-12V4m0 0l-4 4m4-4l4 4"/></svg>
                                                                                )}
                                                                        </div>
                                                                        <div class="category-card-content">
                                                                                <span class="category-card-name">{cat.label}</span>
                                                                                <span class="category-card-meta">
                                                                                        {cat.count} article{cat.count > 1 ? 's' : ''}
                                                                                </span>
                                                                        </div>
                                                                        <div class="category-card-arrow" aria-hidden="true">
                                                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                                                                        </div>
                                                                </a>
                                                        ))}
                                                </div>
                                        </section>
                                )
                        }

                        <!-- ── NEWSLETTER CTA WAOUH ══════════════════════════════════ -->
                        <section class="newsletter-waouh" data-newsletter-card>
                                <div class="nl-bg-effects" aria-hidden="true">
                                        <div class="nl-mesh"></div>
                                        <div class="nl-grid"></div>
                                        <div class="nl-orb nl-orb-1"></div>
                                        <div class="nl-orb nl-orb-2"></div>
                                        <div class="nl-shine"></div>
                                </div>

                                <div class="nl-content">
                                        <!-- Badge -->
                                        <div class="nl-badge">
                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                                <span>NEWSLETTER</span>
                                        </div>

                                        <!-- Texte principal -->
                                        <div class="nl-text-group">
                                                <h3 class="nl-title">Restez <span class="nl-title-accent">informé</span></h3>
                                                <p class="nl-desc">Recevez nos analyses exclusives, tutoriels tech et actualités directement dans votre boîte mail.</p>
                                        </div>

                                        <!-- CTA avec input stylé -->
                                        <div class="nl-action">
                                                <a href="mailto:contact@ftci.fr?subject=Inscription Newsletter FTCI" class="nl-btn">
                                                        <span class="nl-btn-text">S'abonner</span>
                                                        <span class="nl-btn-icon">
                                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-6H6"/></svg>
                                                        </span>
                                                        <div class="nl-btn-glow" aria-hidden="true"></div>
                                                </a>
                                                <span class="nl-note">Gratuit • Pas de spam</span>
                                        </div>
                                </div>

                                <!-- Décorations -->
                                <div class="nl-deco nl-deco-1" aria-hidden="true">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                                </div>
                                <div class="nl-deco nl-deco-2" aria-hidden="true">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                </div>

                                <!-- Coins décoratifs -->
                                <div class="nl-corner nl-corner-tl" aria-hidden="true"></div>
                                <div class="nl-corner nl-corner-br" aria-hidden="true"></div>
                        </section>

                </div>
        </div>
</BlogLayout>

<style>
        /* ═══════════════════════════════════════════════════════════════════════════
           HERO CINÉMATIQUE PREMIUM
           ═══════════════════════════════════════════════════════════════════════════ */
        .blog-hero-premium {
                position: relative;
                min-height: 520px;
                display: flex;
                align-items: center;
                overflow: hidden;
                padding: 5rem 0 4rem;
        }

        .hero-bg {
                position: absolute;
                inset: 0;
                z-index: 0;
        }

        /* Mesh gradient animé */
        .hero-mesh {
                position: absolute;
                inset: 0;
                background: 
                        radial-gradient(ellipse 80% 60% at 20% 30%, rgba(238, 108, 26, 0.15) 0%, transparent 50%),
                        radial-gradient(ellipse 60% 80% at 80% 70%, rgba(107, 127, 199, 0.12) 0%, transparent 50%),
                        radial-gradient(ellipse 100% 100% at 50% 100%, rgba(15, 30, 61, 0.03) 0%, transparent 70%),
                        linear-gradient(180deg, #ffffff 0%, #fafbfc 50%, #f5f7fa 100%);
                animation: meshFloat 20s ease-in-out infinite alternate;
        }

        @keyframes meshFloat {
                0% { transform: scale(1) rotate(0deg); }
                100% { transform: scale(1.05) rotate(0.5deg); }
        }

        /* Grid pattern subtil */
        .hero-grid-pattern {
                position: absolute;
                inset: 0;
                background-image: 
                        linear-gradient(rgba(15, 30, 61, 0.03) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(15, 30, 61, 0.03) 1px, transparent 1px);
                background-size: 60px 60px;
                mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 20%, transparent 70%);
        }

        /* Formes flottantes */
        .hero-float {
                position: absolute;
                border-radius: 50%;
                filter: blur(60px);
                opacity: 0.5;
                animation: float 15s ease-in-out infinite;
        }
        .hero-float-1 {
                width: 300px;
                height: 300px;
                background: rgba(238, 108, 26, 0.1);
                top: 10%;
                right: 10%;
                animation-delay: 0s;
        }
        .hero-float-2 {
                width: 200px;
                height: 200px;
                background: rgba(107, 127, 199, 0.12);
                bottom: 20%;
                left: 5%;
                animation-delay: -5s;
        }
        .hero-float-3 {
                width: 150px;
                height: 150px;
                background: rgba(15, 30, 61, 0.08);
                top: 50%;
                right: 30%;
                animation-delay: -10s;
        }

        @keyframes float {
                0%, 100% { transform: translate(0, 0) scale(1); }
                25% { transform: translate(20px, -20px) scale(1.05); }
                50% { transform: translate(-10px, 15px) scale(0.95); }
                75% { transform: translate(-20px, -10px) scale(1.02); }
        }

        /* Content */
        .hero-content {
                position: relative;
                z-index: 1;
                max-width: 720px;
                padding: 0 1.5rem;
        }

        /* Eyebrow */
        .hero-eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 0.625rem;
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                color: var(--color-orange);
                margin-bottom: 1.5rem;
                padding: 0.5rem 1rem;
                background: rgba(238, 108, 26, 0.08);
                border-radius: var(--radius-pill);
                border: 1px solid rgba(238, 108, 26, 0.15);
        }
        .hero-eyebrow-dot {
                width: 6px;
                height: 6px;
                background: var(--color-orange);
                border-radius: 50%;
                animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse {
                0%, 100% { opacity: 1; transform: scale(1); }
                50% { opacity: 0.5; transform: scale(1.2); }
        }

        /* Titre */
        .hero-title {
                font-family: var(--font-display);
                margin: 0 0 1.5rem;
                line-height: 1.05;
        }
        .hero-title-line {
                display: block;
                font-weight: 800;
                letter-spacing: -0.03em;
                color: var(--color-navy);
        }
        .hero-title-line-1 {
                font-size: clamp(2.25rem, 5vw, 3.5rem);
        }
        .hero-title-line-2 {
                font-size: clamp(2.5rem, 6vw, 4.5rem);
        }
        .hero-title-accent {
                background: linear-gradient(135deg, var(--color-orange) 0%, #d4520e 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
        }

        /* Description */
        .hero-description {
                font-size: 1.125rem;
                line-height: 1.65;
                color: var(--color-gray-text);
                max-width: 560px;
                margin: 0 0 2.5rem;
        }

        /* Stats */
        .hero-stats {
                display: flex;
                align-items: center;
                gap: 1.5rem;
                flex-wrap: wrap;
        }
        .hero-stat {
                display: flex;
                flex-direction: column;
                gap: 0.125rem;
        }
        .hero-stat-number {
                font-family: var(--font-display);
                font-size: 1.75rem;
                font-weight: 800;
                color: var(--color-navy);
                line-height: 1;
        }
        .hero-stat-label {
                font-size: 0.75rem;
                font-weight: 500;
                color: var(--color-gray-text);
                text-transform: uppercase;
                letter-spacing: 0.05em;
        }
        .hero-stat-divider {
                width: 1px;
                height: 36px;
                background: linear-gradient(180deg, transparent, rgba(15, 30, 61, 0.15), transparent);
        }

        /* Scroll indicator */
        .hero-scroll-indicator {
                margin-top: 3rem;
        }
        .scroll-line {
                width: 24px;
                height: 40px;
                border: 2px solid rgba(15, 30, 61, 0.15);
                border-radius: 12px;
                position: relative;
        }
        .scroll-line::after {
                content: '';
                position: absolute;
                top: 6px;
                left: 50%;
                transform: translateX(-50%);
                width: 4px;
                height: 8px;
                background: var(--color-orange);
                border-radius: 2px;
                animation: scrollBounce 2s ease-in-out infinite;
        }
        @keyframes scrollBounce {
                0%, 100% { top: 6px; opacity: 1; }
                50% { top: 18px; opacity: 0.4; }
        }

        @media (max-width: 768px) {
                .blog-hero-premium {
                        min-height: auto;
                        padding: 3rem 0 2.5rem;
                }
                .hero-float { display: none; }
                .hero-stat-divider { display: none; }
                .hero-stats { gap: 1.5rem; }
                .hero-scroll-indicator { display: none; }
        }

        /* ═══════════════════════════════════════════════════════════════════════════
           BODY PRÉMIUM
           ═══════════════════════════════════════════════════════════════════════════ */
        .blog-body-premium {
                background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
                padding: 0 0 5rem;
        }

        /* Featured section */
        .featured-section {
                padding: 3rem 1.5rem 0;
        }
        .featured-header {
                margin-bottom: 1.25rem;
        }
        .featured-badge-text {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.6875rem;
                font-weight: 700;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: var(--color-orange);
                padding: 0.375rem 0.875rem;
                background: linear-gradient(135deg, rgba(238, 108, 26, 0.1) 0%, rgba(238, 108, 26, 0.05) 100%);
                border: 1px solid rgba(238, 108, 26, 0.2);
                border-radius: var(--radius-pill);
        }

        /* Articles grid section */
        .articles-grid-section {
                padding: 2.5rem 1.5rem;
        }
        .articles-header {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                margin-bottom: 1.5rem;
                gap: 1rem;
        }
        .articles-title {
                font-family: var(--font-display);
                font-weight: 800;
                font-size: 1.5rem;
                letter-spacing: -0.02em;
                color: var(--color-navy);
                margin: 0;
        }
        .articles-count {
                font-size: 0.875rem;
                color: var(--color-gray-text);
                flex-shrink: 0;
        }
        .articles-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
                gap: 1.5rem;
        }
        @media (max-width: 640px) {
                .articles-grid {
                        grid-template-columns: 1fr;
                }
        }

        /* Empty state */
        .blog-empty-premium {
                text-align: center;
                padding: 5rem 1.5rem;
        }
        .empty-icon {
                width: 64px;
                height: 64px;
                margin: 0 auto 1.25rem;
                color: var(--color-navy);
                opacity: 0.2;
        }
        .empty-title {
                font-family: var(--font-display);
                font-size: 1.375rem;
                font-weight: 700;
                color: var(--color-navy);
                margin: 0 0 0.5rem;
        }
        .empty-desc {
                font-size: 1rem;
                color: var(--color-gray-text);
                margin: 0;
        }

        /* Categories showcase */
        .categories-showcase {
                padding: 3rem 1.5rem;
        }
        .categories-header {
                margin-bottom: 1.75rem;
        }
        .categories-title {
                font-family: var(--font-display);
                font-weight: 800;
                font-size: 1.5rem;
                letter-spacing: -0.02em;
                color: var(--color-navy);
                margin: 0 0 0.375rem;
        }
        .categories-subtitle {
