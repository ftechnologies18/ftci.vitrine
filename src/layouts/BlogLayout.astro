---
/**
 * BlogLayout.astro — Layout blog PREMIUM.
 *
 * Hérite de Layout.astro (racine) avec :
 *   - Header navigation
 *   - Main avec background subtil
 *   - Footer global
 */

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	noindex?: boolean;
}

const {
	title,
	description = "Le blog FTCI — analyses, expertises et actualités tech pour décideurs africains.",
	canonical,
	noindex = false,
} = Astro.props;
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	noindex={noindex}
	keywords={[
		'blog',
		'FTCI',
		'transformation digitale',
		'IA',
		'cloud',
		'cybersécurité',
		'innovation',
		'Afrique',
		'Côte d\'Ivoire',
	]}
>
	<slot name="head" />
	<Header />
	<main class="blog-main-premium">
		<slot />
	</main>
	<Footer />
</Layout>

<style>
	.blog-main-premium {
		flex: 1;
		background: #ffffff;
		min-height: 60vh;
	}
</style>
