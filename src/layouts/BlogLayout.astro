---
/**
 * BlogLayout.astro — Layout commun à toutes les pages du blog.
 *
 * Hérite de Layout.astro (racine) mais :
 * - Ajoute un Header avec navigation blog (Accueil, Articles, Catégories)
 * - Fournit un slot `main` pour le contenu de chaque page
 * - Fournit un slot optionnel `head` pour les meta tags SEO spécifiques
 *   (utilisé par [slug].astro pour injecter ArticleSEO.astro)
 * - Inclut le Footer global
 *
 * Utilisé par : /blog/index.astro, /blog/[slug].astro, /blog/categorie/[category].astro
 */

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	noindex?: boolean;
}

const {
	title,
	description = "Le blog FTCI — analyses, bonnes pratiques et actualités sur la transformation digitale, l'IA, le cloud, la cybersécurité et l'innovation technologique en Afrique.",
	canonical,
	noindex = false,
} = Astro.props;
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	noindex={noindex}
	keywords={[
		'blog',
		'FTCI',
		'transformation digitale',
		'IA',
		'cloud',
		'cybersécurité',
		'innovation',
		'Afrique',
	]}
>
	<slot name="head" />
	<Header />
	<main class="flex-1 blog-main">
		<slot />
	</main>
	<Footer />
</Layout>

<style>
	.blog-main {
		background: var(--color-light-bg);
	}
</style>
