---
/**
 * Layout.astro — Layout racine du site FTCI.
 * ────────────────────────────────────────────────────────────────────────────
 * - Import global.css + SEO.astro
 * - Props : title, description, canonical, ogImage, noindex, keywords
 * - Schema.org Organization + WebSite JSON-LD (toujours présents)
 * - Head : meta, fonts self-hébergées (Poppins 700/800 + Inter 400-600, preload LCP), favicon
 * - Body : min-h-screen flex flex-col (sticky footer via mt-auto sur Footer)
 * - Script global : scroll reveal, magnetic, parallax, curseur trail
 *   (tous reduced-motion aware, passive listeners, rAF throttled)
 */

import SEO from '../components/SEO.astro';
import '../styles/global.css';

export interface Props {
	title: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	noindex?: boolean;
	keywords?: string[];
	/** JSON-LD schemas additionnels à injecter sur la page (ex: SoftwareApplication, FAQPage). */
	schema?: Record<string, unknown>[];
}

const {
	title,
	description,
	canonical,
	ogImage,
	noindex = false,
	keywords = [],
	schema = [],
} = Astro.props;

const siteUrl = 'https://ftci.fr';

// Schema.org Organization — toujours présent (enrichi avec ContactPoint pour
// le Knowledge Panel Google : téléphone, email, zones desservies).
const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: "FTCI — Freelance Technologies Côte d'Ivoire",
	alternateName: 'FTCI',
	url: siteUrl,
	logo: `${siteUrl}/brand/logo-ftci.png`,
	description:
		'Entreprise de Services du Numérique (ESN) basée à Abidjan. FTCI accompagne les organisations dans leur transformation digitale à travers 4 pôles de services (conseil, développement, infrastructure, formation) et édite 4 solutions SaaS (SECT, OPUC, CATS, ScolaGest) pensées pour le marché africain.',
	foundingDate: '2023',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Abidjan',
		addressRegion: 'Lagunes',
		addressCountry: 'CI',
	},
	areaServed: ["Côte d'Ivoire", "Afrique de l'Ouest", 'Afrique'],
	knowsAbout: [
		'Entreprise de Services du Numérique',
		'Transformation digitale',
		'Développement web sur mesure',
		'Infrastructure IT & Cloud',
		'Assistance technique & Formation IT',
		'Intelligence Artificielle',
		'Solutions SaaS',
		'Évaluation académique',
		'Gestion BTP',
		'Gestion scolaire',
	],
	contactPoint: [
		{
			'@type': 'ContactPoint',
			contactType: 'customer support',
			telephone: '+2250566184040',
			email: 'contact@ftci.fr',
			url: `${siteUrl}/#contact`,
			areaServed: ["Côte d'Ivoire", "Afrique de l'Ouest", 'Afrique'],
			availableLanguage: ['French'],
		},
	],
};

// Schema.org WebSite — toujours présent
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'FTCI',
	url: siteUrl,
	inLanguage: 'fr-FR',
	publisher: { '@type': 'Organization', name: 'FTCI' },
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

		<!-- SEO (meta, OG, Twitter, JSON-LD Organization + WebSite) -->
		<SEO
			title={title}
			description={description}
			canonical={canonical}
			ogImage={ogImage}
			noindex={noindex}
			keywords={keywords}
			schema={[orgSchema, websiteSchema, ...schema]}
		/>

		<!-- Favicon (triskel pixelisé bleu/vert/orange sur fond navy) -->
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<!-- rel="shortcut icon" : syntaxe legacy utilisée par Yandex et les anciens bots.
                     Sans cette balise, Yandex Webmaster peut signaler "robot could not load the favicon"
                     même si /favicon.ico est accessible (HTTP 200). -->
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" sizes="180x180" />
		<link rel="mask-icon" href="/favicon.svg" color="#0F1E3D" />
		<!-- PWA / Android Chrome -->
		<link rel="icon" type="image/png" sizes="192x192" href="/brand/icon-192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/brand/icon-512.png" />
		<!-- Web App Manifest : utilisé par Google/Yandex pour la découverte des icônes
                     (favicon, icône d'app PWA). Référence les mêmes icônes que les <link> ci-dessus. -->
		<link rel="manifest" href="/site.webmanifest" />

		<!-- RSS blog auto-discovery -->
		<link rel="alternate" type="application/rss+xml" title="Blog FTCI — Flux RSS" href="/rss.xml" />

		<!-- Fonts self-hostés : Inter (corps, variable 400-600) + Poppins (display, 700/800).
                     Sous-ensemble latin uniquement (latin-ext retiré — voir global.css).
                     @font-face déclarés dans global.css — preload des 2 fonts critiques pour LCP. -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link
			rel="preload"
			href="/fonts/poppins-700-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<!-- Cloudflare Turnstile : lazy-loaded (voir script en fin de body).
                     Le script api.js n'est injecté QUE si la page contient un widget
                     .cf-turnstile ET que l'utilisateur interagit (pointerdown/focusin)
                     ou scrolle jusqu'au widget. Évite ~30 Ko de JS + 2 preconnect sur
                     les pages sans formulaire (articles de blog, pages légales). -->
	</head>

	<body class="min-h-screen flex flex-col bg-light-bg text-navy antialiased">
		<a
			href="#contenu"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-navy focus:text-white focus:rounded-lg"
		>
			Aller au contenu
		</a>
		<slot />

		<!-- ──────────────────────────────────────────────────────────────────
                     SCRIPT GLOBAL
                     - Scroll reveal (IntersectionObserver .observe → .is-visible)
                     - Magnetic buttons (pointermove + rAF lerp, desktop only)
                     - Parallax (data-parallax, rAF throttled)
                     - Curseur trail (desktop only, spring follow, grow on interactive)
                     Tous reduced-motion aware, passive listeners, rAF throttled.
                     ────────────────────────────────────────────────────────────────── -->
		<script>
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const isTouch = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;

			// ── 1. Scroll reveal ──────────────────────────────────────────────
			const revealElements = document.querySelectorAll('.observe');
			if (prefersReducedMotion || !('IntersectionObserver' in window)) {
				revealElements.forEach((el) => el.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
				);
				revealElements.forEach((el) => observer.observe(el));
			}

			// ── 2. Magnetic buttons (desktop, reduced-motion OK) ──────────────
			if (!isTouch) {
				const magnets = document.querySelectorAll<HTMLElement>('[data-magnetic]');
				magnets.forEach((el) => {
					const strength = parseFloat(el.dataset.magnetic || '') || 20;
					let targetX = 0;
					let targetY = 0;
					let currentX = 0;
					let currentY = 0;
					let rafId: number | null = null;

					const loop = () => {
						currentX += (targetX - currentX) * 0.18;
						currentY += (targetY - currentY) * 0.18;
						el.style.transform = `translate(${currentX.toFixed(2)}px, ${currentY.toFixed(2)}px)`;

						if (Math.abs(targetX - currentX) > 0.15 || Math.abs(targetY - currentY) > 0.15) {
							rafId = requestAnimationFrame(loop);
						} else {
							if (targetX === 0 && targetY === 0) {
								el.style.transform = '';
							}
							rafId = null;
						}
					};

					const schedule = () => {
						if (rafId === null) rafId = requestAnimationFrame(loop);
					};

					el.addEventListener(
						'pointermove',
						(e: PointerEvent) => {
							const r = el.getBoundingClientRect();
							const cx = r.left + r.width / 2;
							const cy = r.top + r.height / 2;
							targetX = ((e.clientX - cx) / r.width) * strength;
							targetY = ((e.clientY - cy) / r.height) * strength;
							schedule();
						},
						{ passive: true },
					);

					el.addEventListener('pointerleave', () => {
						targetX = 0;
						targetY = 0;
						schedule();
					});
				});
			}

			// ── 3. Parallax (rAF throttled) ───────────────────────────────────
			if (!prefersReducedMotion) {
				const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
				if (parallaxEls.length > 0) {
					let ticking = false;

					const update = () => {
						const scrollY = window.scrollY;
						parallaxEls.forEach((el) => {
							const speed = parseFloat(el.dataset.parallax || '') || 0.2;
							// Limite : ne pas parallaxer hors de ~2 viewports
							const offset = scrollY * speed;
							el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
						});
						ticking = false;
					};

					const onScroll = () => {
						if (!ticking) {
							ticking = true;
							requestAnimationFrame(update);
						}
					};

					window.addEventListener('scroll', onScroll, { passive: true });
					update();
				}
			}

			// ── 4. Curseur trail (désactivé) ────────────────
			// Le curseur circulaire a été supprimé à la demande de l'utilisateur

			// ── 5. Lazy-load Cloudflare Turnstile ──────────────────────────────
			// Le script api.js (et ses 2 preconnect) n'est injecté QUE si la page
			// contient un widget `.cf-turnstile` ET que l'utilisateur interagit
			// (pointerdown/focusin) ou scrolle jusqu'au widget (IntersectionObserver).
			// Économise ~30 Ko de JS + 2 round-trips DNS/TLS sur les pages sans
			// formulaire (articles de blog, pages légales, home avant scroll).
			//
			// Une fois api.js chargé, il scanne automatiquement le DOM et rend les
			// widgets `.cf-turnstile` existants. Marche aussi pour les modals
			// (NewsletterModal) car le pointerdown sur le bouton d'ouverture déclenche
			// le chargement avant que le widget ne soit visible.
			(function () {
				const widgets = document.querySelectorAll('.cf-turnstile');
				if (widgets.length === 0) return;

				let loaded = false;
				function loadTurnstile() {
					if (loaded) return;
					loaded = true;

					const head = document.head;
					const pre = document.createElement('link');
					pre.rel = 'preconnect';
					pre.href = 'https://challenges.cloudflare.com';
					pre.crossOrigin = '';
					head.appendChild(pre);

					const dns = document.createElement('link');
					dns.rel = 'dns-prefetch';
					dns.href = 'https://challenges.cloudflare.com';
					head.appendChild(dns);

					const s = document.createElement('script');
					s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
					s.async = true;
					s.defer = true;
					head.appendChild(s);
				}

				// Stratégie 1 : IntersectionObserver pour les widgets visibles au scroll
				// (Contact section sur la home). rootMargin '500px' précharge avant
				// visibilité réelle pour éviter tout délai à l'affichage.
				if ('IntersectionObserver' in window) {
					const io = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									loadTurnstile();
									io.disconnect();
									break;
								}
							}
						},
						{ rootMargin: '500px 0px' },
					);
					widgets.forEach((w) => io.observe(w));
				}

				// Stratégie 2 : pointerdown/focusin au niveau document (capture phase)
				// Couvre les widgets dans des modals fermés au chargement
				// (NewsletterModal, NewsletterForm) : le premier clic ou focus sur la
				// page déclenche le chargement, garantissant qu'api.js est prêt avant
				// que l'utilisateur ne soumette un formulaire.
				document.addEventListener('pointerdown', loadTurnstile, {
					capture: true,
					once: true,
				});
				document.addEventListener('focusin', loadTurnstile, {
					capture: true,
					once: true,
				});
			})();
		</script>
	</body>
</html>
