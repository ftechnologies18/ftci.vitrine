---
/**
 * Layout réutilisable pour les pages produits.
 *
 * Usage :
 *   ---
 *   import ProductLayout from '../../components/ProductLayout.astro';
 *   import { getProduct } from '../../data/products';
 *   const product = getProduct('sect')!;
 *   ---
 *   <ProductLayout product={product} />
 *
 * Inclut : hero, fonctionnalités, cas d'usage, bénéfices, CTA,
 * navigation entre produits, et données structurées schema.org/Product + BreadcrumbList.
 */

import type { Product } from '../data/products';
import { products, productUrls, accentColorClasses } from '../data/products';
import SEO from './SEO.astro';
import Layout from '../layouts/Layout.astro';

export interface Props {
        product: Product;
}

const { product } = Astro.props;
const accent = accentColorClasses[product.accentColor];
const siteUrl = 'https://ftci.fr';
const canonicalPath = productUrls[product.slug];

// Données structurées schema.org Product
const productSchema = {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: product.name,
        description: product.description,
        applicationCategory: product.category,
        operatingSystem: 'Web',
        url: `${siteUrl}${canonicalPath}`,
        offers: {
                '@type': 'Offer',
                price: '0',
                priceCurrency: 'XOF',
                availability: 'https://schema.org/InStock',
                description: 'Tarification sur devis selon les besoins. Contactez FTCI pour une démonstration personnalisée.',
        },
        publisher: {
                '@type': 'Organization',
                name: "FTCI — Freelance Technologies Côte d'Ivoire",
                url: siteUrl,
        },
        featureList: product.features.map((f) => f.title),
        audience: {
                '@type': 'Audience',
                audienceType: product.targetAudience,
        },
};

// Fil d'Ariane schema.org BreadcrumbList
const breadcrumbSchema = {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
                {
                        '@type': 'ListItem',
                        position: 1,
                        name: 'Accueil',
                        item: siteUrl,
                },
                {
                        '@type': 'ListItem',
                        position: 2,
                        name: 'Solutions',
                        item: `${siteUrl}/#solutions`,
                },
                {
                        '@type': 'ListItem',
                        position: 3,
                        name: product.name,
                        item: `${siteUrl}${canonicalPath}`,
                },
        ],
};

// Autres produits pour la navigation
const otherProducts = products.filter((p) => p.slug !== product.slug);
---

<Layout
        title={`${product.name} — ${product.tagline} | FTCI`}
        description={product.description}
        canonical={canonicalPath}
        keywords={product.keywords}
>
        <!-- Inject product-specific schema.org (in addition to Organization/WebSite from Layout) -->
        <SEO
                title={`${product.name} — ${product.tagline} | FTCI`}
                description={product.description}
                canonical={canonicalPath}
                ogType="product"
                keywords={product.keywords}
                schema={[productSchema, breadcrumbSchema]}
        />

        <!-- Breadcrumb -->
        <nav class="bg-light-bg border-b border-gray-200" aria-label="Fil d'Ariane">
                <div class="container py-3">
                        <ol class="flex items-center gap-2 text-sm text-gray-text">
                                <li><a href="/" class="hover:text-orange transition-colors">Accueil</a></li>
                                <li aria-hidden="true">/</li>
                                <li><a href="/#solutions" class="hover:text-orange transition-colors">Solutions</a></li>
                                <li aria-hidden="true">/</li>
                                <li class="text-navy font-medium" aria-current="page">{product.name}</li>
                        </ol>
                </div>
        </nav>

        <!-- Hero Section -->
        <section class={`relative overflow-hidden bg-gradient-to-br ${accent.from} ${accent.to} text-white py-20 md:py-28`}>
                <div class="absolute inset-0 opacity-10" aria-hidden="true">
                        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
                                <defs>
                                        <pattern id={`mosaic-${product.slug}`} x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                                                <polygon points="10,0 20,10 10,20 0,10" fill="none" stroke="white" stroke-width="0.5"/>
                                        </pattern>
                                </defs>
                                <rect width="100" height="100" fill={`url(#mosaic-${product.slug})`}/>
                        </svg>
                </div>

                <div class="container relative z-10">
                        <div class="max-w-4xl">
                                <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full text-sm font-medium mb-6">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={product.iconPath}></path>
                                        </svg>
                                        {product.category}
                                </div>

                                <h1 class="text-5xl md:text-7xl font-bold mb-4">{product.name}</h1>
                                <p class="text-xl md:text-2xl text-white/90 mb-3 font-medium">{product.fullName}</p>
                                <p class="text-lg md:text-xl text-white/80 mb-8 max-w-2xl">{product.tagline}</p>

                                <div class="flex flex-col sm:flex-row gap-4">
                                        {product.externalUrl && (
                                                <a
                                                        href={product.externalUrl}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="px-8 py-4 bg-white text-navy rounded-lg font-semibold hover:bg-white/90 active:scale-95 transition-all duration-200 inline-flex items-center justify-center gap-2"
                                                >
                                                        Accéder à {product.name}
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                                                        </svg>
                                                </a>
                                        )}
                                        <a
                                                href="/#contact"
                                                class="px-8 py-4 border-2 border-white text-white rounded-lg font-semibold hover:bg-white/10 active:scale-95 transition-all duration-200 inline-flex items-center justify-center"
                                        >
                                                Demander une démo
                                        </a>
                                </div>
                        </div>
                </div>
        </section>

        <!-- Description Section -->
        <section class="py-20 md:py-28 bg-white">
                <div class="container">
                        <div class="max-w-3xl mx-auto">
                                <h2 class="text-3xl md:text-4xl font-bold text-navy mb-6">Présentation</h2>
                                <p class="text-lg text-gray-text leading-relaxed mb-8">{product.longDescription}</p>

                                <div class="bg-light-bg rounded-xl p-6 md:p-8">
                                        <h3 class="text-lg font-semibold text-navy mb-3">Public cible</h3>
                                        <p class="text-gray-text">{product.targetAudience}</p>
                                </div>
                        </div>
                </div>
        </section>

        <!-- Features Section -->
        <section class="py-20 md:py-28 bg-light-bg">
                <div class="container">
                        <div class="text-center mb-16">
                                <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Fonctionnalités clés</h2>
                                <p class="text-lg text-gray-text max-w-2xl mx-auto">
                                        Tout ce dont vous avez besoin, réuni dans une seule plateforme
                                </p>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                                {product.features.map((feature, idx) => (
                                        <div class="bg-white rounded-xl p-6 hover:shadow-lg transition-shadow duration-300">
                                                <div class={`w-12 h-12 ${accent.bg} rounded-lg flex items-center justify-center text-white mb-4`}>
                                                        <span class="text-xl font-bold">{String(idx + 1).padStart(2, '0')}</span>
                                                </div>
                                                <h3 class="text-lg font-bold text-navy mb-2">{feature.title}</h3>
                                                <p class="text-gray-text text-sm leading-relaxed">{feature.description}</p>
                                        </div>
                                ))}
                        </div>
                </div>
        </section>

        <!-- Use Cases Section -->
        <section class="py-20 md:py-28 bg-white">
                <div class="container">
                        <div class="max-w-4xl mx-auto">
                                <div class="text-center mb-16">
                                        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Cas d'usage</h2>
                                        <p class="text-lg text-gray-text max-w-2xl mx-auto">
                                                Comment {product.name} répond à des besoins métiers concrets
                                        </p>
                                </div>

                                <div class="space-y-6">
                                        {product.useCases.map((uc) => (
                                                <div class="flex flex-col md:flex-row gap-6 bg-light-bg rounded-xl p-6 md:p-8">
                                                        <div class={`md:w-48 flex-shrink-0 ${accent.text} font-bold text-lg`}>
                                                                {uc.sector}
                                                        </div>
                                                        <div class="flex-1">
                                                                <p class="text-gray-text leading-relaxed">{uc.scenario}</p>
                                                        </div>
                                                </div>
                                        ))}
                                </div>
                        </div>
                </div>
        </section>

        <!-- Benefits Section -->
        <section class={`py-20 md:py-28 bg-navy text-white relative overflow-hidden`}>
                <div class="absolute inset-0 opacity-5" aria-hidden="true">
                        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
                                <defs>
                                        <pattern id={`mosaic-benefits-${product.slug}`} x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                                                <polygon points="10,0 20,10 10,20 0,10" fill="none" stroke="white" stroke-width="0.5"/>
                                        </pattern>
                                </defs>
                                <rect width="100" height="100" fill={`url(#mosaic-benefits-${product.slug})`}/>
                        </svg>
                </div>

                <div class="container relative z-10">
                        <div class="max-w-4xl mx-auto">
                                <div class="text-center mb-16">
                                        <h2 class="text-3xl md:text-4xl font-bold mb-4">Bénéfices mesurables</h2>
                                        <p class="text-lg text-white/70 max-w-2xl mx-auto">
                                                Les résultats concrets que vous pouvez attendre de {product.name}
                                        </p>
                                </div>

                                <div class="grid md:grid-cols-2 gap-4">
                                        {product.benefits.map((benefit) => (
                                                <div class="flex items-start gap-3 p-4 bg-white/5 rounded-lg">
                                                        <svg class={`w-6 h-6 ${accent.text} flex-shrink-0 mt-0.5`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                        </svg>
                                                        <span class="text-white/90">{benefit}</span>
                                                </div>
                                        ))}
                                </div>
                        </div>
                </div>
        </section>

        <!-- CTA Section -->
        <section class="py-20 md:py-28 bg-light-bg">
                <div class="container">
                        <div class="max-w-3xl mx-auto text-center">
                                <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">
                                        Prêt à transformer votre institution avec {product.name} ?
                                </h2>
                                <p class="text-lg text-gray-text mb-8">
                                        Notre équipe vous accompagne de l'audit à la formation, en passant par le déploiement sur mesure.
                                </p>
                                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                                        <a
                                                href="/#contact"
                                                class="px-8 py-4 bg-orange text-white rounded-lg font-semibold hover:bg-orange-600 active:scale-95 transition-all duration-200 inline-flex items-center justify-center gap-2"
                                        >
                                                Demander une démonstration
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                                                </svg>
                                        </a>
                                        <a
                                                href="/#services"
                                                class="px-8 py-4 border-2 border-navy text-navy rounded-lg font-semibold hover:bg-navy/5 active:scale-95 transition-all duration-200 inline-flex items-center justify-center"
                                        >
                                                Découvrir nos services
                                        </a>
                                </div>
                        </div>
                </div>
        </section>

        <!-- Other Products Navigation -->
        <section class="py-16 md:py-20 bg-white border-t border-gray-200">
                <div class="container">
                        <h2 class="text-2xl font-bold text-navy mb-8 text-center">Découvrez nos autres solutions</h2>
                        <div class="grid md:grid-cols-3 gap-6">
                                {otherProducts.map((p) => {
                                        const otherAccent = accentColorClasses[p.accentColor];
                                        return (
                                                <a
                                                        href={productUrls[p.slug]}
                                                        class="group bg-light-bg rounded-xl p-6 hover:shadow-lg hover:scale-105 transition-all duration-300"
                                                >
                                                        <div class={`w-12 h-12 ${otherAccent.bg} rounded-lg flex items-center justify-center text-white mb-4`}>
                                                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={p.iconPath}></path>
                                                                </svg>
                                                        </div>
                                                        <h3 class="text-lg font-bold text-navy mb-1 group-hover:text-orange transition-colors">{p.name}</h3>
                                                        <p class="text-sm text-gray-text">{p.tagline}</p>
                                                </a>
                                        );
                                })}
                        </div>
                </div>
        </section>
</Layout>
