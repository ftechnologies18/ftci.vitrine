---
/**
 * CategoryBadge.astro — Badge catégorie PREMIUM.
 *
 * Redesign avec :
 *   - Couleurs distinctives par catégorie
 *   - Animation subtile au hover
 *   - Dot animé
 */

import { CATEGORY_LABELS } from '../../../keystatic.config';

interface Props {
	category: string;
	href?: string;
	size?: 'sm' | 'md';
}

const { category, href, size = 'md' } = Astro.props;

const label = CATEGORY_LABELS[category] ?? category;

// Mapping catégorie → couleurs (bg + text + border + dot)
const colorByCategory: Record<string, { bg: string; text: string; border: string; dot: string }> = {
	'transformation-digitale': {
		bg: 'rgba(238, 108, 26, 0.1)',
		text: '#c44100',
		border: 'rgba(238, 108, 26, 0.2)',
		dot: '#ee6c1a',
	},
	'intelligence-artificielle': {
		bg: 'rgba(107, 127, 199, 0.12)',
		text: '#4a5aa3',
		border: 'rgba(107, 127, 199, 0.2)',
		dot: '#6b7fc7',
	},
	'cloud-computing': {
		bg: 'rgba(15, 30, 61, 0.08)',
		text: '#0f1e3d',
		border: 'rgba(15, 30, 61, 0.15)',
		dot: '#0f1e3d',
	},
	cybersecurite: {
		bg: 'rgba(34, 197, 94, 0.1)',
		text: '#15803d',
		border: 'rgba(34, 197, 94, 0.2)',
		dot: '#22c55e',
	},
	'tech-innovation': {
		bg: 'rgba(232, 93, 4, 0.1)',
		text: '#c2410c',
		border: 'rgba(232, 93, 4, 0.2)',
		dot: '#e85d04',
	},
	'actualites-ftci': {
		bg: 'rgba(74, 85, 104, 0.1)',
		text: '#374151',
		border: 'rgba(74, 85, 104, 0.2)',
		dot: '#4a5568',
	},
};

const colors = colorByCategory[category] ?? colorByCategory['cloud-computing'];
const sizeClasses = size === 'sm' ? 'badge-sm' : 'badge-md';
---

{
	href ? (
		<a
			href={href}
			class={`category-badge ${sizeClasses}`}
			style={`--badge-bg: ${colors.bg}; --badge-text: ${colors.text}; --badge-border: ${colors.border}; --badge-dot: ${colors.dot};`}
		>
			<span class="badge-dot" aria-hidden="true" />
			<span class="badge-label">{label}</span>
		</a>
	) : (
		<span
			class={`category-badge ${sizeClasses}`}
			style={`--badge-bg: ${colors.bg}; --badge-text: ${colors.text}; --badge-border: ${colors.border}; --badge-dot: ${colors.dot};`}
		>
			<span class="badge-dot" aria-hidden="true" />
			<span class="badge-label">{label}</span>
		</span>
	)
}

<style>
	.category-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4375rem;
		border-radius: var(--radius-pill);
		font-weight: 600;
		background: var(--badge-bg);
		color: var(--badge-text);
		border: 1px solid var(--badge-border);
		transition: all 250ms ease;
		text-decoration: none;
		white-space: nowrap;
	}
	.category-badge:hover {
		background: var(--badge-bg);
		opacity: 0.85;
		transform: translateY(-1px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--badge-dot);
		animation: badgePulse 2s ease-in-out infinite;
	}
	@keyframes badgePulse {
		0%,
		100% {
			opacity: 1;
			transform: scale(1);
		}
		50% {
			opacity: 0.6;
			transform: scale(1.15);
		}
	}

	.badge-label {
		line-height: 1;
	}

	/* Sizes */
	.badge-sm {
		font-size: 10px;
		padding: 0.25rem 0.625rem;
		letter-spacing: 0.02em;
	}
	.badge-md {
		font-size: 11px;
		padding: 0.3125rem 0.75rem;
		letter-spacing: 0.02em;
	}

	@media (prefers-reduced-motion: reduce) {
		.badge-dot {
			animation: none;
		}
		.category-badge {
			transition: none;
		}
		.category-badge:hover {
			transform: none;
		}
	}
</style>
