<script>
	// Light trail effect - suit la souris
	const cards = document.querySelectorAll('[data-featured-card]');

	cards.forEach((card) => {
		card.addEventListener('mousemove', (e) => {
			const rect = card.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 100;
			const y = ((e.clientY - rect.top) / rect.height) * 100;

			const trail = card.querySelector('.light-trail') as HTMLElement;
			if (trail) {
				trail.style.setProperty('--mouse-x', `${x}%`);
				trail.style.setProperty('--mouse-y', `${y}%`);
			}
		});
	});
</script>
