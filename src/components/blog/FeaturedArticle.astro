---
/**
 * FeaturedArticle.astro — Article à la une (hero du blog).
 *
 * Grand format avec image de fond, badge catégorie, titre H2, description,
 * métadonnées. Utilisé sur la page d'index du blog pour le premier article
 * featured, ou le plus récent si aucun n'est marqué featured.
 */

import type { BlogEntry } from '../../lib/blog';
import { getArticleUrl, getReadingTime, getCategoryUrl } from '../../lib/blog';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
        entry: BlogEntry;
}

const { entry } = Astro.props;
const url = getArticleUrl(entry);
const readingTime = getReadingTime(entry);

const dateStr = entry.data.publishedAt.toLocaleDateString('fr-FR', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
});

const hasCover = !!entry.data.coverImage;
---

<article class="featured-article observe" style="--d: 0s;">
        <a href={url} class="featured-link" aria-label={entry.data.title}>
                <div class="featured-cover">
                        {
                                hasCover ? (
                                        <img
                                                src={entry.data.coverImage}
                                                alt=""
                                                loading="eager"
                                                fetchpriority="high"
                                                decoding="async"
                                                class="featured-img"
                                                width="1200"
                                                height="600"
                                        />
                                ) : (
                                        <div class="featured-fallback" aria-hidden="true">
                                                <svg class="w-16 h-16 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                                </svg>
                                        </div>
                                )
                        }
                        <div class="featured-overlay"></div>
                </div>

                <div class="featured-content">
                        <div class="featured-badge">
                                <CategoryBadge category={entry.data.category} size="sm" href={getCategoryUrl(entry.data.category)} />
                        </div>

                        <h2 class="featured-title">{entry.data.title}</h2>
                        <p class="featured-desc">{entry.data.description}</p>

                        <div class="featured-meta">
                                <span>À la une</span>
                                <span class="featured-dot" aria-hidden="true">·</span>
                                <time datetime={entry.data.publishedAt.toISOString()}>{dateStr}</time>
                                <span class="featured-dot" aria-hidden="true">·</span>
                                <span>{readingTime} min de lecture</span>
                        </div>
                </div>
        </a>
</article>

<style>
        .featured-article {
                border-radius: calc(var(--radius-card) + 4px);
                overflow: hidden;
                box-shadow: 0 10px 30px rgba(15, 30, 61, 0.15);
                background: var(--color-navy);
                opacity: 0;
                transform: translateY(20px);
                transition:
                        opacity 600ms var(--ease-out),
                        transform 600ms var(--ease-out);
        }
        .featured-article.is-visible {
                opacity: 1;
                transform: translateY(0);
        }

        .featured-link {
                display: block;
                position: relative;
        }

        .featured-cover {
                position: relative;
                aspect-ratio: 21 / 9;
                overflow: hidden;
        }
        @media (max-width: 768px) {
                .featured-cover {
                        aspect-ratio: 16 / 10;
                }
        }
        .featured-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 700ms var(--ease-out);
        }
        .featured-article:hover .featured-img {
                transform: scale(1.04);
        }
        .featured-fallback {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                background: linear-gradient(135deg, #0F1E3D 0%, #1c2d54 40%, #6B7FC7 70%, #EE6C1A 100%);
        }

        .featured-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(
                        to top,
                        rgba(15, 30, 61, 0.95) 0%,
                        rgba(15, 30, 61, 0.7) 40%,
                        rgba(15, 30, 61, 0.25) 70%,
                        rgba(15, 30, 61, 0.1) 100%
                );
        }

        .featured-content {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                padding: 2rem 2.5rem;
                color: #fff;
        }
        @media (max-width: 768px) {
                .featured-content {
                        padding: 1.5rem;
                }
        }

        .featured-badge {
                margin-bottom: 0.875rem;
        }

        .featured-title {
                font-family: var(--font-display);
                font-weight: 800;
                font-size: clamp(1.5rem, 3vw, 2.25rem);
                line-height: 1.15;
                letter-spacing: -0.025em;
                margin: 0 0 0.625rem;
                max-width: 60ch;
        }
        .featured-desc {
                font-size: 1rem;
                line-height: 1.5;
                color: rgba(255, 255, 255, 0.8);
                margin: 0 0 1rem;
                max-width: 70ch;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
        }

        .featured-meta {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.8125rem;
                color: rgba(255, 255, 255, 0.7);
        }
        .featured-dot {
                opacity: 0.5;
        }

        @media (prefers-reduced-motion: reduce) {
                .featured-article,
                .featured-img {
                        transition: none;
                }
                .featured-article:hover .featured-img {
                        transform: none;
                }
        }
</style>
