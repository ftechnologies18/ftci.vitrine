---
/**
 * ArticleSEO.astro — Meta tags SEO spécifiques à un article de blog.
 *
 * À utiliser dans <head> via le layout quand on est sur une page article.
 * Injecte : Open Graph (article), Twitter Card, et les JSON-LD
 * schema.org BlogPosting (rich snippet article) + BreadcrumbList
 * (fil d'Ariane dans les résultats Google) pour le référencement.
 */

import { getCategoryLabel, getCategoryUrl } from '../../lib/blog';
import { safeJsonStringify } from '../../lib/sanitize';

interface Props {
	title: string;
	description: string;
	url: string;
	publishedAt: Date;
	author: string;
	coverImage?: string;
	category: string;
	keywords?: string[];
}

const {
	title,
	description,
	url,
	publishedAt,
	author,
	coverImage,
	category,
	keywords = [],
} = Astro.props;

const siteUrl = 'https://ftci.fr';
const absoluteUrl = url.startsWith('http') ? url : `${siteUrl}${url}`;
const absoluteCover = coverImage
	? coverImage.startsWith('http')
		? coverImage
		: `${siteUrl}${coverImage}`
	: `${siteUrl}/brand/ftci-a.jpg`;

const categoryLabel = getCategoryLabel(category);
const allKeywords = [categoryLabel, 'FTCI', "Freelance Technologies Côte d'Ivoire", ...keywords];

// Schema.org BlogPosting — rich snippet pour Google
const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	image: absoluteCover,
	datePublished: publishedAt.toISOString(),
	dateModified: publishedAt.toISOString(),
	author: {
		'@type': 'Organization',
		name: author,
		url: siteUrl,
	},
	publisher: {
		'@type': 'Organization',
		name: 'FTCI',
		logo: {
			'@type': 'ImageObject',
			url: `${siteUrl}/brand/logo-ftci.png`,
		},
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': absoluteUrl,
	},
	articleSection: categoryLabel,
	keywords: allKeywords.join(', '),
	inLanguage: 'fr-FR',
};

// Schema.org BreadcrumbList — rich snippet "fil d'Ariane" dans les résultats Google.
// Reflète la hiérarchie de navigation visible sur la page article :
// Accueil > Blog > Catégorie > Article. Google peut afficher ce fil d'Ariane au
// lieu de l'URL brute sous le titre du résultat, ce qui améliore le taux de clic
// et la lisibilité de la provenance de la page.
const categoryUrl = `${siteUrl}${getCategoryUrl(category)}`;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Accueil',
			item: `${siteUrl}/`,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Blog',
			item: `${siteUrl}/blog`,
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: categoryLabel,
			item: categoryUrl,
		},
		{
			'@type': 'ListItem',
			position: 4,
			name: title,
			item: absoluteUrl,
		},
	],
};
---

<!-- Meta keywords (SEO) -->
<meta name="keywords" content={allKeywords.join(', ')} />

<!-- Open Graph (Facebook, LinkedIn) -->
<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={absoluteUrl} />
<meta property="og:image" content={absoluteCover} />
<meta property="og:image:alt" content={`Illustration : ${title}`} />
<meta property="og:site_name" content="FTCI" />
<meta property="og:locale" content="fr_FR" />
<meta property="article:published_time" content={publishedAt.toISOString()} />
<meta property="article:author" content={author} />
<meta property="article:section" content={categoryLabel} />
{keywords.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteCover} />

<!-- JSON-LD BlogPosting (rich snippets Google) — sanitized pour prévenir XSS via </script> -->
<script type="application/ld+json" set:html={safeJsonStringify(blogPostingSchema)} is:inline />

<!-- JSON-LD BreadcrumbList (fil d'Ariane dans les résultats Google) -->
<script type="application/ld+json" set:html={safeJsonStringify(breadcrumbSchema)} is:inline />
