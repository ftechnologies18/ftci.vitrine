---
/**
 * NewsletterCard.astro — Carte newsletter RECTANGULAIRE pour sidebar articles.
 *
 * Design rectangulaire compact :
 *   - Titre + description courte
 *   - Bouton CTA qui ouvre la modale
 *   - Pas trop imposant, élégant
 */
---

<div class="nl-card" data-newsletter-card>
	<div class="nl-card__header">
		<div class="nl-card__icon" aria-hidden="true">
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="1.5"
					d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
				></path></svg
			>
		</div>
		<span class="nl-card__title">Newsletter</span>
	</div>
	<p class="nl-card__desc">Restez informé de nos derniers articles</p>
	<button type="button" class="nl-card__btn" data-open-modal>S'abonner</button>
</div>

<style>
	.nl-card {
		background: var(--color-navy, #0a1628);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 1rem 1.15rem;
		color: #fff;
		transition: border-color 0.2s;
	}
	.nl-card:hover {
		border-color: rgba(238, 108, 26, 0.3);
	}

	.nl-card__header {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 0.625rem;
	}

	.nl-card__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		background: rgba(238, 108, 26, 0.12);
		border-radius: 7px;
		color: var(--color-orange, #ee6c1a);
		flex-shrink: 0;
	}
	.nl-card__icon svg {
		width: 14px;
		height: 14px;
	}

	.nl-card__title {
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-orange, #ee6c1a);
	}

	.nl-card__desc {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.65);
		line-height: 1.45;
		margin: 0 0 0.875rem;
	}

	.nl-card__btn {
		width: 100%;
		padding: 0.55rem 1rem;
		background: var(--color-orange, #ee6c1a);
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 600;
		font-family: inherit;
		border: none;
		border-radius: 8px;
		cursor: pointer;
		transition:
			background 0.15s,
			transform 0.15s;
	}
	.nl-card__btn:hover {
		background: #d4520e;
		transform: translateY(-1px);
	}
	.nl-card__btn:active {
		transform: translateY(0);
	}
</style>

<script>
	document
		.querySelector('[data-newsletter-card]')
		?.querySelector('[data-open-modal]')
		?.addEventListener('click', () => {
			document.dispatchEvent(new CustomEvent('open-newsletter-modal'));
		});
</script>
