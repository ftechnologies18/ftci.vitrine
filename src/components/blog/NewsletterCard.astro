---
/**
 * NewsletterCard.astro — Carte newsletter ULTRA COMPACTE pour sidebar.
 *
 * Design minimaliste extrême :
 *   - Layout horizontal sur une seule ligne
 *   - Dimensions minimales, zéro espace perdu
 *   - Icône micro + texte court + bouton tiny
 */
---

<div class="nl-mini" data-newsletter-card>
  <span class="nl-mini__icon" aria-hidden="true">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
  </span>
  <span class="nl-mini__label">Newsletter</span>
  <button type="button" class="nl-mini__btn" data-open-modal aria-label="S'abonner">S'abonner</button>
</div>

<style>
  .nl-mini {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-navy, #0a1628);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 0.5rem 0.65rem;
    color: #fff;
    transition: border-color 0.2s;
  }
  .nl-mini:hover {
    border-color: rgba(238,108,26,0.3);
  }

  .nl-mini__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: rgba(238,108,26,0.12);
    border-radius: 5px;
    color: var(--color-orange, #ee6c1a);
    flex-shrink: 0;
  }
  .nl-mini__icon svg {
    width: 11px;
    height: 11px;
  }

  .nl-mini__label {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255,255,255,0.8);
    white-space: nowrap;
    flex: 1;
    min-width: 0;
  }

  .nl-mini__btn {
    padding: 0.3rem 0.6rem;
    background: var(--color-orange, #ee6c1a);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    font-family: inherit;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s, transform 0.15s;
  }
  .nl-mini__btn:hover {
    background: #d4520e;
    transform: scale(1.03);
  }
  .nl-mini__btn:active {
    transform: scale(0.98);
  }
</style>

<script>
  document.querySelector('[data-newsletter-card]')?.querySelector('[data-open-modal]')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-newsletter-modal'));
  });
</script>
