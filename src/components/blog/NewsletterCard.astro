---
/**
 * NewsletterCard.astro — Carte newsletter ULTRA MINIMALISTE pour sidebar.
 *
 * Design compact horizontal :
 *   - Icône + texte + bouton sur une seule ligne
 *   - Padding minimal, aucun espace perdu
 *   - Bouton CTA qui ouvre la modale
 *   - Hover subtil et élégant
 *
 * Usage : <NewsletterCard /> dans la sidebar des articles.
 */
---

<div class="nl-card" data-newsletter-card>
	<div class="nl-card-body">
		<!-- Icon + Text -->
		<div class="nl-card-info">
			<div class="nl-card-icon" aria-hidden="true">
				<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
				</svg>
			</div>
			<span class="nl-card-text">Newsletter</span>
		</div>

		<!-- CTA Button -->
		<button 
			type="button"
			class="nl-card-btn"
			data-open-modal
			aria-label="S'abonner à la newsletter"
		>
			S'abonner
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-6H6"/>
			</svg>
		</button>
	</div>
</div>

<style>
	.nl-card {
		background: linear-gradient(135deg, var(--color-navy) 0%, #162345 100%);
		border-radius: var(--radius-card);
		padding: 0.875rem 1rem;
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.06);
		transition: all 250ms ease;
	}

	.nl-card:hover {
		border-color: rgba(238, 108, 26, 0.25);
		box-shadow: 0 4px 20px rgba(15, 30, 61, 0.15);
	}

	/* Horizontal layout - tout sur une ligne */
	.nl-card-body {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	/* Icon + Text group */
	.nl-card-info {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		flex: 1;
		min-width: 0; /* permet le troncature si besoin */
	}

	/* Small icon */
	.nl-card-icon {
		width: 28px;
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(238, 108, 26, 0.15);
		border-radius: 8px;
		color: var(--color-orange);
		flex-shrink: 0;
		transition: all 250ms ease;
	}

	.nl-card-icon svg {
		width: 14px;
		height: 14px;
	}

	.nl-card:hover .nl-card-icon {
		background: rgba(238, 108, 26, 0.25);
	}

	/* Text label */
	.nl-card-text {
		font-size: 0.8125rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.85);
		white-space: nowrap;
	}

	/* Compact button */
	.nl-card-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.5rem 0.875rem;
		background: var(--color-orange);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 600;
		font-family: var(--font-sans);
		border: none;
		border-radius: var(--radius-pill);
		cursor: pointer;
		white-space: nowrap;
		flex-shrink: 0;
		transition: all 200ms ease;
	}

	.nl-card-btn svg {
		width: 12px;
		height: 12px;
		transition: transform 200ms ease;
	}

	.nl-card-btn:hover {
		background: #d4520e;
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(238, 108, 26, 0.35);
	}

	.nl-card-btn:hover svg {
		transform: translateX(2px);
	}

	.nl-card-btn:active {
		transform: translateY(0);
	}
</style>

<script>
	// Ouvrir la modale newsletter au clic sur le bouton
	const card = document.querySelector('[data-newsletter-card]');
	const openBtn = card?.querySelector('[data-open-modal]');

	openBtn?.addEventListener('click', () => {
		document.dispatchEvent(new CustomEvent('open-newsletter-modal'));
	});
</script>
