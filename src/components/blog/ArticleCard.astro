---
/**
 * ArticleCard.astro — Carte d'article de blog pour les listes.
 *
 * Affiche : image de couverture (ou fallback gradient FTCI), badge catégorie,
 * titre, description, métadonnées (date, temps de lecture, auteur).
 *
 * Au survol : élévation légère + zoom de l'image (transform GPU-only).
 * Comportement responsive : grille desktop, colonne mobile.
 */

import type { BlogEntry } from '../../lib/blog';
import { getArticleUrl, getReadingTime, getCategoryUrl } from '../../lib/blog';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
        entry: BlogEntry;
        priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const url = getArticleUrl(entry);
const readingTime = getReadingTime(entry);

// Formatage date FR (ex : "30 juillet 2026")
const dateStr = entry.data.publishedAt.toLocaleDateString('fr-FR', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
});

// Fallback image : gradient navy → orange FTCI quand pas de coverImage.
const hasCover = !!entry.data.coverImage;
const coverSrc = hasCover
        ? entry.data.coverImage
        : '';
---

<article class="group article-card observe" style="--d: 0.05s;">
        <a href={url} class="block" aria-label={entry.data.title}>
                <div class="article-card-cover">
                        {
                                hasCover ? (
                                        <img
                                                src={coverSrc}
                                                alt=""
                                                loading={priority ? 'eager' : 'lazy'}
                                                decoding="async"
                                                class="article-card-img"
                                                width="640"
                                                height="360"
                                        />
                                ) : (
                                        <div class="article-card-fallback" aria-hidden="true">
                                                <svg class="w-12 h-12 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 0a2 2 0 012 2v8a2 2 0 01-2 2m-4-12V4m0 0l3 3m-3-3l-3 3" />
                                                </svg>
                                        </div>
                                )
                        }
                        <div class="article-card-badge">
                                <CategoryBadge category={entry.data.category} size="sm" href={getCategoryUrl(entry.data.category)} />
                        </div>
                </div>

                <div class="article-card-content">
                        <h3 class="article-card-title">{entry.data.title}</h3>
                        <p class="article-card-desc">{entry.data.description}</p>

                        <div class="article-card-meta">
                                <time datetime={entry.data.publishedAt.toISOString()}>{dateStr}</time>
                                <span class="article-card-dot" aria-hidden="true">·</span>
                                <span>{readingTime} min de lecture</span>
                        </div>
                </div>
        </a>
</article>

<style>
        .article-card {
                background: #fff;
                border: 1px solid rgba(15, 30, 61, 0.08);
                border-radius: var(--radius-card);
                overflow: hidden;
                transition:
                        transform 300ms var(--ease-out),
                        box-shadow 300ms var(--ease-out),
                        border-color 300ms var(--ease-out);
        }
        .article-card.is-visible {
                opacity: 1;
                transform: translateY(0);
        }
        .article-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 28px rgba(15, 30, 61, 0.12);
                border-color: rgba(238, 108, 26, 0.3);
        }

        .article-card-cover {
                position: relative;
                aspect-ratio: 16 / 9;
                overflow: hidden;
                background: var(--color-navy);
        }
        .article-card-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 500ms var(--ease-out);
        }
        .article-card:hover .article-card-img {
                transform: scale(1.05);
        }
        .article-card-fallback {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                background: linear-gradient(135deg, #0F1E3D 0%, #1c2d54 40%, #EE6C1A 100%);
        }

        .article-card-badge {
                position: absolute;
                top: 0.75rem;
                left: 0.75rem;
                z-index: 1;
        }

        .article-card-content {
                padding: 1.25rem 1.5rem 1.5rem;
        }
        .article-card-title {
                font-family: var(--font-display);
                font-weight: 700;
                font-size: 1.125rem;
                line-height: 1.35;
                color: var(--color-navy);
                margin: 0 0 0.5rem;
                letter-spacing: -0.01em;
                transition: color 200ms var(--ease-out);
        }
        .article-card:hover .article-card-title {
                color: var(--color-orange);
        }
        .article-card-desc {
                font-size: 0.875rem;
                line-height: 1.55;
                color: var(--color-gray-text);
                margin: 0 0 1rem;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
        }
        .article-card-meta {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.75rem;
                color: var(--color-gray-text);
        }
        .article-card-dot {
                opacity: 0.5;
        }

        @media (prefers-reduced-motion: reduce) {
                .article-card,
                .article-card-img {
                        transition: none;
                }
                .article-card:hover {
                        transform: none;
                }
                .article-card:hover .article-card-img {
                        transform: none;
                }
        }
</style>
