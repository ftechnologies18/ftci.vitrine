---
/**
 * NewsletterModal.astro — Modale d'abonnement newsletter PREMIUM.
 *
 * Fonctionnalités :
 *   - Ouverture/Fermeture avec animation CSS smooth
 *   - Backdrop blur + overlay sombre
 *   - Formulaire email avec validation
 *   - Loading state animé
 *   - Feedback succès/erreur intégré
 *   - Fermeture via bouton, overlay, touche Escape
 *   - Focus trap pour l'accessibilité
 *   - Prevention du body scroll quand ouverte
 *
 * Déclenchement : écoute l'événement custom 'open-newsletter-modal'.
 */

interface Props {
	/** Titre personnalisé de la modale (optionnel) */
	title?: string;
	/** Description personnalisée (optionnel) */
	description?: string;
}

const {
	title = 'Restez informé',
	description = 'Recevez nos derniers articles et analyses directement dans votre boîte mail.',
} = Astro.props;
---

<!-- Modal backdrop -->
<div class="nl-modal-backdrop" id="newsletter-modal-backdrop" aria-hidden="true"></div>

<!-- Modal container -->
<div
	class="nl-modal"
	id="newsletter-modal"
	role="dialog"
	aria-modal="true"
	aria-labelledby="nl-modal-title"
	aria-describedby="nl-modal-desc"
>
	<div class="nl-modal-container">
		<!-- Header -->
		<header class="nl-modal-header">
			<div class="nl-modal-icon-wrap" aria-hidden="true">
				<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.5"
						d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
					></path>
				</svg>
			</div>

			<div class="nl-modal-title-group">
				<h2 id="nl-modal-title" class="nl-modal-title">{title}</h2>
				<p id="nl-modal-desc" class="nl-modal-desc">{description}</p>
			</div>

			<button
				type="button"
				class="nl-modal-close"
				id="nl-modal-close"
				aria-label="Fermer la fenêtre"
			>
				<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</header>

		<!-- Form -->
		<form id="nl-modal-form" class="nl-modal-form" novalidate>
			<div class="nl-input-group">
				<label for="nl-modal-email" class="sr-only">Votre adresse email</label>
				<div class="nl-input-wrapper">
					<svg
						class="nl-input-icon"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"
						></path>
					</svg>
					<input
						type="email"
						id="nl-modal-email"
						name="email"
						class="nl-input"
						placeholder="votre@email.com"
						required
						autocomplete="email"
						aria-required="true"
					/>
				</div>
			</div>

			<button type="submit" class="nl-submit" id="nl-modal-submit">
				<span class="nl-submit-text">
					S'abonner à la newsletter
					<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
					</svg>
				</span>
				<span class="nl-submit-loading hidden">
					<span class="nl-spinner"></span>
					Envoi en cours...
				</span>
			</button>
		</form>

		<!-- Status message -->
		<div id="nl-modal-status" class="nl-status hidden" role="status" aria-live="polite"></div>

		<!-- Footer note -->
		<p class="nl-modal-note">
			<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
				></path>
			</svg>
			Pas de spam. Désabonnement en un clic.
		</p>
	</div>
</div>

<style>
	/* ═══════════════════════════════════════════════════════════════════════════
	   BACKDROP
	   ═══════════════════════════════════════════════════════════════════════════ */
	.nl-modal-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(15, 23, 42, 0.6);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		z-index: 9998;
		opacity: 0;
		visibility: hidden;
		transition: all 300ms ease;
	}

	.nl-modal-backdrop.active {
		opacity: 1;
		visibility: visible;
	}

	/* ═══════════════════════════════════════════════════════════════════════════
	   MODAL CONTAINER
	   ═══════════════════════════════════════════════════════════════════════════ */
	.nl-modal {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) scale(0.95);
		z-index: 9999;
		width: calc(100% - 2rem);
		max-width: 420px;
		max-height: calc(100vh - 4rem);
		overflow-y: auto;
		background: #fff;
		border-radius: 1.25rem;
		box-shadow:
			0 25px 60px rgba(15, 30, 61, 0.25),
			0 10px 20px rgba(15, 30, 61, 0.15),
			inset 0 1px 0 rgba(255, 255, 255, 0.8);
		opacity: 0;
		visibility: hidden;
		transition: all 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.nl-modal.active {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, -50%) scale(1);
	}

	.nl-modal-container {
		padding: 1.75rem;
	}

	/* ═══════════════════════════════════════════════════════════════════════════
	   HEADER
	   ═══════════════════════════════════════════════════════════════════════════ */
	.nl-modal-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		margin-bottom: 1.5rem;
		position: relative;
	}

	.nl-modal-icon-wrap {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--color-navy) 0%, #1c2d54 100%);
		border-radius: 14px;
		color: var(--color-orange);
		box-shadow: 0 8px 24px rgba(15, 30, 61, 0.2);
	}

	.nl-modal-icon-wrap svg {
		width: 26px;
		height: 26px;
	}

	.nl-modal-title-group {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.nl-modal-title {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 700;
		color: var(--color-navy);
		margin: 0;
		line-height: 1.25;
	}

	.nl-modal-desc {
		font-size: 0.9375rem;
		color: var(--color-gray-text);
		margin: 0;
		line-height: 1.5;
		max-width: 320px;
	}

	/* Close button */
	.nl-modal-close {
		position: absolute;
		top: -0.5rem;
		right: -0.5rem;
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(15, 30, 61, 0.06);
		border: none;
		border-radius: 50%;
		cursor: pointer;
		color: var(--color-gray-text);
		transition: all 200ms ease;
	}

	.nl-modal-close svg {
		width: 18px;
		height: 18px;
	}

	.nl-modal-close:hover {
		background: rgba(15, 30, 61, 0.12);
		color: var(--color-navy);
		transform: rotate(90deg);
	}

	/* ═══════════════════════════════════════════════════════════════════════════
	   FORM
	   ═══════════════════════════════════════════════════════════════════════════ */
	.nl-modal-form {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.nl-input-group {
		width: 100%;
	}

	.nl-input-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.nl-input-icon {
		position: absolute;
		left: 1rem;
		width: 18px;
		height: 18px;
		color: rgba(15, 30, 61, 0.35);
		pointer-events: none;
		transition: color 200ms ease;
	}

	.nl-input {
		width: 100%;
		padding: 0.875rem 1rem 0.875rem 2.75rem;
		background: rgba(15, 30, 61, 0.03);
		border: 1.5px solid rgba(15, 30, 61, 0.12);
		border-radius: 0.75rem;
		color: var(--color-navy);
		font-size: 0.9375rem;
		font-family: var(--font-sans);
		outline: none;
		transition: all 200ms ease;
	}

	.nl-input::placeholder {
		color: rgba(15, 30, 61, 0.35);
	}

	.nl-input:focus {
		background: #fff;
		border-color: var(--color-orange);
		box-shadow: 0 0 0 4px rgba(238, 108, 26, 0.12);
	}

	.nl-input:focus + .nl-input-icon,
	.nl-input-wrapper:has(.nl-input:focus) .nl-input-icon {
		color: var(--color-orange);
	}

	/* Submit button */
	.nl-submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		padding: 0.875rem 1.5rem;
		background: linear-gradient(135deg, var(--color-orange) 0%, #e67628 100%);
		color: #fff;
		font-weight: 600;
		font-size: 0.9375rem;
		font-family: var(--font-sans);
		border: none;
		border-radius: 0.75rem;
		cursor: pointer;
		transition: all 250ms ease;
		box-shadow: 0 4px 16px rgba(238, 108, 26, 0.3);
	}

	.nl-submit:hover:not(:disabled) {
		background: linear-gradient(135deg, #d4520e 0%, var(--color-orange) 100%);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(238, 108, 26, 0.4);
	}

	.nl-submit:active:not(:disabled) {
		transform: translateY(0);
	}

	.nl-submit:disabled {
		opacity: 0.7;
		cursor: not-allowed;
	}

	.nl-submit-text {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nl-submit-text svg {
		width: 16px;
		height: 16px;
	}

	.nl-submit-loading {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nl-spinner {
		width: 18px;
		height: 18px;
		border: 2px solid rgba(255, 255, 255, 0.3);
		border-top-color: #fff;
		border-radius: 50%;
		animation: nl-spin 0.6s linear infinite;
	}

	@keyframes nl-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Status */
	.nl-status {
		padding: 0.875rem 1rem;
		border-radius: 0.75rem;
		font-size: 0.875rem;
		font-weight: 500;
		text-align: center;
		animation: nl-status-in 300ms ease-out;
	}

	@keyframes nl-status-in {
		from {
			opacity: 0;
			transform: translateY(-8px) scale(0.95);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.nl-status--success {
		background: linear-gradient(135deg, rgba(30, 158, 79, 0.1) 0%, rgba(30, 158, 79, 0.05) 100%);
		color: #16a34a;
		border: 1px solid rgba(30, 158, 79, 0.2);
	}

	.nl-status--error {
		background: linear-gradient(135deg, rgba(238, 108, 26, 0.1) 0%, rgba(238, 108, 26, 0.05) 100%);
		color: #d4520e;
		border: 1px solid rgba(238, 108, 26, 0.2);
	}

	/* Note */
	.nl-modal-note {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		margin: 1rem 0 0;
		font-size: 0.75rem;
		color: rgba(15, 30, 61, 0.45);
	}

	.nl-modal-note svg {
		width: 14px;
		height: 14px;
		flex-shrink: 0;
	}

	/* Utility */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.hidden {
		display: none !important;
	}

	/* Mobile adjustments */
	@media (max-width: 480px) {
		.nl-modal-container {
			padding: 1.25rem;
		}

		.nl-modal-title {
			font-size: 1.1875rem;
		}
	}
</style>

<script>
	// ── Newsletter Modal Logic ────────────────────────────────────────────────
	const modal = document.getElementById('newsletter-modal') as HTMLElement | null;
	const backdrop = document.getElementById('newsletter-modal-backdrop') as HTMLElement | null;
	const closeBtn = document.getElementById('nl-modal-close') as HTMLButtonElement | null;
	const form = document.getElementById('nl-modal-form') as HTMLFormElement | null;
	const submitBtn = document.getElementById('nl-modal-submit') as HTMLButtonElement | null;
	const statusEl = document.getElementById('nl-modal-status') as HTMLElement | null;
	const emailInput = document.getElementById('nl-modal-email') as HTMLInputElement | null;

	if (!modal || !backdrop || !form || !submitBtn || !statusEl || !emailInput) {
		console.warn('[NewsletterModal] Éléments manquants');
	}

	// State helpers
	let previousActiveElement: HTMLElement | null = null;

	const openModal = () => {
		previousActiveElement = document.activeElement as HTMLElement;

		modal?.classList.add('active');
		backdrop?.classList.add('active');
		document.body.style.overflow = 'hidden';

		// Focus l'input email après animation
		setTimeout(() => emailInput?.focus(), 350);
	};

	const closeModal = () => {
		modal?.classList.remove('active');
		backdrop?.classList.remove('active');
		document.body.style.overflow = '';
		statusEl?.classList.add('hidden');
		form?.reset();

		// Restore focus
		if (previousActiveElement && typeof previousActiveElement.focus === 'function') {
			previousActiveElement.focus();
		}
	};

	// Event listeners
	document.addEventListener('open-newsletter-modal', openModal);

	closeBtn?.addEventListener('click', closeModal);
	backdrop?.addEventListener('click', closeModal);

	// Escape key
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modal?.classList.contains('active')) {
			closeModal();
		}
	});

	// Form submission
	if (form && submitBtn && statusEl) {
		const textLabel = submitBtn.querySelector('.nl-submit-text');
		const loadingLabel = submitBtn.querySelector('.nl-submit-loading');

		const setLoading = (loading: boolean) => {
			if (loading) {
				textLabel?.classList.add('hidden');
				loadingLabel?.classList.remove('hidden');
				submitBtn.disabled = true;
			} else {
				textLabel?.classList.remove('hidden');
				loadingLabel?.classList.add('hidden');
				submitBtn.disabled = false;
			}
		};

		const showStatus = (message: string, type: 'success' | 'error') => {
			statusEl.textContent = message;
			statusEl.className = `nl-status nl-status--${type}`;
			statusEl.classList.remove('hidden');

			// Auto-hide success after 5s
			if (type === 'success') {
				setTimeout(closeModal, 4000);
			} else {
				setTimeout(() => statusEl.classList.add('hidden'), 6000);
			}
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			statusEl.classList.add('hidden');

			const email = emailInput.value.trim();

			// Validation
			if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
				showStatus('Adresse email invalide. Vérifiez votre saisie.', 'error');
				emailInput.focus();
				return;
			}

			setLoading(true);

			try {
				const res = await fetch('/api/newsletter/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email }),
				});

				const data = (await res.json().catch(() => ({}))) as {
					ok?: boolean;
					message?: string;
					error?: string;
				};

				if (res.ok) {
					showStatus(
						data.message || '✓ Abonnement réussi ! Bienvenue parmi nos lecteurs.',
						'success',
					);
					form.reset();
				} else {
					showStatus(data.error || 'Une erreur est survenue. Veuillez réessayer.', 'error');
				}
			} catch {
				showStatus('Erreur réseau. Vérifiez votre connexion et réessayez.', 'error');
			} finally {
				setLoading(false);
			}
		});
	}
</script>
