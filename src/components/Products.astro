---
/**
 * Products.astro — Section "Nos Solutions" (4 cartes produits + écosystème).
 * ────────────────────────────────────────────────────────────────────────────
 * - Import products, productUrls, accentColorClasses de ../data/products
 * - Section id="solutions" py-20 md:py-32 bg-white
 * - Background : motif circuit imprimé SVG (traces H/V + nœuds, opacity 8%)
 * - Grid 2 colonnes (md) des 4 produits
 * - Chaque carte : .tilt-stage.observe (stagger --d) > .tilt-card (data-tilt)
 *   + .halo-glow avec --halo-color inline (couleur produit)
 * - Carte (Small Biz : 4 éléments max) : icône gradient, nom, description,
 *   2 liens (page locale "En savoir plus" + externe "Accéder")
 * - Lignes de connexion SVG animées en bas : 4 nœuds losange + 3 lignes
 *   .connection-line (dashFlow) — signature visuelle "écosystème FTCI"
 * 
 * ENHANCED MICRO-INTERACTIONS (Task #3):
 * - Tilt 3D: perspective(800px) rotateY(x*8deg) rotateX(-y*8deg) translateY(-4px)
 * - Glow: box-shadow with product-specific RGBA at 35%, blur 60px, offset-y 24px
 * - Magnetic buttons: translate(deltaX*0.18, deltaY*0.3), max 15-20px displacement
 * - Connection lines: diamond nodes, stroke-dasharray 6 8, animation towards -140
 */

import { products, productUrls, accentColorClasses } from '../data/products';

// Mapping accentColor → hex pour --halo-color (avec RGBA pour glow)
const haloHex: Record<string, string> = {
        orange: '#ee6c1a',
        green: '#1e9e4f',
        periwinkle: '#6b7fc7',
        navy: '#0f1e3d',
};

// Couleurs des nœuds pour le diagramme écosystème
const nodeColors = products.map((p) => haloHex[p.accentColor]);
---

<section id="solutions" class="relative py-20 md:py-32 bg-white overflow-hidden">
        <!-- ── Motif circuit imprimé (filigrane tech) ───────────────────────── -->
        <div class="absolute inset-0 opacity-[0.08] circuit-bg" aria-hidden="true"></div>

        <div class="container relative z-10">
                <!-- ── Section header ─────────────────────────────────────────────── -->
                <div class="section-header observe">
                        <span class="eyebrow">
                                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 8 8" aria-hidden="true">
                                        <polygon points="4,0 8,4 4,8 0,4" />
                                </svg>
                                Écosystème SaaS
                        </span>
                        <h2>Nos Solutions</h2>
                        <p>
                                Quatre plateformes SaaS conçues pour les réalités du marché africain —
                                évaluation, chantier, présence scolaire et gestion financière.
                        </p>
                </div>

                <!-- ── Grille des 4 produits ──────────────────────────────────────── -->
                <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
                        {products.map((product, idx) => {
                                const accent = accentColorClasses[product.accentColor];
                                const halo = haloHex[product.accentColor];
                                return (
                                        <div
                                                class="tilt-stage halo-glow observe"
                                                style={`--halo-color: ${halo}; --halo-radius: 18px; --d: ${idx * 0.1}s`}
                                        >
                                                <article
                                                        class="tilt-card group h-full bg-white rounded-card border border-navy/8 p-7 md:p-8 shadow-sm"
                                                        data-tilt
                                                >
                                                        <div class="tilt-content flex flex-col h-full">
                                                                <!-- Icône gradient couleur produit -->
                                                                <div
                                                                        class={`w-14 h-14 rounded-xl bg-gradient-to-br ${accent.from} ${accent.to} flex items-center justify-center text-white mb-6 shadow-lg`}
                                                                        aria-hidden="true"
                                                                >
                                                                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                <path
                                                                                        stroke-linecap="round"
                                                                                        stroke-linejoin="round"
                                                                                        stroke-width="2"
                                                                                        d={product.iconPath}
                                                                                />
                                                                        </svg>
                                                                </div>

                                                                <!-- Nom + fullName -->
                                                                <h3
                                                                        class={`text-xl sm:text-2xl font-display font-extrabold text-navy mb-1 transition-colors duration-200 group-hover:text-orange ${accent.text.replace('text-', 'group-hover:')}`}
                                                                >
                                                                        {product.name}
                                                                </h3>
                                                                <p class="text-sm text-gray-text font-medium mb-3">{product.fullName}</p>

                                                                <!-- Description courte -->
                                                                <p class="text-gray-text leading-relaxed mb-6 flex-1">
                                                                        {product.description}
                                                                </p>

                                                                <!-- Bouton vers la plateforme externe (couleur thème carte) -->
                                                                <a
                                                                        href={product.externalUrl}
                                                                        target="_blank"
                                                                        rel="noopener noreferrer"
                                                                        class={`magnetic-btn group/btn relative inline-flex items-center justify-center gap-2.5 text-sm font-bold text-white px-6 py-3.5 rounded-2xl transition-all duration-300 overflow-hidden ${accent.bg} hover:shadow-[0_8px_30px_-6px_var(--btn-glow)]`}
                                                                        style={`--btn-glow: ${halo}50`}
                                                                >
                                                                        <!-- Shimmer effect -->
                                                                        <span class="absolute inset-0 -translate-x-full group-hover/btn:translate-x-full transition-transform duration-700 ease-out bg-gradient-to-r from-transparent via-white/20 to-transparent"></span>
                                                                        <!-- Contenu -->
                                                                        <span class="relative flex items-center gap-2.5">
                                                                                Accéder
                                                                                <svg class="w-4 h-4 transition-transform duration-200 group-hover/btn:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5h5m0 0v5m0-5L9 15M5 5h4a2 2 0 012 2v0a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z" />
                                                                                </svg>
                                                                        </span>
                                                                </a>
                                                        </div>
                                                </article>
                                        </div>
                                );
                        })}
                </div>

                <!-- ═══════════════════════════════════════════════════════════════
                     ÉCOSYSTÈME HUB 3D INTERACTIF (WOW EDITION)
                     - Central Hub pulsant avec radar effect
                     - Data particles flow animé
                     - Node glow cascade au hover
                     - Orbital rings autour du hub
                     - Connection lines avec dash animated + glow
                     ═══════════════════════════════════════════════════════════════ -->
                <div class="ecosystem-hub-section mt-20 md:mt-28 observe" style="--d: 0.15s">
                        
                        <!-- ── Header Écosystème Amélioré ─────────────────────────── -->
                        <div class="ecosystem-header text-center mb-12">
                                <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-gradient-to-r from-navy/5 to-periwinkle/10 border border-navy/10 mb-6">
                                        <span class="w-2 h-2 rounded-full bg-green animate-pulse"></span>
                                        <span class="text-xs font-semibold text-navy/80 tracking-wide uppercase">Écosystème Actif & Synchronisé</span>
                                </div>
                                
                                <h3 class="text-2xl md:text-3xl lg:text-4xl font-display font-bold text-navy mb-4">
                                        Un Écosystème <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange via-periwinkle to-green">Intelligent</span> & Interconnecté
                                </h3>
                                
                                <p class="text-gray-text max-w-2xl mx-auto mb-8 leading-relaxed">
                                        Chaque solution communique en temps réel via notre API unifiée. 
                                        Les données circulent fluidement entre les plateformes pour une expérience cohérente.
                                </p>

                                <!-- Badges Tech -->
                                <div class="flex flex-wrap justify-center gap-3 mb-10">
                                        <span class="eco-badge">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                API Unifiée
                                        </span>
                                        <span class="eco-badge">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                                Sync Temps Réel
                                        </span>
                                        <span class="eco-badge">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                                Chiffré AES-256
                                        </span>
                                        <span class="eco-badge">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                                Latence <100ms
                                        </span>
                                </div>
                        </div>

                        <!-- ── Diagramme 3D Interactif ─────────────────────────────── -->
                        <div class="ecosystem-diagram relative max-w-5xl mx-auto" id="ecosystemDiagram">
                                
                                <!-- Background Glow Effects -->
                                <div class="eco-bg-glow eco-bg-glow--center" aria-hidden="true"></div>
                                <div class="eco-bg-glow eco-bg-glow--left" aria-hidden="true"></div>
                                <div class="eco-bg-glow eco-bg-glow--right" aria-hidden="true"></div>

                                <!-- SVG Container pour les connexions et particules -->
                                <svg class="eco-svg absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                                        <defs>
                                                <!-- Gradients pour les lignes -->
                                                <linearGradient id="lineGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
                                                        <stop offset="0%" stopColor="#EE6C1A" />
                                                        <stop offset="100%" stopColor="#6b7fc7" />
                                                </linearGradient>
                                                <linearGradient id="lineGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
                                                        <stop offset="0%" stopColor="#1a8c42" />
                                                        <stop offset="100%" stopColor="#EE6C1A" />
                                                </linearGradient>
                                                <linearGradient id="lineGrad3" x1="0%" y1="0%" x2="100%" y2="0%">
                                                        <stop offset="0%" stopColor="#6b7fc7" />
                                                        <stop offset="100%" stopColor="#1a8c42" />
                                                </linearGradient>
                                                <linearGradient id="lineGradCenter" x1="0%" y1="0%" x2="100%" y2="100%">
                                                        <stop offset="0%" stopColor="#9333ea" />
                                                        <stop offset="50%" stopColor="#6b7fc7" />
                                                        <stop offset="100%" stopColor="#EE6C1A" />
                                                </linearGradient>
                                                <!-- Glow filter -->
                                                <filter id="glowFilter" x="-50%" y="-50%" width="200%" height="200%">
                                                        <feGaussianBlur stdDeviation="3" result="blur"/>
                                                        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                                                </filter>
                                                <filter id="strongGlow" x="-100%" y="-100%" width="300%" height="300%">
                                                        <feGaussianBlur stdDeviation="6" result="blur"/>
                                                        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                                                </filter>
                                        </defs>

                                        <!-- Lignes de connexion principales (avec dash animé) -->
                                        <g class="connection-lines-group">
                                                <!-- SECT → Hub -->
                                                <path d="M 180 140 Q 300 200 500 280" class="eco-connection-line" stroke="url(#lineGrad1)" fill="none" data-from="sect" data-to="hub"/>
                                                <!-- OPUC → Hub -->
                                                <path d="M 500 100 Q 500 180 500 280" class="eco-connection-line" stroke="url(#lineGrad2)" fill="none" data-from="opuc" data-to="hub"/>
                                                <!-- CATS → Hub -->
                                                <path d="M 820 140 Q 700 200 500 280" class="eco-connection-line" stroke="url(#lineGrad3)" fill="none" data-from="cats" data-to="hub"/>
                                                <!-- Hub → ScolaGest -->
                                                <path d="M 500 330 Q 500 380 500 420" class="eco-connection-line" stroke="url(#lineGradCenter)" fill="none" data-from="hub" data-to="scolagest"/>
                                                
                                                <!-- Connexions latérales (inter-solutions) -->
                                                <path d="M 230 120 Q 365 70 500 85" class="eco-connection-line eco-connection-line--secondary" stroke="#6b7fc7" fill="none" opacity="0.3"/>
                                                <path d="M 500 85 Q 635 70 770 120" class="eco-connection-line eco-connection-line--secondary" stroke="#6b7fc7" fill="none" opacity="0.3"/>
                                        </g>

                                        <!-- Particules de données animées (créées via JS) -->
                                        <g class="data-particles-container" id="dataParticles"></g>

                                        <!-- Orbital Rings autour du hub central -->
                                        <g class="orbital-rings" transform="translate(500, 305)">
                                                <ellipse cx="0" cy="0" rx="90" ry="30" class="orbital-ring orbital-ring--1" fill="none" stroke="url(#lineGradCenter)" stroke-width="1" opacity="0.4" transform="rotate(-15)"/>
                                                <ellipse cx="0" cy="0" rx="130" ry="45" class="orbital-ring orbital-ring--2" fill="none" stroke="#6b7fc7" stroke-width="0.8" opacity="0.25" transform="rotate(10)"/>
                                                <ellipse cx="0" cy="0" rx="170" ry="60" class="orbital-ring orbital-ring--3" fill="none" stroke="#EE6C1A" stroke-width="0.5" opacity="0.15" transform="rotate(-5)"/>
                                        </g>

                                        <!-- Radar Sweep Effect sur hub -->
                                        <g class="radar-sweep" transform="translate(500, 305)">
                                                <circle cx="0" cy="0" r="55" fill="none" stroke="#9333ea" stroke-width="2" opacity="0.3"/>
                                                <circle cx="0" cy="0" r="40" fill="none" stroke="#6b7fc7" stroke-width="1" opacity="0.4"/>
                                                <circle cx="0" cy="0" r="25" fill="none" stroke="#EE6C1A" stroke-width="1" opacity="0.5"/>
                                                <path d="M 0 0 L 50 0 A 50 50 0 0 1 35 35 Z" class="radar-cone" fill="url(#lineGradCenter)" opacity="0.15"/>
                                        </g>
                                </svg>

                                <!-- Nœuds des Solutions (HTML overlay pour interactions) -->
                                <div class="eco-nodes-container">
                                        
                                        <!-- SECT Node -->
                                        <div class="eco-node eco-node--sect" data-product="sect" style="--node-color: #EE6C1A; --node-x: 180px; --node-y: 120px;">
                                                <div class="eco-node__ring"></div>
                                                <div class="eco-node__core">
                                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                                                </div>
                                                <div class="eco-node__label">SECT</div>
                                                <div class="eco-node__desc">Évaluation</div>
                                                <div class="eco-node__pulse"></div>
                                        </div>

                                        <!-- OPUC Node -->
                                        <div class="eco-node eco-node--opuc" data-product="opuc" style="--node-color: #1a8c42; --node-x: 500px; --node-y: 80px;">
                                                <div class="eco-node__ring"></div>
                                                <div class="eco-node__core">
                                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                                </div>
                                                <div class="eco-node__label">OPUC</div>
                                                <div class="eco-node__desc">Chantier</div>
                                                <div class="eco-node__pulse"></div>
                                        </div>

                                        <!-- CATS Node -->
                                        <div class="eco-node eco-node--cats" data-product="cats" style="--node-color: #6b7fc7; --node-x: 820px; --node-y: 120px;">
                                                <div class="eco-node__ring"></div>
                                                <div class="eco-node__core">
                                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M19 12v4m0 0v4m-4-4h4"/></svg>
                                                </div>
                                                <div class="eco-node__label">CATS</div>
                                                <div class="eco-node__desc">Présence</div>
                                                <div class="eco-node__pulse"></div>
                                        </div>

                                        <!-- CENTRAL HUB Node -->
                                        <div class="eco-node eco-node--hub" data-product="hub" style="--node-color: #9333ea; --node-x: 500px; --node-y: 305px;">
                                                <div class="eco-node__hub-rings">
                                                        <div class="hub-ring hub-ring--outer"></div>
                                                        <div class="hub-ring hub-ring--middle"></div>
                                                        <div class="hub-ring hub-ring--inner"></div>
                                                </div>
                                                <div class="eco-node__core eco-node__core--hub">
                                                        <span class="font-bold text-sm">FTCI</span>
                                                </div>
                                                <div class="eco-node__label eco-node__label--hub">HUB CENTRAL</div>
                                                <div class="eco-node__radar"></div>
                                                <div class="eco-node__pulse eco-node__pulse--hub"></div>
                                        </div>

                                        <!-- ScolaGest Node -->
                                        <div class="eco-node eco-node--scolagest" data-product="scolagest" style="--node-color: #9333ea; --node-x: 500px; --node-y: 430px;">
                                                <div class="eco-node__ring"></div>
                                                <div class="eco-node__core">
                                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                </div>
                                                <div class="eco-node__label">ScolaGest</div>
                                                <div class="eco-node__desc">Finance</div>
                                                <div class="eco-node__pulse"></div>
                                        </div>
                                </div>

                                <!-- Cascade Glow Effect Container -->
                                <div class="cascade-glow" id="cascadeGlow" aria-hidden="true"></div>
                        </div>

                        <!-- ── Stats Bar ────────────────────────────────────────────── -->
                        <div class="stats-bar mt-12 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
                                <div class="stat-item">
                                        <div class="stat-icon stat-icon--sync">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                        </div>
                                        <div class="stat-text">
                                                <span class="stat-value">Auto</span>
                                                <span class="stat-label">Sync</span>
                                        </div>
                                </div>
                                <div class="stat-item">
                                        <div class="stat-icon stat-icon--secure">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                        </div>
                                        <div class="stat-text">
                                                <span class="stat-value">AES-256</span>
                                                <span class="stat-label">Crypto</span>
                                        </div>
                                </div>
                                <div class="stat-item">
                                        <div class="stat-icon stat-icon--fast">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                        </div>
                                        <div class="stat-text">
                                                <span class="stat-value">&lt;100ms</span>
                                                <span class="stat-label">Latence</span>
                                        </div>
                                </div>
                                <div class="stat-item">
                                        <div class="stat-icon stat-icon--api">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        </div>
                                        <div class="stat-text">
                                                <span class="stat-value">REST</span>
                                                <span class="stat-label">API</span>
                                        </div>
                                </div>
                        </div>
                </div>
        </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     ÉCOSYSTÈME HUB 3D - STYLES WOW EDITION
     ═══════════════════════════════════════════════════════════════════════════ */
  
  /* Container principal */
  .ecosystem-hub-section {
    position: relative;
    padding: 2rem 0 3rem;
  }

  /* Badges Tech */
  .eco-badge {
    display: inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold
               bg-white border border-navy/8 text-navy/70 shadow-sm
               transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .eco-badge:hover {
    border-color: var(--color-orange, #EE6C1A);
    color: var(--color-navy, #0f1e3d);
    box-shadow: 0 4px 20px -4px rgba(238, 108, 26, 0.25);
    transform: translateY(-2px);
  }
  .eco-badge svg {
    opacity: 0.6;
  }
  .eco-badge:hover svg {
    opacity: 1;
  }

  /* Diagramme container */
  .ecosystem-diagram {
    height: 520px;
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  /* Background Glows */
  .eco-bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
    pointer-events: none;
    animation: ecoGlowPulse 8s ease-in-out infinite alternate;
  }
  .eco-bg-glow--center {
    width: 300px; height: 300px;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(147, 51, 234, 0.5), transparent 70%);
  }
  .eco-bg-glow--left {
    width: 200px; height: 200px;
    top: 15%; left: 10%;
    background: radial-gradient(circle, rgba(238, 108, 26, 0.4), transparent 70%);
    animation-delay: -2s;
  }
  .eco-bg-glow--right {
    width: 200px; height: 200px;
    top: 15%; right: 10%;
    background: radial-gradient(circle, rgba(107, 127, 199, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  @keyframes ecoGlowPulse {
    0% { transform: translate(-50%, -50%) scale(1); opacity: 0.3; }
    100% { transform: translate(-50%, -50%) scale(1.15); opacity: 0.5; }
  }

  /* SVG Styles */
  .eco-svg {
    z-index: 1;
  }

  /* Connection Lines animées */
  .eco-connection-line {
    stroke-width: 2;
    stroke-dasharray: 8 12;
    stroke-dashoffset: 0;
    filter: url(#glowFilter);
    animation: dataFlowLine 2s linear infinite;
  }
  .eco-connection-line--secondary {
    stroke-width: 1;
    stroke-dasharray: 4 8;
    animation-duration: 3s;
    animation-direction: reverse;
  }

  @keyframes dataFlowLine {
    to { stroke-dashoffset: -40; }
  }

  /* Orbital Rings */
  .orbital-ring {
    animation: orbitalRotate 20s linear infinite;
  }
  .orbital-ring--2 {
    animation-duration: 28s;
    animation-direction: reverse;
  }
  .orbital-ring--3 {
    animation-duration: 36s;
  }

  @keyframes orbitalRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Radar Sweep Effect */
  .radar-cone {
    transform-origin: center;
    animation: radarSweep 3s linear infinite;
  }

  @keyframes radarSweep {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Nodes Container */
  .eco-nodes-container {
    position: absolute;
    inset: 0;
    z-index: 10;
  }

  /* Individual Node */
  .eco-node {
    position: absolute;
    left: var(--node-x);
    top: var(--node-y);
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }
  .eco-node:hover {
    z-index: 20;
    transform: translate(-50%, -50%) scale(1.12);
  }

  /* Node Ring (orbit extérieur) */
  .eco-node__ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1.5px solid var(--node-color);
    opacity: 0.3;
    transition: all 0.4s ease;
  }
  .eco-node:hover .eco-node__ring {
    inset: -14px;
    opacity: 0.6;
    border-width: 2px;
    animation: nodeRingPulse 1.5s ease-in-out infinite;
  }

  @keyframes nodeRingPulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.1); opacity: 0.3; }
  }

  /* Node Core (cercle central) */
  .eco-node__core {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--node-color), color-mix(in srgb, var(--node-color) 60%, black));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
      0 4px 20px -4px var(--node-color),
      inset 0 1px 0 rgba(255,255,255,0.2);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 2;
  }
  .eco-node:hover .eco-node__core {
    box-shadow: 
      0 8px 40px -4px var(--node-color),
      0 0 30px -5px var(--node-color),
      inset 0 1px 0 rgba(255,255,255,0.3);
  }

  /* Hub Core spécial */
  .eco-node__core--hub {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, #9333ea 0%, #6b7fc7 50%, #EE6C1A 100%);
    font-size: 11px;
    letter-spacing: 0.5px;
  }

  /* Node Label */
  .eco-node__label {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-navy, #0f1e3d);
    white-space: nowrap;
    opacity: 0.8;
    transition: all 0.3s ease;
  }
  .eco-node:hover .eco-node__label {
    opacity: 1;
    transform: translateX(-50%) translateY(2px);
  }
  .eco-node__label--hub {
    font-size: 11px;
    letter-spacing: 1px;
    top: calc(100% + 14px);
    color: #9333ea;
  }

  /* Node Description */
  .eco-node__desc {
    position: absolute;
    top: calc(100% + 26px);
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    font-weight: 500;
    color: var(--node-color);
    white-space: nowrap;
    opacity: 0;
