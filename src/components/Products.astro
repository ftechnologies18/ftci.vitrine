---
// Products section showcasing FTCI's 4 SaaS solutions
---

<section id="solutions" class="py-20 md:py-32 bg-white relative overflow-hidden">
	<!-- Tech Grid Background -->
	<div 
		class="absolute inset-0 -z-10 opacity-10"
		style={{
			backgroundImage: 'url(/manus-storage/ftci-tech-grid_9a960dd7.png)',
			backgroundSize: '200px 200px',
		}}
	></div>

	<div class="container">
		<!-- Section Header -->
		<div class="text-center mb-16 observe">
			<h2 class="text-4xl md:text-5xl font-bold text-navy mb-4">
				Nos Solutions
			</h2>
			<p class="text-lg text-gray-text max-w-2xl mx-auto">
				Quatre produits SaaS conçus pour transformer les institutions africaines
			</p>
		</div>

		<!-- Products Grid -->
		<div class="grid md:grid-cols-2 gap-8 mb-12">
			<!-- SECT -->
			<div class="observe group relative bg-light-bg border-2 border-transparent hover:border-orange rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:scale-105">
				<!-- Glow effect on hover -->
				<div class="absolute inset-0 bg-gradient-to-br from-orange/0 to-orange/0 group-hover:from-orange/10 group-hover:to-orange/5 rounded-2xl transition-all duration-300"></div>
				
				<div class="relative z-10">
					<div class="w-16 h-16 bg-gradient-to-br from-orange to-orange-600 rounded-xl flex items-center justify-center mb-4 group-hover:shadow-lg group-hover:shadow-orange/30 transition-all duration-300">
						<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5h.01v.01H12v-.01z"></path>
						</svg>
					</div>
					<h3 class="text-2xl font-bold text-navy mb-3">SECT</h3>
					<p class="text-gray-text mb-4">
						Plateforme d'évaluation par IA pour universités africaines. Génération de sujets, surveillance anti-fraude, correction automatique.
					</p>
					<a 
						href="https://sect.ftci.fr"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 text-orange font-semibold hover:gap-3 transition-all duration-200"
					>
						Accéder à SECT
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
						</svg>
					</a>
				</div>
			</div>

			<!-- OPUC -->
			<div class="observe group relative bg-light-bg border-2 border-transparent hover:border-green rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:scale-105">
				<div class="absolute inset-0 bg-gradient-to-br from-green/0 to-green/0 group-hover:from-green/10 group-hover:to-green/5 rounded-2xl transition-all duration-300"></div>
				
				<div class="relative z-10">
					<div class="w-16 h-16 bg-gradient-to-br from-green to-green-600 rounded-xl flex items-center justify-center mb-4 group-hover:shadow-lg group-hover:shadow-green/30 transition-all duration-300">
						<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
						</svg>
					</div>
					<h3 class="text-2xl font-bold text-navy mb-3">OPUC</h3>
					<p class="text-gray-text mb-4">
						Outil de Pilotage Unifié de Chantier. Gestion BTP complète : pointage, budgets, stocks, documents.
					</p>
					<a 
						href="https://opuc.ftci.fr"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 text-green font-semibold hover:gap-3 transition-all duration-200"
					>
						Accéder à OPUC
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
						</svg>
					</a>
				</div>
			</div>

			<!-- CATS -->
			<div class="observe group relative bg-light-bg border-2 border-transparent hover:border-periwinkle rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:scale-105">
				<div class="absolute inset-0 bg-gradient-to-br from-periwinkle/0 to-periwinkle/0 group-hover:from-periwinkle/10 group-hover:to-periwinkle/5 rounded-2xl transition-all duration-300"></div>
				
				<div class="relative z-10">
					<div class="w-16 h-16 bg-gradient-to-br from-periwinkle to-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:shadow-lg group-hover:shadow-periwinkle/30 transition-all duration-300">
						<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
					</div>
					<h3 class="text-2xl font-bold text-navy mb-3">CATS</h3>
					<p class="text-gray-text mb-4">
						Campus Attendance Tracking System. Pointage de présence par QR code pour campus universitaires.
					</p>
					<a 
						href="https://cats.ftci.fr"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 text-periwinkle font-semibold hover:gap-3 transition-all duration-200"
					>
						Accéder à CATS
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
						</svg>
					</a>
				</div>
			</div>

			<!-- ScolaGest -->
			<div class="observe group relative bg-light-bg border-2 border-transparent hover:border-orange rounded-2xl p-8 transition-all duration-300 hover:shadow-lg hover:scale-105">
				<div class="absolute inset-0 bg-gradient-to-br from-orange/0 to-orange/0 group-hover:from-orange/10 group-hover:to-orange/5 rounded-2xl transition-all duration-300"></div>
				
				<div class="relative z-10">
					<div class="w-16 h-16 bg-gradient-to-br from-orange to-orange-600 rounded-xl flex items-center justify-center mb-4 group-hover:shadow-lg group-hover:shadow-orange/30 transition-all duration-300">
						<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</div>
					<h3 class="text-2xl font-bold text-navy mb-3">ScolaGest</h3>
					<p class="text-gray-text mb-4">
						Gestion et caisse scolaire multi-établissements. Encaissement, échéanciers, Mobile Money, comptabilité.
					</p>
					<a 
						href="https://scolagest.ftci.fr"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 text-orange font-semibold hover:gap-3 transition-all duration-200"
					>
						Accéder à ScolaGest
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>

		<!-- Connected Ecosystem Visualization -->
		<div class="observe mt-16 pt-12 border-t border-gray-200">
			<p class="text-center text-gray-text mb-8">
				<strong>Un écosystème intégré</strong> pour transformer votre institution
			</p>
			<svg class="w-full max-w-2xl mx-auto h-32" viewBox="0 0 400 120" preserveAspectRatio="xMidYMid meet">
				<!-- Connection lines -->
				<line x1="50" y1="60" x2="350" y2="60" stroke="#6B7FC7" stroke-width="2" opacity="0.3"/>
				<circle cx="50" cy="60" r="8" fill="#EE6C1A"/>
				<circle cx="150" cy="60" r="8" fill="#1E9E4F"/>
				<circle cx="250" cy="60" r="8" fill="#6B7FC7"/>
				<circle cx="350" cy="60" r="8" fill="#EE6C1A"/>
				
				<!-- Labels -->
				<text x="50" y="85" text-anchor="middle" class="text-xs font-semibold fill-navy">SECT</text>
				<text x="150" y="85" text-anchor="middle" class="text-xs font-semibold fill-navy">OPUC</text>
				<text x="250" y="85" text-anchor="middle" class="text-xs font-semibold fill-navy">CATS</text>
				<text x="350" y="85" text-anchor="middle" class="text-xs font-semibold fill-navy">ScolaGest</text>
			</svg>
		</div>
	</div>
</section>

<style>
	.observe {
		opacity: 0;
		animation: slideUp 0.6s ease-out forwards;
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.observe {
			animation: none;
			opacity: 1;
		}
	}
</style>
