  }
  .stat-item:hover {
    background: white;
    box-shadow: 0 8px 30px -10px rgba(0, 0, 0, 0.1);
    transform: translateY(-3px);
  }

  .stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }
  .stat-icon--sync { background: linear-gradient(135deg, #1a8c42, #22c55e); }
  .stat-icon--secure { background: linear-gradient(135deg, #0f1e3d, #1e3a5f); }
  .stat-icon--fast { background: linear-gradient(135deg, #EE6C1A, #f97316); }
  .stat-icon--api { background: linear-gradient(135deg, #6b7fc7, #818cf8); }

  .stat-text {
    text-align: center;
  }
  .stat-value {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-navy, #0f1e3d);
  }
  .stat-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-gray-text, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .ecosystem-diagram {
      height: 450px;
      transform: scale(0.85);
      transform-origin: center top;
    }
    .eco-node__core {
      width: 44px;
      height: 44px;
    }
    .eco-node__core svg {
      width: 20px;
      height: 20px;
    }
    .eco-node__label {
      font-size: 11px;
    }
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      padding: 1rem;
    }
  }

  @media (max-width: 480px) {
    .ecosystem-diagram {
      transform: scale(0.65);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .eco-connection-line,
    .orbital-ring,
    .radar-cone,
    .eco-node__pulse,
    .hub-ring,
    .eco-node__radar,
    .eco-bg-glow {
      animation: none !important;
    }
    .eco-bg-glow {
      opacity: 0.2;
    }
  }
</style>

<script>
        // ── Detection : mobile/touch + reduced-motion ───────────────────────────
        const isTouch = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!isTouch && !reduced) {
                // ════════════════════════════════════════════════════════════════════
                // ENHANCED TILT 3D (Specs: perspective 800px, ±8deg, translateY -4px)
                // Transform: perspective(800px) rotateY(x*8deg) rotateX(-y*8deg) translateY(-4px)
                // Return: cubic-bezier(0.16, 1, 0.3, 1), 350ms
                // ════════════════════════════════════════════════════════════════════
                document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
                        const stage = card.closest('.tilt-stage') as HTMLElement | null;
                        if (!stage) return;

                        let rafId: number | null = null;
                        let pendingRX = 0;
                        let pendingRY = 0;

                        const apply = () => {
                                // Enhanced tilt: perspective(800px) rotateY(x*8deg) rotateX(-y*8deg) translateY(-4px)
                                card.style.transform = `
                                        perspective(800px)
                                        rotateY(${pendingRY.toFixed(2)}deg)
                                        rotateX(${pendingRX.toFixed(2)}deg)
                                        translateY(-4px)
                                `;
                                rafId = null;
                        };

                        const schedule = () => {
                                if (rafId === null) rafId = requestAnimationFrame(apply);
                        };

                        stage.addEventListener(
                                'pointermove',
                                (e: PointerEvent) => {
                                        const r = stage.getBoundingClientRect();
                                        const px = (e.clientX - r.left) / r.width - 0.5; // -0.5 → 0.5
                                        const py = (e.clientY - r.top) / r.height - 0.5;
                                        // ±8° max → multiplier 16 (0.5 × 16 = 8)
                                        pendingRY = px * 16;
                                        pendingRX = -py * 16;
                                        schedule();
                                },
                                { passive: true },
                        );

                        stage.addEventListener('pointerleave', () => {
                                pendingRX = 0;
                                pendingRY = 0;
                                schedule();
                        });
                });

                // ════════════════════════════════════════════════════════════════════
                // ENHANCED MAGNETIC BUTTONS
                // translate(deltaX * 0.18, deltaY * 0.3), max 15-20px displacement
                // Return: cubic-bezier(0.16, 1, 0.3, 1), 250ms
                // ════════════════════════════════════════════════════════════════════
                const MAX_DISPLACEMENT = 18; // Max 18px (within 15-20px range)

                document.querySelectorAll<HTMLElement>('.magnetic-btn').forEach((btn) => {
                        let rafId: number | null = null;
                        let pendingX = 0;
                        let pendingY = 0;

                        const apply = () => {
                                btn.style.transform = `translate(${pendingX.toFixed(1)}px, ${pendingY.toFixed(1)}px)`;
                                rafId = null;
                        };

                        const schedule = () => {
                                if (rafId === null) rafId = requestAnimationFrame(apply);
                        };

                        btn.addEventListener(
                                'pointermove',
                                (e: PointerEvent) => {
                                        const rect = btn.getBoundingClientRect();
                                        const centerX = rect.left + rect.width / 2;
                                        const centerY = rect.top + rect.height / 2;
                                        
                                        let deltaX = e.clientX - centerX;
                                        let deltaY = e.clientY - centerY;
                                        
                                        // Apply multipliers: X * 0.18, Y * 0.3
                                        let translateX = deltaX * 0.18;
                                        let translateY = deltaY * 0.3;
                                        
                                        // Clamp to max displacement
                                        translateX = Math.max(-MAX_DISPLACEMENT, Math.min(MAX_DISPLACEMENT, translateX));
                                        translateY = Math.max(-MAX_DISPLACEMENT, Math.min(MAX_DISPLACEMENT, translateY));
                                        
                                        pendingX = translateX;
                                        pendingY = translateY;
                                        schedule();
                                },
                                { passive: true },
                        );

                        btn.addEventListener('pointerleave', () => {
                                pendingX = 0;
                                pendingY = 0;
                                schedule();
                        });
                });

                // ════════════════════════════════════════════════════════════════════
                // ÉCOSYSTÈME HUB 3D - INTERACTIONS WOW
                // - Data particles flow animé
                // - Node glow cascade au hover
                // - 3D parallax sur le diagramme
                // ════════════════════════════════════════════════════════════════════
                
                const ecosystemDiagram = document.getElementById('ecosystemDiagram');
                const dataParticlesContainer = document.getElementById('dataParticles');
                const cascadeGlow = document.getElementById('cascadeGlow');
                
                if (ecosystemDiagram && dataParticlesContainer) {
                        
                        // ── Data Particles Flow Animation ──────────────────────────
                        const particlePaths = [
                                { start: { x: 180, y: 140 }, end: { x: 500, y: 280 }, color: '#EE6C1A', delay: 0 },
                                { start: { x: 500, y: 100 }, end: { x: 500, y: 280 }, color: '#1a8c42', delay: 0.5 },
                                { start: { x: 820, y: 140 }, end: { x: 500, y: 280 }, color: '#6b7fc7', delay: 1 },
                                { start: { x: 500, y: 330 }, end: { x: 500, y: 420 }, color: '#9333ea', delay: 1.5 },
                        ];
                        
                        const particles: Array<{
                                el: SVGCircleElement;
                                path: typeof particlePaths[0];
                                progress: number;
                                speed: number;
                        }> = [];
                        
                        // Créer les particules SVG
                        particlePaths.forEach((path, i) => {
                                for (let p = 0; p < 3; p++) {
                                        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                                        circle.setAttribute('r', '3');
                                        circle.setAttribute('fill', path.color);
                                        circle.setAttribute('opacity', '0.7');
                                        circle.style.filter = 'url(#glowFilter)';
                                        dataParticlesContainer.appendChild(circle);
                                        
                                        particles.push({
                                                el: circle,
                                                path: path,
                                                progress: (p / 3) + Math.random() * 0.2,
                                                speed: 0.004 + Math.random() * 0.003,
                                        });
                                }
                        });
                        
                        // Animer les particules
                        function animateParticles() {
                                particles.forEach(p => {
                                        p.progress += p.speed;
                                        if (p.progress > 1) {
                                                p.progress = 0;
                                                // Variation subtile de la vitesse
                                                p.speed = 0.004 + Math.random() * 0.003;
                                        }
                                        
                                        // Interpolation quadratique pour courbe
                                        const t = p.progress;
                                        const x = (1-t)*(1-t)*p.path.start.x + 2*(1-t)*t*((p.path.start.x + p.path.end.x)/2) + t*t*p.path.end.x;
                                        const y = (1-t)*(1-t)*p.path.start.y + 2*(1-t)*t*((p.path.start.y + p.path.end.y)/2 + 30) + t*t*p.path.end.y;
                                        
                                        p.el.setAttribute('cx', String(x));
                                        p.el.setAttribute('cy', String(y));
                                        
                                        // Fade in/out aux extrémités
                                        const opacity = t < 0.1 ? t * 10 : (t > 0.9 ? (1-t) * 10 : 0.7);
                                        p.el.setAttribute('opacity', String(opacity));
                                });
                                
                                requestAnimationFrame(animateParticles);
                        }
                        
                        animateParticles();
                        
                        // ── Node Glow Cascade Effect ───────────────────────────────
                        const ecoNodes = document.querySelectorAll<HTMLElement>('.eco-node');
                        
                        ecoNodes.forEach(node => {
                                node.addEventListener('mouseenter', () => {
                                        if (!cascadeGlow || !ecosystemDiagram) return;
                                        
                                        const rect = node.getBoundingClientRect();
                                        const diagramRect = ecosystemDiagram.getBoundingClientRect();
                                        
                                        // Positionner le cascade glow
                                        const x = rect.left - diagramRect.left + rect.width / 2;
                                        const y = rect.top - diagramRect.top + rect.height / 2;
                                        
                                        cascadeGlow.style.left = `${x}px`;
                                        cascadeGlow.style.top = `${y}px`;
                                        cascadeGlow.style.transform = 'translate(-50%, -50%)';
                                        
                                        // Trigger animation
                                        cascadeGlow.classList.remove('is-active');
                                        void cascadeGlow.offsetWidth; // Force reflow
                                        cascadeGlow.classList.add('is-active');
                                        
                                        // Highlight connection lines from this node
                                        const productId = node.dataset.product;
                                        document.querySelectorAll<SVGPathElement>('.eco-connection-line').forEach(line => {
                                                if (line.dataset.from === productId || line.dataset.to === productId) {
                                                        line.style.strokeWidth = '3';
                                                        line.style.opacity = '1';
                                                        setTimeout(() => {
                                                                line.style.strokeWidth = '';
                                                                line.style.opacity = '';
                                                        }, 800);
                                                }
                                        });
                                });
                                
                                node.addEventListener('mouseleave', () => {
                                        if (cascadeGlow) {
                                                cascadeGlow.classList.remove('is-active');
                                        }
                                });
                        });
                        
                        // ── 3D Parallax on Diagram Mouse Move ─────────────────────
                        let parallaxRaf: number | null = null;
                        let targetRotateX = 0;
                        let targetRotateY = 0;
                        let currentRotateX = 0;
                        let currentRotateY = 0;
                        
                        ecosystemDiagram.addEventListener('pointermove', (e: PointerEvent) => {
                                const rect = ecosystemDiagram.getBoundingClientRect();
                                const centerX = rect.left + rect.width / 2;
                                const centerY = rect.top + rect.height / 2;
                                
                                // Calculate rotation based on mouse position
                                targetRotateY = ((e.clientY - centerY) / rect.height) * 8; // ±8deg
                                targetRotateX = ((e.clientX - centerX) / rect.width) * -8; // ±8deg
                                
                                if (!parallaxRaf) {
                                        parallaxRaf = requestAnimationFrame(applyParallax);
                                }
                        }, { passive: true });
                        
                        ecosystemDiagram.addEventListener('pointerleave', () => {
                                targetRotateX = 0;
                                targetRotateY = 0;
                                if (!parallaxRaf) {
                                        parallaxRaf = requestAnimationFrame(applyParallax);
                                }
                        });
                        
                        function applyParallax() {
                                // Smooth interpolation (lerp)
                                currentRotateX += (targetRotateX - currentRotateX) * 0.08;
                                currentRotateY += (targetRotateY - currentRotateY) * 0.08;
                                
                                // Apply to nodes container
                                const nodesContainer = ecosystemDiagram.querySelector('.eco-nodes-container') as HTMLElement;
                                if (nodesContainer) {
                                        nodesContainer.style.transform = `
                                                translateZ(20px)
                                                rotateX(${currentRotateY}deg)
                                                rotateY(${currentRotateX}deg)
                                        `;
                                }
                                
                                // Continue or stop animation
                                const isMoving = Math.abs(targetRotateX - currentRotateX) > 0.01 ||
                                                 Math.abs(targetRotateY - currentRotateY) > 0.01;
                                
                                if (isMoving) {
                                        parallaxRaf = requestAnimationFrame(applyParallax);
                                } else {
                                        parallaxRaf = null;
                                }
                        }
                }
        }
</script>
