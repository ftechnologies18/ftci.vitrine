---
// Products section showcasing FTCI's 4 SaaS solutions
// Cahier des charges 6.2: tilt 3D + halo lumineux | 6.4: lignes de connexion animées
// Skills: Brand Book (tilt ±2.2°), Emil (transitions not keyframes for interactive), Stagger
import { products, productUrls, accentColorClasses } from '../data/products';
---

<section id="solutions" class="py-20 md:py-32 bg-white relative overflow-hidden">
	<!-- Tech Grid Background (cahier des charges 6.4: motif circuit) -->
	<div
		class="absolute inset-0 -z-10 opacity-[0.08]"
		style={{
			backgroundImage: 'url(/manus-storage/ftci-tech-grid_9a960dd7.png)',
			backgroundSize: '200px 200px',
		}}
	></div>

	<div class="container">
		<!-- Section Header -->
		<div class="text-center mb-16 observe">
			<h2 class="text-4xl md:text-5xl font-bold text-navy mb-4">
				Nos Solutions
			</h2>
			<p class="text-lg text-gray-text max-w-2xl mx-auto">
				Quatre produits SaaS conçus pour transformer les institutions africaines
			</p>
		</div>

		<!-- Products Grid with Tilt 3D (cahier des charges 6.2) -->
		<div class="grid md:grid-cols-2 gap-8 mb-16">
			{products.map((product, idx) => {
				const accent = accentColorClasses[product.accentColor];
				return (
					<div
						class="tilt-stage observe"
						style={`--d:${idx};`}
					>
						<div
							class="tilt-card group relative bg-light-bg border-2 border-transparent rounded-2xl p-8 transition-all duration-300 hover:shadow-xl"
							data-tilt
						>
							<!-- Halo glow (cahier des charges 6.2: halo orange/vert) -->
							<div class={`halo-glow absolute inset-0 rounded-2xl pointer-events-none ${accent.bg === 'bg-orange' ? 'shadow-[0_0_40px_rgba(238,108,26,0.25)]' : accent.bg === 'bg-green' ? 'shadow-[0_0_40px_rgba(30,158,79,0.25)]' : 'shadow-[0_0_40px_rgba(107,127,199,0.25)]'}`}></div>

							<!-- Inner content (preserves depth on tilt) -->
							<div class="relative z-10" style="transform: translateZ(40px);">
								<a href={productUrls[product.slug]} class="block">
									<div class={`w-16 h-16 ${accent.bg} rounded-xl flex items-center justify-center mb-4 transition-all duration-300 group-hover:scale-110`}>
										<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={product.iconPath}></path>
										</svg>
									</div>
									<h3 class="text-2xl font-bold text-navy mb-3 group-hover:text-orange transition-colors">{product.name}</h3>
									<p class="text-gray-text mb-4">{product.description}</p>
								</a>

								<!-- Action links -->
								<div class="flex flex-wrap items-center gap-4">
									<a
										href={productUrls[product.slug]}
										class={`inline-flex items-center gap-2 ${accent.text} font-semibold hover:gap-3 transition-all duration-200`}
									>
										En savoir plus
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
										</svg>
									</a>
									{product.externalUrl && (
										<a
											href={product.externalUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-1.5 text-sm text-gray-text hover:text-navy transition-colors"
											aria-label={`Accéder à la plateforme ${product.name} (nouvel onglet)`}
										>
											Accéder à la plateforme
											<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
											</svg>
										</a>
									)}
								</div>
							</div>
						</div>
					</div>
				);
			})}
		</div>

		<!-- Connected Ecosystem Visualization (cahier des charges 6.4) -->
		<div class="observe mt-16 pt-12 border-t border-gray-200">
			<p class="text-center text-gray-text mb-8">
				<strong>Un écosystème intégré</strong> pour transformer votre institution
			</p>
			<svg
				class="w-full max-w-2xl mx-auto h-32"
				viewBox="0 0 400 120"
				preserveAspectRatio="xMidYMid meet"
				role="img"
				aria-label="Écosystème FTCI : SECT, OPUC, CATS et ScolaGest interconnectés"
			>
				<!-- Connection lines animated (cahier des charges 6.4) -->
				<line x1="50" y1="60" x2="150" y2="60" stroke="#6B7FC7" stroke-width="2" opacity="0.4" class="connection-line"/>
				<line x1="150" y1="60" x2="250" y2="60" stroke="#1E9E4F" stroke-width="2" opacity="0.4" class="connection-line"/>
				<line x1="250" y1="60" x2="350" y2="60" stroke="#EE6C1A" stroke-width="2" opacity="0.4" class="connection-line"/>

				<!-- Product nodes with pulse -->
				<circle cx="50" cy="60" r="8" fill="#EE6C1A">
					<animate attributeName="r" values="8;10;8" dur="3s" repeatCount="indefinite"/>
				</circle>
				<circle cx="150" cy="60" r="8" fill="#1E9E4F">
					<animate attributeName="r" values="8;10;8" dur="3s" begin="0.5s" repeatCount="indefinite"/>
				</circle>
				<circle cx="250" cy="60" r="8" fill="#6B7FC7">
					<animate attributeName="r" values="8;10;8" dur="3s" begin="1s" repeatCount="indefinite"/>
				</circle>
				<circle cx="350" cy="60" r="8" fill="#EE6C1A">
					<animate attributeName="r" values="8;10;8" dur="3s" begin="1.5s" repeatCount="indefinite"/>
				</circle>

				<!-- Labels -->
				<text x="50" y="85" text-anchor="middle" class="text-xs font-semibold fill-navy">SECT</text>
				<text x="150" y="85" text-anchor="middle" class="text-xs font-semibold fill-navy">OPUC</text>
				<text x="250" y="85" text-anchor="middle" class="text-xs font-semibold fill-navy">CATS</text>
				<text x="350" y="85" text-anchor="middle" class="text-xs font-semibold fill-navy">ScolaGest</text>
			</svg>
		</div>
	</div>
</section>

<script>
	// === Tilt 3D effect (cahier des charges 6.2) ===
	// Brand Book Generator: ±2.2° max — subtle and pro
	// Apple Design: continuous tracking, interruptible via CSS transitions
	// Emil Design: transitions (not keyframes) for interactive elements
	const tiltCards = document.querySelectorAll<HTMLElement>('[data-tilt]');

	tiltCards.forEach((card) => {
		card.addEventListener('pointermove', (e) => {
			const rect = card.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			const centerX = rect.width / 2;
			const centerY = rect.height / 2;
			// Normalize -1 to 1, then multiply by max 2.2 degrees
			const rotateY = ((x - centerX) / centerX) * 2.2;
			const rotateX = -((y - centerY) / centerY) * 2.2;
			card.style.transform = `rotateY(${rotateY}deg) rotateX(${rotateX}deg) scale(1.02)`;
		});

		card.addEventListener('pointerleave', () => {
			// Apple Design: transition handles the return from current value
			card.style.transform = '';
		});
	});
</script>

<style>
	.observe {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
	}

	.observe.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.observe {
			opacity: 1;
			transform: none;
			transition: opacity 0.2s ease;
		}
		.connection-line {
			animation: none !important;
		}
	}

	/* Mobile: disable tilt for performance (cahier des charges 6.5) */
	@media (max-width: 767px) {
		[data-tilt] {
			transform: none !important;
		}
	}
</style>
