  }
  .eco-node:hover .eco-node__desc {
    opacity: 1;
    transform: translateX(-50%) translateY(2px);
  }

  /* Node Pulse Effect */
  .eco-node__pulse {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: var(--node-color);
    opacity: 0;
    animation: nodePulse 3s ease-out infinite;
    z-index: 0;
  }

  @keyframes nodePulse {
    0% { transform: scale(1); opacity: 0.4; }
        100% { transform: scale(2.5); opacity: 0; }
  }

  /* Hub Special Elements */
  .eco-node__hub-rings {
    position: absolute;
    inset: -20px;
    pointer-events: none;
  }
  .hub-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid;
    border-color: var(--node-color);
    opacity: 0;
    animation: hubRingExpand 4s ease-out infinite;
  }
  .hub-ring--outer {
    inset: 0;
    animation-delay: 0s;
  }
  .hub-ring--middle {
    inset: 10px;
    animation-delay: 1.3s;
  }
  .hub-ring--inner {
    inset: 20px;
    animation-delay: 2.6s;
  }

  @keyframes hubRingExpand {
    0% { transform: scale(0.8); opacity: 0.6; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  /* Hub Radar */
  .eco-node__radar {
    position: absolute;
    inset: -30px;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: var(--node-color);
    animation: hubRadarSpin 4s linear infinite;
    opacity: 0.4;
  }

  @keyframes hubRadarSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Hub Pulse Spécial */
  .eco-node__pulse--hub {
    animation-duration: 2.5s;
    background: linear-gradient(135deg, #9333ea, #EE6C1A);
  }

  /* Cascade Glow Effect */
  .cascade-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    z-index: 5;
    transition: opacity 0.3s ease;
    background: radial-gradient(circle, rgba(147, 51, 234, 0.4), transparent 60%);
    filter: blur(20px);
  }
  .cascade-glow.is-active {
    opacity: 1;
    animation: cascadeExpand 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes cascadeExpand {
    0% { width: 0; height: 0; }
    100% { width: 400px; height: 400px; }
  }

  /* Stats Bar */
  .stats-bar {
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, rgba(15, 30, 61, 0.03), rgba(107, 127, 199, 0.05));
    border-radius: 20px;
    border: 1px solid rgba(15, 30, 61, 0.06);
    backdrop-filter: blur(10px);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 14px;
