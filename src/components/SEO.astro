---
/**
 * Composant SEO réutilisable.
 *
 * Usage :
 *   <SEO
 *     title="SECT — Plateforme d'évaluation par IA"
 *     description="..."
 *     canonical="/solutions/sect"
 *     ogImage="/og/sect.png"
 *     schema={productSchemaObject}
 *     noindex={false}
 *   />
 *
 * Génère : title, meta description, canonical, Open Graph, Twitter Card,
 * robots, et injecte un JSON-LD schema.org si fourni.
 */

import { safeJsonStringify } from '../lib/sanitize';

export interface Props {
	title: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogType?: 'website' | 'article' | 'product';
	schema?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
	keywords?: string[];
}

const {
	title,
	description = "Freelance Technologies Côte d'Ivoire (FTCI) — Entreprise de Services du Numérique (ESN) basée à Abidjan. Conseil, développement, infrastructure IT, formation + 4 solutions SaaS (SECT, OPUC, CATS, ScolaGest) pour le marché africain.",
	canonical,
	ogImage = '/og-default.png',
	ogType = 'website',
	schema,
	noindex = false,
	keywords = [],
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ftci.fr';
const canonicalUrl = canonical
	? new URL(canonical, siteUrl).toString()
	: new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();

// JSON-LD injection
const jsonLd = schema ? safeJsonStringify(schema) : null;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<meta name="author" content="FTCI — Freelance Technologies Côte d'Ivoire" />
<meta name="language" content="French" />
<meta name="geo.region" content="CI" />
<meta name="geo.placename" content="Abidjan, Côte d'Ivoire" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="FTCI" />
<meta property="og:locale" content="fr_FR" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Theme color (mobile browser UI) -->
<meta name="theme-color" content="#0F1E3D" />

<!-- JSON-LD structured data -->
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
