---
// Contact section with form and company information
---

<section id="contact" class="py-20 md:py-32 bg-light-bg relative overflow-hidden">
	<div class="container">
		<div class="max-w-5xl mx-auto">
			<!-- Section Header -->
			<div class="text-center mb-16 observe">
				<h2 class="text-4xl md:text-5xl font-bold text-navy mb-4">
					Nous Contacter
				</h2>
				<p class="text-lg text-gray-text">
					Discutons de votre projet de transformation digitale
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8 mb-12">
				<!-- Contact Info 1 -->
				<div class="observe bg-white rounded-xl p-6 hover:shadow-lg transition-shadow duration-300">
					<div class="w-12 h-12 bg-gradient-to-br from-orange to-orange-600 rounded-lg flex items-center justify-center text-white mb-4">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
						</svg>
					</div>
					<h3 class="font-semibold text-navy mb-2">Email</h3>
					<a href="mailto:contact@ftci.fr" class="text-orange hover:text-orange-600 transition-colors">
						contact@ftci.fr
					</a>
				</div>

				<!-- Contact Info 2 -->
				<div class="observe bg-white rounded-xl p-6 hover:shadow-lg transition-shadow duration-300">
					<div class="w-12 h-12 bg-gradient-to-br from-green to-green-600 rounded-lg flex items-center justify-center text-white mb-4">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
						</svg>
					</div>
					<h3 class="font-semibold text-navy mb-2">Téléphone</h3>
					<a href="tel:+22501234567" class="text-green hover:text-green-600 transition-colors">
						+225 01 23 45 67
					</a>
				</div>

				<!-- Contact Info 3 -->
				<div class="observe bg-white rounded-xl p-6 hover:shadow-lg transition-shadow duration-300">
					<div class="w-12 h-12 bg-gradient-to-br from-periwinkle to-blue-600 rounded-lg flex items-center justify-center text-white mb-4">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
					</div>
					<h3 class="font-semibold text-navy mb-2">Localisation</h3>
					<p class="text-gray-text text-sm">
						Abidjan & Dabou<br/>
						Côte d'Ivoire
					</p>
				</div>
			</div>

			<!-- Contact Form -->
			<div class="observe bg-white rounded-2xl p-8 md:p-12 shadow-lg">
				<form id="contactForm" class="space-y-6">
					<div class="grid md:grid-cols-2 gap-6">
						<!-- Name -->
						<div>
							<label for="name" class="block text-sm font-medium text-navy mb-2">
								Nom complet
							</label>
							<input 
								type="text" 
								id="name" 
								name="name" 
								required
								class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange/50 transition-all duration-200"
								placeholder="Votre nom"
							/>
						</div>

						<!-- Email -->
						<div>
							<label for="email" class="block text-sm font-medium text-navy mb-2">
								Adresse email
							</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								required
								class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange/50 transition-all duration-200"
								placeholder="votre.email@exemple.com"
							/>
						</div>
					</div>

					<!-- Subject -->
					<div>
						<label for="subject" class="block text-sm font-medium text-navy mb-2">
							Sujet
						</label>
						<select 
							id="subject" 
							name="subject" 
							required
							class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange/50 transition-all duration-200"
						>
							<option value="">Sélectionnez un sujet</option>
							<option value="consultation">Consultation</option>
							<option value="demo">Demande de démo</option>
							<option value="partnership">Partenariat</option>
							<option value="support">Support technique</option>
							<option value="other">Autre</option>
						</select>
					</div>

					<!-- Message -->
					<div>
						<label for="message" class="block text-sm font-medium text-navy mb-2">
							Message
						</label>
						<textarea 
							id="message" 
							name="message" 
							required
							rows="6"
							class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange/50 transition-all duration-200 resize-none"
							placeholder="Décrivez votre projet ou votre demande..."
						></textarea>
					</div>

					<!-- Consent -->
					<div class="flex items-start gap-3">
						<input 
							type="checkbox" 
							id="consent" 
							name="consent" 
							required
							class="w-4 h-4 mt-1 rounded border-gray-200 text-orange focus:ring-orange"
						/>
						<label for="consent" class="text-sm text-gray-text">
							J'accepte que FTCI utilise mes informations pour me contacter et discuter de mon projet.
						</label>
					</div>

					<!-- Submit Button -->
					<button 
						type="submit"
						class="w-full px-8 py-4 bg-orange text-white rounded-lg font-semibold hover:bg-orange-600 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2"
					>
						Envoyer mon message
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
						</svg>
					</button>

					<!-- Form Status Messages -->
					<div id="formStatus" class="hidden p-4 rounded-lg text-sm font-medium"></div>
				</form>
			</div>

			<!-- Additional Info -->
			<div class="observe mt-12 text-center">
				<p class="text-gray-text mb-4">
					Vous préférez discuter directement ? Appelez-nous ou envoyez un email.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a 
						href="tel:+22501234567"
						class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-navy text-navy rounded-lg font-semibold hover:bg-navy/5 transition-all duration-200"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
						</svg>
						Appeler
					</a>
					<a 
						href="mailto:contact@ftci.fr"
						class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-orange text-orange rounded-lg font-semibold hover:bg-orange/5 transition-all duration-200"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
						</svg>
						Envoyer un email
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById('contactForm');
	const formStatus = document.getElementById('formStatus');

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		
		// Get form data
		const formData = new FormData(form);
		const data = Object.fromEntries(formData);

		// Show loading state
		const submitBtn = form.querySelector('button[type="submit"]');
		const originalText = submitBtn.innerHTML;
		submitBtn.disabled = true;
		submitBtn.innerHTML = '<span class="inline-flex items-center gap-2"><svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>Envoi en cours...</span>';

		try {
			// Simulate form submission (replace with actual API endpoint)
			await new Promise(resolve => setTimeout(resolve, 1500));

			// Show success message
			formStatus.classList.remove('hidden', 'bg-red-50', 'text-red-800');
			formStatus.classList.add('bg-green-50', 'text-green-800');
			formStatus.innerHTML = '✓ Merci ! Votre message a été envoyé avec succès. Nous vous recontacterons bientôt.';
			
			// Reset form
			form.reset();

			// Hide message after 5 seconds
			setTimeout(() => {
				formStatus.classList.add('hidden');
			}, 5000);
		} catch (error) {
			// Show error message
			formStatus.classList.remove('hidden', 'bg-green-50', 'text-green-800');
			formStatus.classList.add('bg-red-50', 'text-red-800');
			formStatus.innerHTML = '✗ Une erreur est survenue. Veuillez réessayer ou nous contacter directement.';
		} finally {
			// Reset button
			submitBtn.disabled = false;
			submitBtn.innerHTML = originalText;
		}
	});
</script>

<style>
	.observe {
		opacity: 0;
		animation: slideUp 0.6s ease-out forwards;
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.observe {
			animation: none;
			opacity: 1;
		}
	}
</style>
