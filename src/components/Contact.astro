---
/**
 * Contact.astro — Section "Nous Contacter" (formulaire + fetch API).
 * ────────────────────────────────────────────────────────────────────────────
 * - Section id="contact" py-20 md:py-32 bg-light-bg
 * - 3 cartes info (Email orange / Téléphone green / Localisation periwinkle)
 * - Formulaire (bg-white rounded-2xl shadow-lg p-8 md:p-12) :
 *   • Nom complet + Email (grid 2 colonnes)
 *   • Sujet (select : Consultation, Demande de démo, Partenariat, Support, Autre)
 *   • Message (textarea 6 rows)
 *   • Consentement (checkbox)
 *   • Honeypot caché (website)
 *   • Bouton submit "Envoyer mon message" (btn-primary magnetic)
 *   • Zone message statut (hidden par défaut)
 * - Script : fetch POST /api/contact, gestion erreurs par champ (422),
 *   rate limit (429), succès/erreur, loading state avec spinner
 * - Coordonnées supplémentaires en bas (Appeler / Envoyer email)
 */

const contactCards = [
	{
		label: 'Email',
		value: 'contact@ftci.fr',
		href: 'mailto:contact@ftci.fr',
		color: 'orange',
		textClass: 'text-orange',
		bgClass: 'bg-orange/10',
		iconPath: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
	},
	{
		label: 'Téléphone',
		value: '+225 27 22 00 00 00',
		href: 'tel:+2252722000000',
		color: 'green',
		textClass: 'text-green',
		bgClass: 'bg-green/10',
		iconPath: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
	},
	{
		label: 'Localisation',
		value: 'Abidjan & Dabou, CI',
		href: null,
		color: 'periwinkle',
		textClass: 'text-periwinkle',
		bgClass: 'bg-periwinkle/10',
		iconPath: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
	},
];

const subjectOptions = [
	{ value: '', label: 'Choisissez un sujet…' },
	{ value: 'consultation', label: 'Consultation' },
	{ value: 'demo', label: 'Demande de démo' },
	{ value: 'partnership', label: 'Partenariat' },
	{ value: 'support', label: 'Support technique' },
	{ value: 'other', label: 'Autre' },
];
---

<section id="contact" class="relative py-20 md:py-32 bg-light-bg overflow-hidden">
	<div class="container relative z-10">
		<!-- ── Section header ─────────────────────────────────────────────── -->
		<div class="section-header observe">
			<span class="eyebrow">
				<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 8 8" aria-hidden="true">
					<polygon points="4,0 8,4 4,8 0,4" />
				</svg>
				Échangeons
			</span>
			<h2>Nous Contacter</h2>
			<p>
				Une question, un projet, une demande de démonstration ? Notre équipe
				vous répond sous 48 heures ouvrées.
			</p>
		</div>

		<!-- ── 3 cartes info ──────────────────────────────────────────────── -->
		<div class="grid sm:grid-cols-3 gap-4 mb-12 max-w-4xl mx-auto observe" style="--d: 0.05s">
			{contactCards.map((card) => (
				<div class="flex items-center gap-3 bg-white rounded-card p-4 border border-navy/5">
					<div class={`w-10 h-10 rounded-lg ${card.bgClass} flex items-center justify-center flex-shrink-0`}>
						<svg class={`w-5 h-5 ${card.textClass}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={card.iconPath} />
						</svg>
					</div>
					<div class="min-w-0">
						<p class="text-xs text-gray-text font-medium">{card.label}</p>
						{card.href ? (
							<a href={card.href} class={`text-sm font-semibold ${card.textClass} hover:underline truncate block`}>
								{card.value}
							</a>
						) : (
							<p class="text-sm font-semibold text-navy truncate">{card.value}</p>
						)}
					</div>
				</div>
			))}
		</div>

		<!-- ── Formulaire ─────────────────────────────────────────────────── -->
		<div class="max-w-3xl mx-auto observe" style="--d: 0.1s">
			<form
				id="contact-form"
				class="bg-white rounded-2xl shadow-lg p-8 md:p-12 border border-navy/5"
				novalidate
			>
				<!-- Nom + Email (grid 2 colonnes) -->
				<div class="grid sm:grid-cols-2 gap-5 mb-5">
					<div>
						<label for="name" class="block text-sm font-semibold text-navy mb-1.5">
							Nom complet <span class="text-orange" aria-hidden="true">*</span>
						</label>
						<input
							type="text"
							id="name"
							name="name"
							autocomplete="name"
							required
							aria-required="true"
							aria-describedby="error-name"
							class="w-full px-4 py-3 rounded-lg border border-navy/15 bg-light-bg/50 text-navy placeholder:text-gray-text/60 focus:border-orange focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange/20 transition-colors duration-200"
							placeholder="Jean Kouassi"
						/>
						<p id="error-name" class="hidden text-sm text-orange-700 mt-1" role="alert"></p>
					</div>
					<div>
						<label for="email" class="block text-sm font-semibold text-navy mb-1.5">
							Email <span class="text-orange" aria-hidden="true">*</span>
						</label>
						<input
							type="email"
							id="email"
							name="email"
							autocomplete="email"
							required
							aria-required="true"
							aria-describedby="error-email"
							class="w-full px-4 py-3 rounded-lg border border-navy/15 bg-light-bg/50 text-navy placeholder:text-gray-text/60 focus:border-orange focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange/20 transition-colors duration-200"
							placeholder="jean@exemple.ci"
						/>
						<p id="error-email" class="hidden text-sm text-orange-700 mt-1" role="alert"></p>
					</div>
				</div>

				<!-- Sujet (select) -->
				<div class="mb-5">
					<label for="subject" class="block text-sm font-semibold text-navy mb-1.5">
						Sujet <span class="text-orange" aria-hidden="true">*</span>
					</label>
					<select
						id="subject"
						name="subject"
						required
						aria-required="true"
						aria-describedby="error-subject"
						class="w-full px-4 py-3 rounded-lg border border-navy/15 bg-light-bg/50 text-navy focus:border-orange focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange/20 transition-colors duration-200"
					>
						{subjectOptions.map((opt) => (
							<option value={opt.value} disabled={opt.value === ''}>{opt.label}</option>
						))}
					</select>
					<p id="error-subject" class="hidden text-sm text-orange-700 mt-1" role="alert"></p>
				</div>

				<!-- Message (textarea) -->
				<div class="mb-5">
					<label for="message" class="block text-sm font-semibold text-navy mb-1.5">
						Message <span class="text-orange" aria-hidden="true">*</span>
					</label>
					<textarea
						id="message"
						name="message"
						rows="6"
						required
						aria-required="true"
						aria-describedby="error-message"
						class="w-full px-4 py-3 rounded-lg border border-navy/15 bg-light-bg/50 text-navy placeholder:text-gray-text/60 focus:border-orange focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange/20 transition-colors duration-200 resize-y"
						placeholder="Décrivez votre projet ou votre demande…"
					></textarea>
					<p id="error-message" class="hidden text-sm text-orange-700 mt-1" role="alert"></p>
				</div>

				<!-- Consentement (checkbox) -->
				<div class="mb-6">
					<label for="consent" class="flex items-start gap-3 cursor-pointer">
						<input
							type="checkbox"
							id="consent"
							name="consent"
							required
							aria-required="true"
							aria-describedby="error-consent"
							class="mt-1 w-5 h-5 rounded border-navy/20 text-orange focus:ring-orange/30 cursor-pointer"
						/>
						<span class="text-sm text-gray-text leading-relaxed">
							J'accepte que FTCI utilise mes informations pour me recontacter.
							Vos données ne sont jamais partagées avec des tiers.
						</span>
					</label>
					<p id="error-consent" class="hidden text-sm text-orange-700 mt-1" role="alert"></p>
				</div>

				<!-- Honeypot (caché — les bots le remplissent, pas les humains) -->
				<div class="hidden" aria-hidden="true">
					<label for="website">Ne pas remplir</label>
					<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
				</div>

				<!-- Bouton submit + zone statut -->
				<div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
					<button
						type="submit"
						id="contact-submit"
						data-magnetic="14"
						class="btn-primary magnetic"
					>
						<span class="btn-label">
							Envoyer mon message
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
							</svg>
						</span>
						<span class="btn-loading hidden">
							<span class="spinner"></span>
							<span>Envoi…</span>
						</span>
					</button>

					<div
						id="contact-status"
						class="hidden text-sm font-medium px-4 py-2.5 rounded-lg"
						role="status"
						aria-live="polite"
					></div>
				</div>
			</form>

			<!-- ── Coordonnées supplémentaires ─────────────────────────────── -->
			<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-6 text-sm text-gray-text">
				<a href="tel:+2252722000000" class="inline-flex items-center gap-1.5 hover:text-orange transition-colors duration-200">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
					</svg>
					Appeler
				</a>
				<a href="mailto:contact@ftci.fr" class="inline-flex items-center gap-1.5 hover:text-orange transition-colors duration-200">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
					</svg>
					Envoyer email
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	// ── Formulaire contact : fetch POST /api/contact ────────────────────────
	// Gestion : erreurs par champ (422), rate limit (429), succès/erreur,
	// loading state avec spinner. Honeypot inclus.
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
	const statusEl = document.getElementById('contact-status') as HTMLElement | null;

	if (form && submitBtn && statusEl) {
		const labelEl = submitBtn.querySelector('.btn-label');
		const loadingEl = submitBtn.querySelector('.btn-loading');

		const setFieldError = (field: string, message: string) => {
			const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
			const errorEl = document.getElementById(`error-${field}`);
			if (input) {
				if (message) {
					input.setAttribute('aria-invalid', 'true');
					input.classList.add('border-orange', 'ring-2', 'ring-orange/20');
				} else {
					input.removeAttribute('aria-invalid');
					input.classList.remove('border-orange', 'ring-2', 'ring-orange/20');
				}
			}
			if (errorEl) {
				if (message) {
					errorEl.textContent = message;
					errorEl.classList.remove('hidden');
				} else {
					errorEl.classList.add('hidden');
					errorEl.textContent = '';
				}
			}
		};

		const clearAllErrors = () => {
			['name', 'email', 'subject', 'message', 'consent'].forEach((f) =>
				setFieldError(f, ''),
			);
			statusEl.classList.add('hidden');
			statusEl.textContent = '';
		};

		const showStatus = (message: string, type: 'success' | 'error') => {
			statusEl.textContent = message;
			statusEl.classList.remove('hidden', 'text-green-700', 'bg-green/10', 'text-orange-700', 'bg-orange/10');
			if (type === 'success') {
				statusEl.classList.add('text-green-700', 'bg-green/10');
			} else {
				statusEl.classList.add('text-orange-700', 'bg-orange/10');
			}
		};

		const setLoading = (loading: boolean) => {
			if (loading) {
				labelEl?.classList.add('hidden');
				loadingEl?.classList.remove('hidden');
				submitBtn.disabled = true;
			} else {
				labelEl?.classList.remove('hidden');
				loadingEl?.classList.add('hidden');
				submitBtn.disabled = false;
			}
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			clearAllErrors();

			const formData = new FormData(form);
			const payload = {
				name: formData.get('name'),
				email: formData.get('email'),
				subject: formData.get('subject'),
				message: formData.get('message'),
				consent: formData.get('consent') === 'on',
				website: formData.get('website'), // honeypot
			};

			setLoading(true);

			try {
				const res = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});

				const data = await res.json().catch(() => ({}));

				if (res.ok) {
					showStatus(
						data.message || 'Message envoyé avec succès. Nous vous recontacterons bientôt.',
						'success',
					);
					form.reset();
				} else if (res.status === 422 && data.errors) {
					// Erreurs de validation par champ
					Object.entries(data.errors).forEach(([field, msg]) => {
						if (field !== '_honeypot') {
							setFieldError(field, msg as string);
						}
					});
					// Focus le premier champ en erreur
					const firstError = form.querySelector<HTMLElement>('[aria-invalid="true"]');
					firstError?.focus();
				} else if (res.status === 429) {
					showStatus(
						data.error || 'Trop de tentatives. Veuillez réessayer dans une minute.',
						'error',
					);
				} else {
					showStatus(
						data.error || 'Une erreur est survenue. Veuillez réessayer.',
						'error',
					);
				}
			} catch (err) {
				showStatus(
					'Erreur réseau. Vérifiez votre connexion et réessayez.',
					'error',
				);
			} finally {
				setLoading(false);
			}
		});
	}
</script>
