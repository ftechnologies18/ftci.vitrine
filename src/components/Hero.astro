---
/**
 * Hero.astro — Section d'accueil plein écran.
 * ────────────────────────────────────────────────────────────────────────────
 * - min-h-screen, overflow-hidden
 * - Background mesh-aurore (navy + radials pervenche/orange/vert, anim 26s)
 * - Motif mosaïque filigrane (SVG diamants 10,0 20,10 10,20 0,10, opacity 6%)
 * - 6 diamants flottants (animate-float + data-parallax, wrapper pour séparer
 *   les transforms : outer=parallax, inner=float+rotate)
 * - Logo RÉEL /brand/logo-ftci.png avec .animate-assemble + drop-shadow glow
 * - H1 STATIQUE (Vignelli) — seul fade-in d'entrée (--reveal-ty:0px)
 * - 2 CTA magnétiques (data-magnetic + .magnetic)
 * - Scroll indicator (chevron animate-bounce)
 * - PAS de script local (géré par Layout.astro)
 */
---

<section
	class="relative min-h-[100svh] flex items-center justify-center overflow-hidden"
	id="contenu"
>
	<!-- ── Mesh aurore (navy base + radials chauds) ─────────────────────── -->
	<div class="absolute inset-0 mesh-aurore" aria-hidden="true"></div>

	<!-- ── Motif mosaïque filigrane (parallax) ──────────────────────────── -->
	<div
		class="absolute inset-0 opacity-[0.06]"
		data-parallax="0.25"
		aria-hidden="true"
	>
		<svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
			<defs>
				<pattern
					id="hero-mosaic"
					x="0"
					y="0"
					width="20"
					height="20"
					patternUnits="userSpaceOnUse"
				>
					<polygon points="10,0 20,10 10,20 0,10" fill="none" stroke="white" stroke-width="0.4" />
				</pattern>
			</defs>
			<rect width="100" height="100" fill="url(#hero-mosaic)" />
		</svg>
	</div>

	<!-- ── Diamants flottants (wrapper parallax > inner float+rotate) ───── -->
	<div class="absolute top-[14%] left-[10%]" data-parallax="0.14" aria-hidden="true">
		<div
			class="w-3.5 h-3.5 bg-orange/80 animate-float"
			style="--d: 0s"
		></div>
	</div>
	<div class="absolute top-[24%] right-[16%]" data-parallax="0.22" aria-hidden="true">
		<div
			class="w-4 h-4 bg-green/70 animate-float"
			style="--d: 0.9s"
		></div>
	</div>
	<div class="absolute bottom-[28%] left-[18%]" data-parallax="0.3" aria-hidden="true">
		<div
			class="w-2.5 h-2.5 bg-periwinkle/70 animate-float"
			style="--d: 1.4s"
		></div>
	</div>
	<div class="absolute bottom-[18%] right-[22%]" data-parallax="0.18" aria-hidden="true">
		<div
			class="w-3 h-3 bg-orange/60 animate-float"
			style="--d: 0.5s"
		></div>
	</div>
	<div class="absolute top-[48%] left-[7%]" data-parallax="0.34" aria-hidden="true">
		<div
			class="w-2 h-2 bg-periwinkle/50 animate-float"
			style="--d: 1.8s"
		></div>
	</div>
	<div class="absolute top-[62%] right-[9%]" data-parallax="0.24" aria-hidden="true">
		<div
			class="w-2.5 h-2.5 bg-green/55 animate-float"
			style="--d: 2.2s"
		></div>
	</div>

	<!-- ── Contenu ──────────────────────────────────────────────────────── -->
	<div class="container relative z-10 text-center text-white">
		<!-- Logo réel avec assemble (fade + scale + blur, stagger --d) -->
		<div class="flex justify-center mb-8">
			<img
				src="/brand/logo-ftci.png"
				alt="Logo FTCI — mosaïque en diamants"
				width="112"
				height="115"
				class="h-24 md:h-28 w-auto animate-assemble drop-shadow-[0_0_36px_rgba(238,108,26,0.45)]"
				loading="eager"
				decoding="async"
			/>
		</div>

		<!-- H1 STATIQUE (Vignelli) — seul fade-in d'entrée, pas de translateY -->
		<h1
			class="font-display font-extrabold text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white tracking-[-0.03em] mb-6 observe"
			style="--reveal-ty: 0px; --d: 0.15s"
		>
			Freelance <span class="text-orange">Technologies</span>
			<span class="block">Côte d'Ivoire</span>
		</h1>

		<!-- Sous-titre (Inter) -->
		<p
			class="max-w-2xl mx-auto text-base sm:text-lg md:text-xl text-white/80 mb-10 leading-relaxed observe"
			style="--d: 0.3s"
		>
			Cabinet de conseil en transformation digitale et éditeur de solutions SaaS
			pensées pour le marché africain.
		</p>

		<!-- 2 CTA magnétiques -->
		<div
			class="flex flex-col sm:flex-row gap-4 justify-center observe"
			style="--d: 0.45s"
		>
			<a href="/#solutions" data-magnetic="18" class="btn-primary magnetic">
				<span>
					Découvrir nos solutions
					<svg
						class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M17 8l4 4m0 0l-4 4m4-4H3"
						/>
					</svg>
				</span>
			</a>
			<a href="/#contact" data-magnetic="14" class="btn-outline-light magnetic">
				<span>Nous contacter</span>
			</a>
		</div>
	</div>

	<!-- ── Scroll indicator ─────────────────────────────────────────────── -->
	<a
		href="/#solutions"
		class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/50 hover:text-white transition-colors duration-200"
		aria-label="Faire défiler vers les solutions"
	>
		<svg
			class="w-6 h-6 animate-bounce"
			fill="none"
			stroke="currentColor"
			viewBox="0 0 24 24"
			aria-hidden="true"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				d="M19 14l-7 7m0 0l-7-7m7 7V3"
			/>
		</svg>
	</a>
</section>
