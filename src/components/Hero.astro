---
/**
 * Hero.astro — Logo Reveal Cinématique v4
 * ────────────────────────────────────────────────────────────────────────────
 * 
 * NOUVELLE APPROCHE: Utilisation directe du VRAI logo PNG
 * avec effets cinématiques professionnels
 * 
 * EFFETS:
 * 1. Logo Reveal: clip-path animated reveal (rideau qui s'ouvre)
 * 2. Color Pulse: chaque zone de couleur pulse successivement  
 * 3. Floating Particles: particules de carrés autour du logo
 * 4. Glow Aura: halo lumineux dynamique
 * 5. Subtle Float: flottement continu du logo
 */

interface Particle {
  id: number;
  x: number;
  y: number;
  size: number;
  color: string;
  delay: number;
  duration: number;
}

// ═══════════════════════════════════════════════════════════════════════════
// GÉNÉRATION DE PARTICULES FLOTTANTES AUTOUR DU LOGO
// ═══════════════════════════════════════════════════════════════════════════

function generateParticles(count: number): Particle[] {
  const particles: Particle[] = [];
  const colors = ['#1e3a5f', '#2d5a9e', '#1a8c42', '#28b855', '#d45a0f', '#EE6C1A', '#6B7FC7'];
  
  for (let i = 0; i < count; i++) {
    // Distribution en cercle/ellipse autour du centre
    const angle = (i / count) * Math.PI * 2 + (Math.random() - 0.5) * 0.5;
    const radius = 120 + Math.random() * 80; // Distance du centre
    
    particles.push({
      id: i,
      x: 150 + Math.cos(angle) * radius,
      y: 140 + Math.sin(angle) * radius * 0.8, // Légèrement aplati
      size: 4 + Math.random() * 8,
      color: colors[Math.floor(Math.random() * colors.length)],
      delay: Math.random() * 3,
      duration: 4 + Math.random() * 4,
    });
  }
  
  return particles;
}

const logoParticles = generateParticles(35);
---

<section class="hero-section relative min-h-[100svh] flex items-center overflow-hidden" id="contenu">
  
  <!-- Mesh Background -->
  <div class="hero-mesh absolute inset-[-20%]" aria-hidden="true">
    <div class="mesh-blob mesh-blob--periwinkle"></div>
    <div class="mesh-blob mesh-blob--green"></div>
    <div class="mesh-blob mesh-blob--orange"></div>
    <div class="mesh-blob mesh-blob--navy"></div>
  </div>

  <!-- Contenu -->
  <div class="container relative z-10">
    <div class="hero-grid">
      
      <!-- Texte -->
      <div class="hero-content">
        <div class="hero-eyebrow hero-reveal" style="--delay:0s">
          <span class="inline-flex items-center gap-2 font-sans font-semibold text-xs uppercase tracking-[0.12em] text-orange">
            <span class="w-8 h-px bg-orange/60"></span>
            Freelance Technologies Côte d'Ivoire
          </span>
        </div>

        <h1 class="hero-title font-display font-extrabold text-white tracking-[-0.03em] hero-reveal" style="--delay:0.1s">
          <span class="title-line">La technologie,</span>
          <span class="title-line text-orange">pensée pour le</span>
          <span class="title-line">terrain africain.</span>
        </h1>

        <p class="hero-subtitle max-w-lg text-base sm:text-lg md:text-xl text-white/75 leading-relaxed hero-reveal" style="--delay:0.22s">
          Cabinet de conseil en transformation digitale et éditeur de solutions SaaS 
          conçues pour répondre aux réalités du marché ivoirien et africain.
        </p>

        <div class="hero-ctas flex flex-col sm:flex-row gap-4 mt-10 hero-reveal" style="--delay:0.35s">
          <a href="/#solutions" data-magnetic="18" class="btn-primary magnetic group">
            <span>Découvrir nos solutions
              <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
          <a href="/#contact" data-magnetic="14" class="btn-outline-light magnetic"><span>Nous contacter</span></a>
        </div>

        <div class="hero-stats grid grid-cols-3 gap-6 mt-14 pt-10 border-t border-white/10 hero-reveal" style="--delay:0.48s">
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">4+</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Solutions SaaS</div>
          </div>
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">100%</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Ancré en CI</div>
          </div>
          <div class="stat-item col-span-1">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">24/7</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Support</div>
          </div>
        </div>
      </div>

      <!-- LOGO FTCI avec Effet Reveal Cinématique -->
      <div class="logo-showcase hidden lg:flex items-center justify-center relative" aria-label="Logo FTCI">
        
        <!-- Auras/Glows colorées -->
        <div class="logo-aura aura-navy"></div>
        <div class="logo-aura aura-green"></div>
        <div class="logo-aura aura-orange"></div>
        
        <!-- Container principal du logo -->
        <div class="logo-container">
          
          <!-- Scan Line Effect -->
          <div class="scan-line"></div>
          
          <!-- Le VRAI logo FTCI -->
          <img 
            src="/brand/logo-ftci.png" 
            alt="Logo FTCI - Freelance Technologies Côte d'Ivoire"
            class="logo-image"
            width="320"
            height="300"
          />
          
          <!-- Overlay gradient pour l'effet -->
          <div class="logo-overlay"></div>
          
          <!-- Particules flottantes SVG -->
          <svg class="particles-svg" viewBox="0 0 300 280" aria-hidden="true">
            {logoParticles.map((p) => (
              <rect
                class="particle"
                x={p.x}
                y={p.y}
                width={p.size}
                height={p.size}
                rx={p.size > 6 ? 2 : 1}
                fill={p.color}
                style={`--delay:${p.delay}s;--duration:${p.duration}s`}
              />
            ))}
          </svg>
        </div>
        
        <!-- Label sous le logo -->
        <div class="logo-label hero-reveal" style="--delay:1.2s">
          <span class="label-main">FTCI</span>
          <span class="label-sub">Technologies</span>
        </div>
        
        <!-- Anneau décoratif rotatif -->
        <div class="ring-decoration">
          <svg viewBox="0 0 200 200" class="ring-svg">
            <circle cx="100" cy="100" r="90" fill="none" stroke="url(#ringGradient)" stroke-width="1" stroke-dasharray="8 12" opacity="0.4"/>
            <defs>
              <linearGradient id="ringGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#1e3a5f"/>
                <stop offset="50%" stop-color="#1a8c42"/>
                <stop offset="100%" stop-color="#d45a0f"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="/#solutions" class="scroll-indicator absolute bottom-6 left-1/2 -translate-x-1/2 z-20" aria-label="Défiler">
    <svg class="w-6 h-6 text-white/40 hover:text-white/70 transition-colors animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </a>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     LAYOUT & STRUCTURE
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-section {
    background: #0a1428;
  }
  
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    min-height: 100svh;
    padding: 100px 0 80px;
  }
  
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding: 90px 0 70px;
    }
  }

  /* Typography */
  .hero-title {
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 1024px) {
    .hero-title {
      font-size: clamp(2.5rem, 1.2rem + 4vw, 4.25rem);
      line-height: 1.05;
    }
  }
  
  .title-line {
    display: block;
  }
  
  .stat-value {
    font-variant-numeric: tabular-nums;
  }

  /* Reveal Animation */
  .hero-reveal {
    opacity: 0;
    transform: translateY(24px);
    animation: revealIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay, 0s);
  }
  
  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     MESH BACKGROUND
     ═══════════════════════════════════════════════════════════════════════════ */
  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(55px);
    will-change: transform;
    opacity: 0.55;
  }
  
  .mesh-blob--periwinkle {
    width: 55%;
    height: 50%;
    top: 5%;
    left: 18%;
    background: radial-gradient(ellipse, rgba(107, 127, 199, 0.5), transparent 70%);
    animation: drift 22s ease-in-out infinite alternate;
  }
  
  .mesh-blob--green {
    width: 45%;
    height: 42%;
    top: 8%;
    right: 12%;
    background: radial-gradient(ellipse, rgba(30, 158, 79, 0.35), transparent 70%);
    animation: drift 26s ease-in-out infinite alternate-reverse;
  }
  
  .mesh-blob--orange {
    width: 52%;
    height: 46%;
    bottom: 8%;
    right: 22%;
    background: radial-gradient(ellipse, rgba(238, 108, 26, 0.32), transparent 70%);
    animation: drift 24s ease-in-out infinite alternate;
  }
  
  .mesh-blob--navy {
    width: 42%;
    height: 40%;
    bottom: 15%;
    left: 8%;
    background: radial-gradient(ellipse, rgba(15, 30, 61, 0.6), transparent 70%);
    animation: drift 28s ease-in-out infinite alternate-reverse;
  }
  
  @keyframes drift {
    to {
      transform: translate(3%, 2%) scale(1.07);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LOGO SHOWCASE — Container Principal
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-showcase {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Auras colorées derrière le logo */
  .logo-aura {
    position: absolute;
    border-radius: 50%;
    filter: blur(50px);
    pointer-events: none;
    opacity: 0;
    animation: auraPulse 5s ease-in-out infinite;
  }
  
  .aura-navy {
    width: 55%;
    height: 45%;
    top: 5%;
    left: 0%;
    background: radial-gradient(circle, rgba(30, 58, 95, 0.5), transparent 70%);
    animation-delay: 0.5s;
  }
  
  .aura-green {
    width: 50%;
    height: 42%;
    top: 5%;
    right: 0%;
    background: radial-gradient(circle, rgba(26, 140, 66, 0.4), transparent 70%);
    animation-delay: 1.5s;
  }
  
  .aura-orange {
    width: 60%;
    height: 48%;
    bottom: 5%;
    left: 15%;
    background: radial-gradient(circle, rgba(212, 90, 15, 0.4), transparent 70%);
    animation-delay: 2.5s;
  }
  
  @keyframes auraPulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }

  /* Container du logo avec effets */
  .logo-container {
    position: relative;
    width: 85%;
    z-index: 2;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
    backdrop-filter: blur(10px);
    padding: 15px;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     IMAGE DU LOGO — Effets Cinématiques
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    
    /* Animation d'apparition principale */
    animation: 
      logoReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards,
      logoFloat 7s ease-in-out infinite;
    animation-delay: 0.3s, 1.5s;
    
    /* État initial caché */
    opacity: 0;
    clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
    filter: drop-shadow(0 0 25px rgba(107, 127, 199, 0.35));
    
 /* Blend mode pour fond transparent */
    mix-blend-mode: normal;
  }

  /* Révélation clip-path - effet rideau */
  @keyframes logoReveal {
    0% {
      opacity: 0;
      clip-path: polygon(50% 50%, 50% 50%, 50% 50%, 50% 50%);
      transform: scale(0.8);
    }
    40% {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    }
    60% {
      transform: scale(1.02);
    }
    100% {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      transform: scale(1);
    }
  }
  
  /* Flottement subtil continu */
  @keyframes logoFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* Overlay gradient pour profondeur */
  .logo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(107, 127, 199, 0.08) 0%,
      transparent 40%,
      transparent 60%,
      rgba(212, 90, 15, 0.08) 100%
    );
    pointer-events: none;
    opacity: 0;
    animation: overlayFade 1s ease-out 1.5s forwards;
  }
  
  @keyframes overlayFade {
    to { opacity: 1; }
  }

  /* Scan Line Effect */
  .scan-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(255, 255, 255, 0.03) 50%,
      transparent 100%
    );
    height: 30%;
    animation: scanMove 2.5s ease-in-out infinite;
    animation-delay: 1.8s;
    pointer-events: none;
    opacity: 0;
  }
  
  @keyframes scanMove {
    0% { top: -30%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     PARTICULES FLOTTANTES
     ═══════════════════════════════════════════════════════════════════════════ */
  .particles-svg {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    pointer-events: none;
    overflow: visible;
  }

  .particle {
    opacity: 0;
    animation: particleFloat var(--duration, 5s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    will-change: transform, opacity;
  }
  
  @keyframes particleFloat {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(0deg) scale(0);
    }
    15% {
      opacity: 0.7;
      transform: translate(0, 0) rotate(45deg) scale(1);
    }
    50% {
      opacity: 0.5;
      transform: translate(calc(var(--tx, 15px)), calc(var(--ty, -20px))) rotate(45deg) scale(0.9);
    }
    85% {
      opacity: 0.3;
      transform: translate(calc(var(--tx, 15px) * 0.5), calc(var(--ty, -20px) * 0.5)) rotate(45deg) scale(0.7);
    }
    100% {
      opacity: 0;
      transform: translate(0, 0) rotate(45deg) scale(0);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     ANNEAU DÉCORATIF ROTATIF
     ═══════════════════════════════════════════════════════════════════════════ */
  .ring-decoration {
    position: absolute;
    width: 130%;
    height: 130%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0;
    animation: ringFadeIn 1s ease-out 2s forwards, ringRotate 40s linear infinite;
  }
  
  .ring-svg {
    width: 100%;
    height: 100%;
  }
  
  @keyframes ringFadeIn {
    to { opacity: 1; }
  }
  
  @keyframes ringRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LABEL SOUS LE LOGO
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-label {
    position: absolute;
    bottom: -45px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    z-index: 5;
  }
  
  .label-main {
    font-family: var(--font-display), sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.9);
  }
  
  .label-sub {
    font-family: var(--font-display), sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #EE6C1A;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     REDUCED MOTION — Accessibilité
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .logo-image {
      animation: none !important;
      opacity: 1 !important;
      clip-path: none !important;
      transform: none !important;
    }
    .particle {
      animation: none !important;
      opacity: 0.4 !important;
    }
    .logo-aura {
      animation: none !important;
      opacity: 0.4 !important;
    }
    .scan-line {
      display: none !important;
    }
    .ring-decoration {
      animation: ringFadeIn 0.5s ease-out forwards !important;
    }
    .hero-reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 1023px) {
    .mesh-blob {
      filter: blur(65px);
      animation-duration: 44s !important;
    }
  }
</style>

<script>
function initHero() {
  const section = document.querySelector('.hero-section');
  if (!section) return;
  
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    section.classList.add('reduced-motion');
  }
  
  // Intersection Observer pour déclencher animations au scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    { threshold: 0.1 }
  );
  observer.observe(section);
  
  // Parallax subtil sur les auras au scroll
  if (!prefersReducedMotion) {
    let ticking = false;
    const auras = document.querySelectorAll('.logo-aura');
    
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            const scrollY = window.scrollY;
            auras.forEach((aura, index) => {
              (aura as HTMLElement).style.transform = `translateY(${scrollY * (0.02 + index * 0.01)}px)`;
            });
            ticking = false;
          });
        }
      },
      { passive: true }
    );
  }
  
  // Ajouter des directions aléatoires aux particules
  if (!prefersReducedMotion) {
    const particles = document.querySelectorAll('.particle');
    particles.forEach((p) => {
      const tx = (Math.random() - 0.5) * 35;
      const ty = (Math.random() - 0.5) * 35;
      p.style.setProperty('--tx', `${tx}px`);
      p.style.setProperty('--ty', `${ty}px`);
    });
  }
}

document.readyState === 'loading'
  ? document.addEventListener('DOMContentLoaded', initHero)
  : initHero();
</script>
