---
// ============================================================
// Hero FTCI — Refonte R-DESIGN-1
// ------------------------------------------------------------
// Cahier des charges 6.1 : Mesh gradient animé "aurore numérique"
//                         + motif mosaïque filigrane + logo assemblage
//
// Skills appliqués :
// - Vignelli Canon       : H1 STATIQUE (jamais animé, reste crisp),
//                          max 2 familles typo, hiérarchie stricte
// - Müller-Brockmann     : tous espacements multiples de 8px,
//                          line-height tight sur display type
// - Brand Book Generator : mesh = navy solid base + radial-gradients
//                          pervenche/orange/vert (PAS de bleu→violet),
//                          logo = PNG réel (pas de SVG fait main),
//                          stagger assemble avec ease-spring
// - Apple Design         : reduced-motion = tout statique,
//                          tracking négatif sur gros titre,
//                          animations interruptibles (transitions CSS)
// - Emil Design Eng.     : ease-out custom, scale 0.93 (pas 0),
//                          :active scale(0.97) 160ms, durations < 300ms UI,
//                          uniquement transform + opacity animés (GPU)
// - Review Animations    : pas de transition:all, hover gating,
//                          prefers-reduced-motion respecté
//
// Note script : magnetic + parallax sont gérés GLOBALEMENT par
// Layout.astro (rAF throttled, passive listener, reduced-motion aware).
// Hero.astro ne redéfinit PAS ces handlers — DRY + pas de double-bind.
// ============================================================
---

<section
	class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20"
	aria-label="Présentation FTCI"
>
	<!-- 1. Background — mesh aurore (cahier des charges 6.1) -->
	<!-- Navy solid + 4 radial-gradients pervenche/orange/vert, animation 24s -->
	<div
		class="absolute inset-0 -z-20 mesh-aurore"
		aria-hidden="true"
	></div>

	<!-- 2. Motif mosaïque filigrane (parallax léger) -->
	<!-- Diamants 10,0 20,10 10,20 0,10 — motif identitaire FTCI -->
	<div
		class="absolute inset-0 -z-10 opacity-[0.06]"
		data-parallax="0.25"
		aria-hidden="true"
	>
		<svg
			class="w-full h-full"
			viewBox="0 0 200 200"
			preserveAspectRatio="xMidYMid slice"
		>
			<defs>
				<pattern
					id="mosaic-hero"
					x="0"
					y="0"
					width="20"
					height="20"
					patternUnits="userSpaceOnUse"
				>
					<polygon
						points="10,0 20,10 10,20 0,10"
						fill="none"
						stroke="#F2F4F8"
						stroke-width="0.4"
					/>
				</pattern>
			</defs>
			<rect width="200" height="200" fill="url(#mosaic-hero)" />
		</svg>
	</div>

	<!-- 3. Diamants flottants (parallax + float) — accents identitaires -->
	<div
		class="absolute inset-0 -z-10 overflow-hidden"
		aria-hidden="true"
	>
		<div
			class="absolute top-[15%] left-[12%] w-3 h-3 rotate-45 bg-orange/30 animate-float"
			data-parallax="0.5"
			style="animation-delay: 0s;"
		></div>
		<div
			class="absolute top-[22%] right-[14%] w-2 h-2 rotate-45 bg-green/30 animate-float"
			data-parallax="0.4"
			style="animation-delay: 1s;"
		></div>
		<div
			class="absolute bottom-[28%] left-[18%] w-4 h-4 rotate-45 bg-periwinkle/25 animate-float"
			data-parallax="0.6"
			style="animation-delay: 2s;"
		></div>
		<div
			class="absolute bottom-[22%] right-[20%] w-2.5 h-2.5 rotate-45 bg-orange/25 animate-float"
			data-parallax="0.45"
			style="animation-delay: 1.5s;"
		></div>
		<div
			class="absolute top-[55%] left-[8%] w-1.5 h-1.5 rotate-45 bg-green/40 animate-float"
			data-parallax="0.35"
			style="animation-delay: 0.7s;"
		></div>
		<div
			class="absolute top-[42%] right-[8%] w-1.5 h-1.5 rotate-45 bg-periwinkle/40 animate-float"
			data-parallax="0.55"
			style="animation-delay: 1.2s;"
		></div>
	</div>

	<!-- 4. Contenu hero -->
	<div class="container relative z-10 text-center max-w-5xl mx-auto px-4">
		<!-- Logo réel FTCI (PNG /brand/logo-ftci.png) — PAS de SVG fait main -->
		<!-- Animation d'assemblage : scale 0.93 + blur 7px → 1, ease-spring -->
		<div class="flex justify-center mb-8 animate-assemble" style="--d: 0;">
			<img
				src="/brand/logo-ftci.png"
				alt="Logo FTCI — Freelance Technologies Côte d'Ivoire"
				width="112"
				height="115"
				fetchpriority="high"
				decoding="async"
				class="h-24 w-auto md:h-28 drop-shadow-[0_0_30px_rgba(238,108,26,0.35)]"
			/>
		</div>

		<!-- Titre H1 — Vignelli: STATIQUE, jamais animé au-delà du fade-in d'entrée -->
		<!-- Poppins ExtraBold, blanc, "Technologies" en orange (identité FTCI) -->
		<!-- Tracking négatif sur gros titre (Apple Design) -->
		<h1
			class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-white mb-6 leading-[1.05] animate-fade-in"
			style="animation-delay: 0.25s;"
		>
			Freelance <span class="text-orange">Technologies</span>
			<span class="block">Côte d'Ivoire</span>
		</h1>

		<!-- Sous-titre — Inter Regular, blanc/80 -->
		<p
			class="text-base sm:text-lg md:text-xl text-white/80 mb-10 max-w-2xl mx-auto leading-relaxed animate-fade-in"
			style="animation-delay: 0.45s;"
		>
			Cabinet de conseil en transformation digitale et éditeur de solutions
			SaaS pensées pour le marché africain.
		</p>

		<!-- CTA magnétiques (cahier des charges 6.2) -->
		<!-- data-magnetic + .magnetic : press scale(0.97) géré globalement par .magnetic:active -->
		<div
			class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in"
			style="animation-delay: 0.65s;"
		>
			<a
				href="#solutions"
				class="magnetic btn-primary inline-flex items-center justify-center gap-2 px-8 py-4 bg-orange text-white rounded-lg font-semibold hover:bg-orange-600"
				data-magnetic
			>
				Découvrir nos solutions
				<svg
					class="w-5 h-5"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M13 7l5 5m0 0l-5 5m5-5H6"
					></path>
				</svg>
			</a>
			<a
				href="#contact"
				class="magnetic btn-outline inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-white text-white rounded-lg font-semibold hover:bg-white/10"
				data-magnetic
			>
				Nous contacter
			</a>
		</div>

		<!-- Scroll indicator (bas de hero) -->
		<!-- Tailwind animate-bounce = keyframes bounce par défaut, désactivé par reduced-motion global -->
		<div
			class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-fade-in"
			style="animation-delay: 0.9s;"
			aria-hidden="true"
		>
			<svg
				class="w-6 h-6 text-white/60 animate-bounce"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M19 14l-7 7m0 0l-7-7m7 7V3"
				></path>
			</svg>
		</div>
	</div>
</section>
