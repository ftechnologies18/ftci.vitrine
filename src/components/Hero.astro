---
/**
 * Hero.astro — Logo Reveal Cinématique v5 (Clean & Elegant)
 * ────────────────────────────────────────────────────────────────────────────
 * 
 * APPROCHE: Logo FTCI sans fond avec effets cinématiques raffinés
 * 
 * EFFETS:
 * 1. Logo Reveal: clip-path animated reveal (expansion depuis centre)
 * 2. Glow Aura: halos lumineux dynamiques par couleur
 * 3. Subtle Float: flottement continu du logo
 * 4. Shimmer: effet de brillance subtil
 * 5. Ring Decoration: anneau rotatif élégant
 */

---

<section class="hero-section relative min-h-[100svh] flex items-center overflow-hidden" id="contenu">
  
  <!-- Mesh Background -->
  <div class="hero-mesh absolute inset-[-20%]" aria-hidden="true">
    <div class="mesh-blob mesh-blob--periwinkle"></div>
    <div class="mesh-blob mesh-blob--green"></div>
    <div class="mesh-blob mesh-blob--orange"></div>
    <div class="mesh-blob mesh-blob--navy"></div>
  </div>

  <!-- Contenu -->
  <div class="container relative z-10">
    <div class="hero-grid">
      
      <!-- Texte -->
      <div class="hero-content">
        <div class="hero-eyebrow hero-reveal" style="--delay:0s">
          <span class="inline-flex items-center gap-2 font-sans font-semibold text-xs uppercase tracking-[0.12em] text-orange">
            <span class="w-8 h-px bg-orange/60"></span>
            Freelance Technologies Côte d'Ivoire
          </span>
        </div>

        <h1 class="hero-title font-display font-extrabold text-white tracking-[-0.03em] hero-reveal" style="--delay:0.1s">
          <span class="title-line">La technologie,</span>
          <span class="title-line text-orange">pensée pour le</span>
          <span class="title-line">terrain africain.</span>
        </h1>

        <p class="hero-subtitle max-w-lg text-base sm:text-lg md:text-xl text-white/75 leading-relaxed hero-reveal" style="--delay:0.22s">
          Cabinet de conseil en transformation digitale et éditeur de solutions SaaS 
          conçues pour répondre aux réalités du marché ivoirien et africain.
        </p>

        <div class="hero-ctas flex flex-col sm:flex-row gap-4 mt-10 hero-reveal" style="--delay:0.35s">
          <a href="/#solutions" data-magnetic="18" class="btn-primary magnetic group">
            <span>Découvrir nos solutions
              <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
          <a href="/#contact" data-magnetic="14" class="btn-outline-light magnetic"><span>Nous contacter</span></a>
        </div>

        <div class="hero-stats grid grid-cols-3 gap-6 mt-14 pt-10 border-t border-white/10 hero-reveal" style="--delay:0.48s">
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">4+</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Solutions SaaS</div>
          </div>
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">100%</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Ancré en CI</div>
          </div>
          <div class="stat-item col-span-1">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">24/7</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Support</div>
          </div>
        </div>
      </div>

      <!-- LOGO FTCI avec Effets Cinématiques Épurés -->
      <div class="logo-showcase hidden lg:flex items-center justify-center relative" aria-label="Logo FTCI">
        
        <!-- Auras/Glows colorées améliorées -->
        <div class="logo-aura aura-navy"></div>
        <div class="logo-aura aura-green"></div>
        <div class="logo-aura aura-orange"></div>
        
        <!-- Anneau décoratif rotatif (arrière-plan) -->
        <div class="ring-decoration">
          <svg viewBox="0 0 200 200" class="ring-svg">
            <defs>
              <linearGradient id="ringGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#1e3a5f"/>
                <stop offset="50%" stop-color="#1a8c42"/>
                <stop offset="100%" stop-color="#d45a0f"/>
              </linearGradient>
            </defs>
            <circle cx="100" cy="100" r="85" fill="none" stroke="url(#ringGradient)" stroke-width="0.75" stroke-dasharray="6 10" opacity="0.35"/>
            <circle cx="100" cy="100" r="95" fill="none" stroke="url(#ringGradient)" stroke-width="0.5" stroke-dasharray="2 8" opacity="0.2"/>
          </svg>
        </div>
        
        <!-- Container principal du logo -->
        <div class="logo-container">
          
          <!-- Effet shimmer/brillance -->
          <div class="logo-shimmer"></div>
          
          <!-- Le VRAI logo FTCI (sans fond) -->
          <img 
            src="/brand/logo-ftci-nobg.png" 
            alt="Logo FTCI - Freelance Technologies Côte d'Ivoire"
            class="logo-image"
            width="340"
            height="320"
          />
          
          <!-- Glow overlay pour profondeur -->
          <div class="logo-glow-overlay"></div>
        </div>
        
        <!-- Label sous le logo -->
        <div class="logo-label hero-reveal" style="--delay:1s">
          <span class="label-main">FTCI</span>
          <span class="label-sub">Technologies</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="/#solutions" class="scroll-indicator absolute bottom-6 left-1/2 -translate-x-1/2 z-20" aria-label="Défiler">
    <svg class="w-6 h-6 text-white/40 hover:text-white/70 transition-colors animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </a>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     LAYOUT & STRUCTURE
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-section {
    background: #0a1428;
  }
  
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    min-height: 100svh;
    padding: 100px 0 80px;
  }
  
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding: 90px 0 70px;
    }
  }

  /* Typography */
  .hero-title {
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 1024px) {
    .hero-title {
      font-size: clamp(2.5rem, 1.2rem + 4vw, 4.25rem);
      line-height: 1.05;
    }
  }
  
  .title-line {
    display: block;
  }
  
  .stat-value {
    font-variant-numeric: tabular-nums;
  }

  /* Reveal Animation */
  .hero-reveal {
    opacity: 0;
    transform: translateY(24px);
    animation: revealIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay, 0s);
  }
  
  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     MESH BACKGROUND
     ═══════════════════════════════════════════════════════════════════════════ */
  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(55px);
    will-change: transform;
    opacity: 0.55;
  }
  
  .mesh-blob--periwinkle {
    width: 55%;
    height: 50%;
    top: 5%;
    left: 18%;
    background: radial-gradient(ellipse, rgba(107, 127, 199, 0.5), transparent 70%);
    animation: drift 22s ease-in-out infinite alternate;
  }
  
  .mesh-blob--green {
    width: 45%;
    height: 42%;
    top: 8%;
    right: 12%;
    background: radial-gradient(ellipse, rgba(30, 158, 79, 0.35), transparent 70%);
    animation: drift 26s ease-in-out infinite alternate-reverse;
  }
  
  .mesh-blob--orange {
    width: 52%;
    height: 46%;
    bottom: 8%;
    right: 22%;
    background: radial-gradient(ellipse, rgba(238, 108, 26, 0.32), transparent 70%);
    animation: drift 24s ease-in-out infinite alternate;
  }
  
  .mesh-blob--navy {
    width: 42%;
    height: 40%;
    bottom: 15%;
    left: 8%;
    background: radial-gradient(ellipse, rgba(15, 30, 61, 0.6), transparent 70%);
    animation: drift 28s ease-in-out infinite alternate-reverse;
  }
  
  @keyframes drift {
    to {
      transform: translate(3%, 2%) scale(1.07);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LOGO SHOWCASE — Container Principal
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-showcase {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     AURAS COLORÉES — Halos lumineux améliorés
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-aura {
    position: absolute;
    border-radius: 50%;
    filter: blur(55px);
    pointer-events: none;
    opacity: 0;
    animation: auraPulse 6s ease-in-out infinite;
  }
  
  .aura-navy {
    width: 60%;
    height: 50%;
    top: 0%;
    left: -5%;
    background: radial-gradient(circle, rgba(30, 58, 95, 0.6), transparent 65%);
    animation-delay: 0.3s;
  }
  
  .aura-green {
    width: 55%;
    height: 48%;
    top: 0%;
    right: -5%;
    background: radial-gradient(circle, rgba(26, 140, 66, 0.5), transparent 65%);
    animation-delay: 1.2s;
  }
  
  .aura-orange {
    width: 65%;
    height: 52%;
    bottom: 0%;
    left: 10%;
    background: radial-gradient(circle, rgba(212, 90, 15, 0.5), transparent 65%);
    animation-delay: 2.1s;
  }
  
  @keyframes auraPulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50% { opacity: 0.75; transform: scale(1.08); }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     ANNEAU DÉCORATIF ROTATIF
     ═══════════════════════════════════════════════════════════════════════════ */
  .ring-decoration {
    position: absolute;
    width: 135%;
    height: 135%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0;
    animation: ringFadeIn 1.2s ease-out 1.5s forwards, ringRotate 50s linear infinite;
  }
  
  .ring-svg {
    width: 100%;
    height: 100%;
  }
  
  @keyframes ringFadeIn {
    to { opacity: 1; }
  }
  
  @keyframes ringRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Container du logo */
  .logo-container {
    position: relative;
    width: 88%;
    z-index: 3;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     IMAGE DU LOGO — Effets Cinématiques Raffinés
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    
    /* Animation principale: reveal + float */
    animation: 
      logoReveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards,
      logoFloat 8s ease-in-out infinite,
      logoGlow 4s ease-in-out infinite;
    animation-delay: 0.4s, 1.8s, 2s;
    
    /* État initial caché */
    opacity: 0;
    clip-path: circle(0% at 50% 50%);
    filter: drop-shadow(0 0 30px rgba(107, 127, 199, 0.25));
  }

  /* Révélation circulaire élégante */
  @keyframes logoReveal {
    0% {
      opacity: 0;
      clip-path: circle(0% at 50% 50%);
      transform: scale(0.85);
      filter: drop-shadow(0 0 0px transparent);
    }
    50% {
      opacity: 1;
      clip-path: circle(70% at 50% 50%);
    }
    80% {
      transform: scale(1.02);
      filter: drop-shadow(0 0 35px rgba(107, 127, 199, 0.35));
    }
    100% {
      opacity: 1;
      clip-path: circle(110% at 50% 50%);
      transform: scale(1);
      filter: drop-shadow(0 0 25px rgba(107, 127, 199, 0.25));
    }
  }
  
  /* Flottement subtil continu */
  @keyframes logoFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  /* Pulse lumineux subtil */
  @keyframes logoGlow {
    0%, 100% { filter: drop-shadow(0 0 25px rgba(107, 127, 199, 0.2)); }
    50% { filter: drop-shadow(0 0 40px rgba(107, 127, 199, 0.4)); }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     SHIMMER EFFECT — Brillance subtil
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.04) 45%,
      rgba(255, 255, 255, 0.08) 50%,
      rgba(255, 255, 255, 0.04) 55%,
      transparent 80%
    );
    background-size: 250% 250%;
    pointer-events: none;
    z-index: 4;
    opacity: 0;
    animation: shimmerIn 0.5s ease-out 2s forwards, shimmerMove 6s ease-in-out infinite;
    animation-delay: 0s, 2.5s;
  }
  
  @keyframes shimmerIn {
    to { opacity: 1; }
  }
  
  @keyframes shimmerMove {
    0%, 100% { background-position: 200% 200%; }
    50% { background-position: 0% 0%; }
  }

  /* Glow overlay pour profondeur */
  .logo-glow-overlay {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      ellipse at center,
      rgba(107, 127, 199, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    animation: glowOverlayFade 1.5s ease-out 1.8s forwards;
  }
  
  @keyframes glowOverlayFade {
    to { opacity: 1; }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LABEL SOUS LE LOGO
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-label {
    position: absolute;
    bottom: -48px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    z-index: 5;
  }
  
  .label-main {
    font-family: var(--font-display), sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }
  
  .label-sub {
    font-family: var(--font-display), sans-serif;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #EE6C1A;
    text-shadow: 0 2px 15px rgba(238, 108, 26, 0.4);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     REDUCED MOTION — Accessibilité
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .logo-image {
      animation: none !important;
      opacity: 1 !important;
      clip-path: none !important;
      transform: none !important;
      filter: drop-shadow(0 0 20px rgba(107, 127, 199, 0.2)) !important;
    }
    .logo-shimmer {
      display: none !important;
    }
    .logo-glow-overlay {
      animation: none !important;
      opacity: 1 !important;
    }
    .logo-aura {
      animation: none !important;
      opacity: 0.4 !important;
    }
    .ring-decoration {
      animation: ringFadeIn 0.5s ease-out forwards !important;
    }
    .hero-reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 1023px) {
    .mesh-blob {
      filter: blur(65px);
      animation-duration: 44s !important;
    }
  }
</style>

<script>
function initHero() {
  const section = document.querySelector('.hero-section');
  if (!section) return;
  
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    section.classList.add('reduced-motion');
  }
  
  // Intersection Observer pour déclencher animations au scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    { threshold: 0.1 }
  );
  observer.observe(section);
  
  // Parallax subtil sur les auras au scroll
  if (!prefersReducedMotion) {
    let ticking = false;
    const auras = document.querySelectorAll('.logo-aura');
    
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            const scrollY = window.scrollY;
            auras.forEach((aura, index) => {
              (aura as HTMLElement).style.transform = `translateY(${scrollY * (0.018 + index * 0.008)}px)`;
            });
            ticking = false;
          });
        }
      },
      { passive: true }
    );
  }
}

document.readyState === 'loading'
  ? document.addEventListener('DOMContentLoaded', initHero)
  : initHero();
</script>
