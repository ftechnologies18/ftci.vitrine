---
/**
 * Hero.astro — Hero Slider Cinématique v8 (Masterpiece Edition)
 * ────────────────────────────────────────────────────────────────────────────
 * 
 * AMÉLIORATIONS V8:
 * - Hero 1 (Entreprise): Logo VISIBLE avec animation cinématique améliorée
 * - Hero 2 (Solutions): Animation DISPERSION/RECOMPOSITION - chaque solution apparaît individuellement
 * - Hero 3 (Services): Cartes à droite avec effets "WOW" (3D tilt, glow, magnetic)
 * 
 * PRINCIPES DESIGN:
 * - Layout asymétrique ingénieux par slide type
 * - Animations orchestrées et séquencées
 * - GPU-only animations (transform/opacity)
 * - Signature easing: cubic-bezier(0.16, 1, 0.3, 1)
 */

import { products, accentColorClasses } from '../data/products';

// Données des slides
const slides = [
  {
    id: 'enterprise',
    eyebrow: 'Freelance Technologies Côte d\'Ivoire',
    title: ['La technologie,', 'pensée pour le', 'terrain africain.'],
    titleHighlight: [false, true, false],
    subtitle: 'Entreprise de Services du Numérique (ESN) basée à Abidjan. Nous accompagnons les organisations dans leur transformation digitale — du conseil à la formation — et éditons des solutions SaaS conçues pour les réalités du marché ivoirien et africain.',
    primaryCta: { href: '/#solutions', label: 'Découvrir nos solutions' },
    secondaryCta: { href: '/#services', label: 'Nos services' },
    stats: [
      { value: '4', label: 'Pôles de services', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
      { value: '4+', label: 'Solutions SaaS', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
      { value: '100%', label: 'Ancré en CI', icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' }
    ],
    showLogo: true,
    theme: 'dark'
  },
  {
    id: 'solutions',
    eyebrow: 'Écosystème SaaS',
    title: ['Des solutions qui', 'transforment votre', 'activité.'],
    titleHighlight: [false, false, true],
    subtitle: 'Quatre plateformes complètes pensées pour le marché africain.',
    primaryCta: { href: '/#solutions', label: 'Explorer les solutions' },
    secondaryCta: null,
    products: products.slice(0, 4).map(p => ({
      name: p.name,
      slug: p.slug,
      accentColor: p.accentColor,
      iconPath: p.iconPath,
      shortDesc: p.description.substring(0, 60) + '...',
      url: p.externalUrl || `https://${p.slug}.ftci.fr`
    })),
    showLogo: false,
    theme: 'gradient'
  },
  {
    id: 'services',
    eyebrow: 'Expertise & Accompagnement',
    title: ['Un partenaire', 'technique de', 'confiance.'],
    titleHighlight: [false, false, true],
    subtitle: 'De la stratégie digitale à la réalisation technique, nous accompagnons votre transformation.',
    primaryCta: { href: '/#contact', label: 'Démarrer un projet' },
    secondaryCta: null,
    services: [
      { icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5h.01', name: 'Transformation Digitale', desc: 'Stratégie & implémentation', color: '#EE6C1A' },
      { icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4', name: 'Développement Sur Mesure', desc: 'Web, mobile & API', color: '#1a8c42' },
      { icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2', name: 'Infrastructure IT', desc: 'Cloud & DevOps', color: '#6b7fc7' },
      { icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', name: 'Tech Assistance & Formation', desc: 'Assistance IT, Formations & IA', color: '#d45a0f' }
    ],
    showLogo: false,
    theme: 'navy'
  }
];
---

<section class="hero-slider relative overflow-hidden" id="contenu" data-hero-slider>

  <!-- CSS différé pour les slides 2 (Solutions/dispersion) et 3 (Services/wow-cards).
       Ces styles ne sont pas nécessaires au rendu initial (slide 1 = enterprise).
       Pattern Filament Group : media="print" + onload swap → non bloquant, chargé
       en parallèle après le rendu critique. Fallback <noscript> pour accessibility. -->
  <link rel="stylesheet" href="/css/hero-deferred.css" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="/css/hero-deferred.css" /></noscript>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BACKGROUND LAYER
       ═══════════════════════════════════════════════════════════════════════ -->
  <div class="hero-bg-layer absolute inset-0" aria-hidden="true">
    <div class="mesh-container">
      <div class="mesh-blob mesh--periwinkle"></div>
      <div class="mesh-blob mesh--green"></div>
      <div class="mesh-blob mesh--orange"></div>
      <div class="mesh-blob mesh--navy"></div>
    </div>
    <div class="grid-pattern"></div>
    <div class="geo-shapes">
      <div class="geo-shape geo--diamond geo--1"></div>
      <div class="geo-shape geo--ring geo--2"></div>
      <div class="geo-shape geo--triangle geo--3"></div>
      <div class="geo-shape geo--dot geo--4"></div>
    </div>
    <div class="gradient-overlay"></div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SLIDES CONTAINER
       ═══════════════════════════════════════════════════════════════════════ -->
  <div class="slides-wrapper">
    
    {slides.map((slide, index) => (
      <article 
        class={`hero-slide slide-type--${slide.id} ${index === 0 ? 'is-active' : ''}`}
        data-slide={index}
        data-slide-id={slide.id}
        role="group"
        aria-roledescription="slide"
        aria-label={`Slide ${index + 1} sur ${slides.length}`}
      >
        <div class={`slide-tint slide-tint--${slide.theme}`}></div>
        
        <!-- ════════════════════════════════════════════════════════════════
             SLIDE 1: ENTERPRISE - Logo + Content
             ════════════════════════════════════════════════════════════════ -->
        {slide.id === 'enterprise' && (
          <div class="slide-layout layout-enterprise">
            <!-- Left: Content -->
            <div class="content-zone content-left">
              <div class="eyebrow-block">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-text">{slide.eyebrow}</span>
              </div>

              <h1 class="title-block" aria-label={slide.title.join(' ')}>
                {slide.title.map((line, i) => (
                  <span class={`title-line ${slide.titleHighlight[i] ? 'highlight' : ''}`} data-line-index={i}>
                    <span class="line-text">{line}</span>
                    <span class="line-bg"></span>
                  </span>
                ))}
              </h1>

              <p class="subtitle-block">{slide.subtitle}</p>

              <div class="ctas-row">
                <a href={slide.primaryCta.href} class="cta-primary magnetic" data-magnetic="18">
                  <span class="cta-content">
                    {slide.primaryCta.label}
                    <svg class="cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                  <span class="cta-bg"></span>
                </a>
                {slide.secondaryCta && (
                  <a href={slide.secondaryCta.href} class="cta-secondary magnetic" data-magnetic="14">
                    <span>{slide.secondaryCta.label}</span>
                  </a>
                )}
              </div>

              <!-- Stats -->
              <div class="stats-grid">
                {slide.stats!.map((stat, idx) => (
                  <div class="stat-card" data-stat-index={idx}>
                    <div class="stat-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={stat.icon}/>
                      </svg>
                    </div>
                    <div class="stat-value" data-count={stat.value}>{stat.value}</div>
                    <div class="stat-label">{stat.label}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Right: LOGO SHOWCASE - VISIBLE! -->
            <div class="visual-zone visual-right logo-showcase-container">
              <div class="logo-showcase">
                <!-- Animated rings -->
                <div class="orbital orbital--outer"><div class="orbital-ring"></div></div>
                <div class="orbital orbital--mid"><div class="orbital-ring"></div></div>
                <div class="orbital orbital--inner"><div class="orbital-ring"></div></div>
                
                <!-- Glow effects -->
                <div class="logo-glow logo-glow--navy"></div>
                <div class="logo-glow logo-glow--green"></div>
                <div class="logo-glow logo-glow--orange"></div>
                
                <!-- CORE LOGO - Visible! -->
                <div class="logo-core">
                  <picture>
                    <source srcset="/brand/logo-ftci-nobg.avif" type="image/avif" />
                    <source srcset="/brand/logo-ftci-nobg.webp" type="image/webp" />
                    <img
                      src="/brand/logo-ftci-nobg.png"
                      alt="Logo FTCI - Freelance Technologies Côte d'Ivoire"
                      class="logo-img"
                      width="280"
                      height="264"
                      loading="eager"
                      fetchpriority="high"
                    />
                  </picture>
                  <div class="logo-shimmer"></div>
                  <div class="logo-pulse-ring"></div>
                </div>
                
                <!-- Badge -->
                <div class="logo-badge">
                  <span class="badge-text">FTCI</span>
                  <span class="badge-sub">Technologies</span>
                </div>
                
                <!-- Floating particles -->
                <div class="particles">
                  {[...Array(8)].map((_, i) => (
                    <div class={`particle particle--${i + 1}`} key={i}></div>
                  ))}
                </div>

                <!-- Data points orbiting -->
                <div class="data-orbit">
                  <div class="data-point data-point--1">SaaS</div>
                  <div class="data-point data-point--2">Cloud</div>
                  <div class="data-point data-point--3">AI</div>
                  <div class="data-point data-point--4">CI</div>
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- ════════════════════════════════════════════════════════════════
             SLIDE 2: SOLUTIONS - Dispersion/Recomposition Animation
             ════════════════════════════════════════════════════════════════ -->
        {slide.id === 'solutions' && (
          <div class="slide-layout layout-solutions">
            <!-- Left: Content -->
            <div class="content-zone content-left-sol">
              <div class="eyebrow-block">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-text">{slide.eyebrow}</span>
              </div>

              <h2 class="title-block">
                {slide.title.map((line, i) => (
                  <span class={`title-line ${slide.titleHighlight[i] ? 'highlight' : ''}`} data-line-index={i}>
                    <span class="line-text">{line}</span>
                    <span class="line-bg"></span>
                  </span>
                ))}
              </h2>

              <p class="subtitle-block">{slide.subtitle}</p>

              <div class="ctas-row">
                <a href={slide.primaryCta.href} class="cta-primary magnetic" data-magnetic="18">
                  <span class="cta-content">
                    {slide.primaryCta.label}
                    <svg class="cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                  <span class="cta-bg"></span>
                </a>
              </div>
            </div>

            <!-- Right: SOLUTIONS DISPERSION SHOWCASE -->
            <div class="visual-zone visual-right-sol dispersion-stage">
              <div class="dispersion-container">
                {slide.products!.map((product, idx) => {
                  const accent = accentColorClasses[product.accentColor];
                  // Mapping accentColor → hex pour le glow (cohérent avec Products.astro)
                  const haloHex: Record<string, string> = {
                    orange: '#ee6c1a',
                    green: '#1e9e4f',
                    periwinkle: '#6b7fc7',
                    navy: '#0f1e3d',
                  };
                  const positions = [
                    { x: '-8%', y: '5%', delay: 0.35, rotation: -6 },
                    { x: '18%', y: '-5%', delay: 0.55, rotation: 4 },
                    { x: '-3%', y: '52%', delay: 0.75, rotation: -3 },
                    { x: '15%', y: '48%', delay: 0.95, rotation: 5 }
                  ];
                  const pos = positions[idx] || positions[0];
                  
                  return (
                    <a 
                      href={product.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={`dispersion-card dispersion-card--${idx + 1} ${accent.bg}`}
                      data-dispersion-index={idx}
                      style={`--disp-x: ${pos.x}; --disp-y: ${pos.y}; --disp-delay: ${pos.delay}s; --disp-rot: ${pos.rotation}deg;`}
                    >
                      <div class="dispersion-inner">
                        <div class="dispersion-icon-wrap">
                          <svg class="dispersion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={product.iconPath}/>
                          </svg>
                          <div class="icon-pulse"></div>
                        </div>
                        <div class="dispersion-content">
                          <span class="dispersion-name">{product.name}</span>
                          <span class="dispersion-desc">{product.shortDesc}</span>
                        </div>
                        <div class="dispersion-link">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                          </svg>
                        </div>
                      </div>
                      <div class="dispersion-glow" style={`background: ${haloHex[product.accentColor] || '#6b7fc7'}`}></div>
                      <div class="dispersion-trail"></div>
                    </a>
                  );
                })}
                
                <!-- Central hub element -->
                <div class="dispersion-hub">
                  <div class="hub-core"></div>
                  <div class="hub-ring hub-ring--1"></div>
                  <div class="hub-ring hub-ring--2"></div>
                  <div class="hub-ring hub-ring--3"></div>
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- ════════════════════════════════════════════════════════════════
             SLIDE 3: SERVICES - Cards on Right with WOW Effects
             ════════════════════════════════════════════════════════════════ -->
        {slide.id === 'services' && (
          <div class="slide-layout layout-services">
            <!-- Left: Content Only -->
            <div class="content-zone content-left-svc">
              <div class="eyebrow-block">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-text">{slide.eyebrow}</span>
              </div>

              <h2 class="title-block">
                {slide.title.map((line, i) => (
                  <span class={`title-line ${slide.titleHighlight[i] ? 'highlight' : ''}`} data-line-index={i}>
                    <span class="line-text">{line}</span>
                    <span class="line-bg"></span>
                  </span>
                ))}
              </h2>

              <p class="subtitle-block">{slide.subtitle}</p>

              <div class="ctas-row">
                <a href={slide.primaryCta.href} class="cta-primary magnetic" data-magnetic="18">
                  <span class="cta-content">
                    {slide.primaryCta.label}
                    <svg class="cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                  <span class="cta-bg"></span>
                </a>
              </div>

              <!-- Decorative element -->
              <div class="content-deco">
                <div class="deco-line"></div>
                <div class="deco-dots">
                  {[...Array(5)].map((_, i) => (
                    <span class="deco-dot" key={i}></span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right: SERVICE CARDS with WOW Effects -->
            <div class="visual-zone visual-right-svc cards-showcase">
              <div class="cards-stack">
                {slide.services!.map((service, idx) => (
                  <div 
                    class={`service-wow-card service-wow-card--${idx + 1}`}
                    data-service-index={idx}
                    style={`--svc-color: ${service.color}; --svc-delay: ${0.4 + idx * 0.15}s;`}
                  >
                    <div class="svc-card-inner">
                      <div class="svc-card-bg" style={`background: linear-gradient(135deg, ${service.color}15, transparent)`}></div>
                      <div class="svc-card-border" style={`border-color: ${service.color}30`}></div>
                      <div class="svc-card-glow" style={`background: ${service.color}`}></div>
                      
                      <div class="svc-icon-float">
                        <div class="svc-icon-ring" style={`border-color: ${service.color}50`}></div>
                        <svg class="svc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" style={`color: ${service.color}`}>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.icon}/>
                        </svg>
                      </div>
                      
                      <div class="svc-content">
                        {/* Teaser card inside the hero slider — the authoritative
                            heading hierarchy (h2 "Nos Services" + one h3 per service)
                            lives in src/components/Services.astro. Keeping these as
                            plain divs avoids duplicating the 4 service titles as <h3>
                            in the DOM, which diluted the SEO signal. The .svc-name
                            class preserves the visual styling. */}
                        <div class="svc-name">{service.name}</div>
                        <p class="svc-desc">{service.desc}</p>
                      </div>
                      
                      <div class="svc-hover-line" style={`background: ${service.color}`}></div>
                      
                      <div class="svc-corner svc-corner--tl" style={`border-color: ${service.color}`}></div>
                      <div class="svc-corner svc-corner--br" style={`border-color: ${service.color}`}></div>
                    </div>
                    
                    <div class="svc-particles">
                      {[...Array(3)].map((_, i) => (
                        <div class="svc-particle" style={`--particle-delay: ${i * 0.2}s; background: ${service.color}`}></div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              
              <div class="cards-bg-deco">
                <div class="cards-mesh cards-mesh--1"></div>
                <div class="cards-mesh cards-mesh--2"></div>
              </div>
            </div>
          </div>
        )}
      </article>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       NAVIGATION SYSTEM
       ═══════════════════════════════════════════════════════════════════════ -->
  
  <div class="slide-counter">
    <span class="counter-current">01</span>
    <span class="counter-sep">/</span>
    <span class="counter-total">03</span>
  </div>

  <div class="progress-track">
    <div class="progress-fill"></div>
  </div>

  <nav class="dots-nav" role="tablist" aria-label="Navigation slides">
    {slides.map((_, idx) => (
      <button 
        class={`dot-btn ${idx === 0 ? 'is-active' : ''}`}
        role="tab"
        aria-selected={idx === 0 ? 'true' : 'false'}
        aria-label={`Slide ${idx + 1}`}
        data-dot={idx}
      >
        <span class="dot-fill"></span>
      </button>
    ))}
  </nav>

  <button class="nav-arrow nav-prev" aria-label="Slide précédent" data-dir="prev">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button class="nav-arrow nav-next" aria-label="Slide suivant" data-dir="next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>

  <a href="/#solutions" class="scroll-hint" aria-label="Défiler vers le contenu">
    <div class="scroll-line"></div>
    <span class="scroll-text">Scroll</span>
  </a>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     BASE STRUCTURE
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-slider {
    position: relative;
    width: 100%;
    height: 85vh;
    height: 85svh;
    background: #070e1a;
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     BACKGROUND LAYER
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .mesh-container {
    position: absolute;
    inset: 0;
    filter: blur(80px);
    opacity: 0.6;
  }

  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .mesh--periwinkle {
    width: 60vw; height: 55vw;
    top: -15%; left: -10%;
    background: radial-gradient(circle, rgba(107, 127, 199, 0.4), transparent 70%);
    animation: meshFloat 25s ease-in-out infinite alternate;
  }

  .mesh--green {
    width: 50vw; height: 45vw;
    top: 5%; right: -15%;
    background: radial-gradient(circle, rgba(30, 158, 79, 0.3), transparent 70%);
    animation: meshFloat 30s ease-in-out infinite alternate-reverse;
  }

  .mesh--orange {
    width: 55vw; height: 50vw;
    bottom: -20%; right: 10%;
    background: radial-gradient(circle, rgba(238, 108, 26, 0.28), transparent 70%);
    animation: meshFloat 28s ease-in-out infinite alternate;
  }

  .mesh--navy {
    width: 45vw; height: 40vw;
    bottom: -10%; left: 20%;
    background: radial-gradient(circle, rgba(15, 30, 61, 0.5), transparent 70%);
    animation: meshFloat 32s ease-in-out infinite alternate-reverse;
  }

  @keyframes meshFloat {
    to { transform: translate(4%, 3%) scale(1.08); }
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
  }

  .geo-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .geo-shape {
    position: absolute;
    opacity: 0.15;
  }

  .geo--diamond {
    width: 120px; height: 120px;
    top: 15%; right: 15%;
    background: linear-gradient(135deg, #EE6C1A, transparent);
    transform: rotate(45deg);
    animation: geoPulse 8s ease-in-out infinite, geoRotate 20s linear infinite;
  }

  .geo--ring {
    width: 200px; height: 200px;
    bottom: 20%; left: 10%;
    border: 2px solid #1a8c42;
    border-radius: 50%;
    animation: geoPulse 10s ease-in-out infinite 1s, geoScale 15s ease-in-out infinite;
  }

  .geo--triangle {
    width: 0; height: 0;
    top: 40%; left: 5%;
    border-left: 40px solid transparent;
    border-right: 40px solid transparent;
    border-bottom: 70px rgba(107, 127, 199, 0.3);
    animation: geoPulse 12s ease-in-out infinite 2s;
  }

  .geo--dot {
    width: 12px; height: 12px;
    top: 25%; left: 25%;
    background: #EE6C1A;
    border-radius: 50%;
    animation: geoBlink 4s ease-in-out infinite;
  }

  @keyframes geoPulse {
    0%, 100% { opacity: 0.1; transform: scale(1); }
    50% { opacity: 0.25; transform: scale(1.1); }
  }

  @keyframes geoRotate {
    to { transform: rotate(405deg); }
  }

  @keyframes geoScale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  @keyframes geoBlink {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.6; }
  }

  .gradient-overlay {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 20% 50%, transparent 40%, #070e1a 90%),
      linear-gradient(to bottom, transparent 60%, #070e1a 95%);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     SLIDES SYSTEM
     ═══════════════════════════════════════════════════════════════════════════ */
  .slides-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateX(80px) scale(0.98);
    transition:
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.75s;
    pointer-events: none;
    /* Isolate each slide's rendering so layout/paint work in one slide
       doesn't trigger reflow cascades in the others. Safe on all browsers. */
    contain: layout style paint;
  }

  .hero-slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateX(0) scale(1);
    pointer-events: auto;
  }

  /* Performance: skip layout & paint of non-active slides entirely.
     The slide content stays in the DOM (crawlable by search engines —
     the h1/h2 hierarchy we rely on for SEO is preserved), but the
     browser skips computing styles, layout and paint for the 2 hidden
     slides until one becomes active. On a 3-slide hero this cuts the
     initial render work by ~⅔.

     `contain-intrinsic-size` reserves a placeholder box so the browser
     doesn't have to do a layout pass to know the slide's size. The
     slides are position:absolute so this is belt-and-suspenders, but
     keeps the rule correct if the positioning ever changes.

     Guarded with @supports so older browsers (Safari <18, Firefox <125)
     simply fall back to the visibility:hidden behaviour above. */
  @supports (content-visibility: auto) {
    .hero-slide:not(.is-active) {
      content-visibility: auto;
      contain-intrinsic-size: 100% 600px;
    }
  }

  .hero-slide.slide-exit-left {
    transform: translateX(-80px) scale(0.98);
  }

  /* Slide Tint */
  .slide-tint {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }

  .hero-slide.is-active .slide-tint {
    opacity: 1;
  }

  .slide-tint--dark {
    background: radial-gradient(ellipse at 25% 50%, rgba(15, 30, 61, 0.3), transparent 60%);
  }

  .slide-tint--gradient {
    background: 
      radial-gradient(ellipse at 75% 35%, rgba(238, 108, 26, 0.1), transparent 50%),
      radial-gradient(ellipse at 25% 65%, rgba(30, 158, 79, 0.08), transparent 50%);
  }

  .slide-tint--navy {
    background: radial-gradient(ellipse at 50% 50%, rgba(107, 127, 199, 0.12), transparent 65%);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LAYOUT SYSTEM - Different layouts per slide type
     ═══════════════════════════════════════════════════════════════════════════ */
  
  .slide-layout {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
    gap: 2rem;
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 85svh;
    max-height: 85svh;
    align-content: center;
    position: relative;
    z-index: 2;
  }

  .layout-enterprise {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
  }

  .layout-solutions {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
  }

  .layout-services {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
  }

  @media (min-width: 1024px) {
    .slide-layout {
      grid-template-columns: 1fr 1.2fr;
      grid-template-rows: 1fr;
      gap: 3rem;
      padding: 0 3rem;
      align-items: center;
    }

    .layout-enterprise {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .layout-solutions {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3rem;
    }

    .layout-services {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 2.5rem;
    }
  }

  /* Content Zone Base */
  .content-zone {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    order: 1;
  }

  @media (min-width: 1024px) {
    .content-zone {
      padding: 2rem 0;
    }
    
    .content-left-sol,
    .content-left-svc {
      justify-content: center;
    }
  }

  /* Visual Zone Base */
  .visual-zone {
    display: flex;
    align-items: center;
    justify-content: center;
    order: 2;
    min-height: 280px;
  }

  @media (min-width: 1024px) {
    .visual-zone {
      min-height: 400px;
      position: relative;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     TYPOGRAPHY & CONTENT ELEMENTS (Shared)
     ═══════════════════════════════════════════════════════════════════════════ */

  /* Eyebrow */
  .eyebrow-block {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(15px);
  }

  .hero-slide.is-active .eyebrow-block {
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.1s;
  }

  .eyebrow-line {
    width: 28px;
    height: 2px;
    background: linear-gradient(90deg, #EE6C1A, transparent);
    border-radius: 1px;
  }

  .eyebrow-text {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #EE6C1A;
  }

  /* Title Block */
  .title-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0.5rem 0;
  }

  .title-line {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .line-text {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: clamp(1.75rem, 1.2rem + 3vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: white;
    /* opacity intentionally kept at 1 — SEO fix: crawlers (Bingbot, Google)
       must read the <h1> text. Visual hiding is handled by
       overflow:hidden on .title-line + translateY(110%). */
    transform: translateY(110%);
  }

  .hero-slide.is-active .line-text {
    animation: lineReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.2s + var(--line-index, 0) * 0.1s);
  }

  .title-line.highlight .line-text {
    color: #EE6C1A;
  }

  .line-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(238, 108, 26, 0.1), transparent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero-slide.is-active .highlight .line-bg {
    animation: lineBgReveal 0.5s ease forwards;
    animation-delay: calc(0.5s + var(--line-index, 0) * 0.1s);
  }

  @keyframes lineReveal {
    to { transform: translateY(0); }
  }

  @keyframes lineBgReveal {
    to { transform: scaleX(1); }
  }

  /* Subtitle */
  .subtitle-block {
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.125rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    max-width: 520px;
    margin-top: 0.75rem;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-slide.is-active .subtitle-block {
    animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.55s;
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* CTAs */
  .ctas-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-slide.is-active .ctas-row {
    animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.7s;
  }

  .cta-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    background: linear-gradient(135deg, #EE6C1A, #d45a0f);
    color: white;
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 14px;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(238, 108, 26, 0.3);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 35px rgba(238, 108, 26, 0.45);
  }

  .cta-content {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    position: relative;
    z-index: 1;
  }

  .cta-arrow {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.2));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cta-primary:hover .cta-bg {
    opacity: 1;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.75rem;
    color: white;
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 14px;
    text-decoration: none;
    backdrop-filter: blur(10px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     STATS GRID (Enterprise Slide)
     ═══════════════════════════════════════════════════════════════════════════ */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    opacity: 0;
    transform: translateY(25px);
  }

  .hero-slide.is-active .stats-grid {
    animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.85s;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 0.5rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.35s ease;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-slide.is-active .stat-card:nth-child(1) { animation: statIn 0.5s ease 0.9s forwards; }
  .hero-slide.is-active .stat-card:nth-child(2) { animation: statIn 0.5s ease 1s forwards; }
  .hero-slide.is-active .stat-card:nth-child(3) { animation: statIn 0.5s ease 1.1s forwards; }

  @keyframes statIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .stat-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(238, 108, 26, 0.3);
    transform: translateY(-3px);
  }

  .stat-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    color: #EE6C1A;
  }

  .stat-icon svg {
    width: 22px;
    height: 22px;
  }

  .stat-value {
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: 1.75rem;
    color: white;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.35rem;
  }

  /* Mobile : les 3 stat cards tiennent en une ligne (3 × 103px sur 390px)
     mais le contenu était cramped. On compacte le padding, la taille de
     l'icône et du label pour que tout respire mieux sans stacked layout
     (garder les 3 en ligne garde l'effet "stats dashboard" du Hero). */
  @media (max-width: 640px) {
    .stats-grid {
      gap: 0.5rem;
      margin-top: 1.5rem;
      padding-top: 1.25rem;
    }
    .stat-card {
      padding: 0.625rem 0.25rem;
    }
    .stat-icon {
      width: 28px;
      height: 28px;
      margin-bottom: 0.25rem;
    }
    .stat-icon svg {
      width: 18px;
      height: 18px;
    }
    .stat-value {
      font-size: 1.3rem;
    }
    .stat-label {
      font-size: 0.58rem;
      letter-spacing: 0.05em;
      margin-top: 0.2rem;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LOGO SHOWCASE (Enterprise Slide) - VISIBLE & ENHANCED
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-showcase-container {
    position: relative;
  }

  .logo-showcase {
    position: relative;
    width: 260px;
    height: 285px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .logo-showcase {
      width: 310px;
      height: 335px;
    }
  }

  /* Orbital Rings - Enhanced */
  .orbital {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orbital--outer {
    width: 140%;
    height: 140%;
    opacity: 0;
  }

  .orbital--mid {
    width: 125%;
    height: 125%;
    opacity: 0;
  }

  .orbital--inner {
    width: 110%;
    height: 110%;
    opacity: 0;
  }

  .hero-slide.is-active .orbital--outer {
    animation: orbitalFade 1s ease 0.4s forwards, orbitalSpin 28s linear 1.4s infinite;
  }

  .hero-slide.is-active .orbital--mid {
    animation: orbitalFade 1s ease 0.55s forwards, orbitalSpin 22s linear 1.55s infinite reverse;
  }

  .hero-slide.is-active .orbital--inner {
    animation: orbitalFade 1s ease 0.7s forwards, orbitalSpin 18s linear 1.7s infinite;
  }

  @keyframes orbitalFade {
    to { opacity: 1; }
  }

  @keyframes orbitalSpin {
    to { transform: rotate(360deg); }
  }

  .orbital-ring {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border-style: dashed;
    border-width: 1.5px;
  }

  .orbital--outer .orbital-ring {
    border-color: rgba(238, 108, 26, 0.2);
  }

  .orbital--mid .orbital-ring {
    border-color: rgba(107, 127, 199, 0.18);
    border-style: dotted;
  }

  .orbital--inner .orbital-ring {
    border-color: rgba(26, 140, 66, 0.2);
  }

  /* Glows - Positioned around logo */
  .logo-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(55px);
    pointer-events: none;
    opacity: 0;
  }

  .hero-slide.is-active .logo-glow {
    animation: glowPulse 6s ease-in-out infinite;
  }

  .logo-glow--navy {
    width: 75%; height: 65%; top: -12%; left: -18%;
    background: radial-gradient(circle, rgba(30, 58, 95, 0.55), transparent 70%);
    animation-delay: 0.2s;
  }

  .logo-glow--green {
    width: 68%; height: 58%; top: 3%; right: -18%;
    background: radial-gradient(circle, rgba(26, 140, 66, 0.45), transparent 70%);
    animation-delay: 0.9s;
  }

  .logo-glow--orange {
    width: 78%; height: 62%; bottom: -12%; left: 2%;
    background: radial-gradient(circle, rgba(212, 90, 15, 0.45), transparent 70%);
    animation-delay: 1.6s;
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50% { opacity: 0.65; transform: scale(1.08); }
  }

  /* Core Logo - THE MAIN ELEMENT - Now properly visible */
  .logo-core {
    position: relative;
    width: 72%;
    z-index: 10;
  }

  .logo-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    opacity: 0;
    filter: drop-shadow(0 0 35px rgba(107, 127, 199, 0.3));
  }

  /* Logo stays visible when slide is active - animation fills forwards */
  .hero-slide.is-active .logo-img {
    opacity: 1;
    clip-path: circle(120% at 50% 50%);
    transform: scale(1) rotate(0deg);
    filter: drop-shadow(0 0 30px rgba(107, 127, 199, 0.28));
    animation: logoRevealMaster 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards,
               logoGentleFloat 6s ease-in-out 2s infinite,
               logoRadiantGlow 4s ease-in-out 2.2s infinite;
  }

  @keyframes logoRevealMaster {
    0% { 
      opacity: 0; 
      clip-path: circle(0% at 50% 50%); 
      transform: scale(0.8) rotate(-5deg); 
      filter: drop-shadow(0 0 0px rgba(107, 127, 199, 0)) blur(10px);
    }
    40% { 
      opacity: 0.8; 
      clip-path: circle(60% at 50% 50%); 
      transform: scale(0.95) rotate(-1deg);
      filter: drop-shadow(0 0 20px rgba(107, 127, 199, 0.25)) blur(3px);
    }
    70% { 
      opacity: 1; 
      clip-path: circle(90% at 50% 50%); 
      transform: scale(1.02) rotate(0.5deg);
      filter: drop-shadow(0 0 35px rgba(107, 127, 199, 0.3)) blur(0px);
    }
    85% { 
      transform: scale(1.01) rotate(0deg);
    }
    100% { 
      clip-path: circle(120% at 50% 50%); 
      transform: scale(1) rotate(0deg); 
      filter: drop-shadow(0 0 30px rgba(107, 127, 199, 0.28));
    }
  }

  @keyframes logoGentleFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes logoRadiantGlow {
    0%, 100% { filter: drop-shadow(0 0 25px rgba(107, 127, 199, 0.25)) drop-shadow(0 0 10px rgba(238, 108, 26, 0.15)); }
    50% { filter: drop-shadow(0 0 50px rgba(107, 127, 199, 0.45)) drop-shadow(0 0 25px rgba(238, 108, 26, 0.25)); }
  }

  /* Shimmer overlay on logo */
  .logo-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg, transparent 25%,
      rgba(255, 255, 255, 0.08) 48%,
      rgba(255, 255, 255, 0.15) 52%,
      rgba(255, 255, 255, 0.08) 57%,
      transparent 80%
    );
    background-size: 350% 350%;
    pointer-events: none;
    opacity: 0;
    border-radius: 12px;
  }

  .hero-slide.is-active .logo-shimmer {
    animation: shimmerIn 0.5s ease 2.4s forwards, shimmerMove 6s ease-in-out 2.9s infinite;
  }

  @keyframes shimmerIn { to { opacity: 1; } }
  @keyframes shimmerMove {
    0%, 100% { background-position: 250% 250%; }
    50% { background-position: 0% 0%; }
  }

  /* Pulse ring around logo */
  .logo-pulse-ring {
    position: absolute;
    inset: -15%;
    border: 2px solid rgba(238, 108, 26, 0.3);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .hero-slide.is-active .logo-pulse-ring {
    animation: pulseRingExpand 3s ease-out 2.5s infinite;
  }

  @keyframes pulseRingExpand {
    0% { transform: scale(0.85); opacity: 0.6; }
    100% { transform: scale(1.3); opacity: 0; }
  }

  /* Badge below logo */
  .logo-badge {
    position: absolute;
    bottom: -38px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    opacity: 0;
    z-index: 10;
  }

  .hero-slide.is-active .logo-badge {
    animation: badgeSlideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1.6s forwards;
  }

  @keyframes badgeSlideUp {
    0% { opacity: 0; transform: translateX(-50%) translateY(15px); }
    100% { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .badge-text {
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 25px rgba(0, 0, 0, 0.4);
  }

  .badge-sub {
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #EE6C1A;
    text-shadow: 0 2px 18px rgba(238, 108, 26, 0.5);
  }

  /* Particles around logo */
  .particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  .particle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: rgba(238, 108, 26, 0.65);
    border-radius: 50%;
    opacity: 0;
  }

  .hero-slide.is-active .particle {
    animation: particleOrbit 5s ease-in-out infinite;
  }

  .particle--1 { top: 8%; left: 18%; animation-delay: 1.8s; }
  .particle--2 { top: 22%; right: 12%; animation-delay: 2.2s; background: rgba(30, 158, 79, 0.65); }
  .particle--3 { bottom: 28%; left: 8%; animation-delay: 2.6s; background: rgba(107, 127, 199, 0.65); }
  .particle--4 { bottom: 12%; right: 22%; animation-delay: 3s; }
  .particle--5 { top: 42%; left: 2%; animation-delay: 3.4s; background: rgba(238, 108, 26, 0.45); width: 4px; height: 4px; }
  .particle--6 { top: 58%; right: 5%; animation-delay: 3.8s; background: rgba(30, 158, 79, 0.45); width: 4px; height: 4px; }
  .particle--7 { top: 5%; left: 50%; animation-delay: 4.2s; background: rgba(107, 127, 199, 0.5); width: 5px; height: 5px; }
  .particle--8 { bottom: 5%; left: 45%; animation-delay: 4.6s; background: rgba(238, 108, 26, 0.5); width: 5px; height: 5px; }

  @keyframes particleOrbit {
    0% { opacity: 0; transform: translateY(0) scale(0); }
    15% { opacity: 1; transform: translateY(-8px) scale(1); }
    70% { opacity: 0.5; transform: translateY(-25px) scale(0.75); }
    100% { opacity: 0; transform: translateY(-35px) scale(0); }
  }

  /* Data Orbit Points */
  .data-orbit {
    position: absolute;
    inset: -10%;
    pointer-events: none;
    animation: dataOrbitRotate 25s linear infinite;
  }

  @keyframes dataOrbitRotate {
    to { transform: rotate(360deg); }
  }

  .data-point {
    position: absolute;
    font-family: var(--font-display), sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #0f1e3d;
    padding: 0.3rem 0.6rem;
    background: #ffffff;
    border-radius: 6px;
    border: 1px solid rgba(15, 30, 61, 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .data-point--1 { top: 0; left: 50%; transform: translateX(-50%); }
  .data-point--2 { right: 0; top: 50%; transform: translateY(-50%); }
  .data-point--3 { bottom: 0; left: 50%; transform: translateX(-50%); }
  .data-point--4 { left: 0; top: 50%; transform: translateY(-50%); }

  /* Slides 2 (Solutions/dispersion) et 3 (Services/wow-cards) — CSS différé.
     Voir public/css/hero-deferred.css, chargé en lazy ci-dessous dans le <head> du composant. */
  /* ═══════════════════════════════════════════════════════════════════════════
     NAVIGATION COMPONENTS
     ═══════════════════════════════════════════════════════════════════════════ */

  /* Slide Counter */
  .slide-counter {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-display), sans-serif;
    z-index: 20;
  }

  .counter-current {
    font-size: 1.5rem;
    font-weight: 800;
    color: white;
    min-width: 1.5ch;
  }

  .counter-sep {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .counter-total {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.3);
  }

  /* Progress Track */
  .progress-track {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    z-index: 20;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #EE6C1A, #f97316);
    transition: width 0.1s linear;
  }

  .progress-track.is-animating .progress-fill {
    animation: progressFill 8s linear forwards;
  }

  @keyframes progressFill {
    from { width: 0%; }
    to { width: 100%; }
  }

  /* Dots Nav */
  .dots-nav {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.65rem;
    padding: 0.6rem 1rem;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(12px);
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    z-index: 20;
  }

  .dot-btn {
    position: relative;
    width: 32px;
    height: 4px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    overflow: hidden;
    transition: background 0.3s ease;
    padding: 0;
  }

  .dot-btn:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  .dot-btn.is-active {
    background: rgba(255, 255, 255, 0.3);
  }

  .dot-fill {
    position: absolute;
    inset: 0;
    background: #EE6C1A;
    border-radius: 99px;
    transform: scaleX(0);
    transform-origin: left;
  }

  .dot-btn.is-active .dot-fill {
    animation: dotFill 8s linear forwards;
  }

  @keyframes dotFill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .dots-nav.is-paused .dot-fill {
    animation-play-state: paused;
  }

  /* Arrow Buttons */
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    color: white;
    cursor: pointer;
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
  }

  .hero-slider:hover .nav-arrow {
    opacity: 1;
  }

  .nav-arrow:hover {
    background: rgba(238, 108, 26, 0.85);
    border-color: rgba(238, 108, 26, 0.5);
    transform: translateY(-50%) scale(1.08);
  }

  .nav-arrow svg {
    width: 20px;
    height: 20px;
  }

  .nav-prev { left: 1.5rem; }
  .nav-next { right: 1.5rem; }

  @media (max-width: 767px) {
    .nav-arrow { display: none; }
    .slide-counter { display: none; }
  }

  /* Scroll Hint */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    z-index: 20;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .scroll-hint:hover { opacity: 1; }

  .scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, #EE6C1A, transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50% { transform: scaleY(0.6); opacity: 0.5; }
  }

  .scroll-text {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.5);
    writing-mode: vertical-rl;
  }

  @media (max-width: 767px) {
    .scroll-hint {
      bottom: 5.5rem;
      right: 50%;
      transform: translateX(50%);
      flex-direction: row;
    }
    .scroll-text { writing-mode: horizontal-tb; }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     REDUCED MOTION
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition: opacity 0.3s ease !important;
      transform: none !important;
    }
    .hero-slide.is-active { transform: none !important; }
    .hero-slide.slide-exit-left { transform: none !important; }
    
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0ms !important;
      transition-duration: 0.01ms !important;
    }
    
    .line-text, .eyebrow-block, .subtitle-block, .ctas-row,
    .stats-grid, .stat-card, .dispersion-card, .service-wow-card,
    .logo-img, .logo-badge, .logo-glow, .orbital--outer, .orbital--mid,
    .orbital--inner, .particle, .dispersion-hub, .content-deco {
      opacity: 1 !important;
      transform: none !important;
    }
    
    .dispersion-card {
      position: static;
      transform: none !important;
    }
    
    .service-wow-card {
      transform: none !important;
    }
  }

  /* Mobile Adjustments */
  @media (max-width: 1023px) {
    .visual-zone { display: none; }
    .slide-layout { 
      padding: 5rem 1.5rem 6.5rem;
      justify-content: center;
    }
    .mesh-blob { filter: blur(70px); }
    .geo-shape { display: none; }
    
    .slide-type--solutions .content-zone,
    .slide-type--services .content-zone {
      margin-bottom: 2rem;
    }
  }
</style>

<script>
function initHeroSliderV8() {
  const slider = document.querySelector('[data-hero-slider]');
  if (!slider) return;

  const slides = Array.from(slider.querySelectorAll<HTMLElement>('.hero-slide'));
  const dots = Array.from(slider.querySelectorAll<HTMLElement>('.dot-btn'));
  const prevBtn = slider.querySelector<HTMLElement>('.nav-prev');
  const nextBtn = slider.querySelector<HTMLElement>('.nav-next');
  const progressTrack = slider.querySelector<HTMLElement>('.progress-track');
  const counterCurrent = slider.querySelector<HTMLElement>('.counter-current');
  const dotsNav = slider.querySelector<HTMLElement>('.dots-nav');

  if (!slides.length) return;

  let currentIndex = 0;
  let autoplayTimer: ReturnType<typeof setTimeout> | null = null;
  let isPaused = false;
  const AUTOPLAY_DELAY = 8000;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function goToSlide(index: number, direction: 'next' | 'prev' | 'direct' = 'next') {
    if (index < 0) index = slides.length - 1;
    if (index >= slides.length) index = 0;

    const currentSlide = slides[currentIndex];
    const nextSlide = slides[index];

    currentSlide.classList.remove('is-active');
    if (direction !== 'direct') {
      currentSlide.classList.add(direction === 'next' ? 'slide-exit-left' : '');
    }

    setTimeout(() => {
      currentSlide.classList.remove('slide-exit-left');
      nextSlide.classList.add('is-active');

      if (counterCurrent) {
        counterCurrent.textContent = String(index + 1).padStart(2, '0');
      }

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-selected', String(i === index));
        const fill = dot.querySelector<HTMLElement>('.dot-fill');
        if (fill) {
          fill.style.animation = 'none';
          void fill.offsetWidth;
          fill.style.animation = '';
        }
      });

      initServiceCardsTilt(nextSlide);
      
    }, prefersReducedMotion ? 0 : 150);

    currentIndex = index;
    resetAutoplay();
  }

  function nextSlide() { goToSlide(currentIndex + 1, 'next'); }
  function prevSlide() { goToSlide(currentIndex - 1, 'prev'); }

  function startAutoplay() {
    if (prefersReducedMotion || isPaused) return;
    stopAutoplay();
    progressTrack?.classList.add('is-animating');
    autoplayTimer = setTimeout(nextSlide, AUTOPLAY_DELAY);
  }

  function stopAutoplay() {
    if (autoplayTimer) clearTimeout(autoplayTimer);
    autoplayTimer = null;
    progressTrack?.classList.remove('is-animating');
  }

  function resetAutoplay() {
    stopAutoplay();
    if (!isPaused) startAutoplay();
  }

  function pauseAutoplay() {
    isPaused = true;
    stopAutoplay();
    dotsNav?.classList.add('is-paused');
  }

  function resumeAutoplay() {
    isPaused = false;
    dotsNav?.classList.remove('is-paused');
    startAutoplay();
  }

  // 3D Tilt Effect for Service Cards (Hero 3)
  function initServiceCardsTilt(slide: HTMLElement) {
    if (!slide.classList.contains('slide-type--services')) return;
    
    const cards = slide.querySelectorAll<HTMLElement>('.service-wow-card');
    
    cards.forEach(card => {
      card.addEventListener('mousemove', (e: MouseEvent) => {
        if (prefersReducedMotion) return;
        
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -8;
        const rotateY = ((x - centerX) / centerX) * 8;
        
        const inner = card.querySelector<HTMLElement>('.svc-card-inner');
        if (inner) {
          inner.style.transform = `
            perspective(1000px) 
            rotateX(${rotateX}deg) 
            rotateY(${rotateY}deg) 
            translateZ(15px) 
            translateY(-5px)
          `;
        }
      });
      
      card.addEventListener('mouseleave', () => {
        const inner = card.querySelector<HTMLElement>('.svc-card-inner');
        if (inner) {
          inner.style.transform = '';
        }
      });
    });
  }

  // Magnetic button effect
  function initMagneticButtons() {
    const buttons = slider.querySelectorAll<HTMLElement>('[data-magnetic]');
    
    buttons.forEach(btn => {
      const strength = parseFloat(btn.dataset.magnetic || '10');
      
      btn.addEventListener('mousemove', (e: MouseEvent) => {
        if (prefersReducedMotion) return;
        
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        
        btn.style.transform = `translate(${x * strength / 100}px, ${y * strength / 100}px)`;
      });
      
      btn.addEventListener('mouseleave', () => {
        btn.style.transform = '';
      });
    });
  }

  // Event Listeners
  dots.forEach((dot, i) => dot.addEventListener('click', () => goToSlide(i, i > currentIndex ? 'next' : i < currentIndex ? 'prev' : 'direct')));
  prevBtn?.addEventListener('click', prevSlide);
  nextBtn?.addEventListener('click', nextSlide);

  slider.addEventListener('mouseenter', pauseAutoplay);
  slider.addEventListener('mouseleave', resumeAutoplay);

  // Touch/Swipe
  let touchStartX = 0;
  let touchEndX = 0;

  slider.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartX = e.changedTouches[0].screenX;
    pauseAutoplay();
  }, { passive: true });

  slider.addEventListener('touchend', (e: TouchEvent) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) nextSlide();
      else prevSlide();
    }
    resumeAutoplay();
  }, { passive: true });

  // Keyboard
  slider.setAttribute('tabindex', '0');
  slider.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowLeft') prevSlide();
    else if (e.key === 'ArrowRight') nextSlide();
  });

  // Visibility
  document.addEventListener('visibilitychange', () => document.hidden ? pauseAutoplay() : resumeAutoplay());

  // Initialize
  initMagneticButtons();
  initServiceCardsTilt(slides[currentIndex]);
  
  if (!prefersReducedMotion) startAutoplay();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initHeroSliderV8);
} else {
  initHeroSliderV8();
}
</script>
 
