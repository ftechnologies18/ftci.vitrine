---
// Hero section with animated mesh gradient and CTA buttons
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
	<!-- Animated Mesh Gradient Background -->
	<div 
		class="absolute inset-0 -z-10"
		style={{
			backgroundImage: 'url(/manus-storage/ftci-hero-bg_0c9022cf.png)',
			backgroundSize: 'cover',
			backgroundPosition: 'center',
		}}
	></div>

	<!-- Animated Mosaic Pattern Overlay -->
	<div class="absolute inset-0 -z-10 opacity-5">
		<svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
			<defs>
				<pattern id="mosaic" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
					<polygon points="10,0 20,10 10,20 0,10" fill="none" stroke="#0F1E3D" stroke-width="0.5"/>
				</pattern>
			</defs>
			<rect width="100" height="100" fill="url(#mosaic)"/>
		</svg>
	</div>

	<!-- Content -->
	<div class="container relative z-10 text-center max-w-4xl mx-auto px-4">
		<!-- Main Title -->
		<h1 class="text-5xl md:text-7xl font-bold text-navy mb-6 animate-fade-in" style="animation-delay: 0.1s;">
			Freelance Technologies
			<span class="block text-transparent bg-clip-text bg-gradient-to-r from-periwinkle via-green to-orange">
				Côte d'Ivoire
			</span>
		</h1>

		<!-- Subtitle -->
		<p class="text-lg md:text-xl text-gray-text mb-8 max-w-2xl mx-auto animate-fade-in" style="animation-delay: 0.2s;">
			Transformez votre institution avec des solutions SaaS innovantes et du conseil en transformation digitale pensés pour le marché africain.
		</p>

		<!-- CTA Buttons -->
		<div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in" style="animation-delay: 0.3s;">
			<a 
				href="#solutions"
				class="btn-primary px-8 py-4 bg-orange text-white rounded-lg font-semibold hover:bg-orange-600 active:scale-95 transition-all duration-200 inline-flex items-center justify-center gap-2"
			>
				Découvrir nos solutions
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
			<a 
				href="#contact"
				class="btn-outline px-8 py-4 border-2 border-navy text-navy rounded-lg font-semibold hover:bg-navy/5 active:scale-95 transition-all duration-200"
			>
				Nous contacter
			</a>
		</div>

		<!-- Scroll Indicator -->
		<div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
			<svg class="w-6 h-6 text-navy opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
			</svg>
		</div>
	</div>
</section>

<style>
	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes bounce {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	.animate-fade-in {
		animation: fadeIn 0.6s ease-out forwards;
		opacity: 0;
	}

	.animate-bounce {
		animation: bounce 2s infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.animate-fade-in,
		.animate-bounce {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
