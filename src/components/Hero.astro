---
/**
 * Hero.astro — Mosaïque Logo FTCI "Prenant Vie" — Forme Exacte
 * ────────────────────────────────────────────────────────────────────────────
 * 
 * 🎯 OBJECTIF: Recréer la FORME EXACTE du logo FTCI
 * - Forme: Cœur/Trèfle avec 3 branches courbes
 * - Navy (gauche): arc descendant courbe
 * - Verte (droite): arc descendant courbe  
 * - Orange (bas): grande courbe inférieure en U inversé
 */

interface LogoPiece {
  id: number;
  x: number;
  y: number;
  size: number;
  color: string;
  branch: string;
  delay: number;
  offsetX: number;
  offsetY: number;
  rotation: number;
}

// ═══════════════════════════════════════════════════════════════════════════
// RECONSTRUCTION PRÉCISE DU LOGO FTCI
// Analyse de l'image: forme cœur/trèfle 3 branches
// ═══════════════════════════════════════════════════════════════════════════

function generateLogoMosaic(): LogoPiece[] {
  const pieces: LogoPiece[] = [];
  let id = 0;

  // ══════════════════════════════════════════════════════════════════════════
  // BRANCHE NAVY — Arc gauche supérieur (forme du logo FTCI)
  // Courbe depuis haut-gauche, descend vers le centre en arc
  // ══════════════════════════════════════════════════════════════════════════
  const navy = [
    // Pointe haute gauche
    {x:18,y:85,s:9},{x:24,y:68,s:10},{x:32,y:52,s:11},{x:44,y:38,s:12},
    {x:58,y:26,s:12},{x:76,y:18,s:11},{x:95,y:14,s:10},{x:115,y:15,s:9},
    // Couche 2
    {x:26,y:102,s:10},{x:34,y:82,s:11},{x:44,y:64,s:12},{x:56,y:48,s:13},
    {x:72,y:35,s:13},{x:90,y:27,s:12},{x:110,y:25,s:11},{x:128,y:30,s:10},
    // Couche 3 - milieu
    {x:36,y:122,s:11},{x:46,y:100,s:12},{x:58,y:78,s:13},{x:72,y:58,s:14},
    {x:88,y:44,s:14},{x:108,y:38,s:13},{x:126,y:42,s:12},
    // Couche 4 - interne
    {x:48,y:142,s:10},{x:60,y:118,s:11},{x:76,y:94,s:12},{x:92,y:72,s:13},
    {x:110,y:56,s:12},{x:130,y:58,s:11},
    // Vers centre (pointe basse)
    {x:64,y:158,s:9},{x:84,y:136,s:10},{x:104,y:116,s:11},{x:124,y:100,s:10},
    {x:142,y:88,s:9},
  ];
  
  navy.forEach((p,i) => pieces.push(makePiece(id++,p,'navy',i,navy.length)));

  // ══════════════════════════════════════════════════════════════════════════
  // BRANCHE VERTE — Arc droit supérieur (forme du logo FTCI)
  // Courbe depuis haut-droite, descend vers le centre en arc
  // ══════════════════════════════════════════════════════════════════════════
  const green = [
    // Pointe haute droite
    {x:245,y:16,s:9},{x:258,y:24,s:10},{x:268,y:38,s:11},{x:276,y:55,s:11},
    {x:280,y:76,s:10},
    // Couche 2
    {x:232,y:20,s:10},{x:246,y:28,s:11},{x:258,y:42,s:12},{x:268,y:58,s:12},
    {x:276,y:80,s:11},
    // Couche 3 - milieu
    {x:218,y:28,s:11},{x:232,y:38,s:12},{x:246,y:52,s:13},{x:258,y:68,s:13},
    {x:270,y:90,s:12},
    // Couche 4 - interne
    {x:204,y:40,s:11},{x:220,y:52,s:12},{x:236,y:66,s:13},{x:250,y:84,s:12},
    {x:264,y:106,s:11},
    // Vers centre (pointe basse)
    {x:190,y:56,s:10},{x:208,y:70,s:11},{x:228,y:86,s:12},{x:248,y:104,s:11},
    {x:264,y:122,s:9},
  ];
  
  green.forEach((p,i) => pieces.push(makePiece(id++,p,'green',i,green.length)));

  // ══════════════════════════════════════════════════════════════════════════
  // BRANCHE ORANGE — Grande courbe inférieure (U inversé / sourire)
  // Part bas-gauche → courbe sous le centre → remonte à droite
  // C'est la PLUS GRANDE branche - forme caractéristique du logo
  // ══════════════════════════════════════════════════════════════════════════
  const orange = [
    // Connexion navy (gauche) - remonte
    {x:40,y:165,s:10},{x:52,y:148,s:11},{x:68,y:130,s:12},
    // Montée gauche vers centre
    {x:50,y:185,s:11},{x:66,y:164,s:12},{x:86,y:144,s:13},{x:108,y:126,s:13},
    {x:130,y:114,s:12},
    // Centre-haut gauche
    {x:68,y:208,s:12},{x:90,y:184,s:13},{x:114,y:162,s:14},{x:138,y:144,s:14},
    {x:160,y:132,s:13},
    // Bas central - pointe la plus basse
    {x:95,y:230,s:14},{x:122,y:208,s:14},{x:148,y:186,s:15},{x:174,y:170,s:14},
    {x:200,y:160,s:13},
    // Centre-droit
    {x:142,y:240,s:14},{x:170,y:220,s:14},{x:196,y:200,s:13},{x:222,y:186,s:13},
    // Descente droite
    {x:188,y:250,s:13},{x:216,y:236,s:12},{x:242,y:226,s:11},{x:264,y:222,s:10},
    // Remontée extrême droite (connexion green)
    {x:228,y:262,s:11},{x:252,y:254,s:10},{x:274,y:256,s:9},
    // Remontée vers centre-droit
    {x:205,y:272,s:11},{x:232,y:264,s:10},{x:258,y:260,s:9},
    // Densification courbe basse
    {x:168,y:265,s:12},{x:194,y:252,s:12},{x:220,y:240,s:11},
    // Intermédiaires
    {x:135,y:255,s:11},{x:162,y:242,s:12},{x:188,y:228,s:11},
  ];
  
  orange.forEach((p,i) => pieces.push(makePiece(id++,p,'orange',i,orange.length)));

  // ══════════════════════════════════════════════════════════════════════════
  // PIÈCES CENTRALES — Zone de convergence (creux central du cœur)
  // Periwinkle clair pour connecter les 3 branches
  // ══════════════════════════════════════════════════════════════════════════
  const center = [
    {x:145,y:85,s:8},{x:164,y:92,s:9},{x:182,y:88,s:8},
    {x:152,y:105,s:8},{x:172,y:110,s:9},{x:160,y:125,s:7},
    {x:135,y:115,s:7},{x:185,y:120,s:7},
    {x:148,y:70,s:6},{x:175,y:74,s:6},
    {x:163,y:135,s:6},{x:140,y:95,s:7},{x:188,y:100,s:7},
  ];
  
  center.forEach((p,i) => pieces.push({
    id: id++,
    x: p.x,
    y: p.y,
    size: p.s,
    color: '#6B7FC7',
    branch: 'center',
    delay: Math.round((0.55 + Math.random() * 0.3) * 100) / 100,
    offsetX: Math.round((Math.random() - 0.5) * 180),
    offsetY: Math.round((Math.random() - 0.5) * 180),
    rotation: Math.round((Math.random() - 0.5) * 180)
  }));

  return pieces;
}

// Helper: créer une pièce avec animation cascade
function makePiece(id: number, p: {x:number;y:number;s:number}, branch: string, index: number, total: number): LogoPiece {
  const t = total > 1 ? index / (total - 1) : 0;
  return {
    id,
    x: p.x,
    y: p.y,
    size: p.s,
    color: branch === 'navy' ? '#1e3059' : branch === 'green' ? '#1a9045' : '#e85a0f',
    branch,
    delay: Math.round((t * 0.8 + Math.random() * 0.18) * 100) / 100,
    offsetX: Math.round((Math.random() - 0.5) * 400),
    offsetY: Math.round((Math.random() - 0.5) * 350),
    rotation: Math.round((Math.random() - 0.5) * 200)
  };
}

const logoPieces = generateLogoMosaic();
---

<section class="hero-section relative min-h-[100svh] flex items-center overflow-hidden" id="contenu">
  
  <!-- Mesh Background -->
  <div class="hero-mesh absolute inset-[-20%]" aria-hidden="true">
    <div class="mesh-blob mesh-blob--periwinkle"></div>
    <div class="mesh-blob mesh-blob--green"></div>
    <div class="mesh-blob mesh-blob--orange"></div>
    <div class="mesh-blob mesh-blob--navy"></div>
  </div>

  <!-- Contenu -->
  <div class="container relative z-10">
    <div class="hero-grid">
      
      <!-- Texte -->
      <div class="hero-content">
        <div class="hero-eyebrow hero-reveal" style="--delay:0s">
          <span class="inline-flex items-center gap-2 font-sans font-semibold text-xs uppercase tracking-[0.12em] text-orange">
            <span class="w-8 h-px bg-orange/60"></span>
            Freelance Technologies Côte d'Ivoire
          </span>
        </div>

        <h1 class="hero-title font-display font-extrabold text-white tracking-[-0.03em] hero-reveal" style="--delay:0.1s">
          <span class="title-line">La technologie,</span>
          <span class="title-line text-orange">pensée pour le</span>
          <span class="title-line">terrain africain.</span>
        </h1>

        <p class="hero-subtitle max-w-lg text-base sm:text-lg md:text-xl text-white/75 leading-relaxed hero-reveal" style="--delay:0.22s">
          Cabinet de conseil en transformation digitale et éditeur de solutions SaaS 
          conçues pour répondre aux réalités du marché ivoirien et africain.
        </p>

        <div class="hero-ctas flex flex-col sm:flex-row gap-4 mt-10 hero-reveal" style="--delay:0.35s">
          <a href="/#solutions" data-magnetic="18" class="btn-primary magnetic group">
            <span>Découvrir nos solutions
              <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
          <a href="/#contact" data-magnetic="14" class="btn-outline-light magnetic"><span>Nous contacter</span></a>
        </div>

        <div class="hero-stats grid grid-cols-3 gap-6 mt-14 pt-10 border-t border-white/10 hero-reveal" style="--delay:0.48s">
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">4+</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Solutions SaaS</div>
          </div>
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">100%</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Ancré en CI</div>
          </div>
          <div class="stat-item col-span-1">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">24/7</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Support</div>
          </div>
        </div>
      </div>

      <!-- Mosaïque Logo Animé -->
      <div class="logo-wrapper hidden lg:flex items-center justify-center relative" aria-label="Logo FTCI animé">
        
        <!-- Glows -->
        <div class="logo-glow glow--navy"></div>
        <div class="logo-glow glow--green"></div>
        <div class="logo-glow glow--orange"></div>
        
        <!-- SVG -->
        <svg class="logo-svg" viewBox="0 0 300 270" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="g-navy" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#2a4070"/><stop offset="100%" stop-color="#0F1E3D"/>
            </linearGradient>
            <linearGradient id="g-green" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#28b855"/><stop offset="100%" stop-color="#1E9E4F"/>
            </linearGradient>
            <linearGradient id="g-orange" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ff8533"/><stop offset="100%" stop-color="#EE6C1A"/>
            </linearGradient>
          </defs>
          
          {logoPieces.map((piece) => (
            <g class="piece" data-branch={piece.branch}
               style={`--tx:${piece.offsetX}px;--ty:${piece.offsetY}px;--rot:${piece.rotation}deg;--delay:${piece.delay}s`}>
              <rect
                class="diamond"
                x={piece.x - piece.size/2}
                y={piece.y - piece.size/2}
                width={piece.size}
                height={piece.size}
                rx={piece.size > 11 ? 2 : 1}
                fill={piece.branch === 'navy' ? 'url(#g-navy)' : piece.branch === 'green' ? 'url(#g-green)' : piece.branch === 'orange' ? 'url(#g-orange)' : '#6B7FC7'}
                transform={`rotate(45,${piece.x},${piece.y})`}
              />
            </g>
          ))}
          
          <!-- Centre lumineux -->
          <circle class="core-glow" cx="150" cy="135" r="22"/>
        </svg>
        
        <!-- Label -->
        <div class="logo-label hero-reveal" style="--delay:1s">
          <span class="label-main">FTCI</span>
          <span class="label-sub">Technologies</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="/#solutions" class="scroll-indicator absolute bottom-6 left-1/2 -translate-x-1/2 z-20" aria-label="Défiler">
    <svg class="w-6 h-6 text-white/40 hover:text-white/70 transition-colors animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </a>
</section>

<style>
  /* Layout */
  .hero-section { background: #0a1428; }
  .hero-grid {
    display: grid; grid-template-columns: 1fr; gap: 2.5rem;
    align-items: center; min-height: 100svh; padding: 100px 0 80px;
  }
  @media(min-width:1024px) {
    .hero-grid { grid-template-columns: 1fr 1fr; gap: 2rem; padding: 90px 0 70px; }
  }

  /* Typography */
  .hero-title { font-size: clamp(2.25rem,1.5rem+3.5vw,3.75rem); line-height:1.08; margin-bottom:1.5rem; }
  @media(min-width:1024px) { .hero-title { font-size: clamp(2.5rem,1.2rem+4vw,4.25rem); line-height:1.05; } }
  .title-line { display:block; }
  .stat-value { font-variant-numeric:tabular-nums; }

  /* Reveal */
  .hero-reveal { opacity:0; transform:translateY(24px); animation:revealIn .8s cubic-bezier(.16,1,.3,1) forwards; animation-delay:var(--delay,0s); }
  @keyframes revealIn { to{opacity:1;transform:translateY(0)} }

  /* Mesh Background */
  .mesh-blob { position:absolute; border-radius:50%; filter:blur(55px); will-change:transform; opacity:.55; }
  .mesh-blob--periwinkle { width:55%;height:50%;top:5%;left:18%; background:radial-gradient(ellipse,rgba(107,127,199,.5),transparent70%); animation:drift 22s ease-in-out infinite alternate; }
  .mesh-blob--green { width:45%;height:42%;top:8%;right:12%; background:radial-gradient(ellipse,rgba(30,158,79,.35),transparent70%); animation:drift 26s ease-in-out infinite alternate-reverse; }
  .mesh-blob--orange { width:52%;height:46%;bottom:8%;right:22%; background:radial-gradient(ellipse,rgba(238,108,26,.32),transparent70%); animation:drift 24s ease-in-out infinite alternate; }
  .mesh-blob--navy { width:42%;height:40%;bottom:15%;left:8%; background:radial-gradient(ellipse,rgba(15,30,61,.6),transparent70%); animation:drift 28s ease-in-out infinite alternate-reverse; }
  @keyframes drift { to{transform:translate(3%,2%)scale(1.07)} }

  /* Logo Container */
  .logo-wrapper { position:relative; width:100%; max-width:400px; aspect-ratio:1.05; margin:0 auto; }
  .logo-svg { width:100%; height:100%; overflow:visible; }

  /* Glows */
  .logo-glow { position:absolute; border-radius:50%; filter:blur(60px); pointer-events:none; opacity:0; animation:glowPulse 4s ease-in-out infinite; }
  .glow--navy { width:50%;height:50%;top:0;left:5%; background:radial-gradient(circle,rgba(30,48,90,.4),transparent70%); animation-delay:.5s; }
  .glow--green { width:45%;height:45%;top:0;right:5%; background:radial-gradient(circle,rgba(30,158,79,.32),transparent70%); animation-delay:1.5s; }
  .glow--orange { width:55%;height:50%;bottom:0;left:20%; background:radial-gradient(circle,rgba(238,108,26,.32),transparent70%); animation-delay:2.5s; }
  @keyframes glowPulse { 0%,100%{opacity:.35;transform:scale(1)} 50%{opacity:.65;transform:scale(1.08)} }

  /* ═══════════════════════════════════════════════════════════════════════════
     PIECES ANIMATION — Le cœur de l'effet Waouh !
     ═══════════════════════════════════════════════════════════════════════════ */
  .piece { opacity:0; animation:assemble 1.05s cubic-bezier(.16,1,.3,1) forwards, float 5.5s ease-in-out infinite; animation-delay:var(--delay,0s),calc(var(--delay,0s)+1.05s); will-change:transform,opacity; }
  .diamond { opacity:inherit; }

  @keyframes assemble {
    0% { opacity:0; transform:translate(var(--tx,0),var(--ty,0)) rotate(calc(var(--rot,0deg)+45deg)) scale(.12); }
    60% { opacity:.85; }
    100% { opacity:1; transform:translate(0,0) rotate(45deg) scale(1); }
  }
  @keyframes float {
    0%,100% { transform:rotate(45deg) translateY(0) }
    50% { transform:rotate(45deg) translateY(-5px) }
  }

  /* Core glow */
  .core-glow { fill:rgba(255,255,255,.06); filter:blur(6px); opacity:0; animation:coreIn .8s ease-out 1.2s forwards,corePulse 3s ease-in-out 2s infinite; }
  @keyframes coreIn { to{opacity:1} }
  @keyframes corePulse { 0%,100%{r:22px;opacity:.5} 50%{r:32px;opacity:.9} }

  /* Label */
  .logo-label { position:absolute; bottom:-38px; left:50%; transform:translateX(-50%); display:flex;flex-direction:column;align-items:center;gap:2px; }
  .label-main { font-family:var(--font-display),sans-serif; font-size:1.05rem;font-weight:800;letter-spacing:.18em;color:rgba(255,255,255,.85); }
  .label-sub { font-family:var(--font-display),sans-serif; font-size:.58rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:#EE6C1A; }

  /* Reduced Motion */
  @media(prefers-reduced-motion:reduce) {
    .piece { animation:none!important; opacity:1!important; transform:rotate(45deg) scale(1)!important; }
    .core-glow { animation:none!important; opacity:.5!important; }
    .logo-glow { animation:none!important; opacity:.4!important; }
    .mesh-blob { animation:none!important; }
    .hero-reveal { animation:none!important; opacity:1!important; transform:none!important; }
    * { animation-duration:.01ms!important; transition-duration:.01ms!important; }
  }

  /* Mobile */
  @media(max-width:1023px) { .mesh-blob { filter:blur(65px); animation-duration:44s!important; } }
</style>

<script>
function initHero() {
  const s=document.querySelector('.hero-section');if(!s)return;
  const rm=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(rm)s.classList.add('reduced-motion');
  new IntersectionObserver(e=>{e.forEach(e=>{if(e.isIntersecting)e.target.classList.add('is-visible')})},{threshold:.1}).observe(s);
  if(!rm){let t=false;const g=document.querySelectorAll('.logo-glow');
  window.addEventListener('scroll',()=>{if(!t){t=true;requestAnimationFrame(()=>{const y=window.scrollY;g.forEach((g,i)=>{(g as HTMLElement).style.transform=`translateY(${y*(.015+i*.008)}px)`});t=false})}},{passive:true})}
}
document.readyState==='loading'?document.addEventListener('DOMContentLoaded',initHero):initHero();
</script>
