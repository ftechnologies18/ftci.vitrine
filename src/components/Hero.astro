---
/**
 * Hero.astro — Mosaïque Logo FTCI "Prenant Vie" v3
 * ────────────────────────────────────────────────────────────────────────────
 * 
 * NOUVELLE APPROCHE: Courbes de Bézier paramétriques
 * 
 * Le vrai logo FTCI est un trèfle/cœur de 3 branches:
 * - Navy (gauche): arc depuis haut-gauche vers centre
 * - Verte (droite): arc depuis haut-droite vers centre  
 * - Orange (bas): grande courbe en U inférieur
 * 
 * Chaque branche est générée mathématiquement avec:
 * 1. Courbe de Bézier cubique comme colonne vertébrale
 * 2. Décalage perpendiculaire pour la largeur
 * 3. Placement de diamants le long de ces chemins
 */

interface DiamondPiece {
  x: number;
  y: number;
  size: number;
  rotation: number;
  color: string;
  branch: string;
  delay: number;
  originX: number;
  originY: number;
}

// ═══════════════════════════════════════════════════════════════════════════
// CONFIGURATION DES COULEURS FTCI
// ═══════════════════════════════════════════════════════════════════════════
const COLORS = {
  navy: '#1e3a5f',
  navyLight: '#2d5a9e',
  green: '#1a8c42',
  greenLight: '#28b855',
  orange: '#d45a0f',
  orangeLight: '#EE6C1A',
};

// ═══════════════════════════════════════════════════════════════════════════
// FONCTIONS MATHÉMATIQUES POUR COURBES
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Point sur courbe de Bézier cubique
 * t: 0→1, retourne {x, y}
 */
function cubicBezier(t: number, p0: {x:number,y:number}, p1: {x:number,y:number}, p2: {x:number,y:number}, p3: {x:number,y:number}): {x:number;y:number} {
  const mt = 1 - t;
  const mt2 = mt * mt;
  const mt3 = mt2 * mt;
  const t2 = t * t;
  const t3 = t2 * t;
  return {
    x: mt3 * p0.x + 3 * mt2 * t * p1.x + 3 * mt * t2 * p2.x + t3 * p3.x,
    y: mt3 * p0.y + 3 * mt2 * t * p1.y + 3 * mt * t2 * p2.y + t3 * p3.y,
  };
}

/**
 * Tangente (direction) sur courbe de Bézier
 */
function bezierTangent(t: number, p0: {x:number,y:number}, p1: {x:number,y:number}, p2: {x:number,y:number}, p3: {x:number,y:number}): {x:number;y:number} {
  const mt = 1 - t;
  const mt2 = mt * mt;
  const t2 = t * t;
  return {
    x: 3 * mt2 * (p1.x - p0.x) + 6 * mt * t * (p2.x - p1.x) + 3 * t2 * (p3.x - p2.x),
    y: 3 * mt2 * (p1.y - p0.y) + 6 * mt * t * (p2.y - p1.y) + 3 * t2 * (p3.y - p2.y),
  };
}

/**
 * Normale perpendiculaire (normalisée)
 */
function perpendicular(dx: number, dy: number): {x:number;y:number} {
  const len = Math.sqrt(dx * dx + dy * dy) || 1;
  return { x: -dy / len, y: dx / len };
}

// ═══════════════════════════════════════════════════════════════════════════
// GÉNÉRATION DES BRANCHES DU LOGO
// Centre du logo: (150, 140) dans un viewBox 300x280
// ═══════════════════════════════════════════════════════════════════════════

function generateBranch(
  start: {x:number;y:number},
  cp1: {x:number;y:number},
  cp2: {x:number;y:number},
  end: {x:number;y:number},
  config: {
    color: string;
    colorAlt: string;
    widthStart: number;
    widthEnd: number;
    rows: number;
    tileSize: number;
    tileVar: number;
    branchName: string;
    startDelay: number;
    scatter: number;
  }
): DiamondPiece[] {
  const pieces: DiamondPiece[] = [];
  const steps = 18; // Résolution de la courbe
  
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    
    // Point sur la courbe centrale
    const pos = cubicBezier(t, start, cp1, cp2, end);
    
    // Largeur variable (taper aux extrémités)
    const taper = Math.sin(t * Math.PI); // 0→1→0
    const currentWidth = config.widthStart * (1 - t) + config.widthEnd * t;
    const effectiveWidth = currentWidth * (0.4 + 0.6 * taper);
    
    // Direction perpendiculaire
    const tang = bezierTangent(t, start, cp1, cp2, end);
    const norm = perpendicular(tang.x, tang.y);
    
    // Nombre de rangées basé sur la largeur effective
    const numRows = Math.max(1, Math.round(config.rows * taper));
    
    for (let row = -numRows; row <= numRows; row++) {
      // Skip some positions for organic feel
      if (Math.random() < 0.15 && Math.abs(row) === numRows) continue;
      
      const offset = (row / numRows) * effectiveWidth;
      const px = pos.x + norm.x * offset;
      const py = pos.y + norm.y * offset;
      
      // Taille variable
      const sizeVar = config.tileVar * (Math.random() - 0.5);
      const sizeTaper = 0.7 + 0.3 * taper;
      const size = Math.max(5, (config.tileSize + sizeVar) * sizeTaper);
      
      // Couleur alternée
      const color = (i + row) % 3 === 0 ? config.colorAlt : config.color;
      
      // Délai cascade le long de la courbe
      const delay = config.startDelay + t * 0.6 + (Math.abs(row) / numRows) * 0.2 + Math.random() * 0.1;
      
      // Position d'origine dispersée
      const angle = Math.random() * Math.PI * 2;
      const dist = config.scatter * (0.5 + Math.random() * 0.5);
      
      pieces.push({
        x: Math.round(px * 10) / 10,
        y: Math.round(py * 10) / 10,
        size: Math.round(size * 10) / 10,
        rotation: 45, // Diamant
        color,
        branch: config.branchName,
        delay: Math.round(delay * 100) / 100,
        originX: Math.round(px + Math.cos(angle) * dist),
        originY: Math.round(py + Math.sin(angle) * dist),
      });
    }
  }
  
  return pieces;
}

// ═══════════════════════════════════════════════════════════════════════════
// DÉFINITION DES 3 BRANCHES DU LOGO FTCI
// Basé sur l'analyse visuelle du vrai logo
// ═══════════════════════════════════════════════════════════════════════════

function generateLogoPieces(): DiamondPiece[] {
  const allPieces: DiamondPiece[] = [];
  
  // ─── BRANCHE NAVY (Gauche) ─────────────────────────────────────────────
  // Arc depuis haut-gauche descendant vers le centre
  // Forme: courbe extérieure du côté gauche du trèfle
  allPieces.push(...generateBranch(
    { x: 25, y: 95 },   // Départ: haut-gauche externe
    { x: 5, y: 155 },   // Contrôle 1: courbe vers le bas (plus tendue)
    { x: 50, y: 185 },  // Contrôle 2: amorce vers centre
    { x: 115, y: 155 }, // Arrivée: près du centre
    {
      color: COLORS.navy,
      colorAlt: COLORS.navyLight,
      widthStart: 45,
      widthEnd: 26,
      rows: 4,
      tileSize: 9.5,
      tileVar: 2.5,
      branchName: 'navy',
      startDelay: 0,
      scatter: 150,
    }
  ));
  
  // ─── BRANCHE VERTE (Droite) ────────────────────────────────────────────
  // Arc depuis haut-droite descendant vers le centre
  // Forme: symétrique approximative de navy
  allPieces.push(...generateBranch(
    { x: 275, y: 95 },  // Départ: haut-droite externe
    { x: 295, y: 155 }, // Contrôle 1: courbe vers le bas (plus tendue)
    { x: 250, y: 185 }, // Contrôle 2: amorce vers centre
    { x: 185, y: 155 }, // Arrivée: près du centre
    {
      color: COLORS.green,
      colorAlt: COLORS.greenLight,
      widthStart: 45,
      widthEnd: 26,
      rows: 4,
      tileSize: 9.5,
      tileVar: 2.5,
      branchName: 'green',
      startDelay: 0.1,
      scatter: 150,
    }
  ));
  
  // ─── BRANCHE ORANGE (Bas) ──────────────────────────────────────────────
  // Grande courbe en U/Sourire reliant gauche à droite en passant par le bas
  // C'est la PLUS GRANDE et PLUS VISIBLE branche - forme caractéristique
  allPieces.push(...generateBranch(
    { x: 85, y: 170 },   // Départ: connexion navy (gauche-bas)
    { x: 60, y: 265 },   // Contrôle 1: descente gauche profonde
    { x: 240, y: 265 },  // Contrôle 2: montée droite profonde
    { x: 215, y: 170 },  // Arrivée: connexion green (droite-bas)
    {
      color: COLORS.orange,
      colorAlt: COLORS.orangeLight,
      widthStart: 38,
      widthEnd: 38,
      rows: 5,
      tileSize: 9.5,
      tileVar: 2.5,
      branchName: 'orange',
      startDelay: 0.22,
      scatter: 170,
    }
  ));
  
  // ─── PIÈCES CENTRALES (Cœur du trèfle) ────────────────────────────────
  // Quelques pièces près du centre pour connecter les branches
  const centerPieces = [
    { x: 145, y: 135, s: 9 },
    { x: 158, y: 142, s: 8 },
    { x: 135, y: 148, s: 7 },
    { x: 165, y: 132, s: 7 },
    { x: 152, y: 155, s: 6 },
  ];
  
  centerPieces.forEach((p, i) => {
    const colors = [COLORS.navyLight, COLORS.greenLight, COLORS.orangeLight];
    allPieces.push({
      x: p.x,
      y: p.y,
      size: p.s,
      rotation: 45,
      color: colors[i % 3],
      branch: 'center',
      delay: 0.65 + Math.random() * 0.2,
      originX: p.x + (Math.random() - 0.5) * 120,
      originY: p.y + (Math.random() - 0.5) * 120,
    });
  });
  
  return allPieces;
}

const logoPieces = generateLogoPieces();
---

<section class="hero-section relative min-h-[100svh] flex items-center overflow-hidden" id="contenu">
  
  <!-- Mesh Background -->
  <div class="hero-mesh absolute inset-[-20%]" aria-hidden="true">
    <div class="mesh-blob mesh-blob--periwinkle"></div>
    <div class="mesh-blob mesh-blob--green"></div>
    <div class="mesh-blob mesh-blob--orange"></div>
    <div class="mesh-blob mesh-blob--navy"></div>
  </div>

  <!-- Contenu -->
  <div class="container relative z-10">
    <div class="hero-grid">
      
      <!-- Texte -->
      <div class="hero-content">
        <div class="hero-eyebrow hero-reveal" style="--delay:0s">
          <span class="inline-flex items-center gap-2 font-sans font-semibold text-xs uppercase tracking-[0.12em] text-orange">
            <span class="w-8 h-px bg-orange/60"></span>
            Freelance Technologies Côte d'Ivoire
          </span>
        </div>

        <h1 class="hero-title font-display font-extrabold text-white tracking-[-0.03em] hero-reveal" style="--delay:0.1s">
          <span class="title-line">La technologie,</span>
          <span class="title-line text-orange">pensée pour le</span>
          <span class="title-line">terrain africain.</span>
        </h1>

        <p class="hero-subtitle max-w-lg text-base sm:text-lg md:text-xl text-white/75 leading-relaxed hero-reveal" style="--delay:0.22s">
          Cabinet de conseil en transformation digitale et éditeur de solutions SaaS 
          conçues pour répondre aux réalités du marché ivoirien et africain.
        </p>

        <div class="hero-ctas flex flex-col sm:flex-row gap-4 mt-10 hero-reveal" style="--delay:0.35s">
          <a href="/#solutions" data-magnetic="18" class="btn-primary magnetic group">
            <span>Découvrir nos solutions
              <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
          <a href="/#contact" data-magnetic="14" class="btn-outline-light magnetic"><span>Nous contacter</span></a>
        </div>

        <div class="hero-stats grid grid-cols-3 gap-6 mt-14 pt-10 border-t border-white/10 hero-reveal" style="--delay:0.48s">
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">4+</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Solutions SaaS</div>
          </div>
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">100%</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Ancré en CI</div>
          </div>
          <div class="stat-item col-span-1">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">24/7</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Support</div>
          </div>
        </div>
      </div>

      <!-- Mosaïque Logo Animé -->
      <div class="logo-wrapper hidden lg:flex items-center justify-center relative" aria-label="Logo FTCI animé">
        
        <!-- Glows -->
        <div class="logo-glow glow--navy"></div>
        <div class="logo-glow glow--green"></div>
        <div class="logo-glow glow--orange"></div>
        
        <!-- SVG Container -->
        <svg class="logo-svg" viewBox="0 0 300 290" preserveAspectRatio="xMidYMid meet">
          <defs>
            <!-- Dégradés pour profondeur -->
            <linearGradient id="g-navy" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#2d5a9e"/>
              <stop offset="100%" stop-color="#1e3a5f"/>
            </linearGradient>
            <linearGradient id="g-green" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#28b855"/>
              <stop offset="100%" stop-color="#1a8c42"/>
            </linearGradient>
            <linearGradient id="g-orange" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#EE6C1A"/>
              <stop offset="100%" stop-color="#d45a0f"/>
            </linearGradient>
            
            <!-- Filtre de lueur -->
            <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          
          <!-- Pièces du logo -->
          {logoPieces.map((piece) => (
            <g 
              class="logo-piece" 
              data-branch={piece.branch}
              style={`--from-x:${piece.originX - piece.x}px;--from-y:${piece.originY - piece.y}px;--delay:${piece.delay}s`}
            >
              <rect
                class="diamond-shape"
                x={piece.x - piece.size / 2}
                y={piece.y - piece.size / 2}
                width={piece.size}
                height={piece.size}
                rx={piece.size > 8 ? 2 : 1}
                fill={piece.color}
                transform={`rotate(${piece.rotation}, ${piece.x}, ${piece.y})`}
              />
            </g>
          ))}
          
          <!-- Centre lumineux -->
          <circle class="core-glow" cx="150" cy="145" r="20"/>
        </svg>
        
        <!-- Label sous le logo -->
        <div class="logo-label hero-reveal" style="--delay:1.1s">
          <span class="label-main">FTCI</span>
          <span class="label-sub">Technologies</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="/#solutions" class="scroll-indicator absolute bottom-6 left-1/2 -translate-x-1/2 z-20" aria-label="Défiler">
    <svg class="w-6 h-6 text-white/40 hover:text-white/70 transition-colors animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </a>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     LAYOUT & STRUCTURE
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-section {
    background: #0a1428;
  }
  
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    min-height: 100svh;
    padding: 100px 0 80px;
  }
  
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding: 90px 0 70px;
    }
  }

  /* Typography */
  .hero-title {
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 1024px) {
    .hero-title {
      font-size: clamp(2.5rem, 1.2rem + 4vw, 4.25rem);
      line-height: 1.05;
    }
  }
  
  .title-line {
    display: block;
  }
  
  .stat-value {
    font-variant-numeric: tabular-nums;
  }

  /* Reveal Animation */
  .hero-reveal {
    opacity: 0;
    transform: translateY(24px);
    animation: revealIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay, 0s);
  }
  
  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     MESH BACKGROUND — Ambiance depth
     ═══════════════════════════════════════════════════════════════════════════ */
  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(55px);
    will-change: transform;
    opacity: 0.55;
  }
  
  .mesh-blob--periwinkle {
    width: 55%;
    height: 50%;
    top: 5%;
    left: 18%;
    background: radial-gradient(ellipse, rgba(107, 127, 199, 0.5), transparent 70%);
    animation: drift 22s ease-in-out infinite alternate;
  }
  
  .mesh-blob--green {
    width: 45%;
    height: 42%;
    top: 8%;
    right: 12%;
    background: radial-gradient(ellipse, rgba(30, 158, 79, 0.35), transparent 70%);
    animation: drift 26s ease-in-out infinite alternate-reverse;
  }
  
  .mesh-blob--orange {
    width: 52%;
    height: 46%;
    bottom: 8%;
    right: 22%;
    background: radial-gradient(ellipse, rgba(238, 108, 26, 0.32), transparent 70%);
    animation: drift 24s ease-in-out infinite alternate;
  }
  
  .mesh-blob--navy {
    width: 42%;
    height: 40%;
    bottom: 15%;
    left: 8%;
    background: radial-gradient(ellipse, rgba(15, 30, 61, 0.6), transparent 70%);
    animation: drift 28s ease-in-out infinite alternate-reverse;
  }
  
  @keyframes drift {
    to {
      transform: translate(3%, 2%) scale(1.07);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LOGO CONTAINER
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-wrapper {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1.08;
    margin: 0 auto;
  }
  
  .logo-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Glows behind logo */
  .logo-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    opacity: 0;
    animation: glowPulse 4s ease-in-out infinite;
  }
  
  .glow--navy {
    width: 50%;
    height: 50%;
    top: 0;
    left: 5%;
    background: radial-gradient(circle, rgba(30, 58, 95, 0.4), transparent 70%);
    animation-delay: 0.5s;
  }
  
  .glow--green {
    width: 45%;
    height: 45%;
    top: 0;
    right: 5%;
    background: radial-gradient(circle, rgba(30, 158, 79, 0.32), transparent 70%);
    animation-delay: 1.5s;
  }
  
  .glow--orange {
    width: 55%;
    height: 50%;
    bottom: 0;
    left: 20%;
    background: radial-gradient(circle, rgba(238, 108, 26, 0.32), transparent 70%);
    animation-delay: 2.5s;
  }
  
  @keyframes glowPulse {
    0%, 100% {
      opacity: 0.35;
      transform: scale(1);
    }
    50% {
      opacity: 0.65;
      transform: scale(1.08);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LOGO PIECES ANIMATION — L'effet Waouh !
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-piece {
    opacity: 0;
    animation: 
      pieceAssemble 0.95s cubic-bezier(0.16, 1, 0.3, 1) forwards,
      pieceFloat 6s ease-in-out infinite;
    animation-delay: var(--delay, 0s), calc(var(--delay, 0s) + 0.95s);
    will-change: transform, opacity;
  }
  
  .diamond-shape {
    opacity: inherit;
  }

  /* Assemblage depuis positions dispersées */
  @keyframes pieceAssemble {
    0% {
      opacity: 0;
      transform: translate(var(--from-x, 0px), var(--from-y, 0px)) scale(0.01);
    }
    50% {
      opacity: 0.85;
    }
    100% {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
  }
  
  /* Flottement subtil continu */
  @keyframes pieceFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  /* Core glow central */
  .core-glow {
    fill: rgba(255, 255, 255, 0.06);
    filter: blur(6px);
    opacity: 0;
    animation: coreIn 0.8s ease-out 1.2s forwards, corePulse 3s ease-in-out 2s infinite;
  }
  
  @keyframes coreIn {
    to { opacity: 1; }
  }
  
  @keyframes corePulse {
    0%, 100% { r: 20px; opacity: 0.5; }
    50% { r: 30px; opacity: 0.9; }
  }

  /* Label sous le logo */
  .logo-label {
    position: absolute;
    bottom: -40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  
  .label-main {
    font-family: var(--font-display), sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.85);
  }
  
  .label-sub {
    font-family: var(--font-display), sans-serif;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #EE6C1A;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     REDUCED MOTION — Accessibilité
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .logo-piece {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .core-glow {
      animation: none !important;
      opacity: 0.5 !important;
    }
    .logo-glow {
      animation: none !important;
      opacity: 0.4 !important;
    }
    .mesh-blob {
      animation: none !important;
    }
    .hero-reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 1023px) {
    .mesh-blob {
      filter: blur(65px);
      animation-duration: 44s !important;
    }
  }
</style>

<script>
function initHero() {
  const section = document.querySelector('.hero-section');
  if (!section) return;
  
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    section.classList.add('reduced-motion');
  }
  
  // Intersection Observer pour déclencher animations au scroll
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    { threshold: 0.1 }
  );
  observer.observe(section);
  
  // Parallax subtil sur les glows au scroll
  if (!prefersReducedMotion) {
    let ticking = false;
    const glows = document.querySelectorAll('.logo-glow');
    
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            const scrollY = window.scrollY;
            glows.forEach((glow, index) => {
              (glow as HTMLElement).style.transform = `translateY(${scrollY * (0.015 + index * 0.008)}px)`;
            });
            ticking = false;
          });
        }
      },
      { passive: true }
    );
  }
}

document.readyState === 'loading'
  ? document.addEventListener('DOMContentLoaded', initHero)
  : initHero();
</script>
