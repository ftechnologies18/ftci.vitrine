---
/**
 * Hero.astro — Hero Slider Cinématique v7 (Ingenious Layout + Advanced Animations)
 * ────────────────────────────────────────────────────────────────────────────
 * 
 * APPROCHE DESIGN "THÈSE VISUELLE" (Principes frontend-design skill):
 * - Le Hero est une DÉCLARATION, pas un template
 * - Disposition asymétrique ingénieuse (diagonal flow)
 * - Animation orchestrée: chaque élément raconte une histoire
 * - Signature: Logo trèfle + formes géométriques animées
 * 
 * SLIDES:
 * 1. Entreprise: Présentation FTCI avec logo cinématique
 * 2. Solutions SaaS: Cards produits en mosaïque flottante
 * 3. Services Expertise: Grille services avec icônes animées
 * 
 * ANIMATIONS V7:
 * - Text reveal: ligne par ligne avec clip-path diagonal
 * - Floating elements: éléments qui flottent avec délais échelonnés
 * - Morphing shapes: formes géométriques qui se transforment
 * - Counter animation: chiffres qui comptent jusqu'à la valeur
 * - Magnetic cards: cartes qui suivent le curseur
 * - Gradient mesh: background qui respire
 * - Stagger cascade: effet de cascade sur les enfants
 */

import { products, accentColorClasses } from '../data/products';

// Données des slides
const slides = [
  {
    id: 'enterprise',
    eyebrow: 'Freelance Technologies Côte d\'Ivoire',
    title: ['La technologie,', 'pensée pour le', 'terrain africain.'],
    titleHighlight: [false, true, false],
    subtitle: 'Cabinet de conseil en transformation digitale et éditeur de solutions SaaS conçues pour répondre aux réalités du marché ivoirien et africain.',
    primaryCta: { href: '/#solutions', label: 'Découvrir nos solutions' },
    secondaryCta: { href: '/#contact', label: 'Nous contacter' },
    stats: [
      { value: '4+', label: 'Solutions SaaS', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
      { value: '100%', label: 'Ancré en CI', icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
      { value: '24/7', label: 'Support', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' }
    ],
    showLogo: true,
    theme: 'dark'
  },
  {
    id: 'solutions',
    eyebrow: 'Écosystème SaaS',
    title: ['Des solutions qui', 'transforment votre', 'activité.'],
    titleHighlight: [false, false, true],
    subtitle: 'Quatre plateformes complètes pensées pour le marché africain : évaluation, chantier, présence scolaire et gestion financière.',
    primaryCta: { href: '/#solutions', label: 'Explorer les solutions' },
    secondaryCta: null,
    products: products.slice(0, 4).map(p => ({
      name: p.name,
      slug: p.slug,
      accentColor: p.accentColor,
      iconPath: p.iconPath,
      shortDesc: p.description.substring(0, 50) + '...'
    })),
    showLogo: false,
    theme: 'gradient'
  },
  {
    id: 'services',
    eyebrow: 'Expertise & Accompagnement',
    title: ['Un partenaire', 'technique de', 'confiance.'],
    titleHighlight: [false, false, true],
    subtitle: 'De la stratégie digitale à la réalisation technique, nous accompagnons votre transformation à chaque étape.',
    primaryCta: { href: '/#contact', label: 'Démarrer un projet' },
    secondaryCta: { href: '#services', label: 'Nos services' },
    services: [
      { icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5h.01', name: 'Transformation Digitale', desc: 'Stratégie & implémentation' },
      { icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4', name: 'Développement Sur Mesure', desc: 'Web, mobile & API' },
      { icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2', name: 'Infrastructure IT', desc: 'Cloud & DevOps' },
      { icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', name: 'Formation & Docs', desc: 'Transfert de compétences' }
    ],
    showLogo: false,
    theme: 'navy'
  }
];
---

<section class="hero-slider relative min-h-[100svh] overflow-hidden" id="contenu" data-hero-slider>
  
  <!-- ═══════════════════════════════════════════════════════════════════════
       BACKGROUND LAYER - Mesh + Grid Pattern
       ═══════════════════════════════════════════════════════════════════════ -->
  <div class="hero-bg-layer absolute inset-0" aria-hidden="true">
    <!-- Animated Mesh -->
    <div class="mesh-container">
      <div class="mesh-blob mesh--periwinkle"></div>
      <div class="mesh-blob mesh--green"></div>
      <div class="mesh-blob mesh--orange"></div>
      <div class="mesh-blob mesh--navy"></div>
    </div>
    
    <!-- Grid Pattern -->
    <div class="grid-pattern"></div>
    
    <!-- Floating Geometric Shapes -->
    <div class="geo-shapes">
      <div class="geo-shape geo--diamond geo--1"></div>
      <div class="geo-shape geo--ring geo--2"></div>
      <div class="geo-shape geo--triangle geo--3"></div>
      <div class="geo-shape geo--dot geo--4"></div>
    </div>
    
    <!-- Gradient Overlay -->
    <div class="gradient-overlay"></div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SLIDES CONTAINER
       ═══════════════════════════════════════════════════════════════════════ -->
  <div class="slides-wrapper">
    
    {slides.map((slide, index) => (
      <article 
        class={`hero-slide ${index === 0 ? 'is-active' : ''}`}
        data-slide={index}
        data-slide-id={slide.id}
        role="group"
        aria-roledescription="slide"
        aria-label={`Slide ${index + 1} sur ${slides.length}`}
      >
        
        <!-- Slide-specific background tint -->
        <div class={`slide-tint slide-tint--${slide.theme}`}></div>
        
        <!-- ════════════════════════════════════════════════════════════════
             MAIN CONTENT - Asymmetrical Ingenious Layout
             ════════════════════════════════════════════════════════════════ -->
        <div class="slide-layout">
          
          <!-- LEFT ZONE: Content -->
          <div class="content-zone">
            
            <!-- Eyebrow with animated line -->
            <div class="eyebrow-block">
              <span class="eyebrow-line"></span>
              <span class="eyebrow-text">{slide.eyebrow}</span>
            </div>

            <!-- Title with line-by-line reveal -->
            <h1 class="title-block">
              {slide.title.map((line, i) => (
                <span 
                  class={`title-line ${slide.titleHighlight[i] ? 'highlight' : ''}`}
                  data-line-index={i}
                >
                  <span class="line-text">{line}</span>
                  <span class="line-bg"></span>
                </span>
              ))}
            </h1>

            <!-- Subtitle with fade up -->
            <p class="subtitle-block">{slide.subtitle}</p>

            <!-- CTAs Row -->
            <div class="ctas-row">
              <a href={slide.primaryCta.href} class="cta-primary magnetic" data-magnetic="18">
                <span class="cta-content">
                  {slide.primaryCta.label}
                  <svg class="cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </span>
                <span class="cta-bg"></span>
              </a>
              
              {slide.secondaryCta && (
                <a href={slide.secondaryCta.href} class="cta-secondary magnetic" data-magnetic="14">
                  <span>{slide.secondaryCta.label}</span>
                </a>
              )}
            </div>

            <!-- Stats (Enterprise Slide) -->
            {slide.stats && (
              <div class="stats-grid">
                {slide.stats.map((stat, idx) => (
                  <div class="stat-card" data-stat-index={idx}>
                    <div class="stat-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={stat.icon}/>
                      </svg>
                    </div>
                    <div class="stat-value" data-count={stat.value}>{stat.value}</div>
                    <div class="stat-label">{stat.label}</div>
                  </div>
                ))}
              </div>
            )}

            <!-- Services Grid (Services Slide) -->
            {slide.services && (
              <div class="services-matrix">
                {slide.services.map((service, idx) => (
                  <div class="service-item" data-service-index={idx}>
                    <div class="service-icon-wrap">
                      <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.icon}/>
                      </svg>
                    </div>
                    <div class="service-info">
                      <span class="service-name">{service.name}</span>
                      <span class="service-desc">{service.desc}</span>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- RIGHT ZONE: Visual Showcase -->
          <div class="visual-zone">
            
            <!-- LOGO SHOWCASE (Enterprise) -->
            {slide.showLogo && (
              <div class="logo-showcase">
                <!-- Orbital rings -->
                <div class="orbital orbital--outer">
                  <div class="orbital-ring"></div>
                </div>
                <div class="orbital orbital--inner">
                  <div class="orbital-ring"></div>
                </div>
                
                <!-- Glow layers -->
                <div class="logo-glow logo-glow--navy"></div>
                <div class="logo-glow logo-glow--green"></div>
                <div class="logo-glow logo-glow--orange"></div>
                
                <!-- Main logo container -->
                <div class="logo-core">
                  <img 
                    src="/brand/logo-ftci-nobg.png" 
                    alt="Logo FTCI"
                    class="logo-img"
                    width="260"
                    height="245"
                  />
                  <div class="logo-shimmer"></div>
                </div>
                
                <!-- Label below -->
                <div class="logo-badge">
                  <span class="badge-text">FTCI</span>
                  <span class="badge-sub">Technologies</span>
                </div>
                
                <!-- Floating particles around logo -->
                <div class="particles">
                  {[...Array(6)].map((_, i) => (
                    <div class={`particle particle--${i + 1}`} key={i}></div>
                  ))}
                </div>
              </div>
            )}

            <!-- PRODUCTS MOSAIC (Solutions) -->
            {slide.products && (
              <div class="products-mosaic">
                {slide.products.map((product, idx) => {
                  const accent = accentColorClasses[product.accentColor];
                  return (
                    <a 
                      href={`/solutions/${product.slug}`}
                      class={`mosaic-card mosaic-card--${idx + 1} ${accent.bg}`}
                      data-product-index={idx}
                    >
                      <div class="mosaic-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={product.iconPath}/>
                        </svg>
                      </div>
                      <div class="mosaic-content">
                        <span class="mosaic-name">{product.name}</span>
                        <span class="mosaic-desc">{product.shortDesc}</span>
                      </div>
                      <div class="mosaic-arrow">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                      </div>
                      <div class="mosaic-glow"></div>
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       NAVIGATION SYSTEM
       ═══════════════════════════════════════════════════════════════════════ -->
  
  <!-- Slide Counter -->
  <div class="slide-counter">
    <span class="counter-current">01</span>
    <span class="counter-sep">/</span>
    <span class="counter-total">03</span>
  </div>

  <!-- Progress Bar -->
  <div class="progress-track">
    <div class="progress-fill"></div>
  </div>

  <!-- Dots Navigation -->
  <nav class="dots-nav" role="tablist" aria-label="Navigation slides">
    {slides.map((_, idx) => (
      <button 
        class={`dot-btn ${idx === 0 ? 'is-active' : ''}`}
        role="tab"
        aria-selected={idx === 0 ? 'true' : 'false'}
        aria-label={`Slide ${idx + 1}`}
        data-dot={idx}
      >
        <span class="dot-fill"></span>
      </button>
    ))}
  </nav>

  <!-- Arrow Navigation -->
  <button class="nav-arrow nav-prev" aria-label="Slide précédent" data-dir="prev">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button class="nav-arrow nav-next" aria-label="Slide suivant" data-dir="next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>

  <!-- Scroll Indicator -->
  <a href="/#solutions" class="scroll-hint" aria-label="Défiler vers le contenu">
    <div class="scroll-line"></div>
    <span class="scroll-text">Scroll</span>
  </a>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     BASE STRUCTURE
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-slider {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    background: #070e1a;
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     BACKGROUND LAYER
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Mesh Blobs */
  .mesh-container {
    position: absolute;
    inset: 0;
    filter: blur(80px);
    opacity: 0.6;
  }

  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .mesh--periwinkle {
    width: 60vw; height: 55vw;
    top: -15%; left: -10%;
    background: radial-gradient(circle, rgba(107, 127, 199, 0.4), transparent 70%);
    animation: meshFloat 25s ease-in-out infinite alternate;
  }

  .mesh--green {
    width: 50vw; height: 45vw;
    top: 5%; right: -15%;
    background: radial-gradient(circle, rgba(30, 158, 79, 0.3), transparent 70%);
    animation: meshFloat 30s ease-in-out infinite alternate-reverse;
  }

  .mesh--orange {
    width: 55vw; height: 50vw;
    bottom: -20%; right: 10%;
    background: radial-gradient(circle, rgba(238, 108, 26, 0.28), transparent 70%);
    animation: meshFloat 28s ease-in-out infinite alternate;
  }

  .mesh--navy {
    width: 45vw; height: 40vw;
    bottom: -10%; left: 20%;
    background: radial-gradient(circle, rgba(15, 30, 61, 0.5), transparent 70%);
    animation: meshFloat 32s ease-in-out infinite alternate-reverse;
  }

  @keyframes meshFloat {
    to { transform: translate(4%, 3%) scale(1.08); }
  }

  /* Grid Pattern */
  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
  }

  /* Geometric Shapes */
  .geo-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .geo-shape {
    position: absolute;
    opacity: 0.15;
  }

  .geo--diamond {
    width: 120px; height: 120px;
    top: 15%; right: 15%;
    background: linear-gradient(135deg, #EE6C1A, transparent);
    transform: rotate(45deg);
    animation: geoPulse 8s ease-in-out infinite, geoRotate 20s linear infinite;
  }

  .geo--ring {
    width: 200px; height: 200px;
    bottom: 20%; left: 10%;
    border: 2px solid #1a8c42;
    border-radius: 50%;
    animation: geoPulse 10s ease-in-out infinite 1s, geoScale 15s ease-in-out infinite;
  }

  .geo--triangle {
    width: 0; height: 0;
    top: 40%; left: 5%;
    border-left: 40px solid transparent;
    border-right: 40px solid transparent;
    border-bottom: 70px rgba(107, 127, 199, 0.3);
    animation: geoPulse 12s ease-in-out infinite 2s;
  }

  .geo--dot {
    width: 12px; height: 12px;
    top: 25%; left: 25%;
    background: #EE6C1A;
    border-radius: 50%;
    animation: geoBlink 4s ease-in-out infinite;
  }

  @keyframes geoPulse {
    0%, 100% { opacity: 0.1; transform: scale(1); }
    50% { opacity: 0.25; transform: scale(1.1); }
  }

  @keyframes geoRotate {
    to { transform: rotate(405deg); }
  }

  @keyframes geoScale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  @keyframes geoBlink {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.6; }
  }

  /* Gradient Overlay */
  .gradient-overlay {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 20% 50%, transparent 40%, #070e1a 90%),
      linear-gradient(to bottom, transparent 60%, #070e1a 95%);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     SLIDES SYSTEM
     ═══════════════════════════════════════════════════════════════════════════ */
  .slides-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateX(80px) scale(0.98);
    transition: 
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.75s;
    pointer-events: none;
  }

  .hero-slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateX(0) scale(1);
    pointer-events: auto;
  }

  .hero-slide.slide-exit-left {
    transform: translateX(-80px) scale(0.98);
  }

  /* Slide Tint */
  .slide-tint {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }

  .hero-slide.is-active .slide-tint {
    opacity: 1;
  }

  .slide-tint--dark {
    background: radial-gradient(ellipse at 25% 50%, rgba(15, 30, 61, 0.3), transparent 60%);
  }

  .slide-tint--gradient {
    background: 
      radial-gradient(ellipse at 75% 35%, rgba(238, 108, 26, 0.1), transparent 50%),
      radial-gradient(ellipse at 25% 65%, rgba(30, 158, 79, 0.08), transparent 50%);
  }

  .slide-tint--navy {
    background: radial-gradient(ellipse at 50% 50%, rgba(107, 127, 199, 0.12), transparent 65%);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     INGENIOUS ASYMMETRICAL LAYOUT
     ═══════════════════════════════════════════════════════════════════════════ */
  .slide-layout {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
    gap: 2rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 100svh;
    align-content: center;
  }

  @media (min-width: 1024px) {
    .slide-layout {
      grid-template-columns: 1fr 1.1fr;
      grid-template-rows: 1fr;
      gap: 4rem;
      padding: 0 3rem;
      align-items: center;
    }
  }

  /* Content Zone */
  .content-zone {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    order: 1;
  }

  @media (min-width: 1024px) {
    .content-zone {
      order: 1;
      padding: 2rem 0;
    }
  }

  /* Visual Zone */
  .visual-zone {
    display: flex;
    align-items: center;
    justify-content: center;
    order: 2;
    min-height: 300px;
  }

  @media (min-width: 1024px) {
    .visual-zone {
      order: 2;
      min-height: 500px;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     TYPOGRAPHY & CONTENT ELEMENTS
     ═══════════════════════════════════════════════════════════════════════════ */

  /* Eyebrow */
  .eyebrow-block {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(15px);
  }

  .hero-slide.is-active .eyebrow-block {
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.1s;
  }

  .eyebrow-line {
    width: 28px;
    height: 2px;
    background: linear-gradient(90deg, #EE6C1A, transparent);
    border-radius: 1px;
  }

  .eyebrow-text {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #EE6C1A;
  }

  /* Title Block */
  .title-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0.5rem 0;
  }

  .title-line {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .line-text {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: clamp(2rem, 1.3rem + 3.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: white;
    transform: translateY(110%);
    opacity: 0;
  }

  .hero-slide.is-active .line-text {
    animation: lineReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.2s + var(--line-index, 0) * 0.1s);
  }

  .title-line.highlight .line-text {
    color: #EE6C1A;
  }

  .line-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(238, 108, 26, 0.1), transparent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero-slide.is-active .highlight .line-bg {
    animation: lineBgReveal 0.5s ease forwards;
    animation-delay: calc(0.5s + var(--line-index, 0) * 0.1s);
  }

  @keyframes lineReveal {
    to { transform: translateY(0); opacity: 1; }
  }

  @keyframes lineBgReveal {
    to { transform: scaleX(1); }
  }

  /* Subtitle */
  .subtitle-block {
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.125rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    max-width: 520px;
    margin-top: 0.75rem;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-slide.is-active .subtitle-block {
    animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.55s;
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* CTAs */
  .ctas-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-slide.is-active .ctas-row {
    animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.7s;
  }

  .cta-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    background: linear-gradient(135deg, #EE6C1A, #d45a0f);
    color: white;
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 14px;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(238, 108, 26, 0.3);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 35px rgba(238, 108, 26, 0.45);
  }

  .cta-content {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    position: relative;
    z-index: 1;
  }

  .cta-arrow {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.2));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cta-primary:hover .cta-bg {
    opacity: 1;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.75rem;
    color: white;
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 14px;
    text-decoration: none;
    backdrop-filter: blur(10px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     STATS GRID (Enterprise Slide)
     ═══════════════════════════════════════════════════════════════════════════ */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    opacity: 0;
    transform: translateY(25px);
  }

  .hero-slide.is-active .stats-grid {
    animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.85s;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 0.5rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.35s ease;
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-slide.is-active .stat-card:nth-child(1) { animation: statIn 0.5s ease 0.9s forwards; }
  .hero-slide.is-active .stat-card:nth-child(2) { animation: statIn 0.5s ease 1s forwards; }
  .hero-slide.is-active .stat-card:nth-child(3) { animation: statIn 0.5s ease 1.1s forwards; }

  @keyframes statIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .stat-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(238, 108, 26, 0.3);
    transform: translateY(-3px);
  }

  .stat-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    color: #EE6C1A;
  }

  .stat-icon svg {
    width: 22px;
    height: 22px;
  }

  .stat-value {
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: 1.75rem;
    color: white;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.35rem;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     SERVICES MATRIX (Services Slide)
     ═══════════════════════════════════════════════════════════════════════════ */
  .services-matrix {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
    margin-top: 2rem;
    opacity: 0;
  }

  .hero-slide.is-active .services-matrix {
    animation: fadeUp 0.7s ease 0.75s forwards;
  }

  .service-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    cursor: default;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateX(-20px);
  }

  .hero-slide.is-active .service-item:nth-child(1) { animation: serviceSlide 0.5s ease 0.85s forwards; }
  .hero-slide.is-active .service-item:nth-child(2) { animation: serviceSlide 0.5s ease 0.92s forwards; }
  .hero-slide.is-active .service-item:nth-child(3) { animation: serviceSlide 0.5s ease 0.99s forwards; }
  .hero-slide.is-active .service-item:nth-child(4) { animation: serviceSlide 0.5s ease 1.06s forwards; }

  @keyframes serviceSlide {
    to { opacity: 1; transform: translateX(0); }
  }

  .service-item:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(238, 108, 26, 0.25);
    transform: translateX(4px);
  }

  .service-icon-wrap {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(238, 108, 26, 0.2), rgba(238, 108, 26, 0.05));
    border-radius: 10px;
    flex-shrink: 0;
  }

  .service-icon {
    width: 20px;
    height: 20px;
    color: #EE6C1A;
  }

  .service-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .service-name {
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 0.88rem;
    color: white;
  }

  .service-desc {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LOGO SHOWCASE (Enterprise Slide)
     ═══════════════════════════════════════════════════════════════════════════ */
  .logo-showcase {
    position: relative;
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .logo-showcase {
      width: 340px;
      height: 340px;
    }
  }

  /* Orbital Rings */
  .orbital {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .orbital--outer {
    width: 130%;
    height: 130%;
    opacity: 0;
  }

  .orbital--inner {
    width: 115%;
    height: 115%;
    opacity: 0;
  }

  .hero-slide.is-active .orbital--outer {
    animation: orbitalFade 1s ease 0.6s forwards, orbitalSpin 30s linear 1.6s infinite;
  }

  .hero-slide.is-active .orbital--inner {
    animation: orbitalFade 1s ease 0.8s forwards, orbitalSpin 25s linear 1.8s infinite reverse;
  }

  @keyframes orbitalFade {
    to { opacity: 1; }
  }

  @keyframes orbitalSpin {
    to { transform: rotate(360deg); }
  }

  .orbital-ring {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1.5px dashed;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .orbital--outer .orbital-ring {
    border-color: rgba(238, 108, 26, 0.15);
  }

  /* Glows */
  .logo-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(50px);
    pointer-events: none;
    opacity: 0;
  }

  .hero-slide.is-active .logo-glow {
    animation: glowPulse 6s ease-in-out infinite;
  }

  .logo-glow--navy {
    width: 70%; height: 60%; top: -10%; left: -15%;
    background: radial-gradient(circle, rgba(30, 58, 95, 0.5), transparent 70%);
    animation-delay: 0.3s;
  }

  .logo-glow--green {
    width: 65%; height: 55%; top: 5%; right: -15%;
    background: radial-gradient(circle, rgba(26, 140, 66, 0.4), transparent 70%);
    animation-delay: 1s;
  }

  .logo-glow--orange {
    width: 75%; height: 58%; bottom: -10%; left: 5%;
    background: radial-gradient(circle, rgba(212, 90, 15, 0.4), transparent 70%);
    animation-delay: 1.8s;
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.08); }
  }

  /* Core Logo */
  .logo-core {
    position: relative;
    width: 75%;
    z-index: 3;
  }

  .logo-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    opacity: 0;
    filter: drop-shadow(0 0 30px rgba(107, 127, 199, 0.25));
  }

  .hero-slide.is-active .logo-img {
    animation: logoReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards,
               logoFloat 7s ease-in-out 1.8s infinite,
               logoGlow 4s ease-in-out 2s infinite;
  }

  @keyframes logoReveal {
    0% { opacity: 0; clip-path: circle(0% at 50% 50%); transform: scale(0.85); }
    60% { opacity: 1; clip-path: circle(70% at 50% 50%); }
    85% { transform: scale(1.02); }
    100% { clip-path: circle(110% at 50% 50%); transform: scale(1); }
  }

  @keyframes logoFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @keyframes logoGlow {
    0%, 100% { filter: drop-shadow(0 0 25px rgba(107, 127, 199, 0.2)); }
    50% { filter: drop-shadow(0 0 45px rgba(107, 127, 199, 0.4)); }
  }

  .logo-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg, transparent 25%,
      rgba(255, 255, 255, 0.06) 48%,
      rgba(255, 255, 255, 0.1) 52%,
      rgba(255, 255, 255, 0.06) 57%,
      transparent 80%
    );
    background-size: 300% 300%;
    pointer-events: none;
    opacity: 0;
  }

  .hero-slide.is-active .logo-shimmer {
    animation: shimmerIn 0.5s ease 2.2s forwards, shimmerMove 7s ease-in-out 2.7s infinite;
  }

  @keyframes shimmerIn { to { opacity: 1; } }
  @keyframes shimmerMove {
    0%, 100% { background-position: 250% 250%; }
    50% { background-position: 0% 0%; }
  }

  /* Badge */
  .logo-badge {
    position: absolute;
    bottom: -45px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    opacity: 0;
  }

  .hero-slide.is-active .logo-badge {
    animation: badgeIn 0.6s ease 1.8s forwards;
  }

  @keyframes badgeIn { to { opacity: 1; } }

  .badge-text {
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  .badge-sub {
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: 0.55rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #EE6C1A;
    text-shadow: 0 2px 15px rgba(238, 108, 26, 0.4);
  }

  /* Particles */
  .particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: rgba(238, 108, 26, 0.6);
    border-radius: 50%;
    opacity: 0;
  }

  .hero-slide.is-active .particle {
    animation: particleFloat 4s ease-in-out infinite;
  }

  .particle--1 { top: 10%; left: 20%; animation-delay: 2s; }
  .particle--2 { top: 25%; right: 15%; animation-delay: 2.4s; background: rgba(30, 158, 79, 0.6); }
  .particle--3 { bottom: 30%; left: 10%; animation-delay: 2.8s; background: rgba(107, 127, 199, 0.6); }
  .particle--4 { bottom: 15%; right: 25%; animation-delay: 3.2s; }
  .particle--5 { top: 45%; left: 5%; animation-delay: 3.6s; background: rgba(238, 108, 26, 0.4); width: 4px; height: 4px; }
  .particle--6 { top: 60%; right: 8%; animation-delay: 4s; background: rgba(30, 158, 79, 0.4); width: 4px; height: 4px; }

  @keyframes particleFloat {
    0% { opacity: 0; transform: translateY(0) scale(0); }
    20% { opacity: 1; transform: translateY(-10px) scale(1); }
    80% { opacity: 0.5; transform: translateY(-30px) scale(0.8); }
    100% { opacity: 0; transform: translateY(-40px) scale(0); }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     PRODUCTS MOSAIC (Solutions Slide)
     ═══════════════════════════════════════════════════════════════════════════ */
  .products-mosaic {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 420px;
    perspective: 800px;
  }

  @media (min-width: 640px) {
    .products-mosaic {
      max-width: 480px;
      gap: 1.25rem;
    }
  }

  .mosaic-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border-radius: 20px;
    color: white;
    text-decoration: none;
    overflow: hidden;
    transform-style: preserve-3d;
    transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateY(30px) rotateX(-10deg);
  }

  .hero-slide.is-active .mosaic-card:nth-child(1) { animation: mosaicIn 0.6s ease 0.5s forwards; }
  .hero-slide.is-active .mosaic-card:nth-child(2) { animation: mosaicIn 0.6s ease 0.62s forwards; }
  .hero-slide.is-active .mosaic-card:nth-child(3) { animation: mosaicIn 0.6s ease 0.74s forwards; }
  .hero-slide.is-active .mosaic-card:nth-child(4) { animation: mosaicIn 0.6s ease 0.86s forwards; }

  @keyframes mosaicIn {
    to { opacity: 1; transform: translateY(0) rotateX(0); }
  }

  .mosaic-card:hover {
    transform: translateY(-8px) rotateX(2deg) scale(1.02);
    box-shadow: 0 20px 50px -10px currentColor;
  }

  .mosaic-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    margin-bottom: 0.85rem;
    transition: transform 0.35s ease;
  }

  .mosaic-card:hover .mosaic-icon {
    transform: scale(1.1) rotate(-5deg);
  }

  .mosaic-icon svg {
    width: 22px;
    height: 22px;
  }

  .mosaic-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .mosaic-name {
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .mosaic-desc {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.4;
  }

  .mosaic-arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    opacity: 0;
    transform: translateX(10px);
    transition: all 0.35s ease;
  }

  .mosaic-card:hover .mosaic-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .mosaic-arrow svg {
    width: 14px;
    height: 14px;
  }

  .mosaic-glow {
    position: absolute;
    inset: 0;
    background: inherit;
    filter: blur(30px);
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: -1;
  }

  .mosaic-card:hover .mosaic-glow {
    opacity: 0.4;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     NAVIGATION COMPONENTS
     ═══════════════════════════════════════════════════════════════════════════ */

  /* Slide Counter */
  .slide-counter {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-display), sans-serif;
    z-index: 20;
  }

  .counter-current {
    font-size: 1.5rem;
    font-weight: 800;
    color: white;
    min-width: 1.5ch;
  }

  .counter-sep {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .counter-total {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.3);
  }

  /* Progress Track */
  .progress-track {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    z-index: 20;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #EE6C1A, #f97316);
    transition: width 0.1s linear;
  }

  .progress-track.is-animating .progress-fill {
    animation: progressFill 8s linear forwards;
  }

  @keyframes progressFill {
    from { width: 0%; }
    to { width: 100%; }
  }

  /* Dots Nav */
  .dots-nav {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.65rem;
    padding: 0.6rem 1rem;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(12px);
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    z-index: 20;
  }

  .dot-btn {
    position: relative;
    width: 32px;
    height: 4px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    overflow: hidden;
    transition: background 0.3s ease;
    padding: 0;
  }

  .dot-btn:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  .dot-btn.is-active {
    background: rgba(255, 255, 255, 0.3);
  }

  .dot-fill {
    position: absolute;
    inset: 0;
    background: #EE6C1A;
    border-radius: 99px;
    transform: scaleX(0);
    transform-origin: left;
  }

  .dot-btn.is-active .dot-fill {
    animation: dotFill 8s linear forwards;
  }

  @keyframes dotFill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .dots-nav.is-paused .dot-fill {
    animation-play-state: paused;
  }

  /* Arrow Buttons */
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    color: white;
    cursor: pointer;
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
  }

  .hero-slider:hover .nav-arrow {
    opacity: 1;
  }

  .nav-arrow:hover {
    background: rgba(238, 108, 26, 0.85);
    border-color: rgba(238, 108, 26, 0.5);
    transform: translateY(-50%) scale(1.08);
  }

  .nav-arrow svg {
    width: 20px;
    height: 20px;
  }

  .nav-prev { left: 1.5rem; }
  .nav-next { right: 1.5rem; }

  @media (max-width: 767px) {
    .nav-arrow { display: none; }
    .slide-counter { display: none; }
  }

  /* Scroll Hint */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    z-index: 20;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .scroll-hint:hover { opacity: 1; }

  .scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, #EE6C1A, transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50% { transform: scaleY(0.6); opacity: 0.5; }
  }

  .scroll-text {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.5);
    writing-mode: vertical-rl;
  }

  @media (max-width: 767px) {
    .scroll-hint {
      bottom: 5.5rem;
      right: 50%;
      transform: translateX(50%);
      flex-direction: row;
    }
    .scroll-text { writing-mode: horizontal-tb; }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     REDUCED MOTION
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition: opacity 0.3s ease !important;
      transform: none !important;
    }
    .hero-slide.is-active { transform: none !important; }
    .hero-slide.slide-exit-left { transform: none !important; }
    
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0ms !important;
      transition-duration: 0.01ms !important;
    }
    
    .line-text, .eyebrow-block, .subtitle-block, .ctas-row,
    .stats-grid, .services-matrix, .stat-card, .service-item,
    .mosaic-card, .logo-img, .logo-badge, .logo-glow,
    .orbital--outer, .orbital--inner, .particle {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Mobile Adjustments */
  @media (max-width: 1023px) {
    .visual-zone { display: none; }
    .slide-layout { 
      padding: 6rem 1.5rem 8rem;
      justify-content: center;
    }
    .mesh-blob { filter: blur(70px); }
    .geo-shape { display: none; }
  }
</style>

<script>
function initHeroSliderV7() {
  const slider = document.querySelector('[data-hero-slider]');
  if (!slider) return;

  const slides = Array.from(slider.querySelectorAll<HTMLElement>('.hero-slide'));
  const dots = Array.from(slider.querySelectorAll<HTMLElement>('.dot-btn'));
  const prevBtn = slider.querySelector<HTMLElement>('.nav-prev');
  const nextBtn = slider.querySelector<HTMLElement>('.nav-next');
  const progressTrack = slider.querySelector<HTMLElement>('.progress-track');
  const progressFill = slider.querySelector<HTMLElement>('.progress-fill');
  const counterCurrent = slider.querySelector<HTMLElement>('.counter-current');
  const dotsNav = slider.querySelector<HTMLElement>('.dots-nav');

  if (!slides.length) return;

  let currentIndex = 0;
  let autoplayTimer: ReturnType<typeof setTimeout> | null = null;
  let isPaused = false;
  const AUTOPLAY_DELAY = 8000;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function goToSlide(index: number, direction: 'next' | 'prev' | 'direct' = 'next') {
    if (index < 0) index = slides.length - 1;
    if (index >= slides.length) index = 0;

    const currentSlide = slides[currentIndex];
    const nextSlide = slides[index];

    // Exit animation for current
    currentSlide.classList.remove('is-active');
    if (direction !== 'direct') {
      currentSlide.classList.add(direction === 'next' ? 'slide-exit-left' : '');
    }

    // Small delay then activate new
    setTimeout(() => {
      currentSlide.classList.remove('slide-exit-left');
      nextSlide.classList.add('is-active');

      // Update counter
      if (counterCurrent) {
        counterCurrent.textContent = String(index + 1).padStart(2, '0');
      }

      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-selected', String(i === index));
        const fill = dot.querySelector<HTMLElement>('.dot-fill');
        if (fill) {
          fill.style.animation = 'none';
          void fill.offsetWidth;
          fill.style.animation = '';
        }
      });
    }, prefersReducedMotion ? 0 : 150);

    currentIndex = index;
    resetAutoplay();
  }

  function nextSlide() { goToSlide(currentIndex + 1, 'next'); }
  function prevSlide() { goToSlide(currentIndex - 1, 'prev'); }

  function startAutoplay() {
    if (prefersReducedMotion || isPaused) return;
    stopAutoplay();
    progressTrack?.classList.add('is-animating');
    autoplayTimer = setTimeout(nextSlide, AUTOPLAY_DELAY);
  }

  function stopAutoplay() {
    if (autoplayTimer) clearTimeout(autoplayTimer);
    autoplayTimer = null;
    progressTrack?.classList.remove('is-animating');
  }

  function resetAutoplay() {
    stopAutoplay();
    if (!isPaused) startAutoplay();
  }

  function pauseAutoplay() {
    isPaused = true;
    stopAutoplay();
    dotsNav?.classList.add('is-paused');
  }

  function resumeAutoplay() {
    isPaused = false;
    dotsNav?.classList.remove('is-paused');
    startAutoplay();
  }

  // Event Listeners
  dots.forEach((dot, i) => dot.addEventListener('click', () => goToSlide(i, i > currentIndex ? 'next' : i < currentIndex ? 'prev' : 'direct')));
  prevBtn?.addEventListener('click', prevSlide);
  nextBtn?.addEventListener('click', nextSlide);

  slider.addEventListener('mouseenter', pauseAutoplay);
  slider.addEventListener('mouseleave', resumeAutoplay);

  // Touch/Swipe
  let touchStartX = 0;
  let touchEndX = 0;

  slider.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartX = e.changedTouches[0].screenX;
    pauseAutoplay();
  }, { passive: true });

  slider.addEventListener('touchend', (e: TouchEvent) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 50) diff > 0 ? nextSlide() : prevSlide();
    resumeAutoplay();
  }, { passive: true });

  // Keyboard
  slider.setAttribute('tabindex', '0');
  slider.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowLeft') prevSlide();
    else if (e.key === 'ArrowRight') nextSlide();
  });

  // Visibility
  document.addEventListener('visibilitychange', () => document.hidden ? pauseAutoplay() : resumeAutoplay());

  // Start
  if (!prefersReducedMotion) startAutoplay();
}

document.readyState === 'loading'
  ? document.addEventListener('DOMContentLoaded', initHeroSliderV7)
  : initHeroSliderV7();
</script>
