---
/**
 * Hero.astro — Section d'accueil "Effet Waouh" avec mosaïque animée.
 * ────────────────────────────────────────────────────────────────────────────
 * - min-h-screen, overflow-hidden
 * - Background mesh gradient amélioré (4 radials superposés + drift 22s)
 * - Mosaïque ~70 diamants SVG en forme de ruban infini (∞)
 *   • Placement paramétrique: x = center + sin(t)*radius, y = center + sin(2t)*radius*0.55
 *   • Couleurs par quadrant: navy (HG), vert (HD), orange (B), pervenche (transition)
 *   • Animation d'assemblage: départ aléatoire → convergence expo-out 1.1s
 *   • Float loop post-assemblage: translateY 0→-10px sur 6s
 * - Contenu texte à GAUCHE (desktop), mosaïque à DROITE
 * - H1: "La technologie, pensée pour le terrain africain."
 * - Sous-titre FTCI + 2 CTA (primary + outline)
 * - Stats row: 4+ Solutions SaaS | 100% Ancré en CI | 24/7 Support
 * - Scroll indicator (chevron bounce)
 * - Pure CSS animations + vanilla JS (pas de librairies)
 * - GPU-only (transform + opacity uniquement)
 * - prefers-reduced-motion: disable TOUTES les animations
 * - Mobile responsive: effets complexes désactivés < 1024px
 */

interface MosaicPiece {
  id: number;
  x: number;
  y: number;
  size: number;
  color: string;
  delay: number;
  offsetX: number;
  offsetY: number;
  rotation: number;
}

// Génération des pièces de mosaïque (~70 pièces)
const PIECE_COUNT = 70;
const CENTER_X = 150;
const CENTER_Y = 130;
const RADIUS_X = 110;
const RADIUS_Y = 60;

function generateMosaicPieces(): MosaicPiece[] {
  const pieces: MosaicPiece[] = [];
  
  for (let i = 0; i < PIECE_COUNT; i++) {
    // Double boucle paramétrique (ruban infini)
    const t = (i / PIECE_COUNT) * Math.PI * 2;
    const x = CENTER_X + Math.sin(t) * RADIUS_X;
    const y = CENTER_Y + Math.sin(2 * t) * RADIUS_Y;
    
    // Taille variable 8-20px
    const size = 8 + Math.random() * 12;
    
    // Couleur par quadrant
    let color: string;
    const normalizedX = (x - CENTER_X) / RADIUS_X; // -1 à 1
    const normalizedY = (y - CENTER_Y) / RADIUS_Y; // -1 à 1
    
    if (normalizedY < 0 && normalizedX < 0) {
      color = '#0F1E3D'; // Navy - haut gauche
    } else if (normalizedY < 0 && normalizedX >= 0) {
      color = '#1E9E4F'; // Vert - haut droite
    } else if (normalizedY >= 0 && Math.abs(normalizedX) > 0.3) {
      color = '#EE6C1A'; // Orange - bas
    } else {
      color = '#6B7FC7'; // Pervenche - transition/centre
    }
    
    // Position de départ aléatoire
    const offsetX = (Math.random() - 0.5) * 440; // -220 à +220
    const offsetY = (Math.random() - 0.5) * 440;
    const rotation = (Math.random() - 0.5) * 360; // -180° à +180°
    
    // Délai aléatoire pour cascade 0-0.9s
    const delay = Math.random() * 0.9;
    
    pieces.push({
      id: i,
      x: Math.round(x),
      y: Math.round(y),
      size: Math.round(size),
      color,
      delay: Math.round(delay * 100) / 100,
      offsetX: Math.round(offsetX),
      offsetY: Math.round(offsetY),
      rotation: Math.round(rotation)
    });
  }
  
  return pieces;
}

const mosaicPieces = generateMosaicPieces();
---

<section
  class="hero-section relative min-h-[100svh] flex items-center overflow-hidden"
  id="contenu"
>
  <!-- ══════════════════════════════════════════════════════════════════════════
       MESH GRADIENT AMÉLIORÉ (4 radials superposés + drift animation)
       ══════════════════════════════════════════════════════════════════════════ -->
  <div class="hero-mesh absolute inset-[-20%]" aria-hidden="true">
    <div class="mesh-blob mesh-blob-1"></div>
    <div class="mesh-blob mesh-blob-2"></div>
    <div class="mesh-blob mesh-blob-3"></div>
    <div class="mesh-blob mesh-blob-4"></div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════
       CONTENU PRINCIPAL (Grid 2 colonnes desktop)
       ══════════════════════════════════════════════════════════════════════════ -->
  <div class="container relative z-10">
    <div class="hero-grid">
      
      <!-- ── CÔTÉ GAUCHE : Texte ───────────────────────────────────────────── -->
      <div class="hero-content">
        <!-- Eyebrow / Kicker -->
        <div class="hero-eyebrow observe" style="--d: 0s;">
          <span class="inline-flex items-center gap-2 font-sans font-semibold text-xs uppercase tracking-[0.12em] text-orange mb-6">
            <span class="w-8 h-px bg-orange/60"></span>
            Freelance Technologies Côte d'Ivoire
          </span>
        </div>

        <!-- H1 Principal -->
        <h1
          class="hero-title font-display font-extrabold text-white tracking-[-0.03em] observe"
          style="--reveal-ty: 24px; --d: 0.12s;"
        >
          <span class="title-line">La technologie,</span>
          <span class="title-line text-orange">pensée pour le</span>
          <span class="title-line">terrain africain.</span>
        </h1>

        <!-- Sous-titre -->
        <p
          class="hero-subtitle max-w-lg text-base sm:text-lg md:text-xl text-white/75 leading-relaxed observe"
          style="--d: 0.25s;"
        >
          Cabinet de conseil en transformation digitale et éditeur de solutions SaaS 
          conçues pour répondre aux réalités du marché ivoirien et africain.
        </p>

        <!-- CTAs -->
        <div
          class="hero-ctas flex flex-col sm:flex-row gap-4 mt-10 observe"
          style="--d: 0.4s;"
        >
          <a href="/#solutions" data-magnetic="18" class="btn-primary magnetic group">
            <span>
              Découvrir nos solutions
              <svg
                class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </a>
          <a href="/#contact" data-magnetic="14" class="btn-outline-light magnetic">
            <span>Nous contacter</span>
          </a>
        </div>

        <!-- Stats Row -->
        <div
          class="hero-stats grid grid-cols-3 gap-6 mt-14 pt-10 border-t border-white/10 observe"
          style="--d: 0.55s;"
        >
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">4+</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Solutions SaaS</div>
          </div>
          <div class="stat-item">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">100%</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Ancré en CI</div>
          </div>
          <div class="stat-item col-span-1">
            <div class="stat-value font-display font-bold text-3xl md:text-4xl text-white">24/7</div>
            <div class="stat-label text-xs sm:text-sm text-white/50 uppercase tracking-wider mt-1">Support</div>
          </div>
        </div>
      </div>

      <!-- ── CÔTÉ DROIT : Mosaïque animée (~70 diamants) ───────────────────── -->
      <div class="hero-mosaic-wrapper hidden lg:flex items-center justify-center" aria-hidden="true">
        <svg
          id="hero-mosaic"
          class="hero-mosaic w-full max-w-[340px] h-auto"
          viewBox="0 0 300 260"
          preserveAspectRatio="xMidYMid meet"
        >
          {mosaicPieces.map((piece) => (
            <rect
              class="mosaic-piece"
              data-piece-id={piece.id}
              x={piece.x}
              y={piece.y}
              width={piece.size}
              height={piece.size}
              rx="2"
              ry="2"
              fill={piece.color}
              style={
                `--tx: ${piece.offsetX}px;` +
                `--ty: ${piece.offsetY}px;` +
                `--rot: ${piece.rotation}deg;` +
                `--delay: ${piece.delay}s;`
              }
            />
          ))}
        </svg>
        
        <!-- Glow effect behind mosaic -->
        <div class="mosaic-glow absolute inset-0 bg-gradient-radial from-periwinkle/20 via-transparent to-transparent blur-3xl scale-150"></div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════
       SCROLL INDICATOR
       ══════════════════════════════════════════════════════════════════════════ -->
  <a
    href="/#solutions"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/40 hover:text-white/70 transition-colors duration-300 z-20"
    aria-label="Faire défiler vers les solutions"
  >
    <svg
      class="w-6 h-6 animate-bounce"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </a>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     HERO SECTION — Layout Grid
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    min-height: 100svh;
    padding: 120px 0 100px;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding: 100px 0 80px;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     TYPOGRAPHIE HERO
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-title {
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: clamp(2.5rem, 1.2rem + 4vw, 4.25rem);
      line-height: 1.05;
    }
  }

  .title-line {
    display: block;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     MESH GRADIENT AMÉLIORÉ (4 blobs + drift animation)
     ═══════════════════════════════════════════════════════════════════════════ */
  .hero-mesh {
    background-color: #0f1e3d;
  }

  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    will-change: transform;
  }

  .mesh-blob-1 {
    /* Pervenche 55% opacity - haut gauche */
    width: 65%;
    height: 55%;
    top: 10%;
    left: 15%;
    background: radial-gradient(ellipse, rgba(107, 127, 199, 0.55), transparent 70%);
    animation: meshDrift1 22s ease-in-out infinite alternate;
  }

  .mesh-blob-2 {
    /* Vert 35% opacity - haut droite */
    width: 50%;
    height: 45%;
    top: 15%;
    right: 10%;
    background: radial-gradient(ellipse, rgba(30, 158, 79, 0.35), transparent 70%);
    animation: meshDrift2 22s ease-in-out infinite alternate-reverse;
  }

  .mesh-blob-3 {
    /* Orange 30% opacity - bas droite */
    width: 55%;
    height: 48%;
    bottom: 12%;
    right: 18%;
    background: radial-gradient(ellipse, rgba(238, 108, 26, 0.30), transparent 70%);
    animation: meshDrift3 22s ease-in-out infinite alternate;
  }

  .mesh-blob-4 {
    /* Pervenche 25% opacity - bas gauche */
    width: 45%;
    height: 40%;
    bottom: 18%;
    left: 12%;
    background: radial-gradient(ellipse, rgba(107, 127, 199, 0.25), transparent 70%);
    animation: meshDrift4 22s ease-in-out infinite alternate-reverse;
  }

  @keyframes meshDrift1 {
    0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
    100% { transform: translate(3%, 2%) rotate(3deg) scale(1.05); }
  }

  @keyframes meshDrift2 {
    0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
    100% { transform: translate(-2%, 3%) rotate(-4deg) scale(1.04); }
  }

  @keyframes meshDrift3 {
    0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
    100% { transform: translate(2%, -2%) rotate(3.5deg) scale(1.06); }
  }

  @keyframes meshDrift4 {
    0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
    100% { transform: translate(-3%, -1%) rotate(-3deg) scale(1.03); }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     MOSAÏQUE ANIMÉE — Diamants SVG avec assemblage cascade
     ═══════════════════════════════════════════════════════════════════════════ */
  .mosaic-piece {
    /* État initial: décalé, rotaté, réduit */
    transform: 
      translate(var(--tx, 0px), var(--ty, 0px)) 
      rotate(var(--rot, 0deg)) 
      scale(0.4);
    opacity: 0;
    
    /* Animation d'assemblage vers position finale */
    animation: 
      mosaicAssemble 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards,
      mosaicFloat 6s ease-in-out infinite;
    
    /* Délai individuel pour effet cascade */
    animation-delay: var(--delay, 0s), calc(var(--delay, 0s) + 1.1s);
    
    /* GPU acceleration */
    will-change: transform, opacity;
    transform-origin: center;
    transform-box: fill-box;
  }

  /* Rotation initiale de 45° pour former des diamants */
  .mosaic-piece {
    transform: 
      translate(var(--tx, 0px), var(--ty, 0px)) 
      rotate(calc(var(--rot, 0deg) + 45deg)) 
      scale(0.4);
  }

  @keyframes mosaicAssemble {
    0% {
      transform: 
        translate(var(--tx, 0px), var(--ty, 0px)) 
        rotate(calc(var(--rot, 0deg) + 45deg)) 
        scale(0.4);
      opacity: 0;
    }
    100% {
      transform: 
        translate(0, 0) 
        rotate(45deg) 
        scale(1);
      opacity: 1;
    }
  }

  @keyframes mosaicFloat {
    0%, 100% {
      transform: rotate(45deg) translateY(0);
    }
    50% {
      transform: rotate(45deg) translateY(-10px);
    }
  }

  /* Glow derrière la mosaïque */
  .mosaic-glow {
    pointer-events: none;
    z-index: -1;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     STATS ROW
     ═══════════════════════════════════════════════════════════════════════════ */
  .stat-item {
    position: relative;
  }

  .stat-value {
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum" 1;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     REDUCED MOTION — Disable ALL animations
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .mosaic-piece {
      animation: none !important;
      transform: rotate(45deg) scale(1) !important;
      opacity: 1 !important;
    }
    
    .mesh-blob {
      animation: none !important;
    }
    
    .hero-mesh {
      animation: none !important;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     MOBILE — Simplification des effets
     ═══════════════════════════════════════════════════════════════════════════ */
  @media (max-width: 1023px) {
    .hero-mesh {
      filter: blur(30px);
    }
    
    .mesh-blob {
      filter: blur(50px);
      animation-duration: 44s !important;
    }
  }
</style>

<script>
  /**
   * Hero Mosaic — Initialisation JS minimal
   * Vérifie prefers-reduced-motion et ajoute classe si nécessaire.
   * Pas de logique complexe — tout est géré par CSS.
   */
  function initHeroMosaic() {
    const heroSection = document.querySelector('.hero-section');
    if (!heroSection) return;

    // Vérifier reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (prefersReducedMotion) {
      heroSection.classList.add('reduced-motion');
    }

    // Observer l'entrée dans le viewport pour déclencher les animations
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(heroSection);
  }

  // Exécuter au DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroMosaic);
  } else {
    initHeroMosaic();
  }
</script>
