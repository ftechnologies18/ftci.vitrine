---
/**
 * About.astro — Section "À Propos" (stats NYT + count-up ENHANCED)
 * ────────────────────────────────────────────────────────────────────────────
 * - Section id="about" py-20 md:py-32 bg-white overflow-hidden
 * - Background : motif circuit discret (opacity 5%) with parallax
 * - Layout 2 colonnes (md) : texte gauche, stats droite
 * 
 * SCROLL ANIMATIONS ENHANCED:
 * ─────────────────────────────────
 * 1. Scroll Reveal (.observe-reveal):
 *    - IntersectionObserver threshold 0.15
 *    - Initial: opacity: 0, translateY(28px)
 *    - Visible: opacity: 1, translateY(0), 0.7s cubic-bezier(0.16, 1, 0.3, 1)
 *    - Cascade delay by index
 *    - Single appearance only
 *
 * 2. Stats Counter Enhancement:
 *    - IntersectionObserver threshold 0.5
 *    - Easing: 1 - Math.pow(1 - progress, 3) over 1.6s
 *    - requestAnimationFrame for smooth updates
 *    - tabular-nums formatting to prevent jitter
 *    - Single trigger per element (unobserve after)
 *
 * 3. Parallax Background:
 *    - Circuit grid moves on scroll
 *    - Ratio: 0.06x scroll distance
 *    - Max displacement: 32px
 */

const keyPoints = [
        {
                title: 'Expertise Locale',
                description: 'Une connaissance fine du terrain ouest-africain et de ses contraintes.',
                color: 'orange',
                textClass: 'text-orange',
                bgClass: 'bg-orange/10',
                iconPath: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
        },
        {
                title: 'Excellence Technique',
                description: 'Des solutions modernes, robustes et conformes aux standards internationaux.',
                color: 'periwinkle',
                textClass: 'text-periwinkle',
                bgClass: 'bg-periwinkle/10',
                iconPath: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
        },
        {
                title: 'Partenariat Durable',
                description: 'Un accompagnement long terme, de l\'audit à la formation de vos équipes.',
                color: 'green',
                textClass: 'text-green',
                bgClass: 'bg-green/10',
                iconPath: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
        },
];
---

<section id="about" class="relative py-20 md:py-32 bg-white overflow-hidden">
        <!-- ═══════════════════════════════════════════════════════════════════════
             FLOATING ICONS MATRIX — Arrière-plan animé
             - Icônes technology en rotation (sans engrenages)
             - Pluie binaire ultra-légère
             - Contenu parfaitement lisible
             ═══════════════════════════════════════════════════════════════════════ -->
        
        <!-- ── Couche 1 : Pluie binaire ultra-légère ──────────────────────────── -->
        <div class="gear-matrix-binary" aria-hidden="true">
                {Array.from({length: 15}).map((_, colIndex) => (
                        <div class={`gmb-col ${colIndex % 4 === 0 ? 'gmb-col--reverse' : ''}`}
                                style={`--gmb-speed: ${22 + (colIndex % 6) * 4}s; --gmb-delay: ${(colIndex * -2)}s;`}>
                                {/* Contenu dupliqué pour animation fluide */}
                                {[...Array(2)].map(() => Array.from({length: 12}).map((_, i) => (
                                        <span class="gmb-char">{Math.random() > 0.5 ? '01' : '10'} {Math.random() > 0.5 ? '00' : '11'} {Math.random() > 0.5 ? '10' : '01'} {Math.random() > 0.5 ? '11' : '00'}</span>
                                )))}
                        </div>
                ))}
        </div>

        <!-- ── Couche 2 : Icônes flottantes en rotation ──────────────────────── -->
        <div class="floating-icons-container" aria-hidden="true">
                <!-- Icon 1 : IOT / Internet of Things (haut-gauche) -->
                <div class="floating-icon floating-icon--lg floating-icon--cw" style="--icon-x: 5%; --icon-y: 12%; --icon-speed: 45s; --icon-color: #ee6c1a;">
                        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <!-- Cercle extérieur connectivité -->
                                <circle cx="50" cy="50" r="42" opacity="0.15" fill="currentColor"/>
                                <circle cx="50" cy="50" r="42"/>
                                
                                <!-- Cercle intérieur -->
                                <circle cx="50" cy="50" r="28"/>
                                
                                <!-- Nœuds de connexion (haut/bas/gauche/droite) -->
                                <circle cx="50" cy="8" r="5" fill="currentColor"/>
                                <circle cx="50" cy="92" r="5" fill="currentColor"/>
                                <circle cx="8" cy="50" r="5" fill="currentColor"/>
                                <circle cx="92" cy="50" r="5" fill="currentColor"/>
                                
                                <!-- Nœuds diagonaux -->
                                <circle cx="22" cy="22" r="4" fill="currentColor"/>
                                <circle cx="78" cy="22" r="4" fill="currentColor"/>
                                <circle cx="22" cy="78" r="4" fill="currentColor"/>
                                <circle cx="78" cy="78" r="4" fill="currentColor"/>
                                
                                <!-- Lignes de connexion internes -->
                                <line x1="50" y1="22" x2="50" y2="8"/>
                                <line x1="50" y1="78" x2="50" y2="92"/>
                                <line x1="22" y1="50" x2="8" y2="50"/>
                                <line x1="78" y1="50" x2="92" y2="50"/>
                                
                                <!-- Texte IoT au centre -->
                                <text x="50" y="58" text-anchor="middle" font-family="'Courier New', monospace" font-size="20" font-weight="bold" fill="currentColor" stroke="none">IoT</text>
                        </svg>
                </div>
                
                <!-- Icon 2 : CLOUD (droit) - Forme nuage avec texte -->
                <div class="floating-icon floating-icon--lg floating-icon--ccw" style="--icon-x: 85%; --icon-y: 8%; --icon-speed: 35s; --icon-color: #6b7fc7;">
                        <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <!-- Forme nuage -->
                                <path d="M25 55 C10 55 5 45 12 35 C8 22 22 10 38 15 C45 5 65 5 75 15 C88 8 105 18 100 32 C112 38 108 55 95 55 Z" fill="currentColor" opacity="0.15"/>
                                <path d="M25 55 C10 55 5 45 12 35 C8 22 22 10 38 15 C45 5 65 5 75 15 C88 8 105 18 100 32 C112 38 108 55 95 55 Z"/>
                                <!-- Texte Cloud à l'intérieur -->
                                <text x="60" y="44" text-anchor="middle" font-family="'Courier New', monospace" font-size="16" font-weight="bold" fill="currentColor" stroke="none">Cloud</text>
                        </svg>
                </div>
                
                <!-- Icon 3 : CHIP/CPU (centre-droit) -->
                <div class="floating-icon floating-icon--sm floating-icon--cw" style="--icon-x: 78%; --icon-y: 58%; --icon-speed: 28s; --icon-color: #1e9e4f;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="4" y="4" width="16" height="16" rx="2"/>
                                <rect x="9" y="9" width="6" height="6"/>
                                <line x1="9" y1="1" x2="9" y2="4"/>
                                <line x1="15" y1="1" x2="15" y2="4"/>
                                <line x1="9" y1="20" x2="9" y2="23"/>
                                <line x1="15" y1="20" x2="15" y2="23"/>
                                <line x1="20" y1="9" x2="23" y2="9"/>
                                <line x1="20" y1="14" x2="23" y2="14"/>
                                <line x1="1" y1="9" x2="4" y2="9"/>
                                <line x1="1" y1="14" x2="4" y2="14"/>
                        </svg>
                </div>
                
                <!-- Icon 4 : WIFI (bas-gauche) -->
                <div class="floating-icon floating-icon--md floating-icon--ccw" style="--icon-x: 5%; --icon-y: 62%; --icon-speed: 40s; --icon-color: #0f1e3d;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
                                <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
                                <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
                                <line x1="12" y1="20" x2="12.01" y2="20"/>
                        </svg>
                </div>
                
                <!-- Icon 5 : CODE/TERMINAL (bas-droite) -->
                <div class="floating-icon floating-icon--sm floating-icon--cw" style="--icon-x: 90%; --icon-y: 78%; --icon-speed: 25s; --icon-color: #ee6c1a;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="16 18 22 12 16 6"/>
                                <polyline points="8 6 2 12 8 18"/>
                                <line x1="14" y1="4" x2="10" y2="20"/>
                        </svg>
                </div>
                
                <!-- Icon 6 : AI / CPU (centre-haut - forme chip avec texte AI) -->
                <div class="floating-icon floating-icon--lg floating-icon--ccw" style="--icon-x: 42%; --icon-y: 8%; --icon-speed: 35s; --icon-color: #6b7fc7;">
                        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <!-- Pattes du CPU (haut) -->
                                <line x1="30" y1="12" x2="30" y2="2"/>
                                <circle cx="30" cy="2" r="3" fill="currentColor"/>
                                <line x1="50" y1="10" x2="50" y2="0"/>
                                <circle cx="50" cy="0" r="3" fill="currentColor"/>
                                <line x1="70" y1="12" x2="70" y2="2"/>
                                <circle cx="70" cy="2" r="3" fill="currentColor"/>
                                
                                <!-- Pattes du CPU (bas) -->
                                <line x1="30" y1="88" x2="30" y2="98"/>
                                <circle cx="30" cy="98" r="3" fill="currentColor"/>
                                <line x1="50" y1="90" x2="50" y2="100"/>
                                <circle cx="50" cy="100" r="3" fill="currentColor"/>
                                <line x1="70" y1="88" x2="70" y2="98"/>
                                <circle cx="70" cy="98" r="3" fill="currentColor"/>
                                
                                <!-- Pattes du CPU (gauche) -->
                                <line x1="12" y1="30" x2="2" y2="30"/>
                                <circle cx="2" cy="30" r="3" fill="currentColor"/>
                                <line x1="10" y1="50" x2="0" y2="50"/>
                                <circle cx="0" cy="50" r="3" fill="currentColor"/>
                                <line x1="12" y1="70" x2="2" y2="70"/>
                                <circle cx="2" cy="70" r="3" fill="currentColor"/>
                                
                                <!-- Pattes du CPU (droite) -->
                                <line x1="88" y1="30" x2="98" y2="30"/>
                                <circle cx="98" cy="30" r="3" fill="currentColor"/>
                                <line x1="90" y1="50" x2="100" y2="50"/>
                                <circle cx="100" cy="50" r="3" fill="currentColor"/>
                                <line x1="88" y1="70" x2="98" y2="70"/>
                                <circle cx="98" cy="70" r="3" fill="currentColor"/>
                                
                                <!-- Corps du CPU (carré arrondi) -->
                                <rect x="18" y="18" width="64" height="64" rx="12" fill="currentColor" opacity="0.08"/>
                                <rect x="18" y="18" width="64" height="64" rx="12"/>
                                
                                <!-- Texte AI au centre -->
                                <text x="50" y="62" text-anchor="middle" font-family="'Courier New', monospace" font-size="28" font-weight="bold" fill="currentColor" stroke="none">AI</text>
                        </svg>
                </div>
        </div>

        <!-- ── Parallax background elements existants ───────────────────────────── -->
        <div class="parallax-bg about-parallax absolute inset-0 pointer-events-none" aria-hidden="true">
                <!-- Circuit grid with parallax -->
                <div class="absolute inset-0 opacity-[0.03] circuit-bg parallax-circuit"></div>
                <!-- Subtle gradient accent -->
                <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] rounded-full opacity-15 blur-[100px] parallax-glow"
                        style="background: radial-gradient(circle, var(--color-green) 0%, transparent 70%);"></div>
        </div>

        <div class="container relative z-10">
                <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                        <!-- ── Colonne gauche : texte ───────────────────────────────────── -->
                        <div class="observe-reveal" data-reveal-delay="0">
                                <span class="eyebrow">
                                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 8 8" aria-hidden="true">
                                                <polygon points="4,0 8,4 4,8 0,4" />
                                        </svg>
                                        L'entreprise
                                </span>
                                <h2 class="mb-6">À Propos de FTCI</h2>

                                <p class="text-lg text-gray-text leading-relaxed mb-5">
                                        <strong class="text-navy font-semibold">FTCI — Freelance Technologies Côte d'Ivoire</strong>
                                        est un cabinet de conseil en transformation digitale et un éditeur de
                                        solutions SaaS. Nous concevons des plateformes qui répondent aux défis
                                        spécifiques du marché africain : éducation, BTP, gestion scolaire et
                                        présence étudiante.
                                </p>
                                <p class="text-gray-text leading-relaxed mb-8">
                                        Notre approche combine expertise technique de pointe et compréhension
                                        profonde du terrain. Chaque solution est pensée pour fonctionner dans
                                        des contextes de connectivité limitée, avec des modes de paiement locaux
                                        et des réglementations régionales.
                                </p>

                                <!-- 3 points clés avec stagger -->
                                <div class="space-y-4 mb-8">
                                        {keyPoints.map((point, idx) => (
                                                <div class="flex items-start gap-4 key-point-item" data-key-delay={idx}>
                                                        <div class={`w-10 h-10 rounded-lg ${point.bgClass} flex items-center justify-center flex-shrink-0 key-point-icon`}>
                                                                <svg class={`w-5 h-5 ${point.textClass}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={point.iconPath} />
                                                                </svg>
                                                        </div>
                                                        <div class="key-point-content">
                                                                <h3 class="text-base font-display font-bold text-navy mb-0.5">{point.title}</h3>
                                                                <p class="text-sm text-gray-text leading-snug">{point.description}</p>
                                                        </div>
                                                </div>
                                        ))}
                                </div>

                                <a href="/#contact" data-magnetic="14" class="btn-outline magnetic">
                                        <span>
                                                En savoir plus
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                                </svg>
                                        </span>
                                </a>
                        </div>

                        <!-- ── Colonne droite : panneau stats (NYT Data Viz) ENHANCED ─────── -->
                        <div class="observe-reveal" data-reveal-delay="1">
                                <div class="bg-light-bg rounded-card p-8 md:p-10 border border-navy/5 stats-panel">
                                        <!-- HERO STAT — UN seul accent orange (NYT) -->
                                        <div class="mb-10 pb-8 border-b border-navy/8 stat-hero">
                                                <div class="flex items-baseline gap-1">
                                                        <span
                                                                class="stat-value font-display font-extrabold text-5xl sm:text-6xl md:text-7xl text-orange tracking-[-0.04em]"
                                                                data-count="100"
                                                                data-suffix="K+"
                                                        >0</span>
                                                </div>
                                                <p class="text-sm font-semibold text-navy mt-2">Utilisateurs actifs</p>
                                                <p class="source-line mt-1">Cumul across SECT, OPUC, CATS & ScolaGest — 2025</p>
                                        </div>

                                        <!-- 3 stats secondaires de-emphasized (NYT) -->
                                        <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-8 stats-grid">
                                                <div class="stat-item" data-stat-delay="0">
                                                        <div
                                                                class="stat-value font-display font-extrabold text-2xl sm:text-3xl text-navy tracking-tight"
                                                                data-count="4"
                                                        >0</div>
                                                        <p class="text-xs font-medium text-navy/70 mt-1">Solutions</p>
                                                        <p class="source-line mt-0.5">SaaS en production</p>
                                                </div>
                                                <div class="stat-item" data-stat-delay="1">
                                                        <div
                                                                class="stat-value font-display font-extrabold text-2xl sm:text-3xl text-green tracking-tight"
                                                                data-count="50"
                                                                data-suffix="+"
                                                        >0</div>
                                                        <p class="text-xs font-medium text-navy/70 mt-1">Institutions</p>
                                                        <p class="source-line mt-0.5">Clientes en CI</p>
                                                </div>
                                                <div class="stat-item" data-stat-delay="2">
                                                        <div
                                                                class="stat-value font-display font-extrabold text-2xl sm:text-3xl text-periwinkle tracking-tight"
                                                                data-count="99"
                                                                data-suffix="%"
                                                        >0</div>
                                                        <p class="text-xs font-medium text-navy/70 mt-1">Satisfaction</p>
                                                        <p class="source-line mt-0.5">Sondage clients 2025</p>
                                                </div>
                                        </div>

                                        <!-- Bloc localisation -->
                                        <div class="flex items-center gap-3 p-4 bg-white rounded-xl border border-navy/5 location-block">
                                                <svg class="w-6 h-6 text-orange flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                                </svg>
                                                <div>
                                                        <p class="text-sm font-semibold text-navy">Abidjan & Dabou</p>
                                                        <p class="text-xs text-gray-text">Côte d'Ivoire — Afrique de l'Ouest</p>
                                                </div>
                                        </div>
                                </div>
                        </div>
                </div>
        </div>
</section>

<script>
        // ═══════════════════════════════════════════════════════════════════════════
        // ABOUT SECTION — Enhanced Scroll Animations & Counters
        // ═══════════════════════════════════════════════════════════════════════════

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ── 1. Scroll Reveal Enhancement ────────────────────────────────────────
        // Same spec as Services: threshold 0.15, translateY(28px), 0.7s spring easing

        const revealElements = document.querySelectorAll('#about .observe-reveal');
        const cascadeDelays = [0, 0.08, 0.16, 0.24, 0.32];

        if (!reduced && 'IntersectionObserver' in window) {
                const revealObserver = new IntersectionObserver(
                        (entries) => {
                                entries.forEach((entry) => {
                                        if (entry.isIntersecting) {
                                                const el = entry.target as HTMLElement;
                                                const delayIdx = parseInt(el.dataset.revealDelay || '0', 10);
                                                const delay = cascadeDelays[Math.min(delayIdx, cascadeDelays.length - 1)] || 0;
                                                
                                                el.style.transitionDelay = `${delay}s`;
                                                el.classList.add('is-revealed');
                                                
                                                // Trigger staggered children animations
                                                if (el.classList.contains('observe-reveal')) {
                                                        const keyPoints = el.querySelectorAll('.key-point-item');
                                                        keyPoints.forEach((kp, idx) => {
                                                                setTimeout(() => {
                                                                        kp.classList.add('is-visible');
                                                                }, (delay * 1000) + (idx * 100));
                                                        });
                                                }
                                                
                                                revealObserver.unobserve(el);
                                        }
                                });
                        },
                        {
                                threshold: 0.15,
                                rootMargin: '0px 0px -40px 0px'
                        }
                );

                revealElements.forEach((el) => revealObserver.observe(el));
        } else if (reduced) {
                revealElements.forEach((el) => {
                        el.classList.add('is-revealed');
                        el.querySelectorAll('.key-point-item').forEach(kp => kp.classList.add('is-visible'));
                });
        }

        // ── 2. Stats Counter Enhancement ────────────────────────────────────────
        // IntersectionObserver threshold 0.5
        // Easing: 1 - Math.pow(1 - progress, 3) over 1.6s
        // requestAnimationFrame for smooth animation
        // tabular-nums via .stat-value CSS class
        // Single trigger per element (unobserve after)

        const counters = document.querySelectorAll<HTMLElement>('#about [data-count]');

        const formatNumber = (n: number): string => {
                return n.toLocaleString('fr-FR');
        };

        const animateCounter = (el: HTMLElement) => {
                const target = parseInt(el.dataset.count || '0', 10);
                const suffix = el.dataset.suffix || '';

                // Reduced motion: instant display
                if (reduced) {
                        el.textContent = formatNumber(target) + suffix;
                        return;
                }

                const duration = 1600; // 1.6s per spec
                const start = performance.now();

                const frame = (now: number) => {
                        const elapsed = now - start;
                        const progress = Math.min(elapsed / duration, 1);
                        
                        // Ease-out cubic: 1 - (1-t)^3
                        const eased = 1 - Math.pow(1 - progress, 3);
                        const current = Math.round(target * eased);
                        
                        el.textContent = formatNumber(current) + suffix;
                        
                        if (progress < 1) {
                                requestAnimationFrame(frame);
                        }
                };

                requestAnimationFrame(frame);
        };

        if ('IntersectionObserver' in window) {
                const counterObserver = new IntersectionObserver(
                        (entries) => {
                                entries.forEach((entry) => {
                                        if (entry.isIntersecting) {
                                                animateCounter(entry.target as HTMLElement);
                                                counterObserver.unobserve(entry.target); // Single trigger only
                                        }
                                });
                        },
                        { threshold: 0.5 }
                );

                counters.forEach((el) => counterObserver.observe(el));
        } else {
                counters.forEach((el) => animateCounter(el));
        }

        // ── 3. Parallax Background Enhancement ─────────────────────────────────
        // Apply to circuit grid and glow element
        // Ratio: 0.06x scroll distance
        // Max displacement: 32px
        // rAF throttled

        if (!reduced) {
                const parallaxContainer = document.querySelector('.about-parallax') as HTMLElement | null;
                
                if (parallaxContainer) {
                        let ticking = false;
                        const maxDisplacement = 32; // px
                        const parallaxRatio = 0.06;

                        const updateParallax = () => {
                                const rect = parallaxContainer.getBoundingClientRect();
                                const windowHeight = window.innerHeight;
                                
                                const viewProgress = (windowHeight - rect.top) / (windowHeight + rect.height);
                                const clampedProgress = Math.max(-1, Math.min(1, (viewProgress - 0.5) * 2));
                                const displacement = clampedProgress * maxDisplacement;
                                
                                // Apply to circuit grid
                                const circuit = parallaxContainer.querySelector('.parallax-circuit') as HTMLElement | null;
                                if (circuit) {
                                        circuit.style.transform = `translateY(${displacement}px)`;
                                }
                                
                                // Apply to glow (opposite direction for depth effect)
                                const glow = parallaxContainer.querySelector('.parallax-glow') as HTMLElement | null;
                                if (glow) {
                                        glow.style.transform = `translateY(${-displacement * 0.5}px)`;
                                }
                                
                                ticking = false;
                        };

                        updateParallax();

                        window.addEventListener('scroll', () => {
                                if (!ticking) {
                                        requestAnimationFrame(updateParallax);
                                        ticking = true;
                                }
                        }, { passive: true });
                }
        }
