                        <path class="gear-path" d="M100,35 L105,48 L120,46 L124,60 L139,63 L137,78 L150,87 L143,99 L152,113 L140,119 L143,135 L130,137 L127,152 L115,147 L104,158 L97,145 L85,150 L81,136 L68,134 L71,119 L61,111 L68,99 L61,87 L71,78 L69,63 L84,60 L89,47 Z M100,58 A28,28 0 1,0 100,114 A28,28 0 1,0 100,58" fill="none"/>
