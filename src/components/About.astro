                                        {/* 3 stats secondaires — de-emphasized, tabular-nums */}
                                        {/* navy / green / periwinkle (couleurs FTCI, pas de surcharge orange) */}
                                        <div class="grid grid-cols-3 gap-4 md:gap-6">
