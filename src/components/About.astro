---
/**
 * About.astro — Section "À Propos" (stats NYT + count-up).
 * ────────────────────────────────────────────────────────────────────────────
 * - Section id="about" py-20 md:py-32 bg-white
 * - Background : motif circuit discret (opacity 5%)
 * - Layout 2 colonnes (md) : texte gauche, stats droite
 * - Colonne gauche : h2, 2 paragraphes (positionnement + ancrage), 3 points
 *   clés (Expertise Locale / Excellence Technique / Partenariat Durable),
 *   CTA "En savoir plus" (btn-outline magnetic)
 * - Colonne droite : panneau bg-light-bg avec :
 *   • HERO STAT (NYT) : 100K+ Utilisateurs actifs en text-7xl text-orange
 *     + source line italique 11px — UN seul accent héros
 *   • 3 stats secondaires de-emphasized : 4 Solutions (navy), 50+ Institutions
 *     (green), 99% Satisfaction (periwinkle) — chacune avec source line
 *   • Bloc localisation : "Abidjan & Dabou"
 * - Compteurs : rAF ease-out 1.8s, IntersectionObserver threshold 0.5,
 *   prefers-reduced-motion → instant. tabular-nums via .stat-value
 */

const keyPoints = [
	{
		title: 'Expertise Locale',
		description: 'Une connaissance fine du terrain ouest-africain et de ses contraintes.',
		color: 'orange',
		textClass: 'text-orange',
		bgClass: 'bg-orange/10',
		iconPath: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
	},
	{
		title: 'Excellence Technique',
		description: 'Des solutions modernes, robustes et conformes aux standards internationaux.',
		color: 'periwinkle',
		textClass: 'text-periwinkle',
		bgClass: 'bg-periwinkle/10',
		iconPath: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
	},
	{
		title: 'Partenariat Durable',
		description: 'Un accompagnement long terme, de l\'audit à la formation de vos équipes.',
		color: 'green',
		textClass: 'text-green',
		bgClass: 'bg-green/10',
		iconPath: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
	},
];
---

<section id="about" class="relative py-20 md:py-32 bg-white overflow-hidden">
	<!-- ── Motif circuit discret ───────────────────────────────────────── -->
	<div class="absolute inset-0 opacity-[0.05] circuit-bg" aria-hidden="true"></div>

	<div class="container relative z-10">
		<div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
			<!-- ── Colonne gauche : texte ───────────────────────────────────── -->
			<div class="observe" style="--d: 0s">
				<span class="eyebrow">
					<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 8 8" aria-hidden="true">
						<polygon points="4,0 8,4 4,8 0,4" />
					</svg>
					L'entreprise
				</span>
				<h2 class="mb-6">À Propos de FTCI</h2>

				<p class="text-lg text-gray-text leading-relaxed mb-5">
					<strong class="text-navy font-semibold">FTCI — Freelance Technologies Côte d'Ivoire</strong>
					est un cabinet de conseil en transformation digitale et un éditeur de
					solutions SaaS. Nous concevons des plateformes qui répondent aux défis
					spécifiques du marché africain : éducation, BTP, gestion scolaire et
					présence étudiante.
				</p>
				<p class="text-gray-text leading-relaxed mb-8">
					Notre approche combine expertise technique de pointe et compréhension
					profonde du terrain. Chaque solution est pensée pour fonctionner dans
					des contextes de connectivité limitée, avec des modes de paiement locaux
					et des réglementations régionales.
				</p>

				<!-- 3 points clés -->
				<div class="space-y-4 mb-8">
					{keyPoints.map((point) => (
						<div class="flex items-start gap-4">
							<div class={`w-10 h-10 rounded-lg ${point.bgClass} flex items-center justify-center flex-shrink-0`}>
								<svg class={`w-5 h-5 ${point.textClass}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={point.iconPath} />
								</svg>
							</div>
							<div>
								<h3 class="text-base font-display font-bold text-navy mb-0.5">{point.title}</h3>
								<p class="text-sm text-gray-text leading-snug">{point.description}</p>
							</div>
						</div>
					))}
				</div>

				<a href="/#contact" data-magnetic="14" class="btn-outline magnetic">
					<span>
						En savoir plus
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</span>
				</a>
			</div>

			<!-- ── Colonne droite : panneau stats (NYT Data Viz) ────────────── -->
			<div class="observe" style="--d: 0.15s">
				<div class="bg-light-bg rounded-card p-8 md:p-10 border border-navy/5">
					<!-- HERO STAT — UN seul accent orange (NYT) -->
					<div class="mb-10 pb-8 border-b border-navy/8">
						<div class="flex items-baseline gap-1">
							<span
								class="stat-value font-display font-extrabold text-7xl text-orange tracking-[-0.04em]"
								data-count="100"
								data-suffix="K+"
							>0</span>
						</div>
						<p class="text-sm font-semibold text-navy mt-2">Utilisateurs actifs</p>
						<p class="source-line mt-1">Cumul across SECT, OPUC, CATS & ScolaGest — 2025</p>
					</div>

					<!-- 3 stats secondaires de-emphasized (NYT) -->
					<div class="grid grid-cols-3 gap-4 mb-8">
						<div>
							<div
								class="stat-value font-display font-extrabold text-3xl text-navy tracking-tight"
								data-count="4"
							>0</div>
							<p class="text-xs font-medium text-navy/70 mt-1">Solutions</p>
							<p class="source-line mt-0.5">SaaS en production</p>
						</div>
						<div>
							<div
								class="stat-value font-display font-extrabold text-3xl text-green tracking-tight"
								data-count="50"
								data-suffix="+"
							>0</div>
							<p class="text-xs font-medium text-navy/70 mt-1">Institutions</p>
							<p class="source-line mt-0.5">Clientes en CI</p>
						</div>
						<div>
							<div
								class="stat-value font-display font-extrabold text-3xl text-periwinkle tracking-tight"
								data-count="99"
								data-suffix="%"
							>0</div>
							<p class="text-xs font-medium text-navy/70 mt-1">Satisfaction</p>
							<p class="source-line mt-0.5">Sondage clients 2025</p>
						</div>
					</div>

					<!-- Bloc localisation -->
					<div class="flex items-center gap-3 p-4 bg-white rounded-xl border border-navy/5">
						<svg class="w-6 h-6 text-orange flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
						<div>
							<p class="text-sm font-semibold text-navy">Abidjan & Dabou</p>
							<p class="text-xs text-gray-text">Côte d'Ivoire — Afrique de l'Ouest</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// ── Count-up (rAF ease-out 1.8s, IntersectionObserver threshold 0.5) ────
	// prefers-reduced-motion → instant. tabular-nums via .stat-value (anti-jitter)
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const counters = document.querySelectorAll<HTMLElement>('[data-count]');

	const formatNumber = (n: number): string => {
		return n.toLocaleString('fr-FR');
	};

	const animate = (el: HTMLElement) => {
		const target = parseInt(el.dataset.count || '0', 10);
		const suffix = el.dataset.suffix || '';

		if (reduced) {
			el.textContent = formatNumber(target) + suffix;
			return;
		}

		const duration = 1800;
		const start = performance.now();

		const frame = (now: number) => {
			const elapsed = now - start;
			const progress = Math.min(elapsed / duration, 1);
			// ease-out cubic : 1 - (1-t)^3
			const eased = 1 - Math.pow(1 - progress, 3);
			const current = Math.round(target * eased);
			el.textContent = formatNumber(current) + suffix;
			if (progress < 1) {
				requestAnimationFrame(frame);
			}
		};

		requestAnimationFrame(frame);
	};

	if ('IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						animate(entry.target as HTMLElement);
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.5 },
		);
		counters.forEach((el) => observer.observe(el));
	} else {
		counters.forEach((el) => animate(el));
	}
</script>
