---
/**
 * About.astro — Section "À Propos" (stats NYT + count-up ENHANCED)
 * ────────────────────────────────────────────────────────────────────────────
 * - Section id="about" py-20 md:py-32 bg-white overflow-hidden
 * - Background : motif circuit discret (opacity 5%) with parallax
 * - Layout 2 colonnes (md) : texte gauche, stats droite
 * 
 * SCROLL ANIMATIONS ENHANCED:
 * ─────────────────────────────────
 * 1. Scroll Reveal (.observe-reveal):
 *    - IntersectionObserver threshold 0.15
 *    - Initial: opacity: 0, translateY(28px)
 *    - Visible: opacity: 1, translateY(0), 0.7s cubic-bezier(0.16, 1, 0.3, 1)
 *    - Cascade delay by index
 *    - Single appearance only
 *
 * 2. Stats Counter Enhancement:
 *    - IntersectionObserver threshold 0.5
 *    - Easing: 1 - Math.pow(1 - progress, 3) over 1.6s
 *    - requestAnimationFrame for smooth updates
 *    - tabular-nums formatting to prevent jitter
 *    - Single trigger per element (unobserve after)
 *
 * 3. Parallax Background:
 *    - Circuit grid moves on scroll
 *    - Ratio: 0.06x scroll distance
 *    - Max displacement: 32px
 */

const keyPoints = [
        {
                title: 'Expertise Locale',
                description: 'Une connaissance fine du terrain ouest-africain et de ses contraintes.',
                color: 'orange',
                textClass: 'text-orange',
                bgClass: 'bg-orange/10',
                iconPath: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
        },
        {
                title: 'Excellence Technique',
                description: 'Des solutions modernes, robustes et conformes aux standards internationaux.',
                color: 'periwinkle',
                textClass: 'text-periwinkle',
                bgClass: 'bg-periwinkle/10',
                iconPath: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
        },
        {
                title: 'Partenariat Durable',
                description: 'Un accompagnement long terme, de l\'audit à la formation de vos équipes.',
                color: 'green',
                textClass: 'text-green',
                bgClass: 'bg-green/10',
                iconPath: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
        },
];
---

<section id="about" class="relative py-20 md:py-32 bg-white overflow-hidden">
        <!-- ═══════════════════════════════════════════════════════════════════════
             FLOATING ICONS MATRIX — Arrière-plan animé
             - Icônes technology en rotation (sans engrenages)
             - Pluie binaire ultra-légère
             - Contenu parfaitement lisible
             ═══════════════════════════════════════════════════════════════════════ -->
        
        <!-- ── Couche 1 : Pluie binaire ultra-légère (couvre toute la section) ───── -->
        <div class="gear-matrix-binary" aria-hidden="true">
                {Array.from({length: 25}).map((_, colIndex) => (
                        <div class={`gmb-col ${colIndex % 4 === 0 ? 'gmb-col--reverse' : ''}`}
                                style={`--gmb-speed: ${20 + (colIndex % 6) * 3}s; --gmb-delay: ${(colIndex * -1.5)}s;`}>
                                {/* Contenu triplé pour animation fluide et couverture complète */}
                                {[...Array(3)].map(() => Array.from({length: 20}).map((_, i) => (
                                        <span class="gmb-char">{Math.random() > 0.5 ? '01' : '10'} {Math.random() > 0.5 ? '00' : '11'} {Math.random() > 0.5 ? '10' : '01'} {Math.random() > 0.5 ? '11' : '00'}</span>
                                )))}
                        </div>
                ))}
        </div>

        <!-- ── Couche 2 : Icônes flottantes en rotation ──────────────────────── -->
        <div class="floating-icons-container" aria-hidden="true">
                <!-- Icon 1 : IOT / Internet of Things (haut-gauche monté) -->
                <div class="floating-icon floating-icon--md floating-icon--cw" style="--icon-x: 4%; --icon-y: 2%; --icon-speed: 45s; --icon-color: #ee6c1a;">
                        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <!-- Cercle extérieur connectivité -->
                                <circle cx="50" cy="50" r="42" opacity="0.15" fill="currentColor"/>
                                <circle cx="50" cy="50" r="42"/>
                                
                                <!-- Cercle intérieur -->
                                <circle cx="50" cy="50" r="28"/>
                                
                                <!-- Nœuds de connexion (haut/bas/gauche/droite) -->
                                <circle cx="50" cy="8" r="5" fill="currentColor"/>
                                <circle cx="50" cy="92" r="5" fill="currentColor"/>
                                <circle cx="8" cy="50" r="5" fill="currentColor"/>
                                <circle cx="92" cy="50" r="5" fill="currentColor"/>
                                
                                <!-- Nœuds diagonaux -->
                                <circle cx="22" cy="22" r="4" fill="currentColor"/>
                                <circle cx="78" cy="22" r="4" fill="currentColor"/>
                                <circle cx="22" cy="78" r="4" fill="currentColor"/>
                                <circle cx="78" cy="78" r="4" fill="currentColor"/>
                                
                                <!-- Lignes de connexion internes -->
                                <line x1="50" y1="22" x2="50" y2="8"/>
                                <line x1="50" y1="78" x2="50" y2="92"/>
                                <line x1="22" y1="50" x2="8" y2="50"/>
                                <line x1="78" y1="50" x2="92" y2="50"/>
                                
                                <!-- Texte IoT au centre -->
                                <text x="50" y="58" text-anchor="middle" font-family="'Courier New', monospace" font-size="20" font-weight="bold" fill="currentColor" stroke="none">IoT</text>
                        </svg>
                </div>
                
                <!-- Icon 2 : CLOUD (droite - position initiale) -->
                <div class="floating-icon floating-icon--lg floating-icon--ccw" style="--icon-x: 85%; --icon-y: 8%; --icon-speed: 35s; --icon-color: #6b7fc7;">
                        <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <!-- Forme nuage -->
                                <path d="M25 55 C10 55 5 45 12 35 C8 22 22 10 38 15 C45 5 65 5 75 15 C88 8 105 18 100 32 C112 38 108 55 95 55 Z" fill="currentColor" opacity="0.15"/>
                                <path d="M25 55 C10 55 5 45 12 35 C8 22 22 10 38 15 C45 5 65 5 75 15 C88 8 105 18 100 32 C112 38 108 55 95 55 Z"/>
                                <!-- Texte Cloud à l'intérieur -->
                                <text x="60" y="44" text-anchor="middle" font-family="'Courier New', monospace" font-size="16" font-weight="bold" fill="currentColor" stroke="none">Cloud</text>
                        </svg>
                </div>
                
                <!-- Icon 4 : WIFI (bas gauche, place ancien bouton) -->
                <div class="floating-icon floating-icon--md floating-icon--ccw" style="--icon-x: 5%; --icon-y: 85%; --icon-speed: 40s; --icon-color: #0f1e3d;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
                                <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
                                <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
                                <line x1="12" y1="20" x2="12.01" y2="20"/>
                        </svg>
                </div>
                
                <!-- Icon 5 : CODE/TERMINAL (monté d'un cran) -->
                <div class="floating-icon floating-icon--sm floating-icon--cw" style="--icon-x: 90%; --icon-y: 86%; --icon-speed: 25s; --icon-color: #ee6c1a;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="16 18 22 12 16 6"/>
                                <polyline points="8 6 2 12 8 18"/>
                                <line x1="14" y1="4" x2="10" y2="20"/>
                        </svg>
                </div>
                
                <!-- Icon 6 : AI / CPU (centre haut au-dessus du contenu) -->
                <div class="floating-icon floating-icon--md floating-icon--ccw" style="--icon-x: 50%; --icon-y: 2%; --icon-speed: 35s; --icon-color: #6b7fc7;">
                        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <!-- Pattes du CPU (haut) -->
                                <line x1="30" y1="12" x2="30" y2="2"/>
                                <circle cx="30" cy="2" r="3" fill="currentColor"/>
                                <line x1="50" y1="10" x2="50" y2="0"/>
                                <circle cx="50" cy="0" r="3" fill="currentColor"/>
                                <line x1="70" y1="12" x2="70" y2="2"/>
                                <circle cx="70" cy="2" r="3" fill="currentColor"/>
                                
                                <!-- Pattes du CPU (bas) -->
                                <line x1="30" y1="88" x2="30" y2="98"/>
                                <circle cx="30" cy="98" r="3" fill="currentColor"/>
                                <line x1="50" y1="90" x2="50" y2="100"/>
                                <circle cx="50" cy="100" r="3" fill="currentColor"/>
                                <line x1="70" y1="88" x2="70" y2="98"/>
                                <circle cx="70" cy="98" r="3" fill="currentColor"/>
                                
                                <!-- Pattes du CPU (gauche) -->
                                <line x1="12" y1="30" x2="2" y2="30"/>
                                <circle cx="2" cy="30" r="3" fill="currentColor"/>
                                <line x1="10" y1="50" x2="0" y2="50"/>
                                <circle cx="0" cy="50" r="3" fill="currentColor"/>
                                <line x1="12" y1="70" x2="2" y2="70"/>
                                <circle cx="2" cy="70" r="3" fill="currentColor"/>
                                
                                <!-- Pattes du CPU (droite) -->
                                <line x1="88" y1="30" x2="98" y2="30"/>
                                <circle cx="98" cy="30" r="3" fill="currentColor"/>
                                <line x1="90" y1="50" x2="100" y2="50"/>
                                <circle cx="100" cy="50" r="3" fill="currentColor"/>
                                <line x1="88" y1="70" x2="98" y2="70"/>
                                <circle cx="98" cy="70" r="3" fill="currentColor"/>
                                
                                <!-- Corps du CPU (carré arrondi) -->
                                <rect x="18" y="18" width="64" height="64" rx="12" fill="currentColor" opacity="0.08"/>
                                <rect x="18" y="18" width="64" height="64" rx="12"/>
                                
                                <!-- Texte AI au centre -->
                                <text x="50" y="62" text-anchor="middle" font-family="'Courier New', monospace" font-size="28" font-weight="bold" fill="currentColor" stroke="none">AI</text>
                        </svg>
                </div>
                
                <!-- Icon 7 : CYBERSÉCURITÉ (bas centre) -->
                <div class="floating-icon floating-icon--md floating-icon--cw" style="--icon-x: 48%; --icon-y: 86%; --icon-speed: 38s; --icon-color: #1e9e4f; opacity: 0.22;">
                        <svg viewBox="0 0 120 140" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Bouclier extérieur -->
                                <path d="M60 5L110 25V65C110 95 85 120 60 135C35 120 10 95 10 65V25L60 5Z" 
                                        stroke="currentColor" stroke-width="2.5" fill="none"/>
                                <!-- Bouclier intérieur -->
                                <path d="M60 15L100 32V63C100 88 80 108 60 120C40 108 20 88 20 63V32L60 15Z" 
                                        stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.85"/>
                                <!-- Cadenas -->
                                <rect x="45" y="62" width="30" height="26" rx="4" stroke="currentColor" stroke-width="2" fill="none"/>
                                <!-- Anneau du cadenas -->
                                <path d="M50 62V52C50 46.477 54.477 42 60 42C65.523 42 70 46.477 70 52V62" 
                                        stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
                                <!-- Trou de clé -->
                                <circle cx="60" cy="73" r="4" fill="currentColor" opacity="0.9"/>
                                <circle cx="60" cy="73" r="2" fill="currentColor"/>
                                <!-- Points circuit décoratifs -->
                                <circle cx="25" cy="55" r="2" fill="currentColor" opacity="0.7"/>
                                <circle cx="95" cy="55" r="2" fill="currentColor" opacity="0.7"/>
                                <circle cx="35" cy="105" r="1.5" fill="currentColor" opacity="0.6"/>
                                <circle cx="85" cy="105" r="1.5" fill="currentColor" opacity="0.6"/>
                        </svg>
                </div>
        </div>

        <!-- ── Parallax background elements existants ───────────────────────────── -->
        <div class="parallax-bg about-parallax absolute inset-0 pointer-events-none" aria-hidden="true">
                <!-- Circuit grid with parallax -->
                <div class="absolute inset-0 opacity-[0.03] circuit-bg parallax-circuit"></div>
                <!-- Subtle gradient accent -->
                <div class="absolute -bottom-32 -left-32 w-[400px] h-[400px] rounded-full opacity-15 blur-[100px] parallax-glow"
                        style="background: radial-gradient(circle, var(--color-green) 0%, transparent 70%);"></div>
        </div>

        <div class="container relative z-10">
                <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                        <!-- ── Colonne gauche : texte ───────────────────────────────────── -->
                        <div class="observe-reveal" data-reveal-delay="0">
                                <span class="eyebrow">
                                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 8 8" aria-hidden="true">
                                                <polygon points="4,0 8,4 4,8 0,4" />
                                        </svg>
                                        L'entreprise
                                </span>
                                <h2 class="about-title mb-6">À Propos de FTCI</h2>

                                <p class="text-lg text-gray-text leading-relaxed mb-5">
                                        <strong class="text-navy font-semibold">FTCI — Freelance Technologies Côte d'Ivoire</strong>{' '}
