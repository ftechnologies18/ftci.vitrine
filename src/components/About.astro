                                                        </div>
                                                        <p class="text-gray-text text-sm font-medium">Institutions servies</p>
                                                        <p class="text-gray-text text-[11px] italic mt-1">
                                                                Universités & écoles, CI
                                                        </p>
                                                </div>

                                                {/* Stat: Satisfaction client — periwinkle */}
                                                <div class="text-center">
                                                        <div class="text-3xl md:text-4xl font-extrabold text-periwinkle mb-1 stat-value">
                                                                <span class="counter" data-target="99">0</span>%
                                                        </div>
                                                        <p class="text-gray-text text-sm font-medium">Satisfaction client</p>
                                                        <p class="text-gray-text text-[11px] italic mt-1">
                                                                Enquête interne, 2026
                                                        </p>
                                                </div>
                                        </div>

                                        {/* Bloc localisation — ancrage local (Abidjan & Dabou) */}
                                        <div class="mt-10 pt-8 border-t border-navy/10">
                                                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-text mb-3">
                                                        Basée en Côte d'Ivoire
                                                </p>
                                                <div class="flex items-center gap-2 mb-3">
                                                        <svg
                                                                class="w-5 h-5 text-orange flex-shrink-0"
                                                                fill="none"
                                                                stroke="currentColor"
                                                                viewBox="0 0 24 24"
                                                                aria-hidden="true"
                                                        >
                                                                <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                                                />
                                                                <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                                                />
                                                        </svg>
                                                        <p class="text-navy font-bold text-lg">Abidjan & Dabou</p>
                                                </div>
                                                <p class="text-gray-text text-sm leading-relaxed">
                                                        Nous accompagnons les institutions africaines dans leur
                                                        transformation digitale, avec une expertise locale et une
                                                        excellence technique.
                                                </p>
                                        </div>
                                </div>
                        </div>
                </div>
        </div>
</section>

<script>
        // === Compteurs animés (cahier des charges 6.2 — R-DESIGN-2) ===
        // NYT Data Viz: tabular-nums (.stat-value global) prevents count-up jitter.
        // Apple Design: reduced-motion = valeur finale instantanée (no vestibular trigger).
        // Emil Design: rAF + ease-out cubic, 1.8s, GPU-friendly (text-only).
        // Review Animations: interruptible via unobserve, GPU-only, < 300ms UI N/A ici
        //                    (animation longue justifiée = data viz counters, exception autorisée).
        const counters = document.querySelectorAll('.counter');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const runCounter = (counter: Element) => {
                const target = parseInt(counter.getAttribute('data-target') || '0');

                // Reduced motion: snap à la valeur finale immédiatement (Apple Design)
                if (prefersReducedMotion) {
                        counter.textContent = String(target);
                        return;
                }

                const duration = 1800; // 1.8s — snappy, sous 2s
                const startTime = performance.now();

                const updateCounter = (now: number) => {
                        const elapsed = now - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        // ease-out cubic — décélération naturelle (Emil: ease-out sur enter/reveal)
                        const eased = 1 - Math.pow(1 - progress, 3);
                        const current = Math.floor(eased * target);
                        counter.textContent = String(current);

                        if (progress < 1) {
                                requestAnimationFrame(updateCounter);
                        } else {
                                counter.textContent = String(target);
                        }
                };

                requestAnimationFrame(updateCounter);
        };

        // Déclenchement au scroll (Intersection Observer natif — pas de JS lourd)
        const counterObserver = new IntersectionObserver(
                (entries) => {
                        entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                        runCounter(entry.target);
                                        counterObserver.unobserve(entry.target);
                                }
                        });
                },
                { threshold: 0.5 }
        );

        counters.forEach((counter) => counterObserver.observe(counter));
</script>
