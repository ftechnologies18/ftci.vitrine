                        {/* === Colonne droite : panneau stats === */}
                        <div
                                class="observe"
                                style="--d:1; transition-delay: calc(var(--d, 0) * 0.1s);"
                        >
                                <div class="bg-light-bg rounded-2xl p-8 md:p-10 border border-navy/8">
                                        {/* HERO STAT — UN seul accent (NYT Data Viz) */}
                                        {/* 100K+ utilisateurs, orange, très gros — le "wow" de la vue */}
                                        <div class="text-center mb-10 pb-8 border-b border-navy/10">
                                                <div class="text-6xl md:text-7xl font-extrabold text-orange mb-3 stat-value leading-none">
