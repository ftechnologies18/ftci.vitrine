                                                <div class="w-10 h-10 bg-periwinkle/10 rounded-lg flex items-center justify-center text-periwinkle flex-shrink-0">
                                                        <svg
                                                                class="w-5 h-5"
                                                                fill="none"
                                                                stroke="currentColor"
                                                                viewBox="0 0 24 24"
                                                                aria-hidden="true"
                                                        >
                                                                <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                                                                />
                                                        </svg>
                                                </div>
                                                <div>
                                                        <h4 class="font-bold text-navy mb-1">Partenariat Durable</h4>
                                                        <p class="text-gray-text">
                                                                Support continu et évolution selon vos besoins
                                                        </p>
                                                </div>
                                        </div>
                                </div>

