---
// Services section showcasing FTCI's consulting and development services
// Cahier des charges 6.3: Timeline animée + icônes en tracé animé SVG (stroke animation)
// Skills: Emil (stroke-draw utility), Apple Design (interruptible), Vignelli (clarity)
---

<section id="services" class="py-20 md:py-32 bg-light-bg relative overflow-hidden">
	<div class="container">
		<!-- Section Header -->
		<div class="text-center mb-16 observe">
			<h2 class="text-4xl md:text-5xl font-bold text-navy mb-4">
				Nos Services
			</h2>
			<p class="text-lg text-gray-text max-w-2xl mx-auto">
				Du conseil stratégique au déploiement d'outils numériques sur mesure
			</p>
		</div>

		<!-- Services Timeline with SVG stroke animation -->
		<div class="max-w-4xl mx-auto">
			<!-- Service 1: Digital Transformation Consulting -->
			<div class="observe relative mb-12 md:mb-16 flex gap-8" data-stagger="0">
				<!-- Timeline dot with SVG icon -->
				<div class="flex flex-col items-center">
					<div class="w-14 h-14 bg-gradient-to-br from-orange to-orange-600 rounded-full flex items-center justify-center text-white flex-shrink-0 shadow-lg relative">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M13 10V3L4 14h7v7l9-11h-7z"
								class="stroke-draw"
								style="--d: 0;"
							/>
						</svg>
						<span class="absolute -top-2 -right-2 w-6 h-6 bg-white text-orange text-xs font-bold rounded-full flex items-center justify-center border-2 border-orange">1</span>
					</div>
					<div class="w-0.5 h-24 bg-gradient-to-b from-orange to-periwinkle mt-4"></div>
				</div>

				<!-- Content -->
				<div class="pb-8 flex-1">
					<h3 class="text-2xl font-bold text-navy mb-2">
						Transformation Digitale
					</h3>
					<p class="text-gray-text mb-4">
						Accompagnement stratégique pour digitaliser votre institution. Audit des processus, recommandations technologiques, planification de déploiement.
					</p>
					<ul class="space-y-2 text-sm text-gray-text">
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Audit des besoins métier
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Roadmap technologique
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Gestion du changement
						</li>
					</ul>
				</div>
			</div>

			<!-- Service 2: Custom Web Development -->
			<div class="observe relative mb-12 md:mb-16 flex gap-8" data-stagger="1">
				<div class="flex flex-col items-center">
					<div class="w-14 h-14 bg-gradient-to-br from-periwinkle to-blue-600 rounded-full flex items-center justify-center text-white flex-shrink-0 shadow-lg relative">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
								class="stroke-draw"
								style="--d: 1;"
							/>
						</svg>
						<span class="absolute -top-2 -right-2 w-6 h-6 bg-white text-periwinkle text-xs font-bold rounded-full flex items-center justify-center border-2 border-periwinkle">2</span>
					</div>
					<div class="w-0.5 h-24 bg-gradient-to-b from-periwinkle to-green mt-4"></div>
				</div>

				<div class="pb-8 flex-1">
					<h3 class="text-2xl font-bold text-navy mb-2">
						Développement Web sur Mesure
					</h3>
					<p class="text-gray-text mb-4">
						Création d'applications web et mobiles adaptées à vos besoins spécifiques. Stack moderne, performant, sécurisé.
					</p>
					<ul class="space-y-2 text-sm text-gray-text">
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Applications web progressives (PWA)
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Intégrations API tierces
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Support et maintenance
						</li>
					</ul>
				</div>
			</div>

			<!-- Service 3: IT Infrastructure -->
			<div class="observe relative mb-12 md:mb-16 flex gap-8" data-stagger="2">
				<div class="flex flex-col items-center">
					<div class="w-14 h-14 bg-gradient-to-br from-green to-green-600 rounded-full flex items-center justify-center text-white flex-shrink-0 shadow-lg relative">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M5 12H3l9-9 9 9h-2M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7M9 21v-6a2 2 0 012-2h2a2 2 0 012 2v6"
								class="stroke-draw"
								style="--d: 2;"
							/>
						</svg>
						<span class="absolute -top-2 -right-2 w-6 h-6 bg-white text-green text-xs font-bold rounded-full flex items-center justify-center border-2 border-green">3</span>
					</div>
					<div class="w-0.5 h-24 bg-gradient-to-b from-green to-orange mt-4"></div>
				</div>

				<div class="pb-8 flex-1">
					<h3 class="text-2xl font-bold text-navy mb-2">
						Infrastructure IT
					</h3>
					<p class="text-gray-text mb-4">
						Mise en place d'infrastructures cloud robustes et sécurisées. Hébergement, sauvegarde, monitoring 24/7.
					</p>
					<ul class="space-y-2 text-sm text-gray-text">
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Infrastructure cloud (AWS, Google Cloud)
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Sécurité et conformité
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Disaster recovery
						</li>
					</ul>
				</div>
			</div>

			<!-- Service 4: Documentation & Training -->
			<div class="observe relative flex gap-8" data-stagger="3">
				<div class="flex flex-col items-center">
					<div class="w-14 h-14 bg-gradient-to-br from-orange to-orange-600 rounded-full flex items-center justify-center text-white flex-shrink-0 shadow-lg relative">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
								class="stroke-draw"
								style="--d: 3;"
							/>
						</svg>
						<span class="absolute -top-2 -right-2 w-6 h-6 bg-white text-orange text-xs font-bold rounded-full flex items-center justify-center border-2 border-orange">4</span>
					</div>
				</div>

				<div class="pb-8 flex-1">
					<h3 class="text-2xl font-bold text-navy mb-2">
						Documentation & Formation
					</h3>
					<p class="text-gray-text mb-4">
						Documentation technique complète et formation des équipes. Garantir l'adoption et la maîtrise des outils.
					</p>
					<ul class="space-y-2 text-sm text-gray-text">
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Guides utilisateur et administrateur
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Formations en ligne et présentiel
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Support utilisateur continu
						</li>
					</ul>
				</div>
			</div>
		</div>

		<!-- CTA -->
		<div class="observe mt-16 text-center">
			<p class="text-gray-text mb-6">
				Besoin d'une solution personnalisée ?
			</p>
			<a
				href="#contact"
				class="magnetic inline-flex items-center gap-2 px-8 py-4 bg-orange text-white rounded-lg font-semibold hover:bg-orange-600 active:scale-95 transition-all duration-200"
				data-magnetic
			>
				Discutons de votre projet
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.observe {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
	}

	.observe.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.observe {
			opacity: 1;
			transform: none;
			transition: opacity 0.2s ease;
		}
		.stroke-draw {
			stroke-dashoffset: 0 !important;
			animation: none !important;
		}
	}
</style>
