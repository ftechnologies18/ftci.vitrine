---
/**
 * Services.astro — Section "Nos Services" (timeline verticale + stroke-draw ENHANCED)
 * ────────────────────────────────────────────────────────────────────────────
 * - Section id="services" py-16 md:py-24 lg:py-32 bg-light-bg overflow-hidden
 * - Timeline verticale : 4 services avec cercle numéroté gradient + icône SVG
 *   .stroke-draw-enhanced (tracé animé au scroll — dasharray 300, 1.4s)
 * - Chaque étape : titre, description, liste à puces vertes
 * - CTA final "Discutons de votre projet" (btn-primary magnetic)
 * 
 * SCROLL ANIMATIONS ENHANCED:
 * ─────────────────────────────────
 * 1. Scroll Reveal (.observe-reveal):
 *    - IntersectionObserver threshold 0.15
 *    - Initial: opacity: 0, translateY(28px)
 *    - Visible: opacity: 1, translateY(0), 0.7s cubic-bezier(0.16, 1, 0.3, 1)
 *    - Cascade delay: 0s / 0.08s / 0.16s / 0.24s / 0.32s by index
 *    - Single appearance only (unobserve after first trigger)
 *
 * 2. SVG Stroke Animation (.stroke-draw-enhanced):
 *    - Icons stroke-only (fill="none")
 *    - stroke-dasharray: 300, stroke-dashoffset: 300 → 0
 *    - Duration: 1.4s cubic-bezier(0.16, 1, 0.3, 1)
 *    - Triggered when parent card enters viewport
 *
 * 3. Parallax Background (.parallax-bg):
 *    - Mesh gradient & circuit grid move on scroll
 *    - Ratio: 0.08x scroll distance
 *    - Max displacement: 36px
 *    - rAF throttled single scroll listener
 */

import { services } from '../data/services';
---

<section id="services" class="relative py-16 md:py-24 lg:py-32 bg-light-bg overflow-hidden">
        <!-- ── Parallax background elements ────────────────────────────────────── -->
        <div class="parallax-bg services-parallax absolute inset-0 pointer-events-none" aria-hidden="true">
                <!-- Mesh gradient blob -->
                <div class="absolute -top-24 -right-24 w-[500px] h-[500px] rounded-full opacity-30 blur-[80px]"
                        style="background: radial-gradient(circle, var(--color-periwinkle) 0%, transparent 70%);"></div>
                <!-- Circuit grid overlay -->
                <div class="absolute inset-0 opacity-[0.03] circuit-bg"></div>
        </div>

        <div class="container relative z-10">
                <!-- ── Section header ─────────────────────────────────────────────── -->
                <div class="section-header observe-reveal" data-reveal-delay="0">
                        <span class="eyebrow">
                                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 8 8" aria-hidden="true">
                                        <polygon points="4,0 8,4 4,8 0,4" />
                                </svg>
                                Accompagnement
                        </span>
                        <h2>Nos Services</h2>
                        <p>
                                Une expertise complète, de la stratégie à l'exploitation — pour transformer
                                vos idées en solutions durables.
                        </p>
                </div>

                <!-- ── Timeline verticale ─────────────────────────────────────────── -->
                <div class="relative max-w-3xl mx-auto">
                        <!-- Ligne verticale gradient (orange → periwinkle → green → orange) -->
                        <div
                                class="absolute left-6 top-2 bottom-2 w-0.5 bg-gradient-to-b from-orange via-periwinkle to-green md:left-8 timeline-line"
                                aria-hidden="true"
                        ></div>

                        {services.map((service, idx) => (
                                <div
                                        id={`service-${service.slug}`}
                                        class="relative pl-16 md:pl-24 pb-8 last:pb-0 observe-reveal service-card scroll-mt-24"
                                        data-reveal-delay={idx}
                                >
                                        <!-- Cercle numéroté gradient -->
                                        <div
                                                class={`absolute left-0 top-0 w-12 h-12 md:w-16 md:h-16 rounded-full bg-gradient-to-br ${service.gradient} flex items-center justify-center text-white font-display font-extrabold text-sm md:text-lg shadow-lg shrink-0 service-circle`}
                                                aria-hidden="true"
                                        >
                                                {service.num}
                                        </div>

                                        <!-- Contenu -->
                                        <div class="bg-white rounded-card p-5 md:p-7 shadow-sm border border-navy/5 service-content">
                                                <!-- Titre + icône stroke-draw-enhanced -->
                                                <div class="flex items-start justify-between gap-4 mb-3">
                                                        <h3 class="text-xl md:text-2xl font-display font-extrabold text-navy">
                                                                {service.title}
                                                        </h3>
                                                        <svg
                                                                class={`w-8 h-8 ${service.text} stroke-draw-enhanced shrink-0`}
                                                                fill="none"
                                                                stroke="currentColor"
                                                                viewBox="0 0 24 24"
                                                                stroke-width="1.8"
                                                                aria-hidden="true"
                                                        >
                                                                <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        d={service.iconPath}
                                                                />
                                                        </svg>
                                                </div>

                                                <!-- Description -->
                                                <p class="text-gray-text leading-relaxed mb-4">
                                                        {service.description}
                                                </p>

                                                <!-- Liste à puces vertes -->
                                                <ul class="space-y-2">
                                                        {service.items.map((item) => (
                                                                <li class="flex items-center gap-2.5 text-sm text-navy/80">
                                                                        <svg class="w-4 h-4 text-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                                                        </svg>
                                                                        {item}
                                                                </li>
                                                        ))}
                                                </ul>
                                        </div>
                                </div>
                        ))}
                </div>

                <!-- ── CTA final ──────────────────────────────────────────────────── -->
                <div class="text-center mt-14 observe-reveal" data-reveal-delay="4">
                        <a href="/#contact" data-magnetic="16" class="btn-primary magnetic">
                                <span>
                                        Discutons de votre projet
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                        </svg>
                                </span>
                        </a>
                </div>
        </div>
</section>

<script>
        // ═══════════════════════════════════════════════════════════════════════════
        // SERVICES SECTION — Enhanced Scroll Animations
        // ═══════════════════════════════════════════════════════════════════════════

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ── 1. Scroll Reveal Enhancement ────────────────────────────────────────
        // IntersectionObserver threshold 0.15
        // Initial: opacity: 0, translateY(28px)
        // Visible: opacity: 1, translateY(0), 0.7s cubic-bezier(0.16, 1, 0.3, 1)
        // Cascade delay by index: 0s, 0.08s, 0.16s, 0.24s, 0.32s
        // Single appearance only (unobserve after first reveal)

        const revealElements = document.querySelectorAll('.observe-reveal');
        
        // Cascade delays in seconds based on element index
        const cascadeDelays = [0, 0.08, 0.16, 0.24, 0.32];

        if (!reduced && 'IntersectionObserver' in window) {
                const revealObserver = new IntersectionObserver(
                        (entries) => {
                                entries.forEach((entry) => {
                                        if (entry.isIntersecting) {
                                                const el = entry.target as HTMLElement;
                                                const delayIdx = parseInt(el.dataset.revealDelay || '0', 10);
                                                const delay = cascadeDelays[Math.min(delayIdx, cascadeDelays.length - 1)] || 0;
                                                
                                                // Apply staggered delay via CSS custom property
                                                el.style.transitionDelay = `${delay}s`;
                                                el.classList.add('is-revealed');
                                                
                                                // Unobserve after first reveal (single appearance only)
                                                revealObserver.unobserve(el);
                                        }
                                });
                        },
                        {
                                threshold: 0.15,
                                rootMargin: '0px 0px -40px 0px'
                        }
                );

                revealElements.forEach((el) => revealObserver.observe(el));
        } else if (reduced) {
                // Reduced motion: show all immediately
                revealElements.forEach((el) => el.classList.add('is-revealed'));
        }

        // ── 2. Parallax Background Enhancement ──────────────────────────────────
        // Apply to mesh gradient and circuit grid
        // Ratio: 0.08x scroll distance
        // Max displacement: 36px
        // rAF throttled single scroll listener

        if (!reduced) {
                const parallaxContainer = document.querySelector('.services-parallax') as HTMLElement | null;
                
                if (parallaxContainer) {
                        let ticking = false;
                        const maxDisplacement = 36; // px

                        const updateParallax = () => {
                                const rect = parallaxContainer.getBoundingClientRect();
                                const windowHeight = window.innerHeight;
                                
                                // Calculate how far through the viewport the section is
                                // 0 = section just entering from bottom, 1 = section fully exited top
                                const viewProgress = (windowHeight - rect.top) / (windowHeight + rect.height);
                                
                                // Clamp between -1 and 1 for smooth bidirectional movement
                                const clampedProgress = Math.max(-1, Math.min(1, (viewProgress - 0.5) * 2));
                                
                                // Calculate displacement (max 36px)
                                const displacement = clampedProgress * maxDisplacement;
                                
                                // Apply transform to the mesh blob inside
                                const meshBlob = parallaxContainer.querySelector(':scope > div:first-child') as HTMLElement | null;
                                if (meshBlob) {
                                        meshBlob.style.transform = `translateY(${displacement}px)`;
                                }
                                
                                ticking = false;
                        };

                        // Initial call
                        updateParallax();

                        // Throttled scroll listener with rAF
                        window.addEventListener('scroll', () => {
                                if (!ticking) {
                                        requestAnimationFrame(updateParallax);
                                        ticking = true;
                                }
                        }, { passive: true });
                }
        }

        // ── 3. SVG Stroke Animation Trigger ─────────────────────────────────────
        // The CSS handles the actual animation (.stroke-draw-enhanced)
        // This JS ensures icons animate when their parent card is revealed
        
        const strokeIcons = document.querySelectorAll('.stroke-draw-enhanced');
        
        // Add is-visible class to trigger CSS animation when parent is revealed
        // Using MutationObserver to watch for parent's is-revealed class
        if (!reduced && 'MutationObserver' in window) {
                const mutationObserver = new MutationObserver((mutations) => {
                        mutations.forEach((mutation) => {
                                if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                                        const target = mutation.target as HTMLElement;
                                        if (target.classList.contains('is-revealed')) {
                                                // Find stroke-draw icon within this card and trigger animation
                                                const icon = target.querySelector('.stroke-draw-enhanced') as HTMLElement | null;
                                                if (icon && !icon.classList.contains('stroke-animated')) {
                                                        // Small delay after parent reveals for visual flow
                                                        setTimeout(() => {
                                                                icon.classList.add('stroke-animated');
                                                        }, 350);
                                                }
                                        }
                                }
                        });
                });

                // Observe each service card for class changes
                document.querySelectorAll('.service-card').forEach((card) => {
                        mutationObserver.observe(card, { attributes: true, attributeFilter: ['class'] });
                });
        } else if (reduced) {
                // Reduced motion: show strokes immediately
                strokeIcons.forEach((icon) => icon.classList.add('stroke-animated'));
        }
</script>

<style>
        /* ── Scroll Reveal Enhanced ─────────────────────────────────────────────── */
        .observe-reveal {
                opacity: 0;
                transform: translateY(28px);
                transition:
                        opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
                will-change: opacity, transform;
        }

        .observe-reveal.is-revealed {
                opacity: 1;
                transform: translateY(0);
        }

        /* ── SVG Stroke Draw Enhanced ──────────────────────────────────────────── */
        .stroke-draw-enhanced {
                stroke-dasharray: 300;
                stroke-dashoffset: 300;
                opacity: 0.6;
                will-change: stroke-dashoffset, opacity;
        }

        .stroke-draw-enhanced.stroke-animated {
                stroke-dashoffset: 0;
                opacity: 1;
                transition:
                        stroke-dashoffset 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                        opacity 0.5s ease-out;
        }

        /* ── Service Card Children Stagger ─────────────────────────────────────── */
        .service-card.is-revealed .service-circle {
                animation: circlePop 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                animation-delay: 0.1s;
        }

        .service-card.is-revealed .service-content {
                animation: contentSlide 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                animation-delay: 0.15s;
        }

        @keyframes circlePop {
                0% {
                        transform: scale(0.7);
                        opacity: 0;
                }
                100% {
                        transform: scale(1);
                        opacity: 1;
                }
        }

        @keyframes contentSlide {
                0% {
                        transform: translateX(16px);
                        opacity: 0;
                }
                100% {
                        transform: translateX(0);
                        opacity: 1;
                }
        }

        /* ── Timeline Line Animation ──────────────────────────────────────────── */
        .timeline-line {
                transform-origin: top center;
                transform: scaleY(0);
                transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
        }

        #services:has(.service-card[data-reveal-delay="0"].is-revealed) .timeline-line {
                transform: scaleY(1);
        }

        /* ── Parallax Container ───────────────────────────────────────────────── */
        .services-parallax > div {
                will-change: transform;
                transition: none; /* No transition — direct rAF updates */
        }

        /* ── Reduced Motion Overrides ─────────────────────────────────────────── */
        @media (prefers-reduced-motion: reduce) {
                .observe-reveal {
                        opacity: 1 !important;
                        transform: none !important;
                        transition: none !important;
                }

                .stroke-draw-enhanced {
                        stroke-dashoffset: 0 !important;
                        opacity: 1 !important;
                }

                .service-card.is-revealed .service-circle,
                .service-card.is-revealed .service-content {
                        animation: none !important;
                        transform: none !important;
                        opacity: 1 !important;
                }

                .timeline-line {
                        transform: scaleY(1) !important;
                }
        }
</style>
