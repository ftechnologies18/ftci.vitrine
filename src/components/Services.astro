---
/**
 * Services.astro — Section "Nos Services" (timeline verticale + stroke-draw).
 * ────────────────────────────────────────────────────────────────────────────
 * - Section id="services" py-20 md:py-32 bg-light-bg
 * - Timeline verticale : 4 services avec cercle numéroté gradient + icône SVG
 *   .stroke-draw (tracé animé au scroll), ligne verticale gradient entre étapes
 * - Chaque étape : titre, description, liste à puces vertes
 * - CTA final "Discutons de votre projet" (btn-primary magnetic)
 * - Stagger d'entrée (.observe + --d)
 * - L'icône .stroke-draw se déclenche via .observe.is-visible .stroke-draw
 *   (rule CSS dans global.css — pas d'observer séparé nécessaire)
 */

const services = [
        {
                num: '01',
                title: 'Transformation Digitale',
                color: 'orange',
                gradient: 'from-orange to-orange-600',
                text: 'text-orange',
                description:
                        "Nous accompagnons les organisations dans leur migration vers le numérique — de l'audit initial à la conduite du changement.",
                items: ['Audit & diagnostic', 'Roadmap stratégique', 'Gestion du changement'],
                iconPath:
                        'M13 10V3L4 14h7v7l9-11h-7z',
        },
        {
                num: '02',
                title: 'Développement Web sur Mesure',
                color: 'periwinkle',
                gradient: 'from-periwinkle to-periwinkle-600',
                text: 'text-periwinkle',
                description:
                        'Applications web et mobiles, API et PWA conçues sur mesure pour vos processus métiers et vos contraintes locales.',
                items: ['PWA & applications', 'API & intégrations', 'Support & maintenance'],
                iconPath:
                        'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
        },
        {
                num: '03',
                title: 'Infrastructure IT',
                color: 'green',
                gradient: 'from-green to-green-600',
                text: 'text-green',
                description:
                        "Conception, déploiement et sécurisation de votre infrastructure cloud et on-premise, avec continuité d'activité garantie.",
                items: ['Cloud & hybridation', 'Sécurité & conformité', 'Disaster recovery'],
                iconPath:
                        'M5 12H3l8-8 8 8h-2M5 12v7a1 1 0 001 1h3v-5h4v5h3a1 1 0 001-1v-7',
        },
        {
                num: '04',
                title: 'Documentation & Formation',
                color: 'orange',
                gradient: 'from-orange to-orange-600',
                text: 'text-orange',
                description:
                        "Nous transférons les compétences : guides techniques, formations utilisateurs et support continu pour autonomiser vos équipes.",
                items: ['Guides & documentation', 'Formations sur mesure', 'Support continu'],
                iconPath:
                        'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
        },
];
---

<section id="services" class="relative py-20 md:py-32 bg-light-bg overflow-hidden">
        <div class="container relative z-10">
                <!-- ── Section header ─────────────────────────────────────────────── -->
                <div class="section-header observe">
                        <span class="eyebrow">
                                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 8 8" aria-hidden="true">
                                        <polygon points="4,0 8,4 4,8 0,4" />
                                </svg>
                                Accompagnement
                        </span>
                        <h2>Nos Services</h2>
                        <p>
                                Une expertise complète, de la stratégie à l'exploitation — pour transformer
                                vos idées en solutions durables.
                        </p>
                </div>

                <!-- ── Timeline verticale ─────────────────────────────────────────── -->
                <div class="relative max-w-3xl mx-auto">
                        <!-- Ligne verticale gradient (orange → periwinkle → green → orange) -->
                        <div
                                class="absolute left-6 top-2 bottom-2 w-0.5 bg-gradient-to-b from-orange via-periwinkle to-green md:left-8"
                                aria-hidden="true"
                        ></div>

                        {services.map((service, idx) => (
                                <div
                                        class="relative pl-16 md:pl-24 pb-12 last:pb-0 observe"
                                        style={`--d: ${idx * 0.12}s`}
                                >
                                        <!-- Cercle numéroté gradient -->
                                        <div
                                                class={`absolute left-0 top-0 w-12 h-12 md:w-16 md:h-16 rounded-full bg-gradient-to-br ${service.gradient} flex items-center justify-center text-white font-display font-extrabold text-sm md:text-lg shadow-lg shrink-0`}
                                                aria-hidden="true"
                                        >
                                                {service.num}
                                        </div>

                                        <!-- Contenu -->
                                        <div class="bg-white rounded-card p-6 md:p-7 shadow-sm border border-navy/5">
                                                <!-- Titre + icône stroke-draw -->
                                                <div class="flex items-start justify-between gap-4 mb-3">
                                                        <h3 class="text-xl md:text-2xl font-display font-extrabold text-navy">
                                                                {service.title}
                                                        </h3>
                                                        <svg
                                                                class={`w-8 h-8 ${service.text} stroke-draw shrink-0`}
                                                                fill="none"
                                                                stroke="currentColor"
                                                                viewBox="0 0 24 24"
                                                                stroke-width="1.8"
                                                                aria-hidden="true"
                                                        >
                                                                <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        d={service.iconPath}
                                                                />
                                                        </svg>
                                                </div>

                                                <!-- Description -->
                                                <p class="text-gray-text leading-relaxed mb-4">
                                                        {service.description}
                                                </p>

                                                <!-- Liste à puces vertes -->
                                                <ul class="space-y-2">
                                                        {service.items.map((item) => (
                                                                <li class="flex items-center gap-2.5 text-sm text-navy/80">
                                                                        <svg class="w-4 h-4 text-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                                                        </svg>
                                                                        {item}
                                                                </li>
                                                        ))}
                                                </ul>
                                        </div>
                                </div>
                        ))}
                </div>

                <!-- ── CTA final ──────────────────────────────────────────────────── -->
                <div class="text-center mt-14 observe" style="--d: 0.1s">
                        <a href="/#contact" data-magnetic="16" class="btn-primary magnetic">
                                <span>
                                        Discutons de votre projet
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                        </svg>
                                </span>
                        </a>
                </div>
        </div>
</section>
