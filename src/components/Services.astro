---
// Services section showcasing FTCI's consulting and development services
---

<section id="services" class="py-20 md:py-32 bg-light-bg relative overflow-hidden">
	<div class="container">
		<!-- Section Header -->
		<div class="text-center mb-16 observe">
			<h2 class="text-4xl md:text-5xl font-bold text-navy mb-4">
				Nos Services
			</h2>
			<p class="text-lg text-gray-text max-w-2xl mx-auto">
				Du conseil stratégique au déploiement d'outils numériques sur mesure
			</p>
		</div>

		<!-- Services Timeline -->
		<div class="max-w-4xl mx-auto">
			<!-- Service 1: Digital Transformation Consulting -->
			<div class="observe relative mb-12 md:mb-16 flex gap-8">
				<!-- Timeline dot -->
				<div class="flex flex-col items-center">
					<div class="w-12 h-12 bg-gradient-to-br from-orange to-orange-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg">
						1
					</div>
					<div class="w-1 h-24 bg-gradient-to-b from-orange to-periwinkle mt-4"></div>
				</div>

				<!-- Content -->
				<div class="pb-8 flex-1">
					<h3 class="text-2xl font-bold text-navy mb-2">
						Transformation Digitale
					</h3>
					<p class="text-gray-text mb-4">
						Accompagnement stratégique pour digitaliser votre institution. Audit des processus, recommandations technologiques, planification de déploiement.
					</p>
					<ul class="space-y-2 text-sm text-gray-text">
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Audit des besoins métier
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Roadmap technologique
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Gestion du changement
						</li>
					</ul>
				</div>
			</div>

			<!-- Service 2: Custom Web Development -->
			<div class="observe relative mb-12 md:mb-16 flex gap-8">
				<div class="flex flex-col items-center">
					<div class="w-12 h-12 bg-gradient-to-br from-periwinkle to-blue-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg">
						2
					</div>
					<div class="w-1 h-24 bg-gradient-to-b from-periwinkle to-green mt-4"></div>
				</div>

				<div class="pb-8 flex-1">
					<h3 class="text-2xl font-bold text-navy mb-2">
						Développement Web sur Mesure
					</h3>
					<p class="text-gray-text mb-4">
						Création d'applications web et mobiles adaptées à vos besoins spécifiques. Stack moderne, performant, sécurisé.
					</p>
					<ul class="space-y-2 text-sm text-gray-text">
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Applications web progressives (PWA)
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Intégrations API tierces
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Support et maintenance
						</li>
					</ul>
				</div>
			</div>

			<!-- Service 3: IT Infrastructure -->
			<div class="observe relative mb-12 md:mb-16 flex gap-8">
				<div class="flex flex-col items-center">
					<div class="w-12 h-12 bg-gradient-to-br from-green to-green-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg">
						3
					</div>
					<div class="w-1 h-24 bg-gradient-to-b from-green to-orange mt-4"></div>
				</div>

				<div class="pb-8 flex-1">
					<h3 class="text-2xl font-bold text-navy mb-2">
						Infrastructure IT
					</h3>
					<p class="text-gray-text mb-4">
						Mise en place d'infrastructures cloud robustes et sécurisées. Hébergement, sauvegarde, monitoring 24/7.
					</p>
					<ul class="space-y-2 text-sm text-gray-text">
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Infrastructure cloud (AWS, Google Cloud)
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Sécurité et conformité
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Disaster recovery
						</li>
					</ul>
				</div>
			</div>

			<!-- Service 4: Documentation & Training -->
			<div class="observe relative flex gap-8">
				<div class="flex flex-col items-center">
					<div class="w-12 h-12 bg-gradient-to-br from-orange to-orange-600 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 shadow-lg">
						4
					</div>
				</div>

				<div class="pb-8 flex-1">
					<h3 class="text-2xl font-bold text-navy mb-2">
						Documentation & Formation
					</h3>
					<p class="text-gray-text mb-4">
						Documentation technique complète et formation des équipes. Garantir l'adoption et la maîtrise des outils.
					</p>
					<ul class="space-y-2 text-sm text-gray-text">
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Guides utilisateur et administrateur
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Formations en ligne et présentiel
						</li>
						<li class="flex items-center gap-2">
							<span class="w-2 h-2 bg-green rounded-full"></span>
							Support utilisateur continu
						</li>
					</ul>
				</div>
			</div>
		</div>

		<!-- CTA -->
		<div class="observe mt-16 text-center">
			<p class="text-gray-text mb-6">
				Besoin d'une solution personnalisée ?
			</p>
			<a 
				href="#contact"
				class="inline-flex items-center gap-2 px-8 py-4 bg-orange text-white rounded-lg font-semibold hover:bg-orange-600 active:scale-95 transition-all duration-200"
			>
				Discutons de votre projet
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.observe {
		opacity: 0;
		animation: slideUp 0.6s ease-out forwards;
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.observe {
			animation: none;
			opacity: 1;
		}
	}
</style>
