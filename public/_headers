# Security & cache headers for FTCI — Cloudflare Pages
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Security headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  # Content Security Policy (ajuster si besoin après test)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Immutable cache for hashed Astro assets (_astro/*)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache static images
/brand/*
  Cache-Control: public, max-age=604800

# Cache favicon
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# Never cache the API (dynamic)
/api/*
  Cache-Control: no-store

# Never cache sitemap & robots (regénérés à chaque build, mais on veut la version fraîche)
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
