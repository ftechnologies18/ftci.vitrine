# Security & cache headers for FTCI — Cloudflare Pages
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Security headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # X-XSS-Protection: 0 (déprécié, peut introduire des vulnérabilités — OWASP recommande de le désactiver quand une CSP est en place)
  X-XSS-Protection: 0
  # Content Security Policy (ajuster si besoin après test)
  # connect-src inclut api.keystatic.cloud (requêtes UI Keystatic Cloud) et keystatic.cloud (auth)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.keystatic.cloud https://keystatic.cloud; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Immutable cache for hashed Astro assets (_astro/*)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Immutable cache for self-hosted fonts (woff2)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Cache static images
/brand/*
  Cache-Control: public, max-age=604800

# Cache favicon
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# Never cache the API (dynamic)
/api/*
  Cache-Control: no-store

# Never cache sitemap & robots (regénérés à chaque build, mais on veut la version fraîche)
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Web App Manifest (icônes PWA / favicon discovery pour Google/Yandex)
/site.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json
