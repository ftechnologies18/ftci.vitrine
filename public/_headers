# Security & cache headers for FTCI — Cloudflare Pages
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Security headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # X-XSS-Protection: 0 (déprécié, peut introduire des vulnérabilités — OWASP recommande de le désactiver quand une CSP est en place)
  X-XSS-Protection: 0
  # Content Security Policy (ajuster si besoin après test)
  # connect-src inclut api.keystatic.cloud (requêtes UI Keystatic Cloud) et keystatic.cloud (auth)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.keystatic.cloud https://keystatic.cloud https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Immutable cache for hashed Astro assets (_astro/*)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Immutable cache for self-hosted fonts (woff2)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Cache static brand images (logos, favicons) — immuables car versionnés par
# hash de contenu dans les noms de fichiers _astro/* ou servis tels quels depuis
# /brand/*. Un cache long terme évite les re-téléchargements inutiles lors des
# visites répétées et améliore le LCP sur navigateur chaud.
/brand/*
  Cache-Control: public, max-age=31536000, immutable

# CSS des slides Hero (hero-slides.css) — fichier statique immuable, cache long terme.
# Si le contenu change, renommer le fichier (hero-slides.v2.css) pour invalider.
/css/*
  Cache-Control: public, max-age=31536000, immutable

# Cache favicon
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# Never cache the API (dynamic)
/api/*
  Cache-Control: no-store

# Security.txt — cache court car mis à jour avec les coordonnées de contact
/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# Never cache sitemap & robots (regénérés à chaque build, mais on veut la version fraîche)
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Web App Manifest (icônes PWA / favicon discovery pour Google/Yandex)
/site.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json
