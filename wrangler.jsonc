{
  "name": "ftci-vitrine",
  "kv_namespaces": [
    {
      "binding": "MESSAGE_STORE",
      "id": "a46dcd55e8ec4c04890ced3cbc1b3557"
    }
  ],
  "build": {
    "command": "pnpm install --no-frozen-lockfile && pnpm run build",
