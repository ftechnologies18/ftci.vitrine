{
  // Nom du Worker déployé sur Cloudflare (ftci-vitrine.<subdomain>.workers.dev).
  "name": "ftci-vitrine",

  // Date de compatibilité du runtime Workers.
  // À mettre à jour lors des montées de version d'Astro/@astrojs/cloudflare.
  "compatibility_date": "2026-04-15",

  // KV namespace pour le formulaire de contact (src/pages/api/contact.ts).
  // L'ID correspond au namespace MESSAGE_STORE du compte Cloudflare
  // 319de93db5a99db76b4bf41f9d06b785.
  "kv_namespaces": [
    {
      "binding": "MESSAGE_STORE",
      "id": "a46dcd55e8ec4c04890ced3cbc1b3557"
    }
  ]

  // NOTE — Pipeline CI/CD :
  // Le build ET le déploiement sont désormais pilotés par GitHub Actions
  // (voir .github/workflows/deploy.yml). Ce workflow installe les dépendances,
  // lance `astro build`, puis `wrangler deploy`.
  //
  // Aucune directive `build` n'est nécessaire ici : elle serait ignorée par
  // wrangler (warning "not applicable when using Vite") et n'est utilisée que
  // par Workers Builds (intégration Git native Cloudflare), que nous n'utilisons
  // pas. Si vous souhaitez réactiver Workers Builds à l'avenir, décommentez :
  //
  // , "build": {
  //     "command": "pnpm install --no-frozen-lockfile && pnpm run build",
  //     "cwd": "."
  //   }
}
