{
	"name": "ftci-vitrine",
	"type": "module",
	"version": "1.0.0",
	"description": "Site vitrine institutionnel de FTCI — Freelance Technologies Côte d'Ivoire (ESN). Astro 7 + Tailwind CSS 4 + Cloudflare Workers + Keystatic Cloud CMS.",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"types": "wrangler types",
		"deploy": "astro build && wrangler deploy",
		"cf-build": "astro build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "astro check",
		"audit": "pnpm audit",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.1.5",
		"@astrojs/markdoc": "^2.0.6",
		"@astrojs/react": "^6.0.2",
		"@keystatic/astro": "^5.2.0",
		"@keystatic/core": "^0.6.4",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.1.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"set-cookie-parser": "^3.1.2",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"wrangler": "^4.114.0"
	},
	"lint-staged": {
		"*.{ts,tsx,astro,mjs,js,cjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,jsonc,md,mdoc,css,html,yaml,yml}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"patchedDependencies": {
			"@keystatic/astro@5.2.0": "patches/@keystatic__astro@5.2.0.patch"
		},
		"overrides": {
			"minimatch": "^10.0.0"
		}
	}
}
