# build output
dist/
# generated types
.astro/
worker-configuration.d.ts

# dependencies
node_modules/

# bun lockfile — le projet utilise pnpm (voir package.json `packageManager`).
# Garder uniquement pnpm-lock.yaml pour éviter toute ambigüité côté CI/CD
# (Cloudflare Workers Builds et GitHub Actions détectent le package manager
# via le lockfile présent ; bun.lock en double pouvait causer des builds instables).
bun.lock
bun.lockb

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local contact form storage (dev mode)
storage/

# wrangler local cache (dev only — remote KV bindings are in wrangler.jsonc)
.wrangler/

